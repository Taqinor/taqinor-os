# Etape 1 : build React (Vite).
# IMPORTANT : le contexte de build est la RACINE du repo (voir docker-compose.yml),
# car la page ERP /devis-design importe le builder 3D roofPro11 depuis
# apps/web/src via un alias Vite (../apps/web/src). Sans ces fichiers dans le
# contexte, `npm run build` echoue (l'alias ne resout rien).
FROM node:22.14-alpine AS builder
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci --frozen-lockfile
# Source du builder 3D importee par l'alias Vite (../apps/web/src).
COPY apps/web/src /build/apps/web/src
# ERR-QJR5-DOCKERFILE-WORKER-ABSENT — apps/web/src/lib/lead.ts importe
# ../../worker/deadLetter.mjs (QJR663) : sans ce dossier, le build echoue.
COPY apps/web/worker /build/apps/web/worker
COPY frontend/ ./

# Variables d'environnement injectees au moment du build
ARG VITE_API_URL=http://localhost/api/django
ARG VITE_IA_API_URL=http://localhost/api/fastapi
ARG VITE_CONTACT_FORM_ENABLED=0
# ODY30 — kill-switch coquille "apps" (defaut ON = 1). Flag build-time :
# changer sa valeur exige un rebuild d'image (docker compose build frontend).
# OFF (0) = repli legacy, smoke d'urgence uniquement ; retrait planifie ODY33.
ARG VITE_APPS_SHELL=1
# QAH8 — Sentry frontend, garde par DSN (voir .env.example). Vide par defaut
# = monitoring desactive (frontend/src/lib/monitoring.js reste un no-op tant
# qu'aucun DSN n'est present dans le bundle).
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENVIRONMENT=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_IA_API_URL=$VITE_IA_API_URL
ENV VITE_CONTACT_FORM_ENABLED=$VITE_CONTACT_FORM_ENABLED
ENV VITE_APPS_SHELL=$VITE_APPS_SHELL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT

RUN npm run build

# Etape 2 : serveur nginx statique
FROM nginx:1.27-alpine
COPY --from=builder /build/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
