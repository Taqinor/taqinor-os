{
	"compatibility_date": "2026-06-11",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "taqinor-web",
	// Runtime configuration (Worker secrets/vars — see .dev.vars.example for local dev):
	//   SIMULATOR_API_URL — upstream simulation API; absent => local estimation fallback
	//   LEAD_WEBHOOK_URL  — lead forwarding endpoint (Odoo transition CRM webhook)
	//   CAPI_URL          — Meta Conversions API relay service (taqinor-os)
	//   WHATSAPP_NUMBER   — destination WhatsApp number, digits only (e.g. 2126XXXXXXXX)
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// QJR663 — lettre morte des leads non livrés : cron toutes les 30 min qui
	// renvoie le contenu de la liaison KV `LEADS_DLQ` à LEAD_WEBHOOK_URL
	// (worker/deadLetter.mjs). Sans liaison, le déclencheur est un no-op.
	// La liaison `kv_namespaces` n'est VOLONTAIREMENT PAS ici : un id factice
	// ferait échouer le déploiement. À ajouter par le fondateur APRÈS création
	// de l'espace de noms au tableau de bord :
	//   "kv_namespaces": [{ "binding": "LEADS_DLQ", "id": "<ID_DE_L_ESPACE>" }]
	// QJR663 — espace KV créé par le fondateur le 01/10/2026 (nom de liaison imposé par le code : LEADS_DLQ).
	"kv_namespaces": [{ "binding": "LEADS_DLQ", "id": "7fe63f806963407dbedf4ff525fda5e4" }],
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	"observability": {
		"enabled": true
	}
}