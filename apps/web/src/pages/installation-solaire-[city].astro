---
/**
 * Pages ville (W2) — une page indexée par ville de la zone de service
 * (Casablanca, Rabat, Marrakech, Tanger, Agadir). Données 100 % issues du site
 * (réalisations) ou de données météo publiques indicatives (ensoleillement) —
 * voir CITY_PAGES_NOTES.md. Aucun chantier n'est revendiqué là où il n'en
 * existe pas (`hasLocalInstall: false` → cadre honnête « zone couverte +
 * chantiers les plus proches »). Page publique, indexée.
 *
 * W201 — ARCHÉTYPES HÉRO CANONIQUES (3 sanctionnés, ne pas en inventer d'autres) :
 *
 *   A. VIDÉO-AFFICHE  (index.astro)
 *      — Plein écran min-h-[92svh], vidéo différée + affiche AVIF/WebP, scrim
 *        `.hero-scrim` canonique, titre ancré en bas à gauche. Réservé à l'accueil.
 *
 *   B. PHOTO-REMPLISSAGE  ← cette page utilise cet archétype
 *      (installation-solaire-[city].astro, realisations/[slug].astro, et leurs jumeaux)
 *      — `relative isolate mt-6 overflow-hidden`, photo `absolute inset-0 -z-10`
 *        via Picture.astro (eager + fetchpriority high), dégradé `from-nuit`, contenu
 *        texte `pt-24 pb-16 sm:pt-32 sm:pb-20` dans un `max-w-6xl`. Cadence :
 *        eyebrow tech-label + h1 display v2-page-title + lead v2-lead.
 *
 *   C. TEXTE-SEUL  (realisations/index.astro, nos-solutions.astro, guides/…)
 *      — Pas d'image de fond. Breadcrumb + `pt-16 pb-10 sm:pt-20`, eyebrow +
 *        h1 display v2-page-title + lead. Fond nuit du Layout, pas de scrim.
 *
 * Toute nouvelle page de segment/service/ville/guide DOIT choisir l'un de ces
 * trois archétypes et ne pas dériver. Pour ajouter un archétype, noter ici et
 * documenter dans DESIGN_RATIONALE.md.
 */
import CityPageBody from '../components/CityPageBody.astro';
import Layout from '../layouts/Layout.astro';
import { CITIES } from '../lib/realisations';
import { cityPageBase, cityServiceJsonLd, NEUTRAL_CITY_HERO } from '../lib/cityPageData';
import { PRODUCTION_NET_FACTOR } from '../lib/systemLoss';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const L = (href: string) => href; // FR : liens racine tels quels

// ENF19 — calcul commun FR/EN/AR (listes de chantiers, rendement mesuré, prose, alt des cartes) : lib/cityPageData.ts
const city = cityPageBase(c, c.intro);
const { inCity, avgYieldPerKwc, cityYieldTable, title, description, nearestInstallNote } = city;
const southOptimalYield = cityYieldTable
  ? Math.round(cityYieldTable.grid['0']['29'] * PRODUCTION_NET_FACTOR)
  : undefined;

// Hero : la 1re photo d'un chantier en ville si elle existe ; sinon une photo
// de marque neutre (crépuscule résidentiel, sans ville identifiable) — jamais
// une photo qui laisserait croire à un chantier local là où il n'y en a pas.
const heroPhoto = inCity[0]?.photos[0] ?? NEUTRAL_CITY_HERO;

const serviceJsonLd = cityServiceJsonLd('Installation solaire photovoltaïque', `Installation solaire ${c.intro}`, c.name);
const t = {
  kicker: `Zone d'intervention · ${c.name}`,
  h1: `Installation solaire ${c.intro}`,
  potential: 'Potentiel solaire',
  hoursUnit: 'h/an',
  sunshineLabel: `Ensoleillement annuel indicatif · ${c.name}`,
  publicData: 'Donnée météo publique, à titre indicatif.',
  statBill: 'De la facture couverte',
  statRoiValue: '3–7 ans',
  statRoi: 'Retour sur investissement',
  statWarrantyValue: '25 ans',
  statWarranty: 'Garantie de performance',
  stat8221: 'Simple déclaration loi 82-21',
  projectsKicker: `Nos chantiers · ${c.name}`,
  projectsH2: `Des installations réelles ${c.intro}`,
  caseStudy: "Voir l'étude de cas",
  nearbyKicker: 'Dans la région',
  nearbyH2: `D'autres chantiers en région de ${c.name}`,
  coveredKicker: 'Votre ville est couverte',
  coveredH2: `Nous intervenons ${c.intro} — et nos chantiers parlent pour nous`,
  closestLead: 'Voici nos chantiers les plus proches :',
  latest: 'Nos dernières réalisations',
  residential: 'Solaire résidentiel',
  business: 'Solaire professionnel',
};
const bodyProps = { c, rtl: false, L, cardAlt: (r: { photos: { alt: string }[] }) => r.photos[0].alt, t, breadcrumbItems: [{ label: 'Accueil', href: '/' }, { label: `Installation solaire ${c.intro}` }], heroPhoto, showYieldNote: !!(avgYieldPerKwc && southOptimalYield && avgYieldPerKwc < southOptimalYield), city };
---

<Layout title={title} description={description} ogSlug="accueil">
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <CityPageBody {...bodyProps}>
    <Fragment slot="yieldNote">
      À noter : ces installations mesurent en moyenne ≈{avgYieldPerKwc?.toLocaleString('fr-FR')} kWh/kWc/an,
      en dessous des ≈{southOptimalYield?.toLocaleString('fr-FR')} kWh/kWc/an du tableau modélisé utilisé
      pour les estimations — les installations réelles ne sont pas toutes plein sud à 29°,
      contrairement à l'hypothèse du modèle. L'étude affine ce chiffre sur votre toit réel.
    </Fragment>
    <Fragment slot="coveredNote">
      {nearestInstallNote ?? `${c.name} fait partie de notre zone d'intervention. Nos installations déjà en service ` +
        'les plus proches se trouvent en région de Casablanca — mêmes méthodes d\'étude, même ' +
        'matériel tier-1, même suivi de production en temps réel.'}
    </Fragment>
  </CityPageBody>
</Layout>
