---
/**
 * /status/<incident> — détail d'un incident public + son post-mortem (NTOBS2).
 *
 * Page SSR (prerender=false, même patron que /status/index.astro) qui lit
 * GET /api/django/statuspage/public/incidents/<id>/. Le post-mortem
 * n'apparaît que s'il a été PUBLIÉ côté backend (``postmortem_markdown``
 * vide sinon) — jamais un brouillon interne exposé.
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

interface IncidentUpdatePublic {
  statut: string;
  message: string;
  horodatage: string;
}

interface IncidentPublicItem {
  id: number;
  titre: string;
  severite: string;
  statut: string;
  region: string;
  composants: string[];
  debute_le: string;
  resolu_le: string | null;
  updates: IncidentUpdatePublic[];
  postmortem_markdown: string;
  postmortem_publie_le: string | null;
}

const API_BASE = (import.meta.env.PUBLIC_API_BASE as string | undefined) ?? 'https://api.taqinor.ma';
const SSR_FETCH_TIMEOUT_MS = 8000;
const { incident: incidentParam } = Astro.params as { incident: string };

async function fetchIncident(id: string): Promise<IncidentPublicItem | null> {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), SSR_FETCH_TIMEOUT_MS);
  try {
    const res = await fetch(
      `${API_BASE.replace(/\/+$/, '')}/api/django/statuspage/public/incidents/${encodeURIComponent(id)}/`,
      { headers: { accept: 'application/json' }, signal: controller.signal },
    );
    if (!res.ok) return null;
    return (await res.json()) as IncidentPublicItem;
  } catch {
    return null;
  } finally {
    clearTimeout(timer);
  }
}

const incident = incidentParam && /^\d+$/.test(incidentParam)
  ? await fetchIncident(incidentParam)
  : null;

if (!incident) {
  Astro.response.status = 404;
}

function formatDate(iso: string | null): string {
  if (!iso) return '';
  try {
    return new Date(iso).toLocaleString('fr-FR', {
      day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
    });
  } catch {
    return iso;
  }
}
---

<Layout
  title={incident ? `${incident.titre} | Statut Taqinor` : 'Incident introuvable | Statut Taqinor'}
  description="Détail d'un incident de la page de statut Taqinor et de son post-mortem, le cas échéant."
>
  <section class="mx-auto max-w-3xl bg-blanc-azur px-5 py-16 text-encre">
    <Breadcrumb
      tone="dark"
      items={[
        { label: 'Accueil', href: '/' },
        { label: 'Statut du service', href: '/status' },
        { label: incident ? incident.titre : 'Incident' },
      ]}
    />

    {!incident ? (
      <p class="mt-6 rounded-lg border border-alert-300 bg-alert-50 px-4 py-3 text-alert-600">
        Cet incident est introuvable.
      </p>
    ) : (
      <>
        <h1 class="mt-6 text-3xl font-semibold text-encre">{incident.titre}</h1>
        <p class="mt-2 text-sm text-encre-soft">
          Sévérité : {incident.severite} — Statut : {incident.statut}
          {incident.region ? ` — Région : ${incident.region}` : ''}
        </p>
        <p class="mt-1 text-xs text-encre-faint">
          Débuté le {formatDate(incident.debute_le)}
          {incident.resolu_le ? ` — Résolu le ${formatDate(incident.resolu_le)}` : ''}
        </p>

        {incident.updates.length > 0 && (
          <ol class="mt-8 space-y-3 border-l-2 border-azur-900/15 pl-4">
            {incident.updates.map((u) => (
              <li>
                <span class="text-xs text-encre-faint">{formatDate(u.horodatage)} — {u.statut}</span>
                <p class="text-sm text-encre-soft">{u.message}</p>
              </li>
            ))}
          </ol>
        )}

        {incident.postmortem_markdown ? (
          <div class="mt-10 rounded-md border border-azur-900/15 bg-blanc px-5 py-4">
            <h2 class="text-lg font-semibold text-encre">Post-mortem</h2>
            {incident.postmortem_publie_le && (
              <p class="mt-1 text-xs text-encre-faint">
                Publié le {formatDate(incident.postmortem_publie_le)}
              </p>
            )}
            <p class="mt-3 whitespace-pre-line text-sm text-encre-soft">{incident.postmortem_markdown}</p>
          </div>
        ) : null}

        <a class="mt-8 inline-block text-sm text-azur-700 underline" href="/status">
          ← Retour au statut du service
        </a>
      </>
    )}
  </section>
</Layout>
