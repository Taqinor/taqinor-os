---
/**
 * EN — Law 82-21: the three autoproduction regimes (W67). Faithful translation
 * of /loi-82-21 ; no new figure or claim. Every legal fact is kept EXACT: the
 * law number 82-21, decree 2-25-100, in force since 9 June 2026, the thresholds
 * (< 11 kW LV, up to 5 MW, ≥ 5 MW) and ANRE. Regime data comes from
 * regimesFor('en'). Internal links use localizeNavHref (EN if it exists, else
 * the FR page — never a dead link). FR untouched.
 */
import Layout from '../../layouts/Layout.astro';
import { pageLocale } from '../../lib/pageCtx';
import V2Enhance from '../../components/V2Enhance.astro';
import Article33Ribbon from '../../components/Article33Ribbon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RegimeSelector from '../../components/RegimeSelector.astro';
import CtaBand from '../../components/CtaBand.astro';
import StickyCta from '../../components/StickyCta.astro';
import ZelligeDivider from '../../components/ZelligeDivider.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import SourcesOfficielles8221 from '../../components/SourcesOfficielles8221.astro';
import { regimesFor } from '../../lib/regime';
import { localizeNavHref } from '../../i18n/pages';

const { locale, L } = pageLocale(Astro.url.pathname);
const REGIMES = regimesFor(locale);
import Loi8221DivBD31 from '../../components/blocs/Loi8221DivBD31.astro';
import Loi8221MxAutoCF28 from '../../components/blocs/Loi8221MxAutoCF28.astro';
import Loi8221OuEnEstLaLoiEn from '../../components/blocs/Loi8221OuEnEstLaLoiEn.astro';
---

<Layout
  title="Law 82-21: the 3 autoproduction regimes in Morocco | Taqinor"
  description="Declaration, connection agreement or authorization? In 3 questions, identify the Law 82-21 regime (decree 2-25-100) that applies to your solar installation."
  ogSlug="loi-82-21"
>
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'Home', href: L('/') }, { label: 'Law 82-21' }]} />

    <section class="px-4 py-20 text-white sm:py-28">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">Law 82-21 · decree 2-25-100</p>
        <h1 class="display v2-page-title cine-in mt-5 max-w-3xl [animation-delay:120ms]">Three regimes, only one is yours</h1>
        <p class="v2-lead cine-in mt-6 max-w-xl text-white/85 [animation-delay:240ms]">
          Law 82-21 on the self-production of electrical energy and its implementing decree
          2-25-100 are in force. From now on, whether it is brand new
          or already installed, every self-production installation falls under one of the three
          regimes below — and it is its power and its connection that decide which one.
        </p>
      </div>
    </section>

    <!-- W259 — « Where does the law stand? »: distinguishes LIVE (MV/HV) from PENDING (LV residential). -->
    <section class="mx-auto max-w-4xl px-4">
      <div class="v2-rise border-2 border-brass-400/50 bg-nuit-800/60 p-6 sm:p-8">
        <p class="tech-label v2-kicker text-brass-300">Where does the law stand? · verified on 5 October 2026</p>
        {/* CIW412 — sources: ANRE decision 04/26 art. 6-7 (the surplus tariff targets the VOLTAGE
            MV/HV/EHV, whatever the regime); decree 2.25.100 art. 12 (connection agreement from
            11 kW to under 5 MW); D-CIQ-4. In low voltage, resale is not open. */}
        <Loi8221OuEnEstLaLoiEn />
        <p class="mt-5 text-xs leading-relaxed text-lune-faint">
          Every tariff figure published on this site carries its validity window and its source; we
          update this page as soon as the residential LV tariff is published.
        </p>
      </div>
    </section>

    <!-- The lit instrument: the selector, a white document on the night -->
    <Loi8221MxAutoCF28 />

    <section class="mx-auto max-w-4xl px-4 py-16">
      <p class="tech-label v2-kicker rule-brass text-lune">Reference</p>
      <h2 class="display v2-section-title mt-4 text-white">The three regimes in detail</h2>
      <Loi8221DivBD31 REGIMES={REGIMES} />
      <RelatedLinks mt="mt-8" links={[
        { href: L('/résidentiel'), label: 'Regimes for a home' },
        { href: L('/professionnel'), label: 'Regimes for a business site' },
        { href: L('/guides/loi-82-21-expliquee'), label: 'Law 82-21 explained simply' },
        { href: L('/financement'), label: 'Financing & returns' },
      ]} />
    </section>

    <!-- FINAL ACT — regularization is handled in full daylight -->
    <div class="v2-seam" aria-hidden="true"></div>
    <section class="bg-blanc-azur px-4 pb-4 pt-2 text-encre">
      <div class="mx-auto max-w-4xl border-2 border-azur-600 bg-blanc p-7">
        <p class="tech-label text-azur-600">Existing installations</p>
        <h2 class="display v2-section-title mt-2">Already have an undeclared installation?</h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-encre-soft">
          For installations already in place, Article 33 of the law provides for regularization
          "within eighteen (18) months from the date of entry into force of this law" (Law 82-21, art. 33 — text of dahir 1-23-21 linked in this page's official
          sources). The step-by-step procedure is detailed on the dedicated page.
        </p>
        <a href={L('/regularization-article-33')} class="mt-5 inline-block bg-brass-400 px-6 py-3 text-sm font-bold text-azur-950 transition-colors hover:bg-brass-300">
          Regularize my installation
        </a>
      </div>
    </section>

    <SourcesOfficielles8221 />

    <CtaBand title="Unsure about your regime? We check it for free." buttonLabel="Have my file checked" seam={false} />

    <StickyCta />
  </div>
</Layout>
