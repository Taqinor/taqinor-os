---
/**
 * EN — Case study (W67). One page per real installation. Faithful English
 * translation of the FR `realisations/[slug].astro`. Data 100% from
 * `realisations.ts` (untouched): no invented figure. The production card is
 * OMITTED when measured production is not published (e.g. Nouaceur). Prose
 * (situation/sizing/result/install/resume/title/description/cityLink/alts) from
 * `caseStudyBySlug(slug, 'en')`. Internal links via localizeNavHref. FR untouched.
 *
 * W309 — ported the phased Avant/Pendant/Après (Before/During/After) gallery
 * (W184) + the accessible lightbox (W178) that the FR case study already has;
 * the phase data already lives in realisations.ts, this page just never
 * rendered it.
 */
import RealisationSlugBody from '../../../components/RealisationSlugBody.astro';
import Layout from '../../../layouts/Layout.astro';
import { REALISATIONS, CITIES } from '../../../lib/realisations';
import { caseStudyBySlug } from '../../../lib/caseStudies';
import { NAP } from '../../../lib/nap';
import { getLocaleFromPath } from '../../../i18n/utils';
import { localizeNavHref } from '../../../i18n/pages';

export function getStaticPaths() {
  return REALISATIONS.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}

const { r } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const L = (href: string) => localizeNavHref(href, locale);

const cs = caseStudyBySlug(r.slug, locale);

// La ville-page correspondante (Casablanca/Rabat/Marrakech/Tanger/Agadir).
const cityPage = CITIES.find((c) => c.name === r.ville);
// Forme localisée « in <city> » pour le H1 et le libellé du lien ville exacte.
const cityIntro = cityPage ? `in ${cityPage.name}` : `in ${r.ville}`;
const cityLink = cityPage
  ? { href: `/installation-solaire-${cityPage.slug}`, label: `Solar installation in ${cityPage.name}` }
  : cs.cityLink;
const segmentHref = r.segment === 'professionnel' ? '/professionnel' : '/résidentiel';
const segmentLabel = r.segment === 'professionnel' ? 'Business' : 'Residential';
const ogSlug = r.segment === 'professionnel' ? 'professionnel' : 'residentiel';

const hero = r.photos[0];
const rest = r.photos.slice(1);
const heroAlt = cs.alts[hero.name] ?? hero.alt;
const heroLargest = Math.max(...hero.widths);
const heroImg = new URL(`/photos/${hero.name}-${heroLargest}.webp`, Astro.site).href;

const equipment = [
  { label: 'Panels', value: r.panneaux },
  { label: 'Inverter', value: r.onduleur },
  { label: 'Storage', value: r.batterie },
].filter((e) => e.value);

const title = cs.title;
const description = cs.description;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Solar installation${r.kwc ? ` ${r.kwc}` : ''} ${cityIntro} — ref. ${r.ref}`,
  description: cs.resume,
  image: heroImg,
  about: { '@type': 'Thing', name: 'Photovoltaic solar installation' },
  author: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};

// W309 — before/during/after diptych: photos with a `phase` defined
const phasedPhotos = r.photos.filter((p) => p.phase);
const phaseLabels: Record<string, string> = {
  before: 'Before',
  during: 'During',
  after: 'After',
};
const hasDiptych = phasedPhotos.length >= 2;

// W309 — lightbox: all gallery photos (rest), index from 0
const galleryPhotos = rest;
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import '../../../styles/realisations-hover-zoom.css';
const t = {
  ref: 'Ref.',
  h1Kwc: `of solar installation ${cityIntro}`,
  h1NoKwc: `Solar installation ${cityIntro}`,
  resume: cs.resume,
  power: 'Installed power',
  productionEstimated: 'Estimated production — measured yield of our projects',
  productionMeasured: 'Measured production — real-time production monitoring',
  panels: 'Panels fitted',
  storyKicker: 'The project, told',
  whyPre: 'Why ',
  whyPost: ', on this roof',
  whatShows: 'What this project shows',
  videoKicker: 'The project on film',
  videoTitle: 'Watch the project on video',
  videoPlay: 'Play the project video',
  phasesKicker: 'The project in phases',
  phasesTitle: 'Before · During · After',
  enlarge: 'Enlarge:',
  equipmentKicker: 'The equipment fitted',
  equipmentTitle: 'What is really on the roof',
  brands: 'Tier-1 brands sourced through official distributors in Morocco — local warranties activatable.',
  allEquipment: 'See all the equipment',
  galleryKicker: 'From the file',
  galleryTitle: 'The project, as it is',
  referKicker: 'Word of mouth matters',
  referTitle: 'Know someone with a similar profile? Refer Taqinor',
  referCta: 'Discover the referral programme',
  segment: `${segmentLabel} solar`,
  latest: 'Our latest projects',
  monitoring: "This project's production monitoring",
  ctaTitle: `An assessment like the one in ${r.ville}, for your roof.`,
};

const bodyProps = { r, cs, L, rtl: false, fr: false, t, altOf: (p: { name: string; alt: string }) => cs.alts[p.name] ?? p.alt, breadcrumbItems: [{ label: 'Home', href: L('/') }, { label: 'Projects', href: L('/realisations') }, { label: r.kwc ? `${r.ville} · ${r.kwc}` : r.ville }], cityLink, segmentHref, phasedPhotos, phaseLabels, hasDiptych, galleryPhotos, equipment, heroAlt };
---

<Layout title={title} description={description} ogSlug={ogSlug}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <RealisationSlugBody {...bodyProps} />

  <PhotoLightbox locale="en" trigger="[data-lightbox-trigger-slug]" />
</Layout>
