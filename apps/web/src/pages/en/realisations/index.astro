---
/**
 * EN — Projects hub (W67). Faithful English translation of the FR
 * `realisations/index.astro`. Indexed gallery of the real installations, each
 * card linked to its case study. Numeric data from `realisations.ts`
 * (untouched); translated card summaries + alts come from `caseStudyBySlug`.
 * Internal links via localizeNavHref. FR untouched.
 *
 * W308 — ported the lightbox (W178) + hover-zoom (W179) + case-study nudge
 * (W204) that the FR index already has. W289 — SEO-framed intro + ItemList
 * schema for the measured/visitable pillar, ported from FR.
 */
import Layout from '../../../layouts/Layout.astro';
import V2Enhance from '../../../components/V2Enhance.astro';
import Article33Ribbon from '../../../components/Article33Ribbon.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Picture from '../../../components/Picture.astro';
import PhotoCaption from '../../../components/PhotoCaption.astro';
import VideoChantier from '../../../components/VideoChantier.astro';
import CtaBand from '../../../components/CtaBand.astro';
import StickyCta from '../../../components/StickyCta.astro';
import CertLogoRow from '../../../components/CertLogoRow.astro';
import BrandStrip from '../../../components/BrandStrip.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { REALISATIONS, standardCaption } from '../../../lib/realisations';
import { caseStudyBySlug } from '../../../lib/caseStudies';
import { getLocaleFromPath } from '../../../i18n/utils';
import { localizeNavHref } from '../../../i18n/pages';
import { NAP } from '../../../lib/nap';

const locale = getLocaleFromPath(Astro.url.pathname);
const L = (href: string) => localizeNavHref(href, locale);

// WC5 (2026-07-05) — the aggregate "kWc installed" figure (sum across all
// installations) is removed site-wide; only per-installation power remains.
// WN2 (2026-07-05) — a city count (~3) rendered as a monumental figure reads
// as a small, underwhelming number; a qualitative list of real city names
// (derived from REALISATIONS) carries the same information without a badge.
const villesUniques = [...new Set(REALISATIONS.map((r) => r.ville))];

// alt localisé (repli FR si absent dans la map de l'étude).
const altOf = (r: typeof REALISATIONS[number]) => caseStudyBySlug(r.slug, locale).alts[r.photos[0].name] ?? r.photos[0].alt;

// W289 — ItemList schema, same shape as FR, English name/description.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Taqinor solar installations — viewable, tracked production',
  description:
    'Solar installations actually fitted by Taqinor, viewable on request, with real-time production monitoring.',
  itemListElement: REALISATIONS.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(L(`/realisations/${r.slug}`), Astro.site).href,
    name: `Solar installation${r.kwc ? ` ${r.kwc}` : ''} in ${r.ville} — ref. ${r.ref}`,
  })),
  provider: { '@type': 'LocalBusiness', name: NAP.name, url: NAP.url },
};
import RealisationsIndexSection9BE4 from '../../../components/blocs/RealisationsIndexSection9BE4.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import '../../../styles/realisations-hover-zoom.css';
---

<Layout
  title="Our solar projects in Morocco — tracked installations | Taqinor"
  description="The solar installations actually fitted by Taqinor: villas in Casablanca, El Jadida and Nouaceur, power, the equipment on the roof and real-time production monitoring. Detailed case studies."
  ogSlug="accueil"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'Home', href: L('/') }, { label: 'Projects' }]} />

    <section class="px-4 pb-12 pt-16 text-white sm:pt-20">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">Recent projects</p>
        <h1 class="display v2-page-title cine-in mt-5 max-w-3xl [animation-delay:120ms]">Our latest projects</h1>
        <p class="v2-lead cine-in mt-6 max-w-xl text-white/85 [animation-delay:240ms]">
          Real projects, viewable on request — Casablanca, El Jadida, Nouaceur. Each case study
          carries the installed power, the equipment and, when published, a production figure.
          Nothing added, nothing erased.
        </p>
        <dl class="cine-in mt-8 flex flex-wrap gap-x-10 gap-y-4 [animation-delay:360ms]">
          <div>
            <dt class="tech-label text-lune-faint">Cities</dt>
            <dd class="font-display text-2xl font-bold text-white">{villesUniques.join(' · ')}</dd>
          </div>
          <div>
            <dt class="tech-label text-lune-faint">Projects</dt>
            <dd class="font-display text-2xl font-bold text-white">viewable on request</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- W289 — indexable pillar: viewable installations, tracked production -->
    <section class="border-y border-white/10 px-4 py-14 sm:py-16">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass text-lune">What sets our projects apart</p>
        <h2 class="display v2-section-title mt-5 text-white">Viewable installations, tracked production</h2>
        <p class="v2-lead mt-5 text-lune-soft">
          Before a quote, a visit can be arranged: see a Taqinor installation running, ask an
          existing client questions, compare a roof to yours. For every project below, the
          installed power and the equipment fitted are published as they are.
        </p>
        <p class="mt-4 text-lune-soft">
          Every installation has real-time production monitoring, with client access — production
          reads there continuously, straight from the meter.
        </p>
      </div>
    </section>

    <!-- W308 : gallery with lightbox — data-lightbox-gallery marks the group -->
    <section class="px-4 pb-24 sm:pb-32">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3" data-stagger data-lightbox-gallery>
        {REALISATIONS.map((r, i) => (
          <div class="v2-rise relative" style={`--v2-i:${i}`}>
            <button
              type="button"
              class="photo-card-btn cine-card group relative block w-full overflow-hidden text-left"
              data-lightbox-trigger
              data-lightbox-src={`/photos/${r.photos[0].name}-${Math.max(...r.photos[0].widths)}.webp`}
              data-lightbox-alt={altOf(r)}
              data-lightbox-label={[r.ville, r.kwc, r.date].filter(Boolean).join(' · ')}
              aria-label={`Enlarge photo: ${altOf(r)}`}
            >
              <Picture
                name={r.photos[0].name}
                alt={altOf(r)}
                widths={r.photos[0].widths}
                ratio={3 / 2}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                style={(r.photos[0] as any).objectPosition ? `object-position:${(r.photos[0] as any).objectPosition}` : undefined}
                class="photo-card-img aspect-[3/2] w-full object-cover"
              />
              <PhotoCaption
                caption={standardCaption(r, 'en')}
                detail={r.panneaux}
              />
            </button>
            <a
              href={L(`/realisations/${r.slug}`)}
              class="group mt-2 inline-flex items-center gap-1 border-b-2 border-azur-200/60 pb-0.5 text-sm font-bold text-white transition-colors hover:text-azur-200"
            >
              See the case study <span class="motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- W281 — real on-site film, below the dedicated proof hub's gallery -->
    <VideoChantier />

    {/* W280 — CertLogoRow + BrandStrip: standards already published elsewhere
        + tier-1 brands, no-op-safe (no fabricated logo/figure). */}
    <RealisationsIndexSection9BE4 />

    {/* WB17 (2026-07-04) — contextual links into the two ongoing measured-proof
        pages, weakly discoverable (absent from header/footer). */}
    <section class="section-tight px-4">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass text-lune">To go further</p>
        <RelatedLinks links={[
          { href: L('/production-mesuree'), label: 'Our tracked production, ongoing' },
          { href: L('/impact-taqinor'), label: 'Taqinor Impact (kWc, kWh, CO2 avoided)' },
        ]} />
      </div>
    </section>

    <CtaBand title="The next case study could be your roof." href={L('/devis/mon-toit')} />

    <StickyCta />
  </div>

  <PhotoLightbox locale="en" trigger="[data-lightbox-trigger]" />
</Layout>
