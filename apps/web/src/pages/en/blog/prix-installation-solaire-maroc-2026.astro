import Layout from '../../../layouts/Layout.astro';
import { pageLocale, articleMeta } from '../../../lib/pageCtx';
import V2Enhance from '../../../components/V2Enhance.astro';
import Article33Ribbon from '../../../components/Article33Ribbon.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaBand from '../../../components/CtaBand.astro';
import StickyCta from '../../../components/StickyCta.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { NAP } from '../../../lib/nap';
import { localizeNavHref } from '../../../i18n/pages';
import { PHRASE_TVA } from '../../../lib/prixConstants';
import '../../../styles/prose.css';

const { locale, L } = pageLocale(Astro.url.pathname);

const pubDate = new Date('2026-06-21');
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const bodyText = `
What makes up the price in 2026: panels, inverter, labour and accessories, paperwork, VAT line by line on the quote. Payback depends on consumption and ONEE bracket.
`;
const { readingMinutes, url, schemaImageUrl } = articleMeta(bodyText, Astro.url.pathname, Astro.site, '/og/accueil.png');
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: 'Solar prices in Morocco in 2026: what makes up the bill',
  description: "Panels, inverter, installation, paperwork and VAT: what makes up the price of a solar installation in 2026, and how to read a quote item by item.",
  image: schemaImageUrl,
  datePublished: pubDate.toISOString(),
  keywords: 'cost, price, installation, 2026',
  author: { '@type': 'Person', name: 'Reda Kasri' },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};


---

<Layout
  title="Solar prices in Morocco in 2026: what makes up the bill | Taqinor"
  description="Panels, inverter, installation, paperwork and VAT: what makes up the price of a solar installation in 2026, and how to read a quote item by item."
  ogSlug="accueil"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'Home', href: L('/') }, { label: 'Blog', href: L('/blog') }, { label: 'Solar prices in Morocco in 2026: what makes up the bill' }]} />

    <article class="mx-auto max-w-[68ch] px-4 pb-24 pt-12 sm:pb-28">
      <p class="tech-label v2-kicker rule-brass text-brass-300">
        Blog · {dateFmt.format(pubDate)} · by Reda Kasri
      </p>
      <h1 class="display v2-page-title mt-5 text-white">Solar prices in Morocco in 2026: what makes up the bill</h1>

      <p class="article-meta mt-3 flex items-center gap-2 text-xs text-lune-faint">
        {readingMinutes} min read
      </p>

      <p class="prose-lead mt-5">What makes up the bill in 2026 — equipment, installation, paperwork and VAT — and how to read a quote item by item.</p>

      <div class="prose mt-10">
        <p>
          "How much does it really cost?" is the first sentence of almost every one of my meetings.
          And the reason the figures you find online range from single to triple is easy to explain:
          the price of a panel sitting on a shelf has nothing to do with that of a turnkey
          installation, mounted on your roof and connected. This post details what makes up the bill
          — without copying any amount whose dated source I cannot show you.
        </p>
        <p class="text-xs text-lune-faint">
          <em>(What makes the price, the roof and the battery question are on our page <a href={L('/prix-panneaux-solaires-maroc')}>Solar panel
          prices in Morocco</a>.)</em>
        </p>

        <h2>What makes up the price: equipment and installation</h2>
        <h3>Photovoltaic panels</h3>
        <p>
          550–600 W modules represent the current standard — count on about 2 panels per kWc
          installed. On a quote, look for the brand, model and actual power of each panel, not just a
          total in kWc.
        </p>
        <h3>The inverter</h3>
        <p>
          Its price depends on the power, the type (grid-tied or hybrid, with a battery) and the brand.
          A serious quote names the exact model and its manufacturer warranty.
        </p>
        <h3>Labour and accessories</h3>
        <p>
          Mounting structure, DC/AC wiring, protection panel, administrative steps (Law 82-21
          declaration for low-voltage installations under 11 kW) — these items represent a significant
          share of the total turnkey cost, and they are what a "kit price" leaves out.
        </p>

        <h2>VAT</h2>
        <p>{PHRASE_TVA.en} If you're a business or investor, have your VAT situation checked by an accountant.</p>

        <h2>Return on investment</h2>
        <p>
          This calculation depends heavily on your actual consumption and your ONEE/régie tariff
          bracket. A household consuming more than 310 kWh/month (bracket at 1.381704 DH/kWh, or beyond
          510 kWh at 1.622856 DH/kWh) recovers its installation faster than a low consumer — solar is
          all the more profitable the higher your current bill is, and a battery lengthens the payback
          time. (Up-to-date tariff grid: see
          <a href={L('/blog/rentabilite-solaire-par-ville-maroc')}>our profitability-by-city
          article</a>.)
        </p>
        <p>
          For more on real savings by city, see our article
          <a href={L('/blog/rentabilite-solaire-par-ville-maroc')}>Solar profitability by city in Morocco</a>.
        </p>

        <p>

          The only figure that counts for your house comes from reading your bill and a visit.
          That's exactly what our diagnostic does, free of charge and with no obligation.
        </p>
      </div>

      <RelatedLinks
        links={[
          { href: L('/blog'), label: 'All the articles' },
          { href: L('/guides'), label: 'The evergreen guides' },
          { href: L('/prix-panneaux-solaires-maroc'), label: 'Solar panel prices in Morocco (evergreen)' },
        ]}
      />
    </article>

    <CtaBand title="Only your bill gives the exact number." href={L('/devis/mon-toit')} />

    <StickyCta />
  </div>
</Layout>
