---
/**
 * EN — Contact (W67). Faithful English translation of /contact ; FR untouched.
 *
 * W249 — /contact becomes the "talk to a human" page: the DiagnosticForm
 * (which duplicated the /devis/mon-toit and homepage capture) is removed from
 * here. DiagnosticForm.astro + /api/simulate stay intact in the codebase as
 * the documented fallback (mounted elsewhere) — this page already held, below
 * the form, only human doors (WhatsApp, phone, NAP, SAV); it becomes the pure
 * version of that, plus an explicit phone callback request.
 */
import ContactCarteWa from '../../components/blocs/ContactCarteWa.astro';
import ContactEntete from '../../components/blocs/ContactEntete.astro';
import Layout from '../../layouts/Layout.astro';
import { NAP } from '../../lib/nap';
import { useTranslations } from '../../i18n/utils';
import { contactWhatsappLinks } from '../../lib/contactWhatsapp';
import ContactP1D0F from '../../components/blocs/ContactP1D0F.astro';
import RappelForm from '../../components/RappelForm.astro';

const t = useTranslations('en');
const { waGeneral, waRegul, waRappel, waVisite, waSav } = contactWhatsappLinks('en');
---

<Layout
  title="Contact — talk to a human | Taqinor"
  description="Direct WhatsApp, phone callback, full contact details: talk to Taqinor's technical team about your solar project. WhatsApp reply within 1 h, 7 days a week."
  ogSlug="contact"
>
  <div class="v2">
    <ContactEntete>
        <h1 class="display v2-page-title cine-in mt-5 max-w-2xl [animation-delay:120ms]">Talk to a human</h1>
        <p class="v2-lead cine-in mt-5 max-w-xl text-white/85 [animation-delay:240ms]">
          No form here: write to us directly on WhatsApp, call, or ask for a callback.
          For your free study, the assessment takes 60 seconds.
        </p>
        {/* W280 — StarRating: real Google rating only, no-op-safe (renders
            nothing until the founder supplies a real rating). */}
    </ContactEntete>

    <!-- W249 — "talk to a human" page: the WhatsApp/phone shortcuts and the NAP card -->
    <section class="bg-blanc-azur px-4 py-16 text-encre">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          <ContactCarteWa href={waGeneral}>
            <p class="tech-label text-azur-600">New project</p>
            <p class="mt-2 font-display font-bold">WhatsApp — new installation</p>
            <p class="mt-1 text-sm text-encre-soft">Study and quote for a new project</p>
          </ContactCarteWa>
          {/* W249 — phone callback: a human door for visitors who'd rather
              talk than type (pre-filled, never a blank to edit). */}
          <a href="#rappel-form" data-rappel-open rel="noopener"
            class="v2-rise group border border-azur-900/15 bg-blanc p-6 text-center transition-all hover:-translate-y-0.5 hover:border-azur-600 hover:shadow-[0_14px_40px_-16px_rgb(15_28_84/0.4)]" style="--v2-i:1">
            <p class="tech-label text-azur-600">By phone</p>
            <p class="mt-2 font-display font-bold">Request a callback</p>
            <p class="mt-1 text-sm text-encre-soft">Leave your number — we call you</p>
          </a>
          <a href={waRegul} rel="noopener"
            class="v2-rise group border border-azur-900/15 bg-blanc p-6 text-center transition-all hover:-translate-y-0.5 hover:border-azur-600 hover:shadow-[0_14px_40px_-16px_rgb(15_28_84/0.4)]" style="--v2-i:2">
            <p class="tech-label text-azur-600">Article 33</p>
            <p class="mt-2 font-display font-bold">WhatsApp — regularization</p>
            <p class="mt-1 text-sm text-encre-soft">Existing installation to bring into compliance</p>
          </a>
          {/* W285 — "Visit a project" becomes an action: same invitation as
              pourquoi-taqinor.astro, as a direct WhatsApp shortcut. */}
          <a href={waVisite} rel="noopener"
            class="v2-rise group border border-azur-900/15 bg-blanc p-6 text-center transition-all hover:-translate-y-0.5 hover:border-azur-600 hover:shadow-[0_14px_40px_-16px_rgb(15_28_84/0.4)]" style="--v2-i:3">
            <p class="tech-label text-azur-600">See before you sign</p>
            <p class="mt-2 font-display font-bold">WhatsApp — visit a project</p>
            <p class="mt-1 text-sm text-encre-soft">I'd like to visit a real installation</p>
          </a>
        </div>

        <RappelForm locale="en" waRappel={waRappel} />

        <div class="v2-rise mt-8 border border-azur-900/15 bg-blanc-azur p-7 text-center text-sm">
          <p class="font-display text-lg font-bold">{NAP.name}</p>
          <ContactP1D0F />
          <p class="mt-3 text-encre-soft">
            Service area: Casablanca–Rabat axis, and {NAP.serviceArea.slice(2, -1).join(', ')} on request.
          </p>
          <p class="mt-1 text-xs text-encre-faint">On-site visits only — no public reception at an office.</p>
        </div>
      </div>
    </section>

    <!-- W339 — "Already a customer?" SAV/urgent door, visually and
         functionally separate from the quote block above. Pre-filled
         WhatsApp flags a fault report, routed to the SAV team — never the
         commercial lead webhook. -->
    <section id="deja-client" class="border-t border-azur-900/10 bg-blanc px-4 py-16 text-encre">
      <div class="mx-auto max-w-2xl">
        <div class="v2-rise border-2 border-azur-600/40 bg-blanc-azur p-7 text-center sm:p-9">
          <p class="tech-label text-azur-600">Already a customer?</p>
          <h2 class="display mt-2 text-2xl font-bold sm:text-3xl">A problem with your installation?</h2>
          <p class="mt-3 text-sm leading-relaxed text-encre-soft">
            What should you do if your inverter shows an error? Photograph the screen and message
            us on WhatsApp — the fastest way to reach the SAV (after-sales) team, who handle your
            report separately from a new quote request.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a
              href={waSav}
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-brass-400 px-6 py-3 text-sm font-bold text-azur-950 transition-colors hover:bg-brass-300"
            >
              WhatsApp — report a fault (SAV)
            </a>
            <a
              href={`tel:${NAP.phone}`}
              dir="ltr"
              class="inline-flex items-center gap-2 border border-azur-900/25 px-6 py-3 text-sm font-semibold text-encre transition-colors hover:border-azur-600"
            >
              {NAP.phoneDisplayIntl}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
