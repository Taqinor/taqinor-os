   * page's body was missing the whole L-WEBT block and `appareilId` without
   * anything ever signalling it.
   *
   * We read EVERYTHING, unconditionally. The gates (box ticked, unit chosen,
   * active profile) live in the registry: a value read here is not a value
   * emitted. The registry decides, once, for all three pages.
   */
  function lireEtatTunnel(): EtatTunnel {
    return {
      ...etatVide(),
      // QJW21 — THE « ONE FIELD ↔ ONE ID » READS COME FROM THE SHARED READER.
      // This list lived identically in ALL THREE pages: three copies, hence
      // three chances to forget one — exactly how the L-WEBT block and
      // `appareilId` stayed missing from the EN and AR pages without a single
      // red test. `lireChampsDomTunnel` reads THIS page's DOM; the parity guard
      // runs it against EACH locale's DOM and compares the emitted bodies
      // (tests/tunnelParite.test.ts).
      //
      // Everything is read UNCONDITIONALLY. The gates (checked box, chosen
      // unit, active profile) live in the registry: a value read is not a value
      // emitted. The registry decides once, for all three pages.
      ...lireChampsDomTunnel(document),

      // ——— THIS PAGE'S INTERNAL STATE — none of it is read from an identified
      //     element: card groups, the map, session tokens, tracking, mode and
      //     active locale, and the C&I bill whose id DEPENDS on the active panel. ———
      adresseCarte: addressEl?.value ?? '',
      adresseSecours: fallbackAddrEl?.value ?? '',
      // WJ30 — the project type is forwarded to the webhook.
      mode: ctx.etat.mode,
      // WJ39 — this page has no FR/AR toggle (the /en/ URL already declares
      // the locale) and `langue_preferee` only accepts fr/ar (lib/lead.ts
      // LEAD_LANGS): the state carries '' and the registry OMITS the key —
      // never a fabricated locale.
      languePreferee: '',
      // WJ122 — C&I consumption comes from the ACTIVE panel (commercial:
      // mt-cc-bill). The engine's MAD/kWh tariff travels with the value:
      // without it, the registry refuses to convert a kWh entry rather than
      // invent an amount.
      factureProValeur: num(ctx.crochets.appeler('proBillId')),
      factureProUnite: ctx.crochets.appeler('proBillUnit'),
      tarifProMadKwh: ctx.etat.lastProTarifMadKwh,
      tension: ctx.etat.tension,
      activite: ctx.etat.activity,
      tensionTouchee: ctx.etat.tensionTouched,
      activiteTouchee: ctx.etat.activityTouched,
      categorieCommerciale: ctx.etat.commercialCategory,
      // WJ123 — INDUSTRIAL mode: shifts honestly cap self-consumption in
      // estimatePro.
      equipes: ctx.etat.equipes,
      typeSurface: ctx.etat.surfaceType,
      // QX — AGRICULTURAL sub-panel: the water source and its unit are card
      // groups, not identified fields.
      sourceEau: ctx.etat.waterSource,
      uniteEau: ctx.etat.waterUnit,
      regionAgricole: ctx.etat.regionAgricole,
      // W353 — technical visit slot preference (optional, STATIC).
      creneauVisitePartie: ctx.etat.visitWindowPart,
      creneauVisiteSemaine: ctx.etat.visitWindowWeek,
      // L-WEBT — the day occupancy is a CARD GROUP whose state the page holds;
      // the hidden `mt-occupation-jour` input only mirrors it.
      occupationJour: ctx.etat.occupationJour,
      // WJ52 — short reference for the post-submission artefact (echoed as-is,
      // never a server uniqueness key — see lib/lead.ts).
      clientRef: ctx.crochets.appeler('getOrCreateClientRef'),
      // DEDUPLICATION tokens (CRM + Meta CAPI): minted on first display, stable
      // for the whole entry session, so a resend (network failure, double-click,
      // back button then re-submit) carries the SAME pair.
      idempotencyKey: ctx.crochets.appeler('getOrCreateDedupTokens').idempotencyKey,
      eventId: ctx.crochets.appeler('getOrCreateDedupTokens').eventId,
      // LANE T-WEB — anonymous device fingerprint, additive and never blocking:
      // '' (storage unavailable) becomes an ABSENT key.
      appareilId: appareilId(),
      // QX — EXACTLY the figures shown in the estimate document (the CRM
      // advisor sees what the client saw — never more).
      estimationAffichee: ctx.etat.estimateShown,
      // WJ116 — fbclid/UTM (referrals included) resumed from sessionStorage.
      tracking: ctx.crochets.appeler('readTrackingParams'),
      // WJ4 — OPTIONAL pin and outline: we never BLOCK without them.
      repereToit: ctx.etat.capturePin,
      contourToit: ctx.etat.captureOutline,
      layoutToit: ctx.etat.captureLayout,
    };
  }

  /**
   * The lead body + the client-side errors. There is no `buildBody()` here any
   * more — no function, no wrapper: the page calls the shared module directly,
   * which applies the registry then lib/lead.ts's `validateLead`. Messages come
   * from the English table (`src/lib/tunnel/i18n.ts`); `enMsg` below still
   * translates whatever `validateLead` returns untranslated — the phone message
   * in particular, which is circumstantial and has no static equivalent.
   */
  function corpsDuLead(): { body: Record<string, unknown>; errors: Record<string, string> } {
    return construireCorps(lireEtatTunnel(), { messages: ERREURS.en });
  }
  ctx.crochets.installer('corpsDuLead', corpsDuLead);

  // WJ39 — the shared validateLead() (src/lib/lead.ts, out of this page's
  // file scope) returns French messages; translate the known set to English
  // so inline errors never show French on this route (see VALIDATION_ERROR_EN above).
  const enMsg = (msg: string | null | undefined): string | null =>
    msg == null ? null : (VALIDATION_ERROR_EN[msg] ?? msg);
  function showInlineErrors(errors: Record<string, string>) {
    setFieldError('mt-name', 'mt-name-err', enMsg(errors.fullName));
    setFieldError('mt-phone', 'mt-phone-err', enMsg(errors.phone));
    setFieldError('mt-city', 'mt-city-err', enMsg(errors.city));
    // `errors.roofType` no longer has a field to show on: "roof type" is
    // removed from the funnel (founder cut 18/08) and resolveRoofType
    // guarantees a valid value — the error can no longer occur from this page.
    // CIW404 — the range error goes on the VISIBLE field of the active profile (never on the residential <select> hidden in C&I).
    if (ctx.crochets.appeler('isProMode', ctx.etat.mode)) setFieldError(ctx.crochets.appeler('proBillId'), ctx.crochets.appeler('proBillErrId'), enMsg(errors.billRange));
    else setFieldError('mt-bill', 'mt-bill-err', enMsg(errors.billRange));
    const cErr = $('mt-consent-err');
    const consentMsg = enMsg(errors.consent);
    if (cErr) { cErr.textContent = consentMsg ?? ''; cErr.hidden = !consentMsg; }
  }
  ctx.crochets.installer('showInlineErrors', showInlineErrors);

  // ——— WJ3 : WhatsApp deeplink prefilled with the estimate ———
  function buildWaUrl(): string {
    const text = captureWhatsappText({
      fullName: val('mt-name'),
      city: (val('mt-city') || addressEl?.value || '').trim(),
      kwcLabel: ctx.etat.lastKwcLabel || undefined,
      savingsLabel: ctx.etat.lastSavingsLabel || undefined,
    });
    return whatsappLink(WHATSAPP_LEADS, text);
  }

  // ——— WREF2-L3 (founder GO 21/08/2026, option B): fetching the real "NOM-N"
  // server reference AFTER the fire-and-forget send ———
  // The success screen shows the PROVISIONAL code immediately (unchanged
  // behaviour, buildClientRef()/getOrCreateClientRef() above): sending the
  // lead never waits for the CRM webhook's response. This lookup polls the
  // same-origin proxy /api/lead-ref-lookup (key = the idempotencyKey already
  // sent in the body) a few times, spaced out; as soon as it answers, the
  // displayed code AND the WhatsApp prefill switch to the real reference.
  // Silent on failure in every case (backend unreachable, not yet assigned,
  // attempts exhausted): the provisional code stays displayed — an already
  // tolerated degradation, the record stays findable in the CRM via
  // `client_ref_provisoire`. Total budget < 10 s even if every attempt times
  // out (1+1.5 + 1.5+1.5 + 2+1.5 = 9 s worst case).
  const LEAD_REF_LOOKUP_WAITS_MS = [1000, 1500, 2000];
  const LEAD_REF_LOOKUP_TIMEOUT_MS = 1500;
  function pollServerClientRef(idempotencyKey: string) {
    if (!idempotencyKey) return;
    void (async () => {
      for (const waitMs of LEAD_REF_LOOKUP_WAITS_MS) {
        await new Promise((resolve) => setTimeout(resolve, waitMs));
        try {
          const res = await fetch(`/api/lead-ref-lookup?key=${encodeURIComponent(idempotencyKey)}`, {
            signal: AbortSignal.timeout(LEAD_REF_LOOKUP_TIMEOUT_MS),
          });
          const data = (await res.json().catch(() => null)) as { ok?: boolean; client_ref?: string } | null;
          if (data?.ok && data.client_ref) {
            ctx.etat.clientRef = data.client_ref; // getOrCreateClientRef() now returns the real reference.
            const refEl = $('mt-client-ref');
            if (refEl) refEl.textContent = ctx.etat.clientRef;
            const waLink = $('mt-success-wa') as HTMLAnchorElement | null;
            if (waLink) waLink.href = buildWaUrl();
            return;
          }
        } catch {
          // silent — retry; the last exhausted attempt simply leaves the
          // provisional code displayed (current behaviour).
        }
      }
    })();
  }

  // ——— CIW405 (D-CIQ-8) : étape « Affiner », FACULTATIVE, APRÈS la porte de contact ———
  // Réservée aux profils commercial / industriel. Le bouton est dans le bloc de
  // succès qualifié ; le clic appelle le proxy same-origin /api/lead-affiner
  // avec l'idempotencyKey DÉJÀ envoyée (jamais une seconde soumission), puis
  // ouvre /questionnaire/<jeton>. Échec ou 404 : le bouton se retire sans
  // message alarmant. Rien n'est demandé AVANT la porte de contact.
  // Logique partagée (fetch du proxy, ouverture du questionnaire, retrait sur échec) :
  // scripts/tunnel/affiner.ts. Ici, seul le garde de profil.
  function setupAffiner(idempotencyKey: string) {
    if (ctx.etat.mode !== 'commercial' && ctx.etat.mode !== 'industriel') return;
    brancherAffiner($('mt-affiner') as HTMLButtonElement | null, idempotencyKey);
  }

  // ——— submission -> /api/capture-lead (contract UNCHANGED) ———
  const form = $('mt-form') as HTMLFormElement | null;
  const errEl = $('mt-error');
  const okEl = $('mt-success');
  const belowEl = $('mt-belowthreshold');
  const submitBtn = $('mt-submit') as HTMLButtonElement | null;
  const submitLabelEl = $('mt-submit-label');
  const submitPendingEl = $('mt-submit-pending');

  // WJ60 — toggle the CTA to "Sending…" while the network request is pending
  // (never a mute button on slow 3G); restored at the end regardless of
  // outcome (except success, where the whole form disables right after).
  function setSubmitPending(pending: boolean) {
    if (submitBtn) submitBtn.disabled = pending;
    if (submitLabelEl) submitLabelEl.hidden = pending;
    if (submitPendingEl) submitPendingEl.hidden = !pending;
  }

  // WJ60 — HONEST message for a SERVER-SIDE failure (>=500, malformed JSON,
  // timeout, network cut): never blames the visitor's fields for a failure
  // that isn't theirs. WJ63 — the client ALWAYS prefers its own localised
  // copy over server-sent text (e.g. the rate-limit's 429 message, in
  // French on the API side): `data.errors` is only shown as-is for REAL
  // field errors (4xx validation), never for a generic server failure.
  const SERVER_ERROR_MSG = 'A technical problem on our side — please try again.';
  // WJ45 — DISTINCT message when the cut comes from the visitor's own
  // network (not our side): reassures that nothing is lost instead of the
  // generic "problem on our side" line.
  const OFFLINE_MSG = "No connection — your answers are kept, we'll retry as soon as the network is back.";
  // WJ60 — 15 s gives a slow connection time to respond, without leaving the
  // "Sending…" CTA hanging indefinitely (the failure, timeout included, falls
  // into the honest message above — never a silent block).
  const SUBMIT_TIMEOUT_MS = 15_000;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) errEl.hidden = true;
    const { body, errors } = ctx.crochets.appeler('corpsDuLead');
    if (Object.keys(errors).length > 0) {
      ctx.crochets.appeler('showInlineErrors', errors);
      if (errEl) {
        errEl.textContent = 'Please check the highlighted fields above.';
        errEl.hidden = false;
      }
      // brings the user to the first field in error. 'mt-roof' left this
      // list along with the question itself (founder cut 18/08): no more
      // hidden field to work around, everything left here is visible.
      const firstId = ['mt-name', 'mt-phone', 'mt-city', 'mt-bill']
        .find((id) => $(id)?.getAttribute('aria-invalid') === 'true');
      if (firstId) ($(firstId) as HTMLElement | null)?.focus();
      return;
    }
    ctx.crochets.appeler('showInlineErrors', {});

    setSubmitPending(true);
    try {
      const res = await fetch('/api/capture-lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(SUBMIT_TIMEOUT_MS),
      });
      // WJ60/WJ63 — a malformed JSON response (empty/unreadable body) is
      // treated as a server failure, never silently as "no error".
      let malformed = false;
      const data = (await res.json().catch(() => {
        malformed = true;
        return {};
      })) as { ok?: boolean; qualified?: boolean; errors?: Record<string, string> };
      if (res.ok && !malformed && data.ok) {
        ctx.etat.submitted = true;
        ctx.etat.hasEnteredData = false; // WJ61 — success: no longer need the beforeunload guard.
        ctx.crochets.appeler('clearWizardState'); // WJ61 — the request went through: the snapshot no longer applies.
        // WJ104 — "callback requested": a signal DISTINCT from a WhatsApp
        // opt-in, emitted ONLY when the chosen contact preference is "call
        // me" (mt-contact-phone), never for the default WhatsApp fallback.
        // Deduped like the other beacons on this page.
        if (($('mt-contact-phone') as HTMLInputElement | null)?.checked === true) {
          ctx.crochets.appeler('sendFunnelBeacon', 'contact', 'callback_requested');
        }
        const waUrl = buildWaUrl();
        // WJ5 — HONEST response per the qualifying threshold (`qualified` returned by the server).
        if (data.qualified) {
          // WB33 — browser "Lead" event with the SAME event_id (WJ92) as the
          // server CAPI relay: Meta deduplicates the two signals.
          (window as unknown as { tqPixelTrack?: (e: string, p?: object, id?: string) => void })
            .tqPixelTrack?.('Lead', {}, ctx.crochets.appeler('getOrCreateDedupTokens').eventId);
          // Google Ads / GA4 — même eventId (transaction_id) ; no-op sans
          // PUBLIC_GOOGLE_TAG_ID ou si refusé (tqGoogleTrack se gate seul).
          (window as unknown as { tqGoogleTrack?: (id?: string) => void })
            .tqGoogleTrack?.(ctx.crochets.appeler('getOrCreateDedupTokens').eventId);
          if (okEl) okEl.hidden = false;
          // WJ52 — display the reference generated when the state was read
          // (already included in the sent body — re-read here via
          // getOrCreateClientRef() to stay the SAME value, never regenerated).
          const refEl = $('mt-client-ref');
          if (refEl) refEl.textContent = ctx.crochets.appeler('getOrCreateClientRef');
          const waLink = $('mt-success-wa') as HTMLAnchorElement | null;
          if (waLink) waLink.href = waUrl;
          // WREF2-L3 — best-effort fetch of the real server reference (see
          // pollServerClientRef above): swaps the displayed code + WhatsApp
          // link the moment it arrives, silent otherwise.
          pollServerClientRef(ctx.crochets.appeler('getOrCreateDedupTokens').idempotencyKey);
          setupAffiner(ctx.crochets.appeler('getOrCreateDedupTokens').idempotencyKey); // CIW405
          // WJ3/WJ51 — on mobile, offer WhatsApp right away when the contact
          // preference is "WhatsApp only" (the option checked by default).
          const wantsWa = ($('mt-contact-phone') as HTMLInputElement | null)?.checked !== true;
          if (wantsWa && /Mobi|Android|iPhone/i.test(navigator.userAgent) && !reducedMotion) {
            setTimeout(() => { window.location.href = waUrl; }, 900);
          }
        } else {
          // below the threshold: NO fake "recorded" — an adapted message + WhatsApp.
          if (ctx.etat.mode === 'commercial' || ctx.etat.mode === 'industriel') {
            // CIW409 — jamais le texte « pas rentable à votre échelle » pour un pro :
            // message neutre (le seuil / `qualified` / l'étiquette restent inchangés).
            const neutreEl = $('mt-belowthreshold-pro');
            if (neutreEl) neutreEl.hidden = false;
            const neutreWa = $('mt-belowthreshold-pro-wa') as HTMLAnchorElement | null;
            if (neutreWa) neutreWa.href = waUrl;
          } else {
            if (belowEl) belowEl.hidden = false;
            const belowWa = $('mt-belowthreshold-wa') as HTMLAnchorElement | null;
            if (belowWa) belowWa.href = waUrl;
          }
        }
        // disable the fields after submission (except the WhatsApp links).
        Array.from(form.elements).forEach((el) => ((el as HTMLInputElement).disabled = true));
        return;
      }
      // WJ60/WJ63 — >=500 or malformed JSON: SERVER-SIDE failure, never a
      // message that blames the fields. Below 500 with usable field errors
      // (4xx validation, e.g. `errors.fullName`), we still show them inline
      // as before — but a server text that is NOT a known field error (e.g.
      // `errors.rate`, the rate-limit's 429, in French on the API side)
      // never overwrites our honest copy: only the `errors.rate` field falls
      // back to the same generic server message.
      const isServerError = malformed || res.status >= 500 || (!!data.errors && 'rate' in data.errors);
      if (!isServerError && data.errors) ctx.crochets.appeler('showInlineErrors', data.errors);
      const firstFieldErr = !isServerError && data.errors ? Object.values(data.errors)[0] : null;
      if (errEl) {
        errEl.textContent = isServerError
          ? SERVER_ERROR_MSG
          : ((firstFieldErr && (VALIDATION_ERROR_EN[firstFieldErr] ?? firstFieldErr)) || 'A field is missing or invalid. Please check your information.');
        errEl.hidden = false;
      }
      setSubmitPending(false);
    } catch {
      // WJ60 — covers the timeout (AbortSignal.timeout) and any network
      // outage. WJ45 — if the browser knows it's offline, say so explicitly
      // (banner + dedicated message) rather than the generic "problem on our
      // side" — which would wrongly blame our infrastructure. The form stays
      // filled and the WJ61 sessionStorage snapshot persists: nothing is
      // lost, just resend once the network is back.
      ctx.crochets.appeler('syncOfflineBanner');
      if (errEl) {
        errEl.textContent = navigator.onLine ? SERVER_ERROR_MSG : OFFLINE_MSG;
        errEl.hidden = false;
      }
      setSubmitPending(false);
    }
  });

  // ——— WJ7/WJ33/WJ46 : WhatsApp offer — exit-intent (desktop + hidden
  // mobile tab) AND peak interest (instant estimate shown). Same modal, same
  // `exitShown` guard (only shows ONCE, whatever the trigger): exit-intent
  // stays a SAFETY NET for whoever didn't see the offer at peak interest
  // (e.g. closes the tab before the revelation), never a duplicate. ———
  const exitModal = $('mt-exit') as HTMLElement | null;
  const exitPhoneInput = $('mt-exit-phone') as HTMLInputElement | null;
  const exitWaLink = $('mt-exit-wa') as HTMLAnchorElement | null;
   // WJ33 — to restore focus on close

  /** WJ33 — builds (or rebuilds) the abandonment WhatsApp link from the current state. */
  function buildExitWaHref(): string {
    const phone = exitPhoneInput?.value.trim() || '';
    // WJ39 — the phone-number sentence stays French by design (frontmatter
    // note): the WhatsApp deep-link text reaches the French-speaking sales team.
    const text = captureWhatsappText({
      fullName: '',
      city: (val('mt-city') || addressEl?.value || '').trim(),
      kwcLabel: ctx.etat.lastKwcLabel || undefined,
      savingsLabel: ctx.etat.lastSavingsLabel || undefined,
    }) + (phone.length >= 6 ? ` Mon numéro : ${phone}.` : '');
    return whatsappLink(WHATSAPP_LEADS, text);
  }

  // WJ102 — while the abandonment modal is open, the REST of the document
  // (header, footer, the wizard itself behind the overlay) must become truly
  // unreachable — not just visually hidden. Otherwise a keyboard/screen-
  // reader user could Tab-cycle to header/footer links BEHIND the
  // semi-transparent overlay, since the focus trap (Tab/Shift+Tab below)
  // only covers the LAST Tab before looping — not links reachable by a
  // direct click/VoiceOver rotor. Same idiom as Header.astro (mobile menu):
  // `inert` set on every DIRECT child of <body> that does NOT contain the
  // modal itself.
  const inertedSiblings: HTMLElement[] = [];
  function setBackgroundInert(on: boolean): void {
    if (on) {
      inertedSiblings.length = 0;
      for (const child of Array.from(document.body.children)) {
        if (!(child instanceof HTMLElement)) continue;
        if (child.contains(exitModal)) continue; // never make the modal itself inert
        if (child.hasAttribute('inert')) continue; // already inert for another reason: leave it alone on close
        child.setAttribute('inert', '');
        inertedSiblings.push(child);
      }
    } else {
      for (const el of inertedSiblings) el.removeAttribute('inert');
      inertedSiblings.length = 0;
    }
  }

  /** WJ46 — shows the WhatsApp offer (exit-intent OR peak interest). Only
   *  shows once per visit (`exitShown`), never after submission. */
  function showWhatsappOffer(triggerEl: HTMLElement | null = null) {
    if (ctx.etat.exitShown || ctx.etat.submitted) return;
    ctx.etat.exitShown = true;
    ctx.etat.exitTriggerEl = triggerEl ?? (document.activeElement as HTMLElement | null);
    if (exitWaLink) exitWaLink.href = buildExitWaHref();
    if (exitModal) {
      exitModal.hidden = false;
      // WJ102 — the rest of the document becomes inert while the modal is open.
      setBackgroundInert(true);
      // WJ33 — initial focus INSIDE the modal (first interactive field).
      exitPhoneInput?.focus();
    }
  }
  ctx.crochets.installer('showWhatsappOffer', showWhatsappOffer);
  // WJ59 — "step abandoned": deduped separately from the WhatsApp offer
  // (which only shows once per visit via `exitShown`), since the
  // measurement signal stays useful even if the offer already showed once.
  function maybeShowExit(triggerEl: HTMLElement | null = null) {
    // WJ46 — the "photo picker open" grace window is gone along with the
    // "Photo of your meter or bill" question (founder cut 18/08): this page
    // no longer opens any file picker, so there is no background transition
    // left to mistake for an abandonment.
    // only interrupt if the visitor has at least started (mode/bill or step > 0)
    const started2 = ctx.etat.step > 0 || ctx.crochets.appeler('resolveMonthlyBill') != null || (ctx.etat.capturePin != null);
    if (!started2) return;
    // WB30 — no "abandoned" beacon before the consent step (the revelation).
    if (!ctx.etat.submitted && !ctx.etat.funnelAbandonSent && ctx.crochets.appeler('hasReachedConsentStep')) {
      ctx.etat.funnelAbandonSent = true;
      // COUPE FONDATEUR 21/08 — même projection que renderStep() : 'toit' =
      // écran 0, 'facture' = écran 1 avant révélation, puis 'contact' si les
      // chiffres sont réellement sortis, sinon 'estimation'. Vocabulaire figé.
      const currentStep = ctx.etat.step === 0
        ? 'toit'
        : !ctx.etat.revealed
          ? 'facture'
          : (ctx.etat.lastKwc != null ? 'contact' : 'estimation');
      ctx.crochets.appeler('sendFunnelBeacon', currentStep, 'abandoned');
    }
    ctx.crochets.appeler('showWhatsappOffer', triggerEl);
  }
  function closeExit() {
    if (!exitModal || exitModal.hidden) return;
    exitModal.hidden = true;
    // WJ102 — restores the rest of the document's accessibility BEFORE
    // returning focus (otherwise the focus target below could still be inert).
    setBackgroundInert(false);
    // WJ33 — restores focus to the element that triggered the opening (or,
    // failing that, a stable anchor point — no language toggle on this EN
    // route, see WJ39).
    (ctx.etat.exitTriggerEl && document.contains(ctx.etat.exitTriggerEl) ? ctx.etat.exitTriggerEl : $('mt-next-0'))?.focus();
    ctx.etat.exitTriggerEl = null;
  }
  // desktop: the mouse leaves from the top
  document.addEventListener('mouseout', (e) => {
    if (!e.relatedTarget && (e as MouseEvent).clientY <= 0) maybeShowExit();
  });
  // mobile: the tab goes to the background
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') maybeShowExit();
  });
  $('mt-exit-close')?.addEventListener('click', () => closeExit());
  exitModal?.addEventListener('click', (e) => { if (e.target === exitModal) closeExit(); });

  // WJ33 — keyboard: Esc closes + focus trap (Tab/Shift+Tab stay INSIDE the modal).
  exitModal?.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Escape') { closeExit(); return; }
    if (ke.key !== 'Tab' || !exitModal) return;
    const focusable = Array.from(
      exitModal.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
    ).filter((el) => el.offsetParent !== null || el === document.activeElement);
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (ke.shiftKey && active === first) {
      ke.preventDefault();
      last.focus();
    } else if (!ke.shiftKey && active === last) {
      ke.preventDefault();
      first.focus();
    }
  });

  // WJ33 — the abandonment WhatsApp CTA: the `href` is rebuilt on EVERY
  // keystroke (not just on click), to stay correct if the user opens
  // WhatsApp via a right-click / "copy link" before finishing typing.
  exitPhoneInput?.addEventListener('input', () => {
    const err = $('mt-exit-err');
    if (err) err.hidden = true;
    if (exitWaLink) exitWaLink.href = buildExitWaHref();
  });
  exitWaLink?.addEventListener('click', (e) => {
    const phone = exitPhoneInput?.value.trim() || '';
    const err = $('mt-exit-err');
    if (phone.length < 6) {
      e.preventDefault();
      if (err) { err.textContent = 'Please enter a number so we can reply to you.'; err.hidden = false; }
      return;
    }
    if (err) err.hidden = true;
  });

  // ——— QX : initial state after full rehydration (everything defined here) ———
  // Range derived from a restored exact amount (fix "redundant range").
  ctx.crochets.appeler('syncBillRangeFromExact');
  // Parcours restauré avec l'estimation DÉJÀ révélée (WJ61 — y compris migré
  // depuis un ancien `step === 2`) : recalcule le document immédiatement —
  // sinon des tirets jusqu'à la première interaction.
  if (ctx.etat.step === 1 && ctx.etat.revealed) ctx.crochets.appeler('computeEstimate');

</script>
