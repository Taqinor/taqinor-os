---
/**
 * EN — « Mon toit » CAPTURE CLIENT (WJ38). Faithful English port of the
 * rebuilt FR quote journey (src/pages/devis/mon-toit.astro): profile-specific
 * step 2 (three sub-panels — residential/professional/agricultural), per-mode
 * stepper labels, an explicit profile requirement at step 0 (#mt-mode-err),
 * bill-to-range auto-detection, live per-field blur validation + per-step
 * gating, the A4 PDF-look estimate document (navy/gold, DM fonts from
 * /fonts/), satellite roof snapshot + 3D drape, a daylight 3D stage, and the
 * payload fields (tensionRaccordement, activityProfile, surfaceType,
 * surfaceM2, proMonthlyKwh/Mad, waterSource, profondeurM, hmtM, debitM3h,
 * besoinM3j, heuresPompage, culture, surfaceHa, fuelSpendMad, estimateShown).
 * Founder cut (18/08): only questions that FEED the estimate stay in the
 * funnel — roof type, connection type, distributor, meter photo, future
 * loads, battery interest, per-category commercial questions, generator,
 * irrigation and current-pump fields are removed; the sales rep fills them
 * in the ERP. SAME /api/capture-lead submission contract (validateLead, per-mode MAD
 * threshold, roofPoint/roofOutline/energy profile optional), SAME client
 * logic. No in-page language toggle here (the /en/ URL already declares the
 * locale, consistent with every other /en/* page on this site) — the
 * WhatsApp deep-link text stays French by design (same convention as
 * en/contact.astro: it reaches the French-speaking sales team).
 *
 * W245 — noindex removed (this is the site's primary conversion CTA, not a
 * private tunnel); real landing-page SEO (meta description, OG, hreflang).
 */
import Layout from '../../../layouts/Layout.astro';
import { BILL_RANGES } from '../../../lib/billRange';
// RWEB17-M13 — table anglaise des tranches, UNE source pour le serveur et le script.
import { BILL_RANGE_LABEL_EN } from '../../../lib/tunnel/selections';
// "Roof type" (ROOF_TYPES) removed from the funnel (founder cut 18/08) — the
// sales rep fills it in the ERP. `roofType` stays REQUIRED by validateLead:
// it is now DERIVED (resolveRoofType -> 'autre'), never asked again.
// WJ122 — category cards rendered at build from the single source ported
// from solar.js (QX44). The per-category questions (COMMERCIAL_CATEGORY_QUESTIONS)
// are removed from the funnel (founder cut 18/08): none of them fed the
// estimate — the sales rep fills them in the ERP.
import { COMMERCIAL_CATEGORIES } from '../../../lib/commercialCategories';
const CC_CAT_LABEL: Record<string, string> = {
  hotel: 'Hotel / Riad', restaurant: 'Restaurant / Café', commerce: 'Shop / Supermarket',
  bureau: 'Office / HQ', sante: 'Healthcare (clinic)', ecole: 'Private school',
  hammam: 'Hammam / Spa / Gym', boulangerie: 'Bakery', froid: 'Cold storage', autre: 'Other business',
};
// WJ124 — crop + region cards rendered at build from the QX48 agronomy engine
// (single source). VALUES = CROP_STAGES / ET0_MONTHLY keys (drive the water
// engine); labels/icons below are localised for this /en/ page.
import { CROP_KEYS, REGION_KEYS } from '../../../lib/agronomy';
const CROP_META: Record<string, { label: string; icon: string }> = {
  agrumes: { label: 'Citrus', icon: '🍊' }, olivier: { label: 'Olive', icon: '🫒' },
  dattier: { label: 'Date palm', icon: '🌴' }, avocatier: { label: 'Avocado', icon: '🥑' },
  arganier: { label: 'Argan', icon: '🌳' }, 'banane-serre': { label: 'Banana (greenhouse)', icon: '🍌' },
  luzerne: { label: 'Alfalfa', icon: '🌿' }, myrtille: { label: 'Blueberry', icon: '🫐' },
  amandier: { label: 'Almond', icon: '🌰' }, vigne: { label: 'Grapevine', icon: '🍇' },
  grenadier: { label: 'Pomegranate', icon: '🔴' }, figuier: { label: 'Fig', icon: '🌳' },
  'tomate-serre': { label: 'Tomato (greenhouse)', icon: '🍅' }, 'poivron-serre': { label: 'Pepper (greenhouse)', icon: '🫑' },
  'pomme-de-terre': { label: 'Potato', icon: '🥔' }, oignon: { label: 'Onion', icon: '🧅' },
  'melon-pasteque': { label: 'Melon / Watermelon', icon: '🍉' }, cereales: { label: 'Cereals', icon: '🌾' },
  fraise: { label: 'Strawberry', icon: '🍓' }, cannabis: { label: 'Cannabis (licensed)', icon: '🌿' },
};
const REGION_LABEL: Record<string, string> = {
  'souss-massa': 'Souss-Massa', doukkala: 'Doukkala', tadla: 'Tadla', saiss: 'Saïss',
  oriental: 'Oriental', 'draa-tafilalet': 'Drâa-Tafilalet', 'gharb-loukkos': 'Gharb-Loukkos', haouz: 'Haouz',
};
import { NAP, WHATSAPP_LEADS } from '../../../lib/nap';
import { whatsappLink } from '../../../lib/whatsapp';
import Logo from '../../../components/Logo.astro';
import StarRating from '../../../components/StarRating.astro';
import CertLogoRow from '../../../components/CertLogoRow.astro';
import InstallCounter from '../../../components/InstallCounter.astro';
import ZelligeSignature from '../../../components/ZelligeSignature.astro';

const inputClass =
  'w-full border border-white/15 bg-white/5 px-3 py-3 text-base text-white placeholder:text-lune-faint outline-none transition-colors focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 aria-[invalid=true]:border-alert-300 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-alert-300/30';
// BILL_RANGES is shared (lead.ts/billRange.ts contract UNCHANGED): the `id`
// values stay identical across locales, only the displayed label is
// translated here (that lib is out of scope).
const billRanges = BILL_RANGES.map((b) => ({ ...b, label: BILL_RANGE_LABEL_EN[b.id] ?? b.label }));

// WJ6 — assistant steps (English labels; residential defaults, overridden
// per-mode client-side by syncStepLabels()).
// COUPE FONDATEUR 21/08 — le tunnel passe de TROIS écrans à DEUX : les questions
// de profil (ex-écran « Votre facture ») et l'estimation + le formulaire de
// contact vivent désormais sur le MÊME écran, la révélation se faisant sur place
// au clic de « Voir mon estimation » (aucune navigation d'étape supplémentaire).
const STEPS = ['Your roof', 'Your estimate'];

// WJ6/QX — project-type selector. No mode is preselected: the profile drives
// an entirely different step-2 questionnaire (bill / pro energy / pumping),
// so "Continue" requires an explicit choice (nudge on #mt-mode-err, never an alert).
// WJ121 — 4 real modes: the "Professional" card is split into 🏭 Industrial
// (factory, production) and 🏪 Commercial (hotel, retail, services); the site
// never emits 'professionnel' anymore (server alias kept in lib/lead.ts + backend).
const MODES = [
  { id: 'residentiel', label: 'Residential', desc: 'Villa, apartment' },
  { id: 'industriel', label: '🏭 Industrial', desc: 'Factory, production' },
  { id: 'commercial', label: '🏪 Commercial', desc: 'Hotel, retail, services' },
  { id: 'agricole', label: 'Agricultural', desc: 'Pumping, farm' },
];

// WJ8 — real service towns (NAP) for proximity proof.
const TOWNS = ['Casablanca', 'Rabat', 'Marrakech', 'Tangier', 'Agadir', 'Kénitra', 'Fès', 'Settat'];

// WJ65 — honest no-JavaScript exit: this form is entirely script-driven
// (estimate calculation, fetch submission) — without JS, nothing works.
// Instead of a mute page, a static wa.me + tel: link (no JS required).
const noscriptWaHref = whatsappLink(
  WHATSAPP_LEADS,
  "Hello, I would like to receive my solar estimate from taqinor.ma (my browser has JavaScript disabled).",
);
const noscriptTelHref = `tel:${NAP.phone}`;
import DevisMonToitDiv3598 from '../../../components/blocs/DevisMonToitDiv3598.astro';
import DevisMonToitDiv6C75 from '../../../components/blocs/DevisMonToitDiv6C75.astro';
import DevisMonToitDivFEAA from '../../../components/blocs/DevisMonToitDivFEAA.astro';
import DevisMonToitDiv7D9F from '../../../components/blocs/DevisMonToitDiv7D9F.astro';
---

<Layout
  title="Instant solar estimate — My roof | Taqinor"
  description="Instant estimate + 3D roof design + online signature: enter your address and your bill, get your power, savings and payback in seconds, for free."
  ogSlug="accueil"
  locales={['fr', 'en', 'ar']}
>
  <!-- W320 — preconnect to the map origin (MapTiler style JSON + the Mapbox/
       Maxar raster tile host when configured): the most interactive moment
       of this page (dropping a pin on your roof) paid a serial DNS+TLS
       handshake until now (~100-300 ms on a cold connection). Zero cost if
       the map is never booted (no key/address fallback). -->
  <link rel="preconnect" href="https://api.maptiler.com" crossorigin />
  <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
  <!-- QX — the "estimate document" (the revelation) is set in DM Serif Display / DM
       Sans, the SAME fonts as the premium quote PDF (copied from
       quote_engine/assets/fonts). Preloaded ONLY on this page (the rest of
       the site stays on Archivo/Hanken); font-display:swap in the
       @font-face block below — never an invisible text while waiting. -->
  <link rel="preload" href="/fonts/dm-serif-display-400.woff2" as="font" type="font/woff2" crossorigin />
  <section class="bg-nuit px-4 py-8 sm:py-12">
    <!-- WJ98 — desktop layout: widen past `max-w-2xl` at `lg` (mobile/tablet
         unchanged); see the FR page (pages/devis/mon-toit.astro) for the
         rationale. -->
    <div class="mx-auto max-w-2xl lg:max-w-4xl">
      <!-- WJ65 — honest exit WITHOUT JavaScript: this page is entirely
           script-driven (map, calculation, submission) — without JS it would
           stay mute. Offer an exit here that needs NO JS at all. -->
      <noscript>
        <div class="cine-card mb-6 border border-brass-400/40 p-5 text-sm text-white">
          <p class="font-semibold">This page needs JavaScript to calculate your estimate.</p>
          <p class="mt-1 text-lune-soft">
            No worries: contact us directly, free and with no obligation.
          </p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <a href={noscriptWaHref} target="_blank" rel="noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 bg-ok-600 px-5 py-3 text-base font-bold text-white transition-opacity hover:opacity-90">
              Message us on WhatsApp
            </a>
            <a href={noscriptTelHref}
              class="inline-flex flex-1 items-center justify-center gap-2 border border-white/25 px-5 py-3 text-base font-bold text-white transition-colors hover:border-brass-400 hover:text-brass-300">
              Call {NAP.phoneDisplayIntl}
            </a>
          </div>
        </div>
      </noscript>

      <!-- WJ45 — offline banner (navigator.onLine + online/offline listeners):
           Moroccan mobile networks drop often mid-journey; instead of a silent
           failure after a timeout, we say so explicitly AND reassure that
           nothing is lost (the form stays filled, the WJ61 sessionStorage
           snapshot persists). -->
      <div id="mt-offline-banner" hidden role="status" aria-live="polite"
        class="mb-4 flex items-start gap-2 border border-brass-400/40 bg-brass-400/10 p-3 text-sm text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none text-brass-300">
          <line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.58 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
        <span>No connection — your answers are kept, we'll retry as soon as the network is back.</span>
      </div>

      <!-- Header (WJ6) — no in-page toggle: the /en/ URL already declares the locale. -->
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="tech-label rule-brass text-brass-300">
            Solar estimate · free · no obligation
          </p>
          <h1 class="display mt-4 text-2xl text-white sm:text-3xl">
            Get your solar estimate
          </h1>
        </div>
      </div>

      <!-- WJ6/WJ58 — "no pressure" microcopy + honest response-time promise
           (WG9 resolved by the founder, 2026-07-03: "within 1 h, 7 days a week"). -->
      <p class="mt-3 text-sm text-lune-soft">
        WhatsApp reply within 1 h, 7 days a week · no sales calls.
      </p>

      <!-- WJ6 — labelled progress bar -->
      <ol id="mt-progress" class="mt-6 grid grid-cols-2 gap-2" aria-label="Progress">
        {STEPS.map((s, i) => (
          <li class="mt-step flex flex-col gap-1.5" data-step={i}>
            <span class="h-1.5 w-full rounded-full bg-white/10 mt-step-bar transition-colors"></span>
            <span class="text-xs text-lune-faint mt-step-label">{s}</span>
          </li>
        ))}
      </ol>

      <!-- ============ STEP 0/1 — YOUR ROOF (mode + map/pin) ============ -->
      <div id="mt-panel-0" class="mt-step-panel">
        <!-- WJ88 — real h2 landmark per step (screen-reader navigation): visually
             hidden (sr-only), the visible progress bar stays the same. -->
        <h2 id="mt-h2-0" class="sr-only">{STEPS[0]}</h2>
        <!-- WJ6/QX — mode selector: no default, the profile drives an
             entirely different step-2 questionnaire (nudge on #mt-mode-err). -->
        <fieldset class="mt-6">
          <legend class="text-sm text-lune-soft">Your project type</legend>
          <!-- WJ65 — on very small screens (≲360 px), several columns crowd the
               text (truncation/overlap): stack in 1 column, then 2×2 from `sm:`
               (640 px) — WJ121: 4 cards. -->
          <div id="mt-mode-grid" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {MODES.map((m) => (
              <button type="button" class="mt-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors"
                data-mode={m.id} aria-pressed="false" aria-describedby="mt-mode-err">
                <span class="text-sm font-semibold text-white">{m.label}</span>
                <span class="text-xs text-lune-faint">{m.desc}</span>
              </button>
            ))}
          </div>
          <span id="mt-mode-err" hidden role="alert" class="mt-2 block text-xs text-alert-300"></span>
        </fieldset>

        <!-- WJ68/QX — the company fields (name / facility type / site count)
             moved to the PROFESSIONAL sub-panel of step 2 ("Your context"
             accordion) to keep this map step light — same id/name, webhook
             contract unchanged. -->

        <p id="mt-step0-intro" class="mt-5 text-lune-soft">
          Search for your address and drop a pin on your roof. This is optional —
          you can also continue with your address alone.
        </p>
        <!-- AGW401 — agricultural variant of step 0 (shown by syncStep2Panels). -->
        <p id="mt-step0-intro-agri" hidden class="mt-5 text-lune-soft">
          Search for your address and drop a pin on your borehole or your plot. This is
          optional — you can also continue with your address alone.
        </p>

        <!-- No-JavaScript / no map-key fallback (WJ4): ask for a plain-text
             address and ALLOW the journey to continue (no more dead end on the pin). -->
        <div id="mt-fallback" hidden class="cine-card mt-5 border-l-4 border-alert-300 p-5">
          <p class="font-semibold text-white">Map temporarily unavailable</p>
          <p class="mt-2 text-sm text-lune-soft">
            No worries: enter your full address below and continue. We'll locate your
            roof for you.
          </p>
          <label class="mt-3 block text-sm text-lune-soft">
            <span>Full address</span>
            <input id="mt-fallback-address" type="text" autocomplete="street-address"
              placeholder="e.g. Lot. Al Wifaq, Hay Riad, Rabat" class={`${inputClass} mt-1`} />
          </label>
        </div>

        <!-- EXPLICIT CHOICE of the roof-marking gesture. The journey used to be
             IMPLICIT: a click dropped a pin, and only a double-click (an
             interaction that does not exist on touch) started an outline —
             nothing announced it, so almost nobody ever drew. We ask the
             question plainly, with a safe default ("point"). -->
        <div id="mt-roof-mode-group" class="mt-5" role="group" aria-labelledby="mt-roof-mode-label">
          <p id="mt-roof-mode-label" class="text-sm text-lune-soft">
            How would you like to show us your roof?
          </p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <button type="button" id="mt-roof-mode-point" data-value="point" aria-pressed="true"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors">
              <span class="text-sm font-semibold text-white">📍 Point at my roof</span>
              <span class="text-xs text-lune-faint">A single tap on your roof — the quickest.</span>
            </button>
            <button type="button" id="mt-roof-mode-draw" data-value="draw" aria-pressed="false"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors">
              <span class="text-sm font-semibold text-white">✏️ Draw my roof</span>
              <span class="text-xs text-lune-faint">Trace the outline — more precise for the study.</span>
            </button>
          </div>
        </div>

        <!-- MAP — address search + pin (ids rp9-* wired by captureBoot). -->
        <div id="mt-stage" class="cine-card mt-5 overflow-hidden">
          <form id="rp9-search" class="flex flex-col gap-3 border-b border-white/10 p-4 sm:flex-row">
            <label for="rp9-address" class="sr-only">Your address</label>
            <div class="relative flex-1">
              <input id="rp9-address" name="address" type="text" autocomplete="off"
                role="combobox" aria-autocomplete="list" aria-expanded="false"
                aria-controls="rp9-suggestions" aria-haspopup="listbox"
                placeholder="Address, neighbourhood or city (e.g. Casablanca, Maârif)" class={inputClass} />
              <ul id="rp9-suggestions" role="listbox" aria-label="Address suggestions" hidden
                class="absolute left-0 right-0 top-full z-20 mt-1 max-h-72 overflow-auto border border-white/15 bg-nuit-900 shadow-xl">
              </ul>
            </div>
            <button type="submit"
              class="flex-none bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
              Locate
            </button>
          </form>

          <!-- WJ88 — role="application" removed: this ARIA role puts the whole
               subtree into "application" mode for a screen reader (native
               arrow/tab navigation is disabled), making the map keyboard-inert
               even though it exposes no keyboard interaction of its own here.
               aria-label alone is enough to name it. -->
          <!-- WJ98 — taller map on desktop (`lg:h-[62vh]`, capped 640px); phone/tablet unchanged. -->
          <div id="rp9-map" class="mt-skeleton-shimmer mt-0 h-[44dvh] min-h-[280px] w-full bg-nuit-700 lg:h-[62vh] lg:max-h-[640px]"
            aria-label="Satellite map to locate your roof"></div>

          <div class="flex flex-wrap items-center gap-3 border-t border-white/10 p-4">
            <button type="button" id="rp9-finish" disabled
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-400 hover:text-brass-300 disabled:cursor-not-allowed disabled:opacity-40">
              Finish tracing
            </button>
            <button type="button" id="rp9-undo-point" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              Undo last point
            </button>
            <button type="button" id="rp9-add-pan" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              Add a roof section
            </button>
            <button type="button" id="rp9-remove-pan" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              Remove this section
            </button>
            <button type="button" id="rp9-clear"
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-white/50 hover:text-white">
              Clear
            </button>
            <p class="ml-auto text-sm text-lune-faint">
              <span>Pin&nbsp;: </span><span id="rp9-area-value" class="text-white">—</span>
            </p>
          </div>
          <p id="rp9-status" class="border-t border-white/10 px-4 py-3 text-sm text-lune-faint" aria-live="polite">
            Search for your address, then drop a pin on your roof (optional).
          </p>

          <!-- VISUAL CONFIRMATION of the pin ("point" flow only). Visitors used to
               drop a point on a wide view and move on without ever seeing WHAT
               they had designated; the map now lands tight on their pin
               (captureBoot.landOn) and we ask the question next to the image.
               The "draw" flow keeps its own visual feedback: the outline. -->
          <div id="mt-pin-confirm" hidden class="border-t border-white/10 p-4">
            <p class="text-sm font-semibold text-white">Is this your roof?</p>
            <p class="mt-1 text-xs text-lune-faint">The map is centred on the pin you just dropped.</p>
            <!-- Address filled ONLY if reverse geocoding found one (W2) — never a
                 guessed address, never an empty line. -->
            <p id="mt-pin-confirm-address" hidden class="mt-2 text-sm text-lune-soft"></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <button type="button" id="mt-pin-confirm-yes"
                class="bg-brass-400 px-4 py-2.5 text-sm font-bold text-azur-950 transition-colors hover:bg-brass-300">
                Yes, that's my roof
              </button>
              <button type="button" id="mt-pin-confirm-adjust"
                class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
                No, move the pin
              </button>
            </div>
          </div>
        </div>

        <div class="mt-5 flex justify-end">
          <button type="button" id="mt-next-0"
            class="inline-flex items-center justify-center gap-2 bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
            <span>Continue</span>
            <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none">
              <polyline points="3,1 7,5 3,9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <!-- ============ STEP 2 — YOUR BILL (+ energy profile) ============ -->
      <div id="mt-panel-1" class="mt-step-panel" hidden>
        <!-- WJ88 — real h2 landmark (see step 0 note). -->
        <h2 id="mt-h2-1" class="sr-only">{STEPS[1]}</h2>

        <!-- ===== QX — RESIDENTIAL SUB-PANEL (bill questions, historical
             behaviour + the "redundant range" fix) — only one sub-panel is
             visible at a time, based on the profile chosen at step 1. ===== -->
        <div id="mt-sub-residentiel">
        <p class="mt-6 text-lune-soft">
          Enter your bill to calculate your estimate. The exact amount gives the most
          accurate figure.
        </p>

        <div class="cine-card mt-5 space-y-4 p-5 sm:p-6">
          <label class="block text-sm text-lune-soft">
            <span>Exact monthly bill (MAD)</span>
            <input id="mt-facture-hiver" name="factureHiver" type="number" step="any" inputmode="decimal"
              aria-describedby="mt-facture-hiver-err" placeholder="e.g. 1,200" class={`${inputClass} mt-1`} />
            <span id="mt-facture-hiver-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
            <!-- WJ67 — "why we ask" micro-transparency: copy-only, collapsed by
                 default (native <details>, no JS required). -->
            <details class="mt-1.5">
              <summary class="cursor-pointer select-none text-xs text-lune-faint hover:text-lune-soft">
                Why do we ask this?
              </summary>
              <p class="mt-1 text-xs text-lune-faint">
                The exact amount gives an accurate calculation — never shared.
