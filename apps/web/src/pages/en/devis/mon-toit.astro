<script>
  import { estimateFromBill, formatMad, formatMadRange } from '../../../lib/billEstimate';
  // QX — the two new per-profile engines (Lane A contract): PRO (C&I
  // self-consumption) and AGRICULTURAL (pumping). Residential stays on
  // estimateFromBill, unchanged.
  import { estimatePro } from '../../../lib/estimatorPro';
  // WJ122 — commercial per-category questions + key→webhook mapping removed
  // from the funnel (founder cut 18/08): none of them fed estimatePro — the
  // sales rep fills them in the ERP.
  // WJ124 — agronomy water engine (crop → m³/day need) — QX48 mirror.
  import { monthlyWaterDemand } from '../../../lib/agronomy';
  import { estimateAgricole } from '../../../lib/estimatorAgricole';
  // QX — auto-derives the range from the exact amount (fix "redundant
  // range"). `billRangeLabel` returns FR text (lib, out of scope) — this
  // page uses its own BILL_RANGE_LABEL_EN map for the detected-range line.
  import { billRangeFromExact, type BillRangeId } from '../../../lib/billRange';
  import { captureWhatsappText, whatsappLink } from '../../../lib/whatsapp';
  import { WHATSAPP_LEADS } from '../../../lib/nap';
  import { buildClientRef, buildIdempotencyKey, MAX_BILL_BY_MODE } from '../../../lib/lead';
  // QJW5 — THE single lead-body builder, shared by the three locales
  // (`src/lib/tunnel/`). This page no longer has a `buildBody()` of its own:
  // it READS its DOM into a plain state and hands it to `construireCorps`,
  // which applies the field registry and calls `validateLead` itself.
  import { construireCorps } from '../../../lib/tunnel/corps';
  import type { RoofLayoutPublic } from '../../../scripts/roofPro11/captureBoot';
  import { etatVide, type EtatTunnel } from '../../../lib/tunnel/champs';
  import { lireChampsDomTunnel } from '../../../lib/tunnel/lecture';
  import { ERREURS } from '../../../lib/tunnel/i18n';
  // LANE T-WEB — anonymous device fingerprint (see lib/visite.ts): echoed
  // as-is on the lead to correlate with beacon visits. QJW5 — it was missing
  // from this page entirely (web-tunnel-1), so the anti-fraud signal was never
  // collected from an English-speaking visitor.
  import { appareilId } from '../../../lib/visite';
  // L-WEBT — SERVER-side occupancy silhouettes (CJ2a): lib/dayProfiles.ts
  // copies backend/django_core/apps/ventes/courbes_journalieres.py
  // SILHOUETTES_OCCUPATION VERBATIM (cross-checked backend<->TS by a test).
  // No weight is invented here.
  import { OCCUPANCY_IDS, OCCUPANCY_SHAPES, type OccupancyId } from '../../../lib/dayProfiles';
  import { renderJourType } from '../../../scripts/tunnel/jourType';
  import { brancherAffiner } from '../../../scripts/tunnel/affiner';
  // QX/Lane C — TYPE only (erased at build: Three.js/viewerOnly NEVER joins
  // the initial bundle — WJ18; the real module stays a lazy import()).
  import type { RoofImageSpec } from '../../../scripts/roofPro11/viewerOnly';
  // WJ72 — single kWc number style, shared with the proposal (src/lib/proposition.ts):
  // comma decimal, trailing zeros stripped — never the raw dot from `String(est.kwc)`.
  import { formatKwc } from '../../../lib/proposition';
  // W342 — "closest installation": client-side haversine over the dropped GPS
  // pin (no network call). (2026-09) pool restricted to projects publishing a
  // `kwc` — this card displays it, so never a real project without a
  // published figure (e.g. Bouskoura).
  import { nearestRealisation, REALISATIONS } from '../../../lib/realisations';
  const REALISATIONS_WITH_KWC = REALISATIONS.filter((r) => r.kwc);
  import { type CaptureStrings } from '../../../scripts/roofPro11/mapDraw';

  // WJ39 — the shared client libs (lib/lead.ts, lib/billRange.ts,
  // scripts/roofPro11/mapDraw.ts) return/default to French text; this page
  // supplies its own English copy so this route never speaks French where a
  // visitor can see it. Only the WhatsApp deep-link text stays French by
  // design (frontmatter note above) — it reaches the French-speaking sales team.

  // Detected-range label (QX bill auto-detect) : la table anglaise vit dans
  // lib/tunnel/selections.ts (BILL_RANGE_LABEL_EN) depuis RWEB17-M13.

  // WJ39 — known client-side validateLead() error strings (src/lib/lead.ts,
  // out of this page's file scope) translated to English so inline field
  // errors never show French on this route. Falls back to the raw (French)
  // message only if the shared validator ever returns something outside
  // this known set.
  const VALIDATION_ERROR_EN: Record<string, string> = {
    'Nom complet requis': 'Full name required',
    'Numéro invalide': 'Invalid number',
    'Numéro invalide — format attendu : 06 XX XX XX XX ou +212 6 XX XX XX XX':
      'Invalid number — expected format: 06 XX XX XX XX or +212 6 XX XX XX XX',
    'Ville / commune requise': 'City / town required',
    'Type de toiture requis': 'Roof type required',
    'Tranche de facture requise': 'Bill range required',
    'Le consentement est requis pour être recontacté': 'Consent is required so we can contact you back',
  };

  // WJ41 — map/geocoder system messages (roofPro11/mapDraw.ts + captureBoot.ts
  // default to French); this page passes English strings so the single most
  // interactive moment of the funnel never speaks French to EN visitors.
  const ROOF_TOOL_STRINGS_EN: CaptureStrings = {
    searchAddressThenPin: 'Search for your address, then drop a pin on your roof.',
    pinPlaced: 'Pin placed. You can adjust it, or trace the outline (optional), then fill in your details.',
    outlineTraced: 'Outline traced. Fill in your details below, then submit.',
    traceOutline: 'Trace the outline of your roof. Double-click to close it (optional).',
    outlineCrosses: 'Your trace crosses itself — fix it ("Clear") before closing.',
    pointWouldCross: 'This point would cross your trace — place it elsewhere to keep a simple outline.',
    doubleClickToClose: 'Double-click (or "Finish") to close the roof and start the calculation.',
    cornerPlaced: (n) => `Corner ${n} placed — keep tracing the outline.`,
    lastPointUndone: (n) => `Last point undone — ${n} corner(s) remaining. Keep tracing.`,
    clickCornersToClose: 'Click the corners of your roof. Double-click to close it and start the calculation.',
    searchingAddress: 'Searching for the address…',
    addressNotFound: 'Address not found. Specify the city or move the map by hand.',
    chooseFromList: 'Choose your address from the list, then click the corners of your roof.',
    searchUnavailable: 'Search unavailable. Move the map by hand to find your roof.',
  };

  import { creerContexte, type ConfigLocale } from '../../../lib/tunnel/contexte';
  import { creerDom } from '../../../lib/tunnel/dom';
  import { creerEtat } from '../../../lib/tunnel/etat';
  import { installerPersistance, loadWizardState } from '../../../lib/tunnel/persistance';
  import { installerParcours } from '../../../lib/tunnel/parcours';
  import { installerSelections } from '../../../lib/tunnel/selections';
  import { installerCarteApercu3d, installerCarteBoot, installerCarteInstantane, type ContexteCarte } from '../../../lib/tunnel/carte';

  // RWEB17-M10 — UN état et UN registre de crochets pour les trois pages : les
  // `let` de haut niveau vivent dans `ctx.etat` (valeurs initiales de
  // `creerEtat`, identiques à celles de la page), et les fonctions appelées par
  // une AUTRE section passent par `ctx.crochets` (liaison tardive, sans TDZ).
  const CONFIG_EN: ConfigLocale = {
    locale: 'en',
    langueBasculable: false,
    formatNombre: (n: number): string => (Math.round(n * 10) / 10).toLocaleString('en-GB'),
  };
  const savedWizard = loadWizardState();
  const ctx = creerContexte(creerDom(document), creerEtat(savedWizard, 'en'), CONFIG_EN);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id: string) => document.getElementById(id);
  const fallback = $('mt-fallback');
  const cityEl = $('mt-city') as HTMLInputElement | null;
  const addressEl = $('rp9-address') as HTMLInputElement | null;
  const fallbackAddrEl = $('mt-fallback-address') as HTMLInputElement | null;
  // ——— RWEB17-M11 — section « persistance » (lib/tunnel/persistance.ts) : jeton et
  // balises de funnel (WJ59/WB30), bandeau hors ligne (WJ45), instantané `mt-wizard-v1`
  // (WJ61), garde `beforeunload`, jetons de dédoublonnage, référence client (WJ52) et
  // clés de suivi ; ses crochets sont inscrits ici. ———
  const persistance = installerPersistance(ctx, savedWizard);
  // ——— RWEB17-M12 — section « parcours » (lib/tunnel/parcours.ts) : ville facultative
  // avec GPS, bascule FR/AR (FR et AR seulement), `?mode=` et migration 'professionnel' ;
  // puis, à leur place d'origine, modes, étapes, rappel et clic « estimation ». ———
  const parcours = installerParcours(ctx, savedWizard);
  // QX/WJ121 — cartes de mode, fil d'étapes et sous-panneaux par profil.
  parcours.brancherModes();
  // ——— RWEB17-M13 — section « sélections » (lib/tunnel/selections.ts) : créneau de visite
  // (W353), occupation de la journée et équipements (L-WEBT), « journée type » (QJR664) ;
  // les groupes de cartes et la facture sont branchés plus bas, à leur place. ———
  const selections = installerSelections(ctx);
  selections.brancherVisiteOccupationEquipements();
  // ——— RWEB17-M14 — section « carte et toiture » (lib/tunnel/carte.ts) : boot de la carte
  // (W324 : un seul /api/roof-config, à l'écran 0), repli adresse, geste pointer/dessiner
  // et confirmation du repère ; MapLibre/Three restent en import() dynamique (WJ18). ———
  Object.assign(ctx.config, {
    doc: document,
    reducedMotion,
    statutsSuiventLangue: false,
    optionsBootLocale: {
      strings: ROOF_TOOL_STRINGS_EN,
      geolocateErrorMsg: 'Location denied — search for your address or drop the pin by hand.',
      panStrings: { panAdded: 'Section added. Draw the next one (double-click to close) or send.', panRemoved: 'Section removed.', maxPans: 'Maximum number of sections reached.' },
    },
    chargeurs: {
      captureBoot: () => import('../../../scripts/roofPro11/captureBoot'),
      viewerOnly: () => import('../../../scripts/roofPro11/viewerOnly'),
    },
  });
  const ctxCarte = ctx as unknown as ContexteCarte;
  installerCarteBoot(ctxCarte);
  // WJ61 — étapes : historique, popstate, « Continuer » / « Retour », premier rendu.
  parcours.brancherEtapes();

  // ——— input helpers ———
  const val = (id: string) => (($(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '');
  const num = (id: string): number | null => {
    const raw = val(id).trim();
    if (raw === '') return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  };
  // WJ105 — SLA de rappel visible seulement si « Un conseiller peut m'appeler ».
  parcours.brancherRappel();
  // WJ61 — réhydratation des champs, du repère et du contour (avant le boot de la carte).
  persistance.rehydrater();
  // WJ61 — persiste sur toute frappe/changement des champs listés.
  persistance.brancherPersistanceSurSaisie();
  // Geste « pointer » / « dessiner » et confirmation du repère : branchés par installerCarteBoot (plus haut).
  // QX/WJ122/WJ123/WJ124/AGW403 — groupes de cartes, cultures, heures de pompage, recalcul en direct.
  selections.brancherGroupes();
  // WJ65/QX — sanity cap PER PROFILE (MAX_BILL_BY_MODE, lib/lead.ts): beyond
  // it, a typo would produce a confidently stated figure — we ask to double
  // check (residential) or route to a dedicated study (pro). Only applies to
  // the EXACT amount entered, never to ranges.
  function maxBillFor(m: string): number {
    return MAX_BILL_BY_MODE[m as keyof typeof MAX_BILL_BY_MODE] ?? 200_000;
  }

  // ——— WJ1/QX : compute + display the estimate in THE DOCUMENT ———
  // QX — has the document already been rendered at least once (fallback included)?
  // QX — estimateShown: EXACTLY the computed figures, attached to the lead (the
  // CRM advisor sees everything). WJ125 — they are NO LONGER rendered on screen.
  // ——— WJ125 — FOUNDER anti-competitor RULE: in the public journey, the
  // figured estimate document (#mt-doc), the "nearest installation" (kWc + km)
  // and the "cost of waiting" (MAD) NO LONGER render. The calculation keeps
  // running silently (estimateShown + labels still reach the CRM and the
  // WhatsApp deeplink) but NO precise figure is written into the public DOM: a
  // locked teaser card (blurred preview WITHOUT a single figure) leads to the
  // form. The full document + "Print" live ONLY on /proposition/<token> (sent
  // by the sales rep). ———
  const PUBLIC_ESTIMATE_GATED: boolean = true;
  // ——— Founder decision 13/09/2026 ("Palmetto" model): the 3D panel preview
  // is visible again BEFORE the contact gate — VISUAL ONLY, no figure in the
  // DOM (no kWc, no panel count, no price). WJ125 stays intact for all
  // figures, which live on /proposition/<token>. Set false to re-hide.
  const PUBLIC_3D_PREVIEW: boolean = true;
  const GATED_ANNOUNCE = 'Your estimate is ready. Enter your details to receive your complete, personalised study.';
  /** WJ125 — switches the public journey to gated mode: hides the figured
   *  document AND the out-of-#mt-doc zones that would leak figures (nearest
   *  installation, cost of waiting, Print button), then reveals the locked
   *  teaser card (figure-free hook adapted to pumping vs roof). The CALCULATION
   *  is unchanged — only the public RENDER changes. */
  /** WJ127 — the three possible hooks. 'standard' = an estimate exists (roof or
   *  pumping hook); 'etude' = no estimate because the project is beyond the
   *  simulator's scale; 'rappel' = no estimate because the hydraulics are
   *  missing. Both fallbacks say the SAME thing as `announceEstimate` on those
   *  paths — sighted / screen-reader parity. */
  type VarianteTeaser = 'standard' | 'etude' | 'rappel';
  function showEstimateTeaser(m: string, variante: VarianteTeaser = 'standard') {
    ctx.etat.docRendered = true;
    const doc = $('mt-doc');
    if (doc) doc.hidden = true;
    const printBtn = $('mt-print-estimate');
    if (printBtn) printBtn.hidden = true;
    const nearestEl = $('mt-nearest-install');
    if (nearestEl) nearestEl.hidden = true;
    const cowEl = $('mt-cost-of-waiting');
    if (cowEl) cowEl.hidden = true;
    const teaser = $('mt-teaser');
    if (teaser) teaser.hidden = false;
    const isAgri = m === 'agricole';
    const etudeHook = $('mt-teaser-hook-etude');
    if (etudeHook) etudeHook.hidden = variante !== 'etude';
    const rappelHook = $('mt-teaser-hook-rappel');
    if (rappelHook) rappelHook.hidden = variante !== 'rappel';
    const roofHook = $('mt-teaser-hook-roof');
    if (roofHook) roofHook.hidden = isAgri || variante !== 'standard';
    const pumpHook = $('mt-teaser-hook-pump');
    if (pumpHook) pumpHook.hidden = !isAgri || variante !== 'standard';
  }
  ctx.crochets.installer('showEstimateTeaser', showEstimateTeaser);
  // QX — MAD/kWh tariff of the last PRO estimate shown (engine assumptions):
  // used to derive a consistent billRange when consumption is in kWh.
  // WJ88 — SINGLE announcement of the result (never during the skeleton
  // phase): replaces the old aria-live set on the whole card, which caused a
  // screen-reader double-fire (skeleton THEN result).
  function announceEstimate(message: string) {
    const el = $('mt-estimate-announce');
    if (el) el.textContent = message;
  }
  ctx.crochets.installer('announceEstimate', announceEstimate);
  // ——— QX : small document formatters (en-GB, deterministic) ———
  const fmtNum = (n: number): string => (Math.round(n * 10) / 10).toLocaleString('en-GB');
