---
/**
 * EN — City pages (W67). Faithful English translation of the FR
 * `installation-solaire-[city].astro`. Same 5 cities, same numeric data from
 * `realisations.ts`/CITIES (untouched) — only the prose is translated, pulled
 * from `cityContentBySlug(slug, 'en')`. No invented figure or claim; honesty of
 * `hasLocalInstall` preserved (only Casablanca shows a local install). Internal
 * links via localizeNavHref. FR untouched.
 */
import CityPageBody from '../../components/CityPageBody.astro';
import Layout from '../../layouts/Layout.astro';
import { CITIES } from '../../lib/realisations';
import { cityPageBase, cityServiceJsonLd, NEUTRAL_CITY_HERO } from '../../lib/cityPageData';
import { getLocaleFromPath } from '../../i18n/utils';
import { localizeNavHref } from '../../i18n/pages';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const L = (href: string) => localizeNavHref(href, locale);

// Forme localisée de l'intro « in <city> » (le FR utilise « à <ville> »).
const intro = `in ${c.name}`;

// ENF19 — calcul commun FR/EN/AR (listes de chantiers, rendement mesuré, prose, alt des cartes) : lib/cityPageData.ts
const city = cityPageBase(c, intro, locale);
const { inCity, avgYieldPerKwc, cardAlt, southOptimalYield, title, description, nearestInstallNote } = city;

const heroPhoto = inCity[0]?.photos[0] ?? NEUTRAL_CITY_HERO;

const serviceJsonLd = cityServiceJsonLd('Photovoltaic solar installation', `Solar installation ${intro}`, c.name);
const heroPhotoAlt = inCity[0] ? cardAlt(inCity[0]) : '';
const t = {
  kicker: `Service area · ${c.name}`,
  h1: `Solar installation ${intro}`,
  potential: 'Solar potential',
  hoursUnit: 'h/year',
  sunshineLabel: `Indicative annual sunshine · ${c.name}`,
  publicData: 'Public weather data, for guidance only.',
  statBill: 'Of the bill covered',
  statRoiValue: '3–7 years',
  statRoi: 'Return on investment',
  statWarrantyValue: '25 years',
  statWarranty: 'Performance warranty',
  stat8221: 'Simple Law 82-21 declaration',
  projectsKicker: `Our projects · ${c.name}`,
  projectsH2: `Real installations ${intro}`,
  caseStudy: 'See the case study',
  nearbyKicker: 'In the region',
  nearbyH2: `Other projects in the ${c.name} region`,
  coveredKicker: 'Your city is covered',
  coveredH2: `We work ${intro} — and our projects speak for us`,
  closestLead: 'Here are our closest projects:',
  latest: 'Our latest projects',
  residential: 'Residential solar',
  business: 'Business solar',
};
const bodyProps = { c, rtl: false, L, cardAlt: cardAlt, t, breadcrumbItems: [{ label: 'Home', href: L('/') }, { label: `Solar installation ${intro}` }], heroPhoto, showYieldNote: !!(avgYieldPerKwc && southOptimalYield), city };
---

<Layout title={title} description={description} ogSlug="accueil">
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <CityPageBody {...bodyProps}>
    <Fragment slot="yieldNote">
      Worth noting: these installations average ≈{avgYieldPerKwc?.toLocaleString('en-US')} kWh/kWc/yr,
      below the ≈{southOptimalYield?.toLocaleString('en-US')} kWh/kWc/yr the modeled yield table
      used for estimates assumes — real installations aren't all south-facing at the optimal
      29° tilt, unlike the model's assumption. The on-site study refines this figure for your
      actual roof.
    </Fragment>
    <Fragment slot="coveredNote">
      {nearestInstallNote ?? `${c.name} is part of our service area. Our closest installations already in service are in ` +
        'the Casablanca region — same assessment methods, same tier-1 equipment, same real-time ' +
        'production monitoring.'}
    </Fragment>
  </CityPageBody>
</Layout>
