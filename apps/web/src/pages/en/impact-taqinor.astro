---
/**
 * EN — Impact Taqinor (W279). Faithful translation of /impact-taqinor ; every
 * figure is DERIVED live from realisations.ts (read-only), exactly like the FR
 * page — no number is hand-typed or re-translated by hand. Internal links use
 * localizeNavHref (EN if it exists, else the FR page — never a dead link).
 * FR untouched.
 *
 * NOTE: this EN route is NOT yet registered in src/i18n/pages.ts
 * (STATIC_TRANSLATED) — that file is out of scope for this task, so the
 * language switcher / hreflang do not surface this page yet. The route itself
 * renders correctly and is a real, indexable page.
 */
import PourAllerPlusLoin from '../../components/blocs/PourAllerPlusLoin.astro';
import LienRealisationsBilanEn from '../../components/blocs/LienRealisationsBilanEn.astro';
import LigneMateriel from '../../components/blocs/LigneMateriel.astro';
import Layout from '../../layouts/Layout.astro';
import { impactFigures } from '../../lib/impactFigures';
import { pageLocale } from '../../lib/pageCtx';
import V2Enhance from '../../components/V2Enhance.astro';
import Article33Ribbon from '../../components/Article33Ribbon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import KeyFigure from '../../components/KeyFigure.astro';
import Callout from '../../components/Callout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CtaBand from '../../components/CtaBand.astro';
import StickyCta from '../../components/StickyCta.astro';
import { localizeNavHref } from '../../i18n/pages';
import { kwcLocale, REALISATIONS } from '../../lib/realisations';

const { locale, L, devisHref } = pageLocale(Astro.url.pathname);

// ── Derived figures — nothing hand-typed ─────────────────────────────────────
// RULE B (2026-07-04): the raw install count is no longer featured in user
// copy (lead, h2, denominators) — the page leads with measured kWh / CO2
// avoided instead (partially supersedes W279).
// (2026-07-05, founder): cumulative installed kWc is dropped (no longer shown
// anywhere on the site) — the page now leads with MEASURED production.

// WB1 (2026-07-04): the fabricated per-installation ANNUAL production was
// removed (identical yield factor across several sites — impossible). The
// only real production figure is the CUMULATIVE tally of the fleet monitored
// in real time (MEASURED_FLEET, realisations.ts) — cumulative "since
// commissioning", NEVER annualized. CO2 avoided and the tree equivalent
// derive from it.
const { productionTotal, productionTotalLabel, batteryKwhTotal, villesMesurees } = impactFigures('en-US');


// « CHECKED FACTS » RULE (founder, 2026-08-26) — the "trees" equivalence is
// REMOVED from all client rendering: the 22 kg of CO2 absorbed per tree per year
// was an order of magnitude with no source. Only the measured tonnage remains,
// and it now says that its emission factor is still awaiting its reference.



const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Taqinor Impact',
  description: `Taqinor's cumulative, measured, honest impact: ${productionTotalLabel} kWh measured cumulatively across the fleet monitored in real time.`,
  isPartOf: { '@type': 'WebSite', name: 'Taqinor', url: 'https://taqinor.ma' },
};
---

<Layout
  title="Taqinor Impact: our real, cumulative, verifiable numbers | Taqinor"
  description={`${productionTotalLabel} kWh measured cumulatively (fleet monitored in real time): the tally of our installations, read on a date shown.`}
  ogSlug="equipement"
>
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Breadcrumb items={[{ label: 'Home', href: L('/') }, { label: 'Taqinor Impact' }]} />

    <section class="section-lg px-4 pb-10 text-white">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">Accountability</p>
        <h1 class="display v2-page-title cine-in cine-in-1 mt-6">Taqinor Impact</h1>
        <p class="v2-lead cine-in cine-in-2 mt-6 max-w-xl text-white/85">
          Not a projection, not a target: {productionTotalLabel} kWh
          measured cumulatively — what the fleet monitored
          in real time has actually produced since commissioning. This page grows project by project;
          it only states what we can prove.
        </p>
      </div>
    </section>

    <!-- Key figures — derived live from realisations.ts -->
    <section class="section px-4">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass text-lune">The tally today</p>
        <h2 class="display v2-section-title mt-5 text-white">{productionTotalLabel} kWh measured, one tally</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          <KeyFigure value={productionTotalLabel} unit="kWh cumulative" label="Measured production">
            Cumulative tally from the fleet monitored in real time since
            commissioning, notably in {villesMesurees.join(', ')}.
          </KeyFigure>
          <KeyFigure value={String(batteryKwhTotal).replace('.', ',')} unit="kWh" label="Cumulative storage">
            Cumulative battery capacity of the published projects.
          </KeyFigure>
        </div>
        <Callout type="info" title="How this figure is calculated">
          <p>
            The total adds up the production readings of the monitored fleet, at their reading date.
            No figure is extrapolated beyond the production actually read.
          </p>
        </Callout>
      </div>
    </section>

    <!-- The detail, project by project -->
    <div class="v2-seam" aria-hidden="true"></div>
    <section class="section bg-blanc-azur px-4 text-encre">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass text-azur-600">The detail</p>
        <h2 class="display v2-section-title mt-5">Project by project</h2>
        <p class="v2-lead mt-4 text-encre-soft">
          Every line is a real installation, documented on our projects page. The cumulative
          figure above is tracked continuously by our real-time production monitoring.
        </p>
        <div class="mt-10 border-t-2 border-azur-900 bg-blanc" data-stagger>
          {REALISATIONS.map((r, i) => (
            <LigneMateriel r={r} i={i} titre={[r.ville, kwcLocale(r, 'en'), `ref. ${r.ref}`].filter(Boolean).join(' · ')} />
          ))}
        </div>
        <LienRealisationsBilanEn />
      </div>
    </section>

    <!-- Why this tally stays honest -->
    <section class="section px-4 text-white">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass text-lune">Our method</p>
        <h2 class="display v2-section-title mt-5 text-white">Measured, never padded</h2>
        <p class="v2-lead mt-5 text-lune-soft">
          We could pad this tally with theoretical estimates, catalogue yields, or five-year
          projections. We'd rather count only what's already installed, monitored, and published. Every newly documented project moves
          this total forward.
        </p>
      </div>
    </section>

    <PourAllerPlusLoin kicker="To go further" links={[
          { href: L('/realisations'), label: 'Our projects' },
          { href: L('/batteries-stockage'), label: 'Batteries & storage' },
          { href: L('/garanties'), label: 'Warranties' },
          { href: L('/à-propos'), label: 'About Taqinor' },
        ]} />

    <CtaBand title="A project that could add to this tally? Start the free assessment." href={devisHref} />

    <StickyCta />
  </div>
</Layout>
