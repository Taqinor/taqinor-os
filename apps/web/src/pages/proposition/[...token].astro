    /* Chrome flottant / interactif qui n'a aucun sens sur une feuille imprimée. */
    .prop-lang-switch,
    #sticky-cta,
    #roof3d-overlay,
    #sld-viewer,
    #contact-confirm,
    #sign-form,
    #pdf-download,
    .btn-pill {
      display: none !important;
    }
    /* Fond clair + texte sombre : le thème nuit/laiton par défaut du site
       imprimerait en dark-on-dark (fond quasi noir, texte clair illisible sur
       papier/PDF navigateur). */
    html,
    body,
    .proposition {
      background: #fff !important;
      color: #111 !important;
    }
    .proposition :global(*) {
      color: inherit;
      text-shadow: none !important;
      box-shadow: none !important;
    }
    .cine-card {
      border: 1px solid #ccc !important;
      background: #fff !important;
    }
    /* La scène 3D (canvas WebGL) ne s'imprime pas de façon fiable — masquée,
