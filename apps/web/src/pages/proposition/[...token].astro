              <div class="roof3d-scrim absolute inset-0" aria-hidden="true"></div>
              <div id="roof3d-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
                <button
                  id="roof3d-start"
                  type="button"
                  class="btn-pill inline-flex items-center justify-center gap-2"
                  style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)"
                  data-i18n data-fr="Explorer votre toit en 3D" data-en="Explore your roof in 3D" data-ar="استكشفوا سطحكم بتقنية ثلاثية الأبعاد"
                >
                  Explorer votre toit en 3D
                </button>
                <p id="roof3d-note" class="max-w-sm text-sm text-lune-soft" data-i18n
                  data-fr="Tournez, zoomez : ce sont votre toit et vos panneaux, tels qu’étudiés."
                  data-en="Rotate, zoom: this is your roof and your panels, exactly as studied."
                  data-ar="دوّروا، قرّبوا: هذا سطحكم وألواحكم، كما تمت دراستهما.">
                  Tournez, zoomez : ce sont votre toit et vos panneaux, tels qu’étudiés.
                </p>
              </div>
            </div>
            <p id="roof3d-hint" class="px-5 py-3 text-xs text-lune-faint" hidden data-i18n
              data-fr="Faites glisser pour tourner · pincez ou molette pour zoomer · deux doigts pour déplacer · flèches pour tourner, + / − pour zoomer au clavier."
              data-en="Drag to rotate · pinch or scroll to zoom · two fingers to pan · arrow keys to rotate, + / − to zoom on keyboard."
              data-ar="اسحبوا للتدوير · قرّبوا بإصبعين أو بعجلة الفأرة · إصبعان للتحريك · أسهم لوحة المفاتيح للتدوير، + / − للتكبير.">
              Faites glisser pour tourner · pincez ou molette pour zoomer · deux doigts pour déplacer · flèches pour tourner, + / − pour zoomer au clavier.
            </p>
          </div>

          <!-- ── WJ26 · Légende : ce que vous voyez, pan par pan ─────────────── -->
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm" aria-label="Légende de la vue 3D">
            <span class="inline-flex items-center gap-2 text-lune-soft">
              <span class="inline-block h-3 w-3 rounded-sm" style="background: #14263f; outline: 1px solid rgb(255 255 255 / 0.25)" aria-hidden="true"></span>
              <span data-i18n data-fr="Vos panneaux solaires" data-en="Your solar panels" data-ar="ألواحكم الشمسية">Vos panneaux solaires</span>
            </span>
            <span class="inline-flex items-center gap-2 text-lune-soft">
              <span class="inline-block h-3 w-3 rounded-sm" style="background: #b9bfca" aria-hidden="true"></span>
              <span data-i18n data-fr="Votre toiture" data-en="Your roof" data-ar="سطحكم">Votre toiture</span>
            </span>
            <span class="inline-flex items-center gap-2 text-lune-soft">
              <span class="inline-block h-3 w-3 rounded-sm" style="background: #9aa3b4" aria-hidden="true"></span>
              <span data-i18n data-fr="Obstacles (cheminée, cage d’escalier…)" data-en="Obstacles (chimney, stairwell…)" data-ar="عوائق (مدخنة، بيت الدرج…)">Obstacles (cheminée, cage d’escalier…)</span>
            </span>
          </div>

          <!-- ── PVUNI · Calepinage à rejouer (fondateur 2026-08-18) ──────────
               La vue ci-dessus a été étudiée pour un autre nombre de panneaux
               que celui du devis. On le DIT, sous la vue, plutôt que de laisser
               le client compter les panneaux à l'écran et trouver un autre
               chiffre dans son devis. Le nombre qui fait foi reste celui des
               lignes (« Votre installation ») — c'est exactement ce que la
               phrase annonce. Bloc absent du DOM sur un devis sain. -->
          {layoutStale && (
            <p id="roof3d-stale" class="mt-3 text-sm text-lune-faint" data-i18n
              data-fr={`Calepinage à rejouer : cette vue 3D a été étudiée pour ${layoutPanneaux} panneaux. Les chiffres de votre proposition suivent votre devis, pas cette vue.`}
              data-en={`Layout to be replayed: this 3D view was studied for ${layoutPanneaux} panels. Your proposal’s figures follow your quote, not this view.`}
              data-ar={`التخطيط بحاجة إلى إعادة: صُمِّم هذا العرض ثلاثي الأبعاد لـ ${layoutPanneaux} لوحاً. أرقام عرضكم تتبع فاتوركم التقديرية، لا هذا العرض.`}>
              Calepinage à rejouer : cette vue 3D a été étudiée pour {layoutPanneaux} panneaux.
              Les chiffres de votre proposition suivent votre devis, pas cette vue.
            </p>
          )}
          {/* Cartes « ZONE n · … » retirées (fondateur 2026-08-15) : les chiffres
              par pan vivent dans « Votre installation » ; zoneAnnotations reste
              dans la lib (testée) pour un éventuel retour. */}

          <!-- WJ26 retirée (fondateur 2026-08-15) : la « visite guidée » 4 étapes
               et sa barre Précédent/Suivant quittent la page ; walkthroughSteps
               reste dans la lib (testée) au cas où elle revient. -->
        </section>
        <div class="seam-soft" aria-hidden="true"></div>
        </>
      )}

      <!-- ── PV80 · CHAPITRE 3 — VOTRE INSTALLATION ───────────────────────────
           Fusion de l'ancien encart « Votre système » (3 chiffres) et de la
           liste d'équipement qui vivait, en vrac, à l'intérieur de la carte de
           PRIX. Les 3 specs clés restent en tête ; le matériel devient un
           tableau structuré juste en dessous. -->
      {(puissance || nbPanneaux || equipmentGroups.length > 0) && (
        <section id="installation" class="mx-auto max-w-4xl px-5 pt-12 sm:px-8">
          <p class="tech-label rule-brass text-brass-300" data-i18n data-fr="Votre installation" data-en="Your installation" data-ar="تركيبكم">Votre installation</p>
          {/* PV81 — les 3 specs occupaient trois CARTES pleine largeur sur mobile
              (~330 px) pour trois valeurs de quelques caractères. Elles tiennent
              en UNE ligne au-dessus du tableau : c'est une légende, pas un
              tableau de bord. Chaque valeur reste celle du devis backend. */}
          <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-lune-soft">
            {puissance ? (
              <span class="fig text-xl text-lune" dir="ltr">{formatNumber(puissance, 2)} <span class="text-sm text-lune-soft">kWc</span></span>
            ) : null}
            {puissance && nbPanneaux ? <span class="text-lune-faint" aria-hidden="true">·</span> : null}
            {nbPanneaux ? (
              <span class="fig text-xl text-lune" dir="ltr">
                {formatNumber(nbPanneaux)}
                {wattPanneau ? <span class="text-sm text-lune-soft"> × {formatNumber(wattPanneau)} W</span> : null}
                <span class="ms-1 text-sm text-lune-soft" data-i18n data-fr="panneaux" data-en="panels" data-ar="لوحاً">panneaux</span>
              </span>
            ) : null}
            {(puissance || nbPanneaux) ? <span class="text-lune-faint" aria-hidden="true">·</span> : null}
            <span class="text-lune">{instLabel}</span>
          </p>

          <!-- ── PV80 · CE QUI SERA POSÉ CHEZ VOUS — tableau STRUCTURÉ ────────
               Désignation × quantité, groupé par famille (production, stockage,
               protection, structure), SANS prix par ligne : le prix vit au
               chapitre « Votre prix » et n'y est dit qu'UNE fois. Marque et
               garantie restent affichées quand le devis les porte — jamais la
               DESCRIPTION (fiche produit brute du catalogue, avec ses notes
               internes « à confirmer fondateur » : vue chez le client une fois,
               plus jamais). Aucune ligne du devis n'est perdue :
               un libellé non reconnu tombe dans « Autres postes ». -->
          {equipmentGroups.length > 0 && (
            <div class="cine-card mt-4 rounded-2xl p-5 sm:p-6" id="equipement">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="tech-label text-lune-faint" data-i18n
                  data-fr="Ce qui sera posé chez vous" data-en="What will be installed" data-ar="ما سيتم تركيبه عندكم">
                  Ce qui sera posé chez vous
                </p>
                {twoOptions && (
                  <p class="text-xs text-lune-faint" data-i18n
                    data-fr={`Détail de l’option « ${optionLabel(equipmentOption)} »`}
                    data-en={`Detail of the “${optionLabelEn(equipmentOption)}” option`}
                    data-ar={`تفاصيل خيار «${optionLabelAr(equipmentOption)}»`}>
                    Détail de l’option « {optionLabel(equipmentOption)} »
                  </p>
                )}
              </div>
              <div class="mt-4 space-y-5">
                {equipmentGroups.map((group) => (
                  <div>
                    <p class="tech-label text-brass-300" data-i18n
                      data-fr={EQUIPMENT_GROUP_LABELS[group.id].fr}
                      data-en={EQUIPMENT_GROUP_LABELS[group.id].en}
                      data-ar={EQUIPMENT_GROUP_LABELS[group.id].ar}>
                      {EQUIPMENT_GROUP_LABELS[group.id].fr}
                    </p>
                    <ul class="mt-2 divide-y divide-white/10 border-t border-white/10">
                      {group.lines.map((it) => (
                        <li class="flex items-start justify-between gap-4 py-2.5">
                          <div class="min-w-0">
                            <p class="text-sm text-lune">
                              {it.designation}
                              {it.marque ? <span class="text-lune-faint"> · {it.marque}</span> : null}
                            </p>
                            {/* JAMAIS it.description ici : c'est la fiche produit
                                BRUTE du catalogue, avec ses notes internes
                                (« Modèle supposé — à confirmer fondateur » a été
                                vu chez le client). La fiche détaillée vit dans le
                                PDF ; la page = désignation · marque · garantie. */}
                            {it.garantie ? (
                              <p class="mt-0.5 text-xs text-brass-300" data-i18n
                                data-fr={`Garantie : ${it.garantie}`}
                                data-en={`Warranty: ${it.garantie}`}
                                data-ar={`الضمان: ${it.garantie}`}>Garantie : {it.garantie}</p>
                            ) : null}
                            {/* WJ131 — « Fiche technique ↗ » : le client peut enfin
                                VÉRIFIER chaque ligne qu'il paie, y compris les
                                postes génériques (protection DC, protection AC,
                                câblage, accessoires de pose, structure) dont la
                                fiche est EXPLICATIVE. Discret par construction :
                                pas de lien du tout quand l'appariement n'est pas
                                certain. La flèche vit HORS du span traduit — sinon la
                                bascule EN/AR (textContent) l'effacerait. */}
                            {it.ficheSlug ? (
                              <a
                                href={`/produits/${it.ficheSlug}`}
                                target="_blank"
                                rel="noopener"
                                class="mt-1 inline-flex items-center gap-1 text-xs text-brass-300 underline-offset-2 transition-colors hover:text-brass-200 hover:underline"
                              >
                                <span data-i18n data-fr="Fiche technique" data-en="Datasheet" data-ar="الورقة التقنية">Fiche technique</span>
                                <span aria-hidden="true">&#8599;</span>
                              </a>
                            ) : null}
                            {/* (fondateur 2026-08-18) « DANS VOTRE INSTALLATION » —
                                le détail électrique de CETTE ligne, sans prix :
                                les organes et leurs calibres sous la protection,
                                les sections et longueurs sous le câblage, le
                                chaînage sous les panneaux et l'onduleur. Replié
                                par défaut (<details> natif, aucun JS) et
                                ENTIÈREMENT absent quand l'étude électrique
                                n'existe pas ou ne dit rien de cette ligne —
                                jamais un volet vide, jamais une valeur inventée. */}
                            {it.detail ? (
                              <details class="conception-fold mt-1.5">
                                <summary class="cursor-pointer list-none text-xs text-lune-faint transition-colors marker:content-none hover:text-lune-soft">
                                  <span class="me-1 text-brass-300" aria-hidden="true">+</span>
                                  <span data-i18n data-fr="Dans votre installation" data-en="In your installation" data-ar="في تركيبكم">Dans votre installation</span>
                                </summary>
                                <ul class="mt-1.5 space-y-1 border-s border-white/10 ps-3">
                                  {it.detail.chaines.map((c) => (
                                    <li class="text-xs text-lune-soft" data-i18n
                                      data-fr={chaineLabel(c, 'fr')}
                                      data-en={chaineLabel(c, 'en')}
                                      data-ar={chaineLabel(c, 'ar')}>{chaineLabel(c, 'fr')}</li>
                                  ))}
                                  {it.detail.protections.map((o) => (
                                    <li class="flex items-baseline justify-between gap-3 text-xs text-lune-soft">
                                      <span class="min-w-0">{protectionLabel(o)}</span>
                                      {o.quantite !== undefined ? (
                                        <span class="fig shrink-0 text-lune-faint" dir="ltr">×{formatNumber(o.quantite)}</span>
                                      ) : null}
                                    </li>
                                  ))}
                                  {/* Câbles RATTACHÉS (le devis ne facture aucune
                                      ligne « câblage ») : ils s'ouvrent par un
                                      intertitre, sinon on lirait une section de
                                      6 mm² comme un organe du coffret. Sous une
                                      vraie ligne câblage, aucun intertitre. */}
                                  {it.detail.cablesRattaches ? (
                                    <li class="pt-1 text-[0.65rem] uppercase tracking-[0.12em] text-lune-faint" data-i18n
                                      data-fr="Câblage" data-en="Cabling" data-ar="الكابلات">Câblage</li>
                                  ) : null}
                                  {it.detail.cables.map((c) => (
                                    <li class="text-xs text-lune-soft">{cableLabel(c)}</li>
                                  ))}
                                </ul>
                              </details>
                            ) : null}
                          </div>
                          <span class="fig shrink-0 text-sm text-lune-soft" dir="ltr">×{formatNumber(it.quantite)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              {equipmentExtra.length > 0 && (
                <p class="mt-5 border-t border-white/10 pt-4 text-sm text-lune-soft" data-i18n
                  data-fr={`L’option « ${optionLabel('avec_batterie')} » ajoute : ${equipmentExtra.map((it) => `${it.designation} ×${formatNumber(it.quantite)}`).join(', ')}.`}
                  data-en={`The “${optionLabelEn('avec_batterie')}” option adds: ${equipmentExtra.map((it) => `${it.designation} ×${formatNumber(it.quantite)}`).join(', ')}.`}
                  data-ar={`يضيف خيار «${optionLabelAr('avec_batterie')}»: ${equipmentExtra.map((it) => `${it.designation} ×${formatNumber(it.quantite)}`).join('، ')}.`}>
                  L’option « {optionLabel('avec_batterie')} » ajoute :{' '}
                  {equipmentExtra.map((it) => `${it.designation} ×${formatNumber(it.quantite)}`).join(', ')}.
                </p>
              )}
              <p class="mt-3 text-xs text-lune-faint" data-i18n
                data-fr="Matériel neuf, garanties constructeur incluses. Le détail des prix figure plus bas, dans « Votre prix »."
                data-en="New equipment, manufacturer warranties included. Pricing is detailed further down, under “Your price”."
                data-ar="معدات جديدة، مع ضمانات الصانع. تفاصيل الأسعار مذكورة أسفل، في «ثمنكم».">
                Matériel neuf, garanties constructeur incluses. Le détail des prix figure plus bas, dans « Votre prix ».
              </p>
            </div>
          )}
        </section>
      )}

      {/* ════════════════════════════════════════════════════════════════════
          WJ126 · VARIANTE AGRICOLE (pompage solaire) — héros pompe + eau/mois
          + bassin + FDA (sous réserve) + carburant évité. Chaque chiffre vient
          du bloc KPI backend (`agri`) ; un champ manquant est OMIS (jamais 0).
          Aucune carte batterie ici (pompage = pas de batterie, CLAUDE.md).
          ════════════════════════════════════════════════════════════════════ */}
      {isAgricole && agri && (
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="mode-agricole">
          <p class="tech-label rule-brass text-brass-300" data-i18n data-fr="Votre pompage solaire" data-en="Your solar pumping" data-ar="ضخّكم الشمسي">Votre pompage solaire</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {(agri.pompe_cv || agri.pompe_kw) ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Pompe" data-en="Pump" data-ar="المضخة">Pompe</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">
                  {agri.pompe_cv ? <>{formatNumber(agri.pompe_cv, 1)} <span class="text-base text-lune-soft">CV</span></> : null}
                  {agri.pompe_cv && agri.pompe_kw ? <span class="text-lune-faint"> · </span> : null}
                  {agri.pompe_kw ? <>{formatNumber(agri.pompe_kw, 1)} <span class="text-base text-lune-soft">kW</span></> : null}
                </p>
              </div>
            ) : null}
            {agri.m3_jour ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Eau / jour" data-en="Water / day" data-ar="الماء / يوم">Eau / jour</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(agri.m3_jour)} <span class="text-base text-lune-soft">m³</span></p>
                {agri.hmt_m ? (
                  <p class="mt-1 text-sm text-lune-faint" dir="ltr" data-i18n
                    data-fr={`à ${formatNumber(agri.hmt_m)} m HMT`}
                    data-en={`at ${formatNumber(agri.hmt_m)} m head`}
                    data-ar={`عند ${formatNumber(agri.hmt_m)} m (ع.ر.)`}>à {formatNumber(agri.hmt_m)} m HMT</p>
                ) : null}
              </div>
            ) : null}
            {agri.champ_kwc ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Champ solaire" data-en="Solar array" data-ar="الحقل الشمسي">Champ solaire</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(agri.champ_kwc, 2)} <span class="text-base text-lune-soft">kWc</span></p>
              </div>
            ) : null}
          </div>
          {/* Honnêteté : aucun KPI pompe exploitable → message d'omission clair. */}
          {(!agri.pompe_cv && !agri.pompe_kw && !agri.m3_jour && !agri.champ_kwc) ? (
            <p class="mt-4 text-sm text-lune-faint" data-i18n
              data-fr="Le dimensionnement précis de votre pompe est confirmé avec votre conseiller."
              data-en="The precise sizing of your pump is confirmed with your advisor."
              data-ar="يُحدَّد تحجيم مضختكم الدقيق مع مستشاركم.">Le dimensionnement précis de votre pompe est confirmé avec votre conseiller.</p>
          ) : null}
          {agri.debit_hmt_m3h ? (
            <p class="mt-4 text-sm text-lune-soft" data-i18n
              data-fr={`Débit estimé ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h à la hauteur de refoulement retenue.`}
              data-en={`Estimated flow ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h at the selected head.`}
              data-ar={`التدفق المقدّر ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h عند ارتفاع الرفع المعتمد.`}>Débit estimé ≈ {formatNumber(agri.debit_hmt_m3h)} m³/h à la hauteur de refoulement retenue.</p>
          ) : null}

          {/* Livraison d'eau mensuelle estimée — suit l'ensoleillement. Omise si
              m3_jour ou la production mensuelle manque (jamais une courbe besoin
              fabriquée : la série besoin/culture n'est pas dans ce payload). */}
          {waterDelivery && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6">
              <p class="tech-label text-lune-faint" data-i18n data-fr="Votre eau au fil des mois" data-en="Your water month by month" data-ar="ماؤكم على مدار الأشهر">Votre eau au fil des mois</p>
              <div class="mt-4 flex items-end gap-1.5" dir="ltr" role="img"
                aria-label="Livraison d'eau estimée par mois, suivant l'ensoleillement">
                {waterDelivery.map((m) => (
                  <div class="flex flex-1 flex-col items-center gap-1">
                    <span class="w-full rounded-t" style={`height:${Math.max(4, Math.round((m.m3 / waterMax) * 72))}px; background: var(--color-azur-300, #7fb4e8)`}></span>
                    <span class="text-[10px] text-lune-faint">{MONTHS_SHORT.fr[m.monthIndex]}</span>
                  </div>
                ))}
              </div>
              <p class="mt-3 text-xs text-lune-faint" data-i18n
                data-fr="Capacité de livraison indicative — le pompage solaire suit l'ensoleillement (dérivée du débit journalier et de la production estimée, jamais un relevé mesuré)."
                data-en="Indicative delivery capacity — solar pumping follows the sun (derived from the daily flow and estimated production, never a measured reading)."
                data-ar="قدرة تسليم إرشادية — يتبع الضخّ الشمسي أشعة الشمس (مشتقّة من التدفق اليومي والإنتاج المقدّر، وليست قراءة مقيسة).">Capacité de livraison indicative — le pompage solaire suit l'ensoleillement (dérivée du débit journalier et de la production estimée, jamais un relevé mesuré).</p>
            </div>
          )}

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {agri.bassin_m3 ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Bassin recommandé" data-en="Recommended reservoir" data-ar="حوض موصى به">Bassin recommandé</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(agri.bassin_m3)} <span class="text-base text-lune-soft">m³</span></p>
                <p class="mt-1 text-sm text-lune-faint" data-i18n
                  data-fr="≈ 2 jours d'autonomie d'eau : pompez au soleil, irriguez à la demande."
                  data-en="≈ 2 days of water autonomy: pump in the sun, irrigate on demand."
                  data-ar="≈ يومان من استقلالية الماء: اضخّوا تحت الشمس واسقوا عند الحاجة.">≈ 2 jours d'autonomie d'eau : pompez au soleil, irriguez à la demande.</p>
              </div>
            ) : null}
            {agri.fda_eligible ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-brass-300" data-i18n data-fr="Subvention FDA envisageable" data-en="FDA subsidy possible" data-ar="دعم FDA ممكن">Subvention FDA envisageable</p>
                <p class="mt-2 text-sm text-lune-soft" data-i18n
                  data-fr="Votre irrigation localisée (goutte-à-goutte) peut ouvrir droit à une aide du Fonds de Développement Agricole pouvant atteindre 30 %. Sous réserve d'éligibilité — votre conseiller vous accompagne dans le dossier."
                  data-en="Your localized (drip) irrigation may qualify for Agricultural Development Fund support of up to 30%. Subject to eligibility — your advisor guides you through the application."
                  data-ar="قد يؤهّل ريّكم الموضعي (بالتنقيط) للحصول على دعم من صندوق التنمية الفلاحية قد يصل إلى 30%. رهْن الأهلية — يرافقكم مستشاركم في الملف.">Votre irrigation localisée (goutte-à-goutte) peut ouvrir droit à une aide du Fonds de Développement Agricole pouvant atteindre 30 %. Sous réserve d'éligibilité — votre conseiller vous accompagne dans le dossier.</p>
              </div>
            ) : null}
          </div>

          {/* Carburant évité — QUALITATIF (aucun chiffre de gasoil dans le payload). */}
          <div class="cine-card mt-5 rounded-xl p-5">
            <p class="tech-label text-brass-300" data-i18n data-fr="Fini le carburant" data-en="No more fuel" data-ar="وداعاً للوقود">Fini le carburant</p>
            <p class="mt-2 text-sm text-lune-soft" data-i18n
              data-fr="Le pompage solaire tourne au soleil : plus de gasoil à acheter ni à transporter, plus de groupe à entretenir. Une pompe silencieuse, sans facture de carburant."
              data-en="Solar pumping runs on sunlight: no more diesel to buy or haul, no generator to service. A quiet pump, with no fuel bill."
              data-ar="يعمل الضخّ الشمسي بالطاقة الشمسية: لا مازوط للشراء أو النقل، ولا مولّد للصيانة. مضخة صامتة، بلا فاتورة وقود.">Le pompage solaire tourne au soleil : plus de gasoil à acheter ni à transporter, plus de groupe à entretenir. Une pompe silencieuse, sans facture de carburant.</p>
          </div>
        </section>
      )}

      {/* ════════════════════════════════════════════════════════════════════
          WJ126 · VARIANTE AUTOCONSOMMATION (industriel + commercial) — tuiles
          autoconso/couverture/économies/payback + injection 82-21 (si calculée,
          mention ANRE) + mini-cashflow 10 ans (même modèle linéaire que le PDF).
          ════════════════════════════════════════════════════════════════════ */}
      {isAutoconso && auto && (
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="mode-autoconso">
          <p class="tech-label rule-brass text-brass-300" data-i18n
            data-fr={isCommercial ? 'Votre autoconsommation' : 'Votre autoconsommation industrielle'}
            data-en={isCommercial ? 'Your self-consumption' : 'Your industrial self-consumption'}
            data-ar={isCommercial ? 'استهلاككم الذاتي' : 'استهلاككم الذاتي الصناعي'}>{isCommercial ? 'Votre autoconsommation' : 'Votre autoconsommation industrielle'}</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {auto.taux_autoconso !== null ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Taux d'autoconsommation" data-en="Self-consumption rate" data-ar="نسبة الاستهلاك الذاتي">Taux d'autoconsommation</p>
                <p class="fig fig-md lum mt-2" dir="ltr">{formatNumber(auto.taux_autoconso)} %</p>
              </div>
            ) : null}
            {auto.taux_couverture !== null ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Taux de couverture" data-en="Coverage rate" data-ar="نسبة التغطية">Taux de couverture</p>
                <p class="fig fig-md mt-2 text-lune" dir="ltr">{formatNumber(auto.taux_couverture)} %</p>
              </div>
            ) : null}
            {auto.economies_annuelles !== null ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Économies estimées / an" data-en="Estimated savings / year" data-ar="التوفير المقدّر / سنة">Économies estimées / an</p>
                <p class="fig fig-md lum mt-2" dir="ltr">{formatMAD(auto.economies_annuelles)}</p>
              </div>
            ) : null}
            {auto.payback !== null ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Rentabilisé en" data-en="Paid back in" data-ar="يُسترد خلال">Rentabilisé en</p>
                <p class="fig fig-md mt-2 text-lune" dir="ltr">{formatNumber(auto.payback, 1)} <span class="text-base text-lune-soft" data-i18n data-fr="ans" data-en="years" data-ar="سنة">ans</span></p>
              </div>
            ) : null}
          </div>
          {(auto.taux_autoconso === null && auto.taux_couverture === null && auto.economies_annuelles === null && auto.payback === null) ? (
            <p class="mt-4 text-sm text-lune-faint" data-i18n
              data-fr="Les indicateurs détaillés de votre étude sont confirmés avec votre conseiller."
              data-en="The detailed indicators of your study are confirmed with your advisor."
              data-ar="تُؤكَّد المؤشرات التفصيلية لدراستكم مع مستشاركم.">Les indicateurs détaillés de votre étude sont confirmés avec votre conseiller.</p>
          ) : null}

          {/* Injection 82-21 — UNIQUEMENT si réellement calculée. Mention ANRE
              obligatoire : l'autoconsommation reste prioritaire, l'injection du
              surplus dépend de la convention en vigueur (jamais promise). */}
          {autoHasInjection && auto.injection_kwh_an !== null && (
            <div class="cine-card mt-5 rounded-xl p-5">
              <p class="tech-label text-brass-300" data-i18n data-fr="Injection du surplus (loi 82-21)" data-en="Surplus injection (law 82-21)" data-ar="حقن الفائض (القانون 82-21)">Injection du surplus (loi 82-21)</p>
              <p class="mt-2 text-sm text-lune-soft" data-i18n
                data-fr={`≈ ${formatNumber(auto.injection_kwh_an)} kWh/an de surplus injectables${auto.injection_dh_an !== null ? `, soit ≈ ${formatMAD(auto.injection_dh_an)}/an` : ''}.`}
                data-en={`≈ ${formatNumber(auto.injection_kwh_an)} kWh/year of injectable surplus${auto.injection_dh_an !== null ? `, i.e. ≈ ${formatMAD(auto.injection_dh_an)}/year` : ''}.`}
                data-ar={`≈ ${formatNumber(auto.injection_kwh_an)} kWh/سنة من الفائض القابل للحقن${auto.injection_dh_an !== null ? `، أي ≈ ${formatMAD(auto.injection_dh_an)}/سنة` : ''}.`}>≈ {formatNumber(auto.injection_kwh_an)} kWh/an de surplus injectables{auto.injection_dh_an !== null ? <>, soit ≈ {formatMAD(auto.injection_dh_an)}/an</> : null}.</p>
              <p class="mt-1 text-xs text-lune-faint" data-i18n
                data-fr="Tarif ANRE valable 03/2026–02/2027, plafond en révision. Sous réserve de la convention d'injection ANRE/ONEE en vigueur — l'autoconsommation reste prioritaire (loi 82-21). Aucune revente n'est garantie."
                data-en="ANRE tariff valid 03/2026–02/2027, cap under revision. Subject to the applicable ANRE/ONEE injection agreement — self-consumption remains the priority (law 82-21). No resale is guaranteed."
                data-ar="تعريفة ANRE سارية 03/2026–02/2027، السقف قيد المراجعة. رهْن اتفاقية الحقن السارية لدى ANRE/ONEE — يبقى الاستهلاك الذاتي أولوية (القانون 82-21). لا يُضمن أي إعادة بيع.">Tarif ANRE valable 03/2026–02/2027, plafond en révision. Sous réserve de la convention d'injection ANRE/ONEE en vigueur — l'autoconsommation reste prioritaire (loi 82-21). Aucune revente n'est garantie.</p>
            </div>
          )}

          {/* Mini-cashflow 10 ans : investissement remboursé puis bénéfice net
              cumulé. Azur = encore en déficit, laiton = bénéfice. Même hypothèse
              tarif constant que le PDF (aucune dérive inventée). */}
          {autoCashflow && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6">
              <p class="tech-label text-lune-faint" data-i18n data-fr="Votre trésorerie sur 10 ans" data-en="Your cash flow over 10 years" data-ar="خزينتكم على مدى 10 سنوات">Votre trésorerie sur 10 ans</p>
              <div class="mt-4 flex items-end gap-1.5" dir="ltr" role="img"
                aria-label="Trésorerie nette cumulée sur 10 ans">
                {autoCashflow.map((p) => (
                  <div class="flex flex-1 flex-col items-center gap-1">
                    <span class="w-full rounded-t" style={`height:${Math.max(3, Math.round((Math.abs(p.cumulative) / cashMaxAbs) * 60))}px; background: ${p.cumulative >= 0 ? 'var(--color-brass-400, #e8b54a)' : 'var(--color-azur-300, #7fb4e8)'}`}></span>
                    <span class="text-[10px] text-lune-faint" dir="ltr">{p.year}</span>
                  </div>
                ))}
              </div>
              <p class="mt-3 text-xs text-lune-faint" data-i18n
                data-fr={`Trésorerie nette cumulée, année après année${cashBreakEven !== null ? ` — au point mort dès l'année ${cashBreakEven}` : ''}. Azur : investissement pas encore remboursé ; laiton : bénéfice net. Estimation à tarif constant (même hypothèse que votre devis PDF).`}
                data-en={`Cumulative net cash flow, year after year${cashBreakEven !== null ? ` — breaks even by year ${cashBreakEven}` : ''}. Blue: investment not yet repaid; brass: net profit. Estimate at constant tariff (same assumption as your PDF quote).`}
                data-ar={`الخزينة الصافية التراكمية سنة بعد سنة${cashBreakEven !== null ? ` — تبلغ نقطة التعادل ابتداءً من السنة ${cashBreakEven}` : ''}. الأزرق: الاستثمار لم يُسترد بعد؛ الذهبي: ربح صافٍ. تقدير بتعريفة ثابتة (نفس افتراض عرض PDF).`}>Trésorerie nette cumulée, année après année{cashBreakEven !== null ? <> — au point mort dès l'année {cashBreakEven}</> : null}. Azur : investissement pas encore remboursé ; laiton : bénéfice net. Estimation à tarif constant (même hypothèse que votre devis PDF).</p>
            </div>
          )}

          {/* Industriel uniquement : tranches horaires + décarbonation/CBAM/ISO
              (qualitatif, aucun chiffre inventé). */}
          {installMode === 'industriel' && (
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-brass-300" data-i18n data-fr="Écrêter vos tranches horaires" data-en="Shave your time-of-use peaks" data-ar="تقليص فترات الذروة">Écrêter vos tranches horaires</p>
                <p class="mt-2 text-sm text-lune-soft" data-i18n
                  data-fr="Le solaire produit en pleine journée, aux heures où le tarif industriel est le plus cher : vous écrêtez vos pointes et lissez votre puissance souscrite."
                  data-en="Solar produces in the middle of the day, when industrial tariffs peak: you shave your peaks and smooth your subscribed power."
                  data-ar="تنتج الطاقة الشمسية في وضح النهار، حين يكون التعريف الصناعي في ذروته: تقلّصون ذرواتكم وتُنعّمون القدرة المكتتبة.">Le solaire produit en pleine journée, aux heures où le tarif industriel est le plus cher : vous écrêtez vos pointes et lissez votre puissance souscrite.</p>
              </div>
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-brass-300" data-i18n data-fr="Décarbonation, CBAM et ISO" data-en="Decarbonation, CBAM and ISO" data-ar="إزالة الكربون، CBAM و ISO">Décarbonation, CBAM et ISO</p>
                <p class="mt-2 text-sm text-lune-soft" data-i18n
                  data-fr="Chaque kWh solaire autoconsommé retire du CO₂ de votre bilan — un atout pour vos clients européens (mécanisme d'ajustement carbone aux frontières, CBAM) et vos certifications ISO 14001/50001."
                  data-en="Every self-consumed solar kWh removes CO₂ from your footprint — an asset for your European customers (Carbon Border Adjustment Mechanism, CBAM) and your ISO 14001/50001 certifications."
                  data-ar="كل كيلوواط ساعة شمسي مستهلك ذاتياً يزيل CO₂ من حصيلتكم — ميزة لعملائكم الأوروبيين (آلية تعديل الكربون على الحدود، CBAM) ولشهادات ISO 14001/50001.">Chaque kWh solaire autoconsommé retire du CO₂ de votre bilan — un atout pour vos clients européens (mécanisme d'ajustement carbone aux frontières, CBAM) et vos certifications ISO 14001/50001.</p>
              </div>
            </div>
          )}
        </section>
      )}

      {/* ════════════════════════════════════════════════════════════════════
          WJ126 · BLOC CATÉGORIE COMMERCIALE — archétype par secteur (hôtel,
          restaurant/froid, école, bureau…), miroir QUALITATIF du backend
          (categories.py). Commercial uniquement ; `autre` en repli honnête.
          ════════════════════════════════════════════════════════════════════ */}
      {isCommercial && comArchetype && (
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="mode-commercial-cat">
          <p class="tech-label rule-brass text-brass-300" data-i18n data-fr="Votre secteur" data-en="Your sector" data-ar="قطاعكم">Votre secteur</p>
          <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6">
            <p class="text-2xl" aria-hidden="true">{comArchetype.icon}</p>
            <p class="fig mt-2 text-xl text-lune" data-i18n
              data-fr={comArchetype.labelFr} data-en={comArchetype.labelEn} data-ar={comArchetype.labelAr}>{comArchetype.labelFr}</p>
            <p class="mt-2 text-sm text-lune-soft" data-i18n
              data-fr={comArchetype.accrocheFr} data-en={comArchetype.accrocheEn} data-ar={comArchetype.accrocheAr}>{comArchetype.accrocheFr}</p>
          </div>
        </section>
      )}

      <!-- ── PV80 · CHAPITRE 4 — VOTRE PRODUCTION (UN SEUL GRAPHIQUE) ────────
           Trois blocs graphiques se disputaient la même histoire : les barres
           mensuelles (« Production estimée »), la courbe journalière (« Votre
           journée solaire ») et, pour un devis à deux options, un TROISIÈME
           graphe batterie de ~1 600 px. Ils fusionnent ici en UN bloc : un
           sélecteur année ↔ journée, les onglets de profil Standard/Été/
           Ramadan, et la batterie en CALQUE de la vue journée — jamais un
           second dessin à côté. Les calques ci-dessous sont EXACTEMENT les
           mêmes SVG pré-rendus serveur qu'avant (aucun chiffre ne change) ;
           seule leur mise en scène change. Quelle couche est visible est
           décidé par productionLayers() — la MÊME fonction pure ici (premier
           rendu) et dans le script client (au clic). -->
      {showProduction && (
        <section id="production" class="mx-auto max-w-4xl px-5 pt-14 sm:px-8" data-production-config={productionConfig}>
          <p class="tech-label rule-brass text-brass-300" data-i18n
            data-fr="Votre production" data-en="Your production" data-ar="إنتاجكم">Votre production</p>
          <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6">
            {/* Sélecteur d'échelle — masqué quand une seule vue est rendue.
                Fondateur 2026-08-15 : la JOURNÉE d'abord (onglet ET défaut —
                availableViews la classe en tête), l'année en second.
                Ce commentaire vit AU-DESSUS de l'expression : un commentaire JSX
                placé en PREMIER ENFANT d'un `&& (` casse le build Astro
                (« Expected ")" but found … ») — il l'a réellement cassé ici. */}
            {prodLayers.showViewTabs && (
              <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Échelle du graphique">
                <button type="button" id="prod-view-journee" data-prod-view-btn="journee" aria-pressed={prodLayers.monthly ? 'false' : 'true'}
                  class="btn-pill px-3 py-1 text-xs"
                  style={prodLayers.monthly ? undefined : 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)'}
                  data-i18n data-fr="Sur une journée" data-en="Over a day" data-ar="خلال يوم">Sur une journée</button>
                <button type="button" id="prod-view-annee" data-prod-view-btn="annee" aria-pressed={prodLayers.monthly ? 'true' : 'false'}
                  class="btn-pill px-3 py-1 text-xs"
                  style={prodLayers.monthly ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : undefined}
                  data-i18n data-fr="Sur l’année" data-en="Over the year" data-ar="على مدار السنة">Sur l’année</button>
              </div>
            )}

            {/* ── CJ2b (fondateur, 21/08/2026) · « AVEC BATTERIE » REVIENT, EN
                   TÊTE DE BLOC — « n'oublie pas le bouton avec batterie qui a
                   mystérieusement disparu, remets-le à une meilleure place, et
                   peut-être plus grand, pour que le client ne le rate jamais ».
                   Il vivait tout en bas, sous un simple `border-t`, en case à
                   cocher NUE — hors du langage de bouton des autres puces
                   (vue année/journée juste au-dessus, saison, occupation,
                   Standard/Été/Ramadan) et hors du champ de vision d'un
                   visiteur qui scrolle vite. Il migre ici, JUSTE SOUS le
                   sélecteur de vue, dans le MÊME `.btn-pill` que ses voisins
                   (remplissage laiton à l'état actif) mais DÉLIBÉRÉMENT plus
                   grand qu'eux (`px-5 py-2.5` contre `px-3 py-1` ailleurs) :
                   c'est la seule puce qui change le PRIX affiché plus bas.
                   Honnêteté (règle fondateur #4) : ce bloc entier ne rend RIEN
                   quand l'option n'est pas VENDABLE à ce devis
                   (`productionAvailability.battery`, gated sur
                   `courbes_journalieres.options` — jamais un bouton posé sur
                   du vide). L'id `prod-battery-toggle` et la machine à états
                   (`setBatteryLayer`, showBatteryToggle/batteryLocked) ne
                   bougent pas — seuls l'élément (bouton plutôt que case) et sa
                   place changent ; voir le script de fin de page. */}
            {productionAvailability.battery && (
              <div data-prod-battery-control class="mb-4 flex flex-wrap items-center gap-3" role="group" aria-label="Option batterie" hidden={!prodLayers.showBatteryToggle}>
                {/* CJ1 — la commande suit les options que le DEVIS porte
                    vraiment (`courbes_journalieres.options`). Deux options
                    (['sans','avec']) ⇒ le bouton ci-dessous. UNE seule
                    option « avec » ⇒ il n'existe pas de variante sans stockage
                    à ce devis : on montre le calque et on l'ÉTIQUETTE, sans
                    offrir un bouton qui ne correspondrait à aucun prix. (Le cas
                    ['sans'] ne passe même pas ici : `battery` est faux.) */}
                {prodLayers.batteryLocked ? (
                  <p class="flex items-center gap-2.5 text-sm text-lune" aria-describedby="prod-battery-hint">
                    <span class="inline-block h-2 w-2 rounded-full" style="background: var(--color-brass-400)" aria-hidden="true"></span>
                    <span data-i18n
                      data-fr="Avec batterie — l’option retenue à votre devis"
                      data-en="With a battery — the option quoted for you"
                      data-ar="مع بطارية — الخيار المعتمد في عرضكم">Avec batterie — l’option retenue à votre devis</span>
                  </p>
                ) : (
                  <button type="button" id="prod-battery-toggle"
                    aria-pressed={prodLayers.battery ? 'true' : 'false'} aria-describedby="prod-battery-hint"
                    class="btn-pill px-5 py-2.5 text-sm font-semibold sm:text-base"
                    style={prodLayers.battery ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : undefined}
                    data-i18n data-fr="Avec batterie" data-en="With a battery" data-ar="مع بطارية">Avec batterie</button>
                )}
                <p id="prod-battery-hint" class="text-xs text-lune-faint" data-i18n
                  data-fr="Rejoue la même journée avec une batterie : ce qui est consommé en direct, ce qui est stocké, ce qui reste au réseau."
                  data-en="Replays the same day with a battery: what is used directly, what is stored, what still comes from the grid."
                  data-ar="يعيد عرض اليوم نفسه مع بطارية: ما يُستهلك مباشرة، وما يُخزَّن، وما يبقى من الشبكة.">
                  Rejoue la même journée avec une batterie : ce qui est consommé en direct, ce qui est stocké, ce qui reste au réseau.
                </p>
              </div>
            )}

            {/* ── CALQUE ANNÉE : 12 barres mensuelles (inchangé). ─────────── */}
            {showChart && (
              <div data-prod-layer="monthly" hidden={!prodLayers.monthly}>
              <!-- WJ80 — trois variantes langue pré-rendues (FR visible par
                   défaut) : le script de bascule de langue affiche la bonne au
                   lieu de réimporter la chaîne de rendu SVG côté client. -->
              <div class="chart-svg" data-chart-lang="fr" set:html={chartSvgFr}></div>
              <div class="chart-svg" data-chart-lang="en" hidden set:html={chartSvgEn}></div>
              <div class="chart-svg" data-chart-lang="ar" hidden set:html={chartSvgAr}></div>
              <!-- WJ80 — tap-to-reveal : le `<title>` SVG (survol souris) est
                   invisible au tactile — l'essentiel du trafic de cette page.
                   Un tap/clic sur une barre affiche ici son mois + sa valeur ;
                   câblé par le script de fin de page (délégation d'événement,
                   aucune dépendance au SVG choisi). -->
              <p id="chart-tap-caption" class="mt-2 min-h-[1.25rem] text-sm text-brass-300" aria-live="polite"></p>
              <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
                <span class="inline-flex items-center gap-2 text-lune-soft">
                  <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--color-brass-400)" aria-hidden="true"></span>
                  <span data-i18n data-fr="Production solaire estimée" data-en="Estimated solar production" data-ar="الإنتاج الشمسي المقدّر">Production solaire estimée</span>
                </span>
                {chartHasConso && (
                  <span class="inline-flex items-center gap-2 text-lune-soft">
                    <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--color-azur-300, #7fb4e8)" aria-hidden="true"></span>
                    <span data-i18n data-fr="Votre consommation" data-en="Your consumption" data-ar="استهلاككم">Votre consommation</span>
                  </span>
                )}
                <span class="text-lune-faint" data-i18n data-fr="kWh par mois" data-en="kWh per month" data-ar="كيلوواط ساعة شهرياً">kWh par mois</span>
              </div>
              {/* PV80 — la phrase « Sur l’année, votre installation produit
                  environ X kWh… Économie estimée Y/an » disait EXACTEMENT ce que
                  les deux chiffres posés sous le graphe disent maintenant : il ne
                  reste ici que la lecture du dessin lui-même. */}
              {chartHasConso && (
                <p class="v2-body mt-4 text-sm text-lune-soft" data-i18n
                  data-fr="Plus la production (laiton) couvre votre consommation (azur), plus vous économisez."
