                  const x = (i: number) => pad + (i / (d.prodKw.length - 1)) * (w - 2 * pad);
                  const y = (v: number) => pad + (1 - v / max) * (h - 2 * pad);
                  const lineOf = (arr: number[]) => `M${arr.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' L')}`;
                  const prodLine = lineOf(d.prodKw);
