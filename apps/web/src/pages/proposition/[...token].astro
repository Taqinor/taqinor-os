                  {/* Phrase SOURCE servie par le backend : affichée TELLE QUELLE
                      (jamais réécrite, jamais retraduite — voir lib/proposition.ts). */}
                  {ecoMensuelles.note && (
                    <p class="mt-1 text-xs text-lune-faint">{ecoMensuelles.note}</p>
                  )}
                </div>
              )}
              </div>
            )}

            {/* ── CALQUE JOURNÉE : la cloche solaire vs la conso (inchangé), avec
                   ses onglets Standard/Été/Ramadan. ───────────────────── */}
            {dailyCurve.svg && (
              <div data-prod-layer="daily" data-curve-config={curveConfig} hidden={!prodLayers.daily}>
              <!-- WJ80 — mêmes trois variantes langue pré-rendues que le graphe
