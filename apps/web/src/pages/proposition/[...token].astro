                data-en="Move the slider: see what one or more batteries would change — more solar kept at home, less grid in the evening, and hours of backup during an outage."
                data-ar="حرّك المؤشر: شاهد ما ستغيّره بطارية واحدة أو أكثر — طاقة شمسية أكثر تبقى في منزلك، وشبكة أقل في المساء، وساعات استقلالية عند انقطاع التيار.">
                Déplacez le curseur : voyez ce qu’une ou plusieurs batteries changeraient — plus de solaire gardé chez vous, moins de réseau le soir, et des heures d’autonomie en cas de coupure.
              </p>

              <!-- ORDRE FONDATEUR (24/08/2026, soir) — curseur 0..N unités,
                   N = plafond RÉEL (storageSweep) quand servi, sinon 3
                   (comportement historique). -->
              <div class="mt-5">
                <div class="flex items-center justify-between text-sm">
                  <label for="battery-sim-slider" class="text-lune-soft" data-i18n data-fr="Nombre de batteries" data-en="Number of batteries" data-ar="عدد البطاريات">Nombre de batteries</label>
                  <span class="font-semibold text-brass-300" dir="ltr"><span id="battery-sim-units">{batterySimInitialN}</span> × <span id="battery-sim-cap">{formatNumber(batteryUnitCapacityKwh, 0)}</span> kWh</span>
                </div>
                <input type="range" id="battery-sim-slider" min="0" max={BATTERY_SIM_MAX_UNITS} step="1" value={batterySimInitialN} class="mt-2 w-full accent-brass-400" aria-describedby="battery-sim-assumptions" />
                <div class="mt-1 flex justify-between text-xs text-lune-faint" aria-hidden="true">
                  {Array.from({ length: BATTERY_SIM_MAX_UNITS + 1 }, (_, n) => (
                    <span>{n}</span>
                  ))}
                </div>
              </div>

              <!-- 3 chiffres live : autoconsommation %, autosuffisance %, heures de secours -->
              <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-2xl font-bold text-brass-300" id="battery-sim-selfconso" dir="ltr">{formatPercent(batteryInitial.selfConsumptionPct, 0)}</p>
                  <p class="text-xs text-lune-soft" data-i18n data-fr="Autoconsommation" data-en="Self-consumption" data-ar="الاستهلاك الذاتي">Autoconsommation</p>
                  <p class="text-[11px] text-lune-faint" data-i18n data-fr="du solaire produit, gardé chez vous" data-en="of the solar you produce, kept at home" data-ar="من الطاقة الشمسية المنتَجة، تبقى في منزلك">du solaire produit, gardé chez vous</p>
                </div>
                <div>
                  <p class="text-2xl font-bold text-brass-300" id="battery-sim-selfsuff" dir="ltr">{formatPercent(batteryInitial.selfSufficiencyPct, 0)}</p>
                  <p class="text-xs text-lune-soft" data-i18n data-fr="Autosuffisance" data-en="Self-sufficiency" data-ar="الاكتفاء الذاتي">Autosuffisance</p>
                  <p class="text-[11px] text-lune-faint" data-i18n data-fr="de votre consommation couverte par le solaire" data-en="of your consumption covered by solar" data-ar="من استهلاككم مغطى بالطاقة الشمسية">de votre consommation couverte par le solaire</p>
                </div>
                <div>
                  <p class="text-2xl font-bold text-brass-300" dir="ltr"><span id="battery-sim-backup">{formatNumber(batteryInitial.backupHours, 0)}</span> h</p>
                  <p class="text-xs text-lune-soft" data-i18n data-fr="Heures de secours" data-en="Backup hours" data-ar="ساعات الطوارئ">Heures de secours</p>
                  <p class="text-[11px] text-lune-faint" data-i18n data-fr="frigo + éclairage + box, batterie pleine" data-en="fridge + lighting + router, full battery" data-ar="ثلاجة + إنارة + راوتر، بطارية ممتلئة">frigo + éclairage + box, batterie pleine</p>
                </div>
              </div>

              <!-- Aire empilée style SolarEdge : direct / batterie / réseau, sur 24 h -->
              <div class="mt-6">
                <div class="battery-split-wrap" id="battery-sim-chart" set:html={batterySplitSvgInitial}></div>
                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-xs">
                  <span class="inline-flex items-center gap-2 text-lune-soft">
                    <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--color-brass-400)" aria-hidden="true"></span>
                    <span data-i18n data-fr="Solaire direct" data-en="Direct solar" data-ar="شمسي مباشر">Solaire direct</span>
                  </span>
                  <span class="inline-flex items-center gap-2 text-lune-soft">
                    <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--color-azur-300, #7fb4e8)" aria-hidden="true"></span>
                    <span data-i18n data-fr="Batterie" data-en="Battery" data-ar="بطارية">Batterie</span>
                  </span>
                  <span class="inline-flex items-center gap-2 text-lune-soft">
                    <span class="inline-block h-3 w-3 rounded-sm" style="background: var(--color-lune-faint)" aria-hidden="true"></span>
                    <span data-i18n data-fr="Réseau" data-en="Grid" data-ar="الشبكة">Réseau</span>
                  </span>
                </div>
                <p class="mt-3 text-sm text-lune-soft">
                  <span data-i18n data-fr="Sur une journée type :" data-en="On a typical day:" data-ar="في يوم نموذجي:">Sur une journée type :</span>
                  <span class="font-semibold text-brass-300" dir="ltr"><span id="battery-sim-direct">{formatNumber(batteryInitial.directKwh, 1)}</span> kWh</span> <span data-i18n data-fr="en direct" data-en="direct" data-ar="مباشرة">en direct</span>,
                  <span class="font-semibold" style="color: var(--color-azur-300, #7fb4e8)" dir="ltr"><span id="battery-sim-battery">{formatNumber(batteryInitial.fromBatteryKwh, 1)}</span> kWh</span> <span data-i18n data-fr="via batterie" data-en="via battery" data-ar="عبر البطارية">via batterie</span>,
                  <span class="font-semibold text-lune-faint" dir="ltr"><span id="battery-sim-grid">{formatNumber(batteryInitial.fromGridKwh, 1)}</span> kWh</span> <span data-i18n data-fr="du réseau" data-en="from the grid" data-ar="من الشبكة">du réseau</span>.
                </p>
              </div>

              <!-- Prix : réel du devis quand N correspond à l'offre, sinon le prix
                   RÉEL du palier de stockage à ce N (balayage), sinon « sur étude ». -->
              <p class="mt-4 text-sm">
                <span class="text-lune-soft" data-i18n data-fr="Prix de cette configuration :" data-en="Price for this configuration:" data-ar="سعر هذا التكوين:">Prix de cette configuration :</span>
                <span class="ms-1 font-semibold text-brass-300" id="battery-sim-price" dir="ltr">{batteryInitialPrice ?? 'Sur étude'}</span>
              </p>

              <!-- ORDRE FONDATEUR (24/08/2026) — LA PÉRIODE DE RETOUR DU PALIER.
                   Le chiffre est celui du MOTEUR (`balayage_stockage.paliers[].
                   payback_annees` = coût TTC du palier ÷ économie annuelle du
                   palier, calculé dans `dimensionnement._palier_rendu`) : cette
                   page ne fait que le CHOISIR et l'habiller — aucune
                   arithmétique en JS. Quand le curseur s'écarte de la
                   configuration du devis, les DEUX chiffres servis sont montrés
                   (« X ans → Y ans »). Palier sans payback servi ⇒ ligne
                   masquée (omission, jamais une valeur approchée). -->
              <p id="battery-sim-payback" class="mt-2 text-sm" hidden={batteryInitialPayback == null}>
                <span class="text-lune-soft" data-i18n
                  data-fr="Retour sur investissement :" data-en="Payback period:" data-ar="مدة استرداد الاستثمار:">Retour sur investissement :</span>
                <span class="ms-1 font-semibold text-brass-300" id="battery-sim-payback-value" dir="ltr">{batteryInitialPayback != null ? `${formatNumber(batteryInitialPayback, 1)} ans` : ''}</span>
              </p>

              <!-- ORDRE FONDATEUR (24/08/2026) — CHARGE INCOMPLÈTE d'un palier
                   ACCEPTÉ (à distinguer du palier REFUSÉ ci-dessous) : le
                   moteur retient ce palier mais sa batterie n'est remplie qu'à
                   `remplissage_moyen_pct` en moyenne. Le pourcentage est celui
                   du palier, servi tel quel ; ≥ 100 % ⇒ aucun message (la
                   batterie se remplit chaque jour — même règle de libellé que
                   le bloc « régime batterie »). -->
              <p id="battery-sim-fill" class="mt-3 rounded-lg border border-azur-300/30 bg-azur-300/10 px-3 py-2 text-xs text-lune-soft" hidden={batteryInitialFillPct == null}>
                <span data-i18n
                  data-fr="La batterie supplémentaire ne se remplira pas à 100 %"
                  data-en="The extra battery will not be filled to 100%"
                  data-ar="لن تمتلئ البطارية الإضافية بنسبة 100٪">La batterie supplémentaire ne se remplira pas à 100 %</span
                ><span dir="ltr"> (<span data-fill-pct-num>{batteryInitialFillPct != null ? formatPercent(batteryInitialFillPct, 0) : ''}</span></span
                ><span data-i18n data-fr=" en moyenne)" data-en=" on average)" data-ar=" في المتوسط)"> en moyenne)</span
                ><span data-i18n data-fr=" — la production solaire ne suffit pas." data-en=" — the solar production is not enough." data-ar=" — الإنتاج الشمسي غير كافٍ."> — la production solaire ne suffit pas.</span>
              </p>

              <!-- ORDRE FONDATEUR (24/08/2026, soir) — message de sur-stockage : ne
                   s'affiche QUE quand storageRefuse est servi ET que N sélectionné
                   l'atteint (le moteur a refusé ce palier car la batterie ne se
                   rechargerait plus chaque jour). Le pourcentage inséré est RÉEL
                   (remplissage du pire mois, servi par le backend) — jamais une
                   nouvelle donnée calculée côté client. -->
              <p id="battery-sim-overstorage" class="mt-3 rounded-lg border border-brass-400/30 bg-brass-400/10 px-3 py-2 text-xs text-lune-soft" hidden={!batteryInitialOverStorage}>
                <span data-i18n
                  data-fr="Au-delà de cette quantité, votre toit ne remplirait plus la batterie tous les jours"
                  data-en="Beyond this quantity, your roof would no longer fill the battery every day"
                  data-ar="بعد هذه الكمية، لن يملأ سطحكم البطارية كل يوم">Au-delà de cette quantité, votre toit ne remplirait plus la batterie tous les jours</span
                ><span data-overstorage-pct dir="ltr" hidden={batteryInitialOverStorage?.remplissagePireMoisPct == null}> (<span data-overstorage-pct-num>{batteryInitialOverStorage?.remplissagePireMoisPct != null ? formatPercent(batteryInitialOverStorage.remplissagePireMoisPct, 0) : ''}</span><span data-i18n data-fr=" le mois le plus faible" data-en=" in the weakest month" data-ar=" في أضعف شهر"> le mois le plus faible</span>)</span
                ><span data-i18n data-fr=" — une capacité plus petite se rentabilise mieux." data-en=" — a smaller capacity pays back faster." data-ar=" — سعة أصغر تكون أكثر ربحية."> — une capacité plus petite se rentabilise mieux.</span>
              </p>

              <!-- Hypothèses (DoD / rendement) + libellé honnête « jamais mesuré ». -->
              <p id="battery-sim-assumptions" class="mt-4 text-xs text-lune-faint" data-i18n
                data-fr="Hypothèses : batterie lithium LFP, décharge 90 %, rendement aller-retour ≈ 92 %. Profil type au Maroc ajusté à votre facture — jamais un chiffre mesuré. Le prix batterie affiché est celui de votre devis ; toute autre configuration est chiffrée sur étude."
                data-en="Assumptions: LFP lithium battery, 90% depth of discharge, round-trip efficiency ≈ 92%. Typical Moroccan profile adjusted to your bill — never a measured figure. The battery price shown is from your quote; any other configuration is priced on request."
                data-ar="الافتراضات: بطارية ليثيوم LFP، عمق تفريغ 90٪، كفاءة ذهاب وإياب ≈ 92٪. نمط نموذجي في المغرب معدّل حسب فاتورتكم — وليس رقماً مقيساً. السعر المعروض للبطارية هو سعر عرضكم؛ أي تكوين آخر يُسعّر حسب الدراسة.">
                Hypothèses : batterie lithium LFP, décharge 90 %, rendement aller-retour ≈ 92 %. Profil type au Maroc ajusté à votre facture — jamais un chiffre mesuré. Le prix batterie affiché est celui de votre devis ; toute autre configuration est chiffrée sur étude.
              </p>
              </div>
            )}

            {/* ── CJ1 · PUCES DE SAISON — Hiver / Mi-saison / Été. Elles ne
                   changent PAS d'unité de récit : elles sélectionnent la saison
                   RÉELLEMENT servie par le backend (forme PVGIS + kWh/jour de
                   cette saison-là). Une seule saison servie ⇒ aucune puce (il
                   n'y aurait rien à comparer). Rangée SŒUR du contrôle de
                   variante ci-dessous : le placement des calques et leur gating
                   (productionLayers) ne bougent pas d'un pixel. */}
            {curveSeasons.length > 1 && (
              <div data-prod-season-control class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Saison affichée" hidden={!prodLayers.showSeasonTabs}>
                {curveSeasons.map((season) => (
                  <button type="button" data-curve-season-btn={season}
                    aria-pressed={season === prodLayers.season ? 'true' : 'false'}
                    class="btn-pill px-3 py-1 text-xs"
                    style={season === prodLayers.season ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : undefined}
                    data-i18n data-fr={SEASON_LABELS[season].fr} data-en={SEASON_LABELS[season].en} data-ar={SEASON_LABELS[season].ar}>{SEASON_LABELS[season].fr}</button>
                ))}
              </div>
            )}

            {/* ── CJ1 · PUCES D'OCCUPATION — « qui est à la maison en journée ? ».
                   Le fondateur voulait trois choix : la silhouette moyenne unique
                   ne ressemblait ni à un retraité présent toute la journée ni à
                   un couple d'actifs absent de 8h à 18h. Résidentiel uniquement
                   (une usine n'a pas d'occupation de logement) ; le défaut vient
                   du drapeau serveur `occupation`. */}
            {curveOccupancies.length > 1 && (
              <div data-prod-occupancy-control class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Occupation du logement en journée" hidden={!prodLayers.showOccupancyTabs}>
                {curveOccupancies.map((occ) => (
                  <button type="button" data-curve-occupancy-btn={occ}
                    aria-pressed={occ === prodLayers.occupancy ? 'true' : 'false'}
                    class="btn-pill px-3 py-1 text-xs"
                    style={occ === prodLayers.occupancy ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : undefined}
                    data-i18n data-fr={OCCUPANCY_LABELS[occ].fr} data-en={OCCUPANCY_LABELS[occ].en} data-ar={OCCUPANCY_LABELS[occ].ar}>{OCCUPANCY_LABELS[occ].fr}</button>
                ))}
              </div>
            )}

            {/* ── Onglets de profil Standard/Été/Ramadan : COMMUNS aux deux
                   calques de la vue journée (courbe nue ET batterie) — le
                   fondateur a demandé que « Avec batterie » se COMBINE avec
                   ces onglets plutôt que les faire disparaître. Ils vivaient
                   avant DANS le calque « daily » (donc masqués dès que la
                   batterie remplaçait ce calque) ; ils sont désormais un
                   frère commun, visible tant que productionLayers dit
                   showVariantTabs — quel que soit le dessin affiché. Changer
                   d'onglet pendant que la batterie est active recalcule la
                   silhouette de consommation ET rejoue le simulateur (script
                   client), jamais un chiffre inventé ici.
                   CJ1 — Été et Ramadan sont des MODIFICATEURS ORTHOGONAUX : ils
                   se posent sur la silhouette d'occupation choisie ci-dessus,
                   ils ne la remplacent pas. */}
            {curveVariantToggle && (
              <div data-prod-variant-control class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Variante du profil de consommation" hidden={!prodLayers.showVariantTabs}>
                <button type="button" id="curve-variant-normal" data-curve-variant-btn="normal" aria-pressed="true"
                  class="btn-pill px-3 py-1 text-xs" style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)"
                  data-i18n data-fr="Standard" data-en="Standard" data-ar="عادي">Standard</button>
                <button type="button" id="curve-variant-ete" data-curve-variant-btn="ete" aria-pressed="false"
                  class="btn-pill px-3 py-1 text-xs"
                  data-i18n data-fr="Été (clim)" data-en="Summer (AC)" data-ar="الصيف (تكييف)">Été (clim)</button>
                {/* CJ1 — la puce Ramadan DIT la fenêtre qu'elle a calculée
                    (coucher de soleil NOAA au point du chantier, à la date du
                    mois de Ramadan) : sans cette heure affichée, une modulation
                    invisible resterait invérifiable par le client. Hors table
                    des plages (après 2033) ⇒ aucune heure, seulement « Ramadan ». */}
                <button type="button" id="curve-variant-ramadan" data-curve-variant-btn="ramadan" aria-pressed="false"
                  class="btn-pill px-3 py-1 text-xs"
                  data-i18n
                  data-fr={ramadanIftarFr ? `Ramadan · iftar ≈ ${ramadanIftarFr}` : 'Ramadan'}
                  data-en={ramadanIftarEn ? `Ramadan · iftar ≈ ${ramadanIftarEn}` : 'Ramadan'}
                  data-ar={ramadanIftarAr ? `رمضان · الإفطار ≈ ${ramadanIftarAr}` : 'رمضان'}>{
                    ramadanIftarFr ? `Ramadan · iftar ≈ ${ramadanIftarFr}` : 'Ramadan'
                  }</button>
              </div>
            )}

          </div>

          {/* ── Le résumé annuel EN CHIFFRES, sous le graphe (jamais un chiffre
                 recalculé : exactement ceux du devis backend). ───────────── */}
          {(prodKwh || ecoHero) && (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {prodKwh ? (
                <div class="cine-card rounded-xl p-5">
                  <p class="tech-label text-lune-faint" data-i18n data-fr="Production estimée / an" data-en="Estimated production / year" data-ar="الإنتاج المقدّر / سنة">Production estimée / an</p>
                  <p class="fig fig-md mt-2 text-lune" dir="ltr">{formatNumber(prodKwh)} <span class="text-lg text-lune-soft">kWh</span></p>
                </div>
              ) : null}
              {ecoHero ? (
                <div class="cine-card rounded-xl p-5">
                  <p class="tech-label text-lune-faint" data-i18n data-fr="Économie estimée / an" data-en="Estimated savings / year" data-ar="التوفير المقدّر / سنة">Économie estimée / an</p>
                  <p class="fig fig-md lum mt-2" dir="ltr">{formatMAD(ecoHero)}</p>
                </div>
              ) : null}
            </div>
          )}
        </section>
      )}


      <!-- ── PV80 · CHAPITRE 5 — VOS ÉCONOMIES (ex-WJ9 « argent dans le temps ») ────────────────────────────────
           Le bloc porte un id historique TROMPEUR : « financing-headline » ne
           parle pas de financement, il porte le cumul d'ÉCONOMIES sur 25 ans.
           On lui donne son nom lisible — ancre #economies — mais l'id observé
           reste `financing-headline` sur la SECTION elle-même : la télémétrie
           WJ55 (`proposal_scrolled_financing`) l'observe avec un seuil de 40 %
           de SURFACE ; déplacer cet id sur une ancre invisible de 0 px aurait
           silencieusement changé le moment où l'événement part. L'alias
           lisible est donc l'ancre vide ci-dessous — zéro pixel, zéro risque. -->
      <!-- WJ126 — jamais en pompage (agricole) : la valeur d'un pompage solaire est
           l'eau livrée + le carburant évité, pas un cumul de facture réseau ; le
           cadrage « économies cumulées 25 ans » est résidentiel/autoconso. -->
      {!isAgricole && headline && (headline.cumulative || headline.annual || paybackHero || prodKwh || synthese || showCouvertureDonut) && (
        <section id="financing-headline" class="mx-auto max-w-4xl px-5 pt-12 sm:px-8 sm:pt-16">
          <span id="economies" aria-hidden="true"></span>
          <p class="tech-label rule-brass mb-5 text-brass-300" data-i18n
            data-fr="Vos économies" data-en="Your savings" data-ar="توفيراتكم">Vos économies</p>
          {/* Accroche « coût de ne rien faire » : le cumul phare. */}
          {headline.cumulative ? (
            <div class="cine-card cine-in rounded-2xl p-6 shadow-premium sm:p-8" style="border-color: rgb(232 181 74 / 0.35)">
              <p class="tech-label text-lune-faint" data-i18n
                data-fr={`Sans le solaire, votre facture continue de courir. Avec, vous économisez sur ${headline.years} ans`}
                data-en={`Without solar, your bill keeps climbing. With it, you save over ${headline.years} years`}
                data-ar={`بدون الطاقة الشمسية، تستمر فاتورتكم في الارتفاع. معها، توفرون على مدى ${headline.years} سنة`}>
                Sans le solaire, votre facture continue de courir. Avec, vous économisez sur {headline.years} ans
              </p>
              <p class="fig lum mt-3 text-4xl sm:text-5xl" dir="ltr">{formatMAD(headline.cumulative)}</p>
              <!-- WJ75 — la mention « tarif constant » s'affiche désormais TOUJOURS,
                   que le taux vienne du backend ou du repli local : les deux
                   partagent la MÊME hypothèse 0 % d'escalade tarifaire (voir
                   savingsHeadline/BILL_INFLATION_RATE dans lib/proposition.ts —
                   vérifié dans le moteur PDF vendorisé, generate_devis_premium.py,
                   qui construit sa propre courbe cumulative par une simple
                   multiplication linéaire, sans terme de dérive). Avant ce
                   correctif, la mention disparaissait quand le taux venait du
                   backend, laissant croire — à tort — que ce chiffre intégrait
                   une hausse tarifaire que ni lui ni le PDF ne modélisent. -->
              <p class="v2-body mt-2 text-sm text-lune-soft" data-i18n
                data-fr={`Économies cumulées estimées sur ${headline.years} ans${headline.monthly ? ` — soit ≈ ${formatMAD(headline.monthly)}/mois qui restent dans votre poche` : ''}. Estimation à tarif constant (loi 82-21, autoconsommation) — même hypothèse que votre devis PDF.`}
                data-en={`Estimated cumulative savings over ${headline.years} years${headline.monthly ? ` — that's ≈ ${formatMAD(headline.monthly)}/month staying in your pocket` : ''}. Estimate at constant tariff (law 82-21, self-consumption) — the same assumption as your PDF quote.`}
                data-ar={`توفير تراكمي مقدّر على مدى ${headline.years} سنة${headline.monthly ? ` — أي ما يعادل ≈ ${formatMAD(headline.monthly)}/شهر تبقى في جيبكم` : ''}. تقدير بتعريفة ثابتة (القانون 82-21، الاستهلاك الذاتي) — نفس الافتراض المعتمد في عرض PDF الخاص بكم.`}>
                Économies cumulées estimées sur {headline.years} ans
                {headline.monthly ? <> — soit <span class="text-brass-300">≈ {formatMAD(headline.monthly)}/mois</span> qui restent dans votre poche</> : null}.
                <span class="text-lune-faint"> Estimation à tarif constant (loi 82-21, autoconsommation) — même hypothèse que votre devis PDF.</span>
              </p>
            </div>
          ) : null}

          {/* ── PVCOV (fondateur 2026-08-18) · CE QUE LE SOLAIRE CHANGE POUR VOUS
                 Le « −N % », la facture avant/après et la couverture solaire
                 sont les valeurs SERVIES par le backend, produites par la MÊME
                 fonction moteur que la page 1 du devis PDF
                 (`residential/renderer.synthese_economies`). La page ne connaît
                 ni tarif, ni barème, ni taux d'autoconsommation : elle affiche
                 ce qu'on lui sert, la seule arithmétique étant « ÷ 12 » pour la
                 lecture mensuelle et la longueur d'arc de l'anneau. PDF et lien
                 client ne peuvent donc plus diverger — et corriger le moteur
                 corrige cette page sans y toucher. Champs `null` (devis hors
                 forme résidentielle) ⇒ le bloc entier disparaît. */}
          {(synthese || showCouvertureDonut) && (
            <div class="cine-card mt-4 rounded-xl p-5 sm:p-6">
              <p class="tech-label text-lune-faint" data-i18n
                data-fr="Ce que le solaire change pour vous" data-en="What solar changes for you" data-ar="ما تغيّره الطاقة الشمسية بالنسبة لكم">Ce que le solaire change pour vous</p>
              <div class="mt-4 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8">
                <div>
                  {synthese && (
                    <>
                      <p class="fig lum text-4xl sm:text-5xl" dir="ltr">−{formatNumber(synthese.pctCut, 0)} %</p>
                      <p class="mt-1 text-sm text-lune-soft" data-i18n
                        data-fr="sur votre facture d’électricité" data-en="on your electricity bill" data-ar="على فاتورة الكهرباء">
                        sur votre facture d’électricité
                      </p>
                      <p class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span class="fig fig-md text-lune-faint line-through" dir="ltr">{formatMAD(synthese.mensuelAvant)}</span>
                        <span class="text-lune-faint" aria-hidden="true">→</span>
                        <span class="fig fig-md text-lune" dir="ltr">{formatMAD(synthese.mensuelApres)}</span>
                        <span class="text-sm text-lune-soft" data-i18n data-fr="par mois" data-en="per month" data-ar="شهرياً">par mois</span>
                      </p>
                      <p class="mt-1 text-sm text-lune-soft" data-i18n
                        data-fr={`Soit ${formatMAD(synthese.annuelAvant)} par an aujourd’hui, contre ${formatMAD(synthese.annuelApres)} par an avec votre installation.`}
                        data-en={`That is ${formatMAD(synthese.annuelAvant)} per year today, against ${formatMAD(synthese.annuelApres)} per year with your installation.`}
                        data-ar={`أي ${formatMAD(synthese.annuelAvant)} سنوياً اليوم، مقابل ${formatMAD(synthese.annuelApres)} سنوياً مع تركيبكم.`}>
                        Soit {formatMAD(synthese.annuelAvant)} par an aujourd’hui, contre {formatMAD(synthese.annuelApres)} par an avec votre installation.
                      </p>
                    </>
                  )}
                </div>

                {/* Donut « ÉNERGIE SOLAIRE » — l'anneau ne fait que DESSINER le
                    pourcentage servi (longueur d'arc = circonférence × pct/100).
                    Le moteur borne déjà 1..100 : 100 % ne s'affiche que si le
                    backend dit production ≥ consommation. */}
                {showCouvertureDonut && couverture && (
                  <div class="flex items-center gap-4 sm:flex-col sm:gap-2">
                    <svg viewBox="0 0 100 100" width="112" height="112" class="shrink-0" role="img"
                      aria-label={`Couverture solaire : ${formatNumber(couverture.pct, 0)} %`}>
                      <circle cx="50" cy="50" r={DONUT_R} fill="none" stroke="var(--color-lune-faint)" stroke-opacity="0.22" stroke-width="10" />
                      <circle cx="50" cy="50" r={DONUT_R} fill="none" stroke="var(--color-brass-400)" stroke-width="10"
                        stroke-linecap="round" stroke-dasharray={`${donutDash.toFixed(2)} ${(donutCirc - donutDash).toFixed(2)}`}
                        transform="rotate(-90 50 50)" />
                      <text x="50" y="50" text-anchor="middle" dominant-baseline="central"
                        font-size="24" font-weight="700" fill="var(--color-lune)" dir="ltr">{formatNumber(couverture.pct, 0)}%</text>
                    </svg>
                    <div class="sm:text-center">
                      <p class="tech-label text-brass-300" data-i18n
                        data-fr="Énergie solaire" data-en="Solar energy" data-ar="الطاقة الشمسية">Énergie solaire</p>
                      <p class="mt-1 text-sm text-lune-soft" data-i18n
                        data-fr="de vos besoins couverts" data-en="of your needs covered" data-ar="من احتياجاتكم مغطاة">
                        de vos besoins couverts
                      </p>
                      {couverture.estimated && (
                        <p class="mt-1 text-xs text-lune-faint" data-i18n
                          data-fr="(estimation — consommation déduite de votre facture)"
                          data-en="(estimate — consumption derived from your bill)"
                          data-ar="(تقدير — استهلاك مستنتج من فاتورتكم)">
                          (estimation — consommation déduite de votre facture)
                        </p>
                      )}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ── L-PROP CJ2b-bis (lot 4, 24/08) — falaise tarifaire / régime
                 batterie / décomposition de l'estimation de consommation.
                 CHAQUE sous-bloc est indépendant : une clé absente masque
                 SEULEMENT ce sous-bloc, jamais toute la carte (sauf quand les
                 trois manquent — `showFalaiseBlock` est alors faux et la carte
                 entière disparaît). Résidentiel uniquement, et jamais un
                 chiffre recalculé côté web : tout vient tel quel du payload. */}
          {showFalaiseBlock && (
            <div id="tarif-falaise" class="cine-card mt-4 rounded-xl p-5 sm:p-6">
              {tarifStory && (
                <div>
                  <p class="tech-label text-lune-faint" data-i18n
                    data-fr="Un dimensionnement pensé pour votre facture" data-en="A sizing built around your bill" data-ar="تصميم يراعي فاتورتكم">
                    Un dimensionnement pensé pour votre facture
                  </p>
                  <p class="v2-body mt-2 text-sm text-lune-soft" data-i18n
                    data-fr={
                      tarifStory.trancheActuelleLibelle && tarifStory.trancheViseeLibelle
                        ? `Votre consommation atterrit aujourd’hui dans la tranche « ${tarifStory.trancheActuelleLibelle} » ; ce dimensionnement vise franchement la tranche « ${tarifStory.trancheViseeLibelle} » — la marche tarifaire suivante, plus économique.`
                        : 'Ce dimensionnement vise franchement le palier tarifaire suivant, plus économique.'
                    }
                    data-en={
                      tarifStory.trancheActuelleLibelle && tarifStory.trancheViseeLibelle
                        ? `Your consumption sits today in the “${tarifStory.trancheActuelleLibelle}” bracket; this sizing plainly targets the “${tarifStory.trancheViseeLibelle}” bracket — the next, cheaper tariff step.`
                        : 'This sizing plainly targets the next, cheaper tariff step.'
                    }
                    data-ar={
                      tarifStory.trancheActuelleLibelle && tarifStory.trancheViseeLibelle
                        ? `يقع استهلاككم اليوم ضمن شريحة « ${tarifStory.trancheActuelleLibelle} » ؛ يستهدف هذا التصميم بوضوح شريحة « ${tarifStory.trancheViseeLibelle} » — الدرجة التعريفية التالية الأوفر.`
                        : 'يستهدف هذا التصميم بوضوح الدرجة التعريفية التالية الأوفر.'
                    }>
                    {tarifStory.trancheActuelleLibelle && tarifStory.trancheViseeLibelle
                      ? `Votre consommation atterrit aujourd’hui dans la tranche « ${tarifStory.trancheActuelleLibelle} » ; ce dimensionnement vise franchement la tranche « ${tarifStory.trancheViseeLibelle} » — la marche tarifaire suivante, plus économique.`
                      : 'Ce dimensionnement vise franchement le palier tarifaire suivant, plus économique.'}
                  </p>
                  {tarifStory.residuelKwhMois !== null && (
                    <p class="mt-2 text-sm text-lune-soft" data-i18n
                      data-fr={`Résiduel importé du réseau : environ ${formatNumber(tarifStory.residuelKwhMois, 0)} kWh/mois.`}
                      data-en={`Residual grid import: about ${formatNumber(tarifStory.residuelKwhMois, 0)} kWh/month.`}
                      data-ar={`المستورد المتبقي من الشبكة: نحو ${formatNumber(tarifStory.residuelKwhMois, 0)} كيلوواط.س/شهرياً.`}>
                      Résiduel importé du réseau : environ {formatNumber(tarifStory.residuelKwhMois, 0)} kWh/mois.
                    </p>
                  )}
                </div>
              )}

              {battRegime && (
                <div class={tarifStory ? 'mt-5 border-t border-white/10 pt-4' : ''}>
                  <div class="flex flex-wrap gap-x-8 gap-y-3">
                    {battRegime.remplissageMoyenPct !== null && (
                      <div>
                        <p class="tech-label text-lune-faint" data-i18n data-fr="Remplissage batterie moyen" data-en="Average battery fill" data-ar="متوسط امتلاء البطارية">Remplissage batterie moyen</p>
                        {battRegime.remplissageMoyenPct >= 100 ? (
                          <p class="fig fig-md mt-1 text-lune" data-i18n data-fr="La batterie se remplit chaque jour" data-en="The battery fills up every day" data-ar="تمتلئ البطارية كل يوم">La batterie se remplit chaque jour</p>
                        ) : (
                          <p class="fig fig-md mt-1 text-lune" dir="ltr">{formatNumber(battRegime.remplissageMoyenPct, 0)} %</p>
                        )}
                      </div>
                    )}
                    {battRegime.couvertureGlitchPct !== null && (
                      <div>
                        <p class="tech-label text-lune-faint" data-i18n data-fr="Couverture des pointes" data-en="Peak coverage" data-ar="تغطية الذروات">Couverture des pointes</p>
                        <p class="fig fig-md mt-1 text-lune" dir="ltr">{formatNumber(battRegime.couvertureGlitchPct, 0)} %</p>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {estimConso && (
                <div class={tarifStory || battRegime ? 'mt-5 border-t border-white/10 pt-4' : ''}>
                  <p class="tech-label text-lune-faint" data-i18n data-fr="Estimation de consommation, mois par mois" data-en="Estimated consumption, month by month" data-ar="تقدير الاستهلاك شهراً بشهر">Estimation de consommation, mois par mois</p>
                  <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-xs" dir="ltr">
                      <thead>
                        <tr class="text-lune-faint">
                          <th class="pe-3 text-start font-normal">&nbsp;</th>
                          {MONTHS_SHORT.fr.map((m) => <th class="px-1 text-end font-normal">{m}</th>)}
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td class="pe-3 text-lune-soft" data-i18n data-fr="Base" data-en="Base" data-ar="أساسي">Base</td>
                          {estimConso.base.map((v) => <td class="px-1 text-end text-lune-soft">{formatNumber(v, 0)}</td>)}
                        </tr>
                        {estimConso.ajouts.map((a) => (
                          <tr>
                            <td class="pe-3 text-lune-soft">{a.libelle}</td>
                            {a.valeurs.map((v) => <td class="px-1 text-end text-lune-soft">{formatNumber(v, 0)}</td>)}
                          </tr>
                        ))}
                        <tr class="border-t border-white/10 font-semibold">
                          <td class="pe-3 text-lune" data-i18n data-fr="Total" data-en="Total" data-ar="المجموع">Total</td>
