                data-en={`${nearestInstall.ville} — ${formatNumber(nearestInstall.kwcNum, 2)} kWc — real Taqinor installation`}
                data-ar={`${nearestInstall.ville} — ${nearestInstall.kwc} — تركيب حقيقي لتاقينور`}>
                {nearestInstall.ville} — {nearestInstall.kwc} — installation réelle Taqinor
              </span>
            </p>
            {/* (fondateur 2026-08-17) production RÉELLEMENT MESURÉE de ce
                chantier — rendue seulement quand la réalisation est appariée à
                une centrale supervisée (cumul depuis la mise en service, jamais
                converti en production annuelle). Aucune estimation par chantier
                n'existe dans les données (WB1) : rien ne vient la compléter. */}
            {nearestMeasured && (
              <p class="mt-2 text-sm text-lune-soft" data-i18n
                data-fr={nearestMeasuredFr} data-en={nearestMeasuredEn} data-ar={nearestMeasuredAr}>
                {nearestMeasuredFr}
              </p>
            )}
            <a href={nearestInstallHref} class="mt-2 inline-block text-sm text-brass-300 underline-offset-2 hover:underline" data-i18n
              data-fr="Voir cette réalisation" data-en="See this project" data-ar="مشاهدة هذا الإنجاز">
              Voir cette réalisation
            </a>
          </div>
        )}

        <!-- WJ35 — bandeau certifications/garanties (texte, sobre — aucun logo
             fabriqué). (fondateur 2026-08-17) chaque badge rendu ici est un LIEN
             vers une page réelle : garanties panneaux/onduleur → /garanties,
             IEC → la fiche du panneau réellement devisé, « Loi 82-21 » →
             /loi-82-21 (page dédiée FR/EN/AR + guide, dans la nav). Le badge
             IEC est le seul OMIS quand sa cible manque — aucun panneau apparié,
             donc aucun lien honnête. Ne retirez pas 'loi8221' de `certKeys` :
             sa page existe et le fondateur a demandé ce badge. -->
        <div class="mt-4">
          <CertLogoRow keys={certKeys} hrefs={certHrefs} />
