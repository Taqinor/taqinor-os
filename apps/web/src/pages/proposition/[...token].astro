      <!-- ── CTA COLLANT (WJ34 — safe-area-inset-bottom pour les iPhone à encoche
           / barre de geste : le CTA ne se cache jamais derrière la zone système).
           WJ82 — sur une offre morte (refusée/expirée/retirée), le CTA de
           signature devient « Demander un devis actualisé » pointant vers le
           contact WhatsApp plutôt que vers le formulaire supprimé.
           WJ56 — QA tablette/desktop (présentation en direct par un commercial) :
           les grilles passent en multi-colonnes dès `sm:` (640px, couvre tablette
           portrait/paysage ET desktop) ; le CTA collant reste `fixed inset-x-0`
           pleine largeur avec conteneur interne `max-w-4xl` centré à toutes les
           largeurs ; la bascule de langue (`fixed top-3 right-3`) et le bouton
           « Partager » (flux normal, jamais `fixed`) ne se chevauchent à aucune
           largeur testée. Aucune régression de layout introduite par WJ53/WJ56. -->
      <div
        id="sticky-cta"
        class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-nuit-800/95 px-4 pt-3 backdrop-blur supports-[backdrop-filter]:bg-nuit-800/80"
        style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
      >
        <div class="mx-auto flex max-w-4xl items-center justify-between gap-4">
          <div class="min-w-0">
            {heroHasRealPrice ? (
              <p class="truncate text-sm text-lune-soft">
                <span data-i18n data-fr={twoOptions ? 'À partir de ' : ''} data-en={twoOptions ? 'From ' : ''} data-ar={twoOptions ? 'ابتداءً من ' : ''}>{twoOptions ? 'À partir de ' : ''}</span>
                <span class="lum fig text-lg" dir="ltr">{formatMAD(optionTtc(data!, reco ?? 'sans_batterie'))}</span>
                <span class="text-lune-faint" data-i18n data-fr=" TTC" data-en=" incl. tax" data-ar=" شامل الضريبة"> TTC</span>
              </p>
            ) : (
              <!-- WJ83 — garde-fou zéro-total : jamais "0 MAD TTC" comme un
                   vrai prix. -->
              <p class="truncate text-sm text-lune-soft" data-i18n
                data-fr="Prix communiqué par votre conseiller"
                data-en="Price provided by your advisor"
                data-ar="السعر يُبلَّغ من طرف مستشاركم">
                Prix communiqué par votre conseiller
              </p>
            )}
            {validity.fromBackend && validity.label && !validity.expired && (
              <p class="truncate text-xs text-lune-faint">
                <span data-i18n data-fr="Valable jusqu’au" data-en="Valid until" data-ar="صالح حتى">Valable jusqu’au</span> <span dir="ltr">{validity.label}</span>
              </p>
            )}
          </div>
          {isOfferDead(offerState) ? (
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill shrink-0 whitespace-nowrap"
              style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)"
              data-i18n data-fr="Demander un devis actualisé" data-en="Request an updated quote" data-ar="طلب عرض محدّث"
            >
              Demander un devis actualisé
            </a>
          ) : heroHasRealPrice ? (
            <a
              href="#signer"
              class="btn-pill shrink-0 whitespace-nowrap"
              style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)"
              data-i18n data-fr="Signer en ligne" data-en="Sign online" data-ar="التوقيع إلكترونياً"
            >
              Signer en ligne
            </a>
          ) : (
            <!-- WJ83 — sans prix réel, le CTA principal ne peut pas pointer vers
                 une signature à 0 MAD : on renvoie vers le conseiller (WhatsApp),
                 jamais vers un formulaire de signature sur un montant fabriqué. -->
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-pill shrink-0 whitespace-nowrap"
              style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)"
              data-i18n data-fr="Contacter mon conseiller" data-en="Contact my advisor" data-ar="التواصل مع مستشاري"
            >
              Contacter mon conseiller
            </a>
          )}
        </div>
      </div>
    </div>
  )}
</Layout>

<script>
  import {
    validateSign,
    buildAcceptBodyRich,
    signStampLabel,
    localizedStamp,
    isOtpRequiredDetail,
    isOtpIncorrectDetail,
    type OptionKey,
    type SignFormState,
    type PropLang as SignPropLang,
  } from '../../lib/proposition';
  // PV80 — la MÊME machine à états pure que celle qui a décidé du premier rendu
  // serveur du graphique fusionné : rejouée ici au clic, donc zéro divergence.
  import {
    type ProductionAvailability,
    type ProductionView,
    initialProductionState,
    productionLayers,
    setProductionView,
    setCurveVariant,
    setBatteryLayer,
    setSeason,
    setOccupancy,
  } from '../../lib/propositionPage';
  // CJ1 — re-rendu CLIENT de la courbe journalière au changement de saison ou
  // d'occupation. C'est la MÊME fonction pure que le rendu serveur, appelée avec
  // les MÊMES nombres servis (sérialisés dans `data-curve-config`) : aucune
  // seconde implémentation, aucun chiffre recalculé dans le navigateur.
  import { renderYearCurve, type ProposalCurveMode, type ProposalCurveVariant } from '../../lib/proposalCurve';
  import {
    OCCUPANCY_LABELS,
    equipmentLegendLabel,
    type EquipmentLayers,
    type OccupancyId,
    type SeasonId,
    type ServedProduction,
  } from '../../lib/dayProfiles';

  interface SignConfig {
    token: string;
    twoOptions: boolean;
    preselect: OptionKey | null;
    accepted: boolean;
    acceptedName: string;
    reference: string;
    /** WJ55 — présent uniquement quand le devis porte un téléphone client. */
    clientPhone?: string;
  }

  // ── WJ17/WJ43 · bascule de langue FR/EN/عربي — MÊME mécanisme dual-node que
  // WJ33 (mon-toit.astro), élargi en TRI-node par WJ43 : `el.textContent = v`
  // APLATIRAIT toute balise imbriquée (ex. <strong> dans un data-i18n) à chaque
  // aller-retour. On enveloppe donc chaque élément `[data-i18n]` d'un TRIPLET de
  // nœuds show/hide au premier passage (FR = markup ORIGINAL capturé une fois
  // via innerHTML, EN = texte simple depuis data-en, AR = texte simple depuis
  // data-ar), puis on masque/affiche le bon nœud — aucune balise n'est jamais
  // perdue, quel que soit le nombre de bascules. Un élément SANS `data-en`
  // (ne devrait pas arriver — chaque data-i18n doit porter les 3 langues) replie
  // simplement sur le markup FR en mode EN plutôt que de planter.
  type PropLang = 'fr' | 'en' | 'ar';
  let currentLang: PropLang = 'fr';
  // WJ119 — variante de la courbe journalière (été/Ramadan, toggle discret,
  // résidentiel/commercial uniquement) : croisée avec currentLang ci-dessous
  // (un bloc n'est visible que si lang ET variante correspondent toutes deux).
  type CurveVariantId = 'normal' | 'ete' | 'ramadan';
  let currentCurveVariant: CurveVariantId = 'normal';
  /** Filtre lang+variant partagé par applyLang() et le toggle été/Ramadan. */
  function applyCurveVisibility(): void {
    document.querySelectorAll<HTMLElement>('[data-curve-lang]').forEach((el) => {
      const variant = (el.dataset.curveVariant as CurveVariantId | undefined) ?? 'normal';
      el.hidden = el.dataset.curveLang !== currentLang || variant !== currentCurveVariant;
    });
  }
  const i18nTriples: Array<{ fr: HTMLElement; en: HTMLElement; ar: HTMLElement }> = [];
  /** Registre des labels à retraduire à chaque bascule (busy-state, non couverts par data-i18n). */
  const propI18nBusyLabels: Array<(lang: PropLang) => void> = [];
  function prepareI18n(): void {
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const arText = el.dataset.ar;
      if (typeof arText !== 'string') return;
      const enText = typeof el.dataset.en === 'string' ? el.dataset.en : el.innerHTML;
      const frSpan = document.createElement('span');
      frSpan.innerHTML = el.innerHTML;
      const enSpan = document.createElement('span');
      enSpan.textContent = enText;
      enSpan.hidden = true;
      const arSpan = document.createElement('span');
      arSpan.textContent = arText;
      arSpan.hidden = true;
      el.textContent = '';
      el.append(frSpan, enSpan, arSpan);
      i18nTriples.push({ fr: frSpan, en: enSpan, ar: arSpan });
    });
  }
  function applyLang(lang: PropLang): void {
    const isAr = lang === 'ar';
    const isEn = lang === 'en';
    currentLang = lang;
    i18nTriples.forEach(({ fr, en, ar }) => {
      fr.hidden = isAr || isEn;
      en.hidden = !isEn;
      ar.hidden = !isAr;
    });
    // RTL/langue au niveau DOCUMENT (pas seulement un bloc local) : un lecteur
    // d'écran ou le rendu natif du navigateur doivent voir la vraie langue.
    document.documentElement.lang = isAr ? 'ar' : isEn ? 'en' : 'fr';
    document.documentElement.dir = isAr ? 'rtl' : 'ltr';
    const propRoot = document.querySelector<HTMLElement>('.proposition');
    if (propRoot) {
      propRoot.dir = isAr ? 'rtl' : 'ltr';
      propRoot.style.lineHeight = isAr ? '1.75' : '';
    }
    const frBtn = document.getElementById('prop-lang-fr');
    const enBtn = document.getElementById('prop-lang-en');
    const arBtn = document.getElementById('prop-lang-ar');
    frBtn?.setAttribute('aria-pressed', String(!isAr && !isEn));
    enBtn?.setAttribute('aria-pressed', String(isEn));
    arBtn?.setAttribute('aria-pressed', String(isAr));
    for (const [btn, on] of [[frBtn, !isAr && !isEn], [enBtn, isEn], [arBtn, isAr]] as const) {
      if (!btn) continue;
      btn.className = on
        ? 'px-2.5 py-1 text-xs font-semibold text-azur-950 bg-brass-400 transition-colors'
        : 'px-2.5 py-1 text-xs font-semibold text-lune-soft transition-colors hover:text-white';
    }
    // Labels pilotés par un état transitoire (ex. « Signature… », « Génération
    // du PDF… ») ne passent pas par prepareI18n (ils sont réécrits en JS APRÈS
    // le premier rendu) : on les retraduit ici, à chaque bascule ET après
    // chaque changement d'état, via un petit registre partagé.
    propI18nBusyLabels.forEach((fn) => fn(currentLang));
    // WJ80 — bascule des TROIS variantes langue pré-rendues du graphe
    // production-vs-consommation et de la courbe journalière (chacune posée
    // dans le DOM au premier rendu serveur, voir data-chart-lang/data-curve-lang) :
    // même logique show/hide que les triplets data-i18n ci-dessus.
    document.querySelectorAll<HTMLElement>('[data-chart-lang]').forEach((el) => {
      el.hidden = el.dataset.chartLang !== currentLang;
    });
    // WJ119 — les blocs `[data-curve-lang]` portent AUSSI `data-curve-variant`
    // (été/Ramadan) : le filtre partagé applyCurveVisibility() gère les deux.
    applyCurveVisibility();
    // WJ87 — les attributs `placeholder` ne sont pas couverts par le mécanisme
    // data-i18n (qui ne touche que le contenu affiché) : ce petit registre
    // dédié retraduit les placeholders posés via data-placeholder-{fr,en,ar}
    // à chaque bascule de langue.
    document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach((el) => {
      const value = isAr ? el.dataset.placeholderAr : isEn ? el.dataset.placeholderEn : el.dataset.placeholderFr;
      if (typeof value === 'string') el.placeholder = value;
    });
    // WJ99 — même registre que les placeholders ci-dessus, mais pour
    // `aria-label` : cet attribut n'est PAS couvert par le mécanisme data-i18n
    // (qui ne touche que le contenu affiché des nœuds `data-i18n`) — sans ce
    // retraduction, un `aria-label` posé au premier rendu restait figé en
    // français même après bascule EN/AR (CertLogoRow.astro `data-aria-label-*`,
    // le canevas de signature `data-aria-label-*` ci-dessous).
    document.querySelectorAll<HTMLElement>('[data-aria-label-fr]').forEach((el) => {
      const value = isAr ? el.dataset.ariaLabelAr : isEn ? el.dataset.ariaLabelEn : el.dataset.ariaLabelFr;
      if (typeof value === 'string') el.setAttribute('aria-label', value);
    });
  }
  prepareI18n();
  document.getElementById('prop-lang-fr')?.addEventListener('click', () => applyLang('fr'));
  document.getElementById('prop-lang-en')?.addEventListener('click', () => applyLang('en'));
  document.getElementById('prop-lang-ar')?.addEventListener('click', () => applyLang('ar'));
  // WJ119 — toggle discret été/Ramadan de la courbe journalière (résidentiel/
  // commercial uniquement — absent du DOM sinon, la boucle ne trouve alors
  // aucun bouton et ne fait rien). Change UNIQUEMENT la silhouette affichée.
  function applyCurveVariant(variant: CurveVariantId): void {
    currentCurveVariant = variant;
    document.querySelectorAll<HTMLElement>('[data-curve-variant-btn]').forEach((btn) => {
      const on = btn.getAttribute('data-curve-variant-btn') === variant;
      btn.setAttribute('aria-pressed', String(on));
      btn.setAttribute(
        'style',
        on ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : '',
      );
    });
    applyCurveVisibility();
  }
  // PACT-battery (2026-08-15) — les clics sur les onglets Standard/Été/Ramadan
  // ne bougent plus `currentCurveVariant` directement : ils passent par la MÊME
  // machine à états que le sélecteur de vue et la case batterie (setCurveVariant,
  // lib/propositionPage), câblée juste en dessous dans setupProductionChart. Ça
  // corrige un double défaut : (1) l'onglet cliqué était oublié au prochain
  // `apply()` (le state ne changeait jamais, donc un futur clic sur la vue ou la
  // batterie ramenait « Standard ») et (2) le calque batterie ne réagissait pas
  // du tout au changement de profil — voir __propSetBatteryVariant plus bas.

  // ── PV80 — LE GRAPHIQUE FUSIONNÉ « Votre production » ──────────────────────
  // Le serveur a déjà posé le bon calque au premier rendu ; ce bloc rejoue
  // EXACTEMENT la même fonction pure (productionLayers, lib/propositionPage)
  // à chaque clic, donc aucune divergence serveur/client n'est possible. Rien
  // ici ne recalcule un chiffre : on ne fait qu'afficher/masquer des SVG déjà
  // rendus. Sans le bloc dans le DOM (aucune série backend), tout est no-op.
  (function setupProductionChart(): void {
    const section = document.getElementById('production');
    if (!section) return;
    let availability: ProductionAvailability;
    try {
      availability = JSON.parse(section.getAttribute('data-production-config') || '{}') as ProductionAvailability;
    } catch {
      return;
    }
    let state = initialProductionState(availability);
    // ORDRE FONDATEUR (24/08/2026) — dernier état CONNU du calque batterie, pour
    // ne redessiner la courbe qu'aux bascules réelles (le rendu serveur porte
    // déjà la couche quand le calque démarre actif).
    let lastBatteryLayer = productionLayers(state, availability).battery;

    // ── CJ1 — CONFIG DE RE-RENDU (saison / occupation) ─────────────────────
    // Tout ce que le serveur a servi, tel qu'il l'a servi. Absent (bloc backend
    // non fourni) ⇒ `null` ⇒ les puces n'existent pas dans le DOM et rien de ce
    // qui suit ne s'exécute : la page se comporte exactement comme avant.
    interface CurveConfig {
      prodKwh: number | null;
      mode: ProposalCurveMode;
      variants: ProposalCurveVariant[];
      ramadan: { imsakHour: number; iftarHour: number } | null;
      production: Partial<Record<SeasonId, ServedProduction>>;
      // CJ2b — `forme` (24 parts, résidentiel) suit désormais le niveau : même
      // objet que `dayProfiles.ServedConsumption`, `forme` optionnelle.
      consommation: Partial<Record<SeasonId, { kwhJour: number; forme?: number[] }>>;
      // L4 — couches d'équipement (script d'appel), `{}` = aucune active.
      equipements: EquipmentLayers;
    }
    const dailyLayer = section.querySelector<HTMLElement>('[data-prod-layer="daily"]');
    let curveCfg: CurveConfig | null = null;
    try {
      const rawCurve = dailyLayer?.getAttribute('data-curve-config') || '';
      curveCfg = rawCurve ? (JSON.parse(rawCurve) as CurveConfig) : null;
    } catch {
      curveCfg = null;
    }

    /** Phrase « d'où vient ce profil » — réécrite à chaque changement de puce
     *  ET à chaque bascule de langue (registre propI18nBusyLabels). Elle ne dit
     *  « calé sur vos factures » QUE si le niveau servi existe vraiment.
     *  L4 — quand une couche d'équipement (piscine/clim/ve) s'applique à la
     *  saison affichée, la phrase se termine SOBREMENT par « · profil ajusté :
     *  piscine, climatisation » ; aucune couche active ⇒ rien de neuf. */
    function renderProfileNote(): void {
      const el = document.getElementById('curve-profile-note');
      if (!el) return;
      const served = curveCfg?.production?.[state.season] ?? null;
      const consKwh = curveCfg?.consommation?.[state.season]?.kwhJour ?? null;
      const real = !!served && typeof consKwh === 'number' && consKwh > 0;
      const label = OCCUPANCY_LABELS[state.occupancy]?.[currentLang] ?? '';
      const isResidential = curveCfg?.mode === 'residentiel';
      const equipSuffix = equipmentLegendLabel(curveCfg?.equipements ?? null, state.season, currentLang);
      const withEquip = (base: string) => (equipSuffix ? `${base} · ${equipSuffix}` : base);
      if (!real) {
        el.textContent = withEquip(currentLang === 'en'
          ? 'Typical Moroccan profile, adjusted to your bill.'
          : currentLang === 'ar'
            ? 'نمط نموذجي في المغرب، معدّل حسب فاتورتكم.'
            : 'Profil type au Maroc, ajusté à votre facture.');
        return;
      }
      if (isResidential && label) {
        el.textContent = withEquip(currentLang === 'en'
          ? `Profile “${label}” calibrated on your bills.`
          : currentLang === 'ar'
            ? `نمط «${label}» معاير على فواتيركم.`
            : `Profil « ${label} » calé sur vos factures.`);
        return;
      }
      el.textContent = withEquip(currentLang === 'en'
        ? 'Typical Moroccan profile, calibrated on your bills.'
        : currentLang === 'ar'
          ? 'نمط نموذجي في المغرب، معاير على فواتيركم.'
          : 'Profil type au Maroc, calé sur vos factures.');
    }

    /** Redessine les SVG pré-rendus (3 langues × variantes) pour la saison et
     *  l'occupation courantes. Les conteneurs et leur visibilité ne bougent pas :
     *  seul le contenu du SVG change, donc les écouteurs tap-to-reveal posés sur
     *  `.daily-curve-wrap` survivent, et `applyCurveVisibility()` reste maître
     *  de qui est affiché. */
    function rerenderCurves(): void {
      if (!curveCfg || !dailyLayer) return;
      // ORDRE FONDATEUR (24/08/2026) — la couche batterie est dessinée sur CE
      // graphe quand le calque est actif. La série vient du simulateur (pont
      // `__propBatteryHourly`, moteur horaire unique) : ce script ne calcule
      // rien, il transmet. Calque inactif ou série absente ⇒ `null`, et la
      // courbe est exactement celle d'avant.
      // `productionLayers` (et non `state.battery`) : sur un devis « avec
      // batterie » verrouillé, le calque est actif sans que l'état porte le
      // drapeau.
      const batterieHoraireKwh = productionLayers(state, availability).battery
        ? ((window as unknown as { __propBatteryHourly?: () => number[] | null })
            .__propBatteryHourly?.() ?? null)
        : null;
      const served = {
        production: curveCfg.production?.[state.season] ?? null,
        consumptionKwhJour: curveCfg.consommation?.[state.season]?.kwhJour ?? null,
        season: state.season,
        // L4 — couches d'équipement (piscine/clim/ve), composées par renderYearCurve.
        equipements: curveCfg.equipements ?? null,
        batterieHoraireKwh,
      };
      dailyLayer.querySelectorAll<HTMLElement>('[data-curve-lang]').forEach((el) => {
        const lang = (el.dataset.curveLang as 'fr' | 'en' | 'ar' | undefined) ?? 'fr';
        const variant = (el.dataset.curveVariant as ProposalCurveVariant | undefined) ?? 'normal';
        el.innerHTML = renderYearCurve(
          curveCfg!.prodKwh,
          undefined,
          lang,
          {
            mode: curveCfg!.mode,
            variant,
            occupancy: state.occupancy,
            ramadan: curveCfg!.ramadan,
            // CJ2b — même règle qu'au premier rendu serveur : la forme SERVIE
            // pour la saison affichée l'emporte, résidentiel uniquement.
            servedShape: curveCfg!.mode === 'residentiel'
              ? (curveCfg!.consommation?.[state.season]?.forme ?? null)
              : null,
          },
          served,
        ).svg;
      });
      renderProfileNote();
    }
    // ORDRE FONDATEUR (24/08/2026) — pont exposé au simulateur batterie : à
    // chaque recalcul (curseur, variante, occupation), il redemande le dessin
    // de la courbe avec sa nouvelle série horaire.
    (window as unknown as { __propRerenderCurves?: () => void }).__propRerenderCurves =
      () => rerenderCurves();

    function apply(): void {
      const layers = productionLayers(state, availability);
      const setLayer = (key: string, on: boolean) => {
        section!.querySelectorAll<HTMLElement>(`[data-prod-layer="${key}"]`).forEach((el) => {
          el.hidden = !on;
        });
      };
      setLayer('monthly', layers.monthly);
      setLayer('daily', layers.daily);
      setLayer('battery', layers.battery);
      section!.querySelectorAll<HTMLElement>('[data-prod-view-btn]').forEach((btn) => {
        const on = btn.getAttribute('data-prod-view-btn') === (layers.monthly ? 'annee' : 'journee');
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute(
          'style',
          on ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : '',
        );
      });
      const control = section!.querySelector<HTMLElement>('[data-prod-battery-control]');
      if (control) control.hidden = !layers.showBatteryToggle;
      // ORDRE FONDATEUR (24/08/2026) — la légende « Couvert par la batterie »
      // suit exactement la couche dessinée sur la courbe.
      section!.querySelectorAll<HTMLElement>('[data-prod-battery-legend]').forEach((el) => {
        el.hidden = !layers.battery;
      });
      // CJ2b — le bouton « Avec batterie » suit désormais le MÊME langage de
      // puce que ses voisins (aria-pressed + remplissage laiton), plus une
      // case à cocher isolée. Absent du DOM (calque verrouillé ou batterie
      // indisponible) ⇒ no-op.
      const batteryBtn = document.getElementById('prod-battery-toggle');
      if (batteryBtn) {
        batteryBtn.setAttribute('aria-pressed', String(layers.battery));
        batteryBtn.setAttribute(
          'style',
          layers.battery ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : '',
        );
      }
      // PACT-battery — les onglets Standard/Été/Ramadan sont désormais un frère
      // commun aux deux calques (daily ET battery, cf. data-prod-variant-control) :
      // visibles tant que la vue journée les rend, quel que soit le dessin actif.
      const variantControl = section!.querySelector<HTMLElement>('[data-prod-variant-control]');
      if (variantControl) variantControl.hidden = !layers.showVariantTabs;
      // CJ1 — les deux nouvelles rangées de puces suivent la MÊME règle : elles
      // n'existent que sur la vue journée, et seulement s'il y a un choix réel.
      const seasonControl = section!.querySelector<HTMLElement>('[data-prod-season-control]');
      if (seasonControl) seasonControl.hidden = !layers.showSeasonTabs;
      const occupancyControl = section!.querySelector<HTMLElement>('[data-prod-occupancy-control]');
      if (occupancyControl) occupancyControl.hidden = !layers.showOccupancyTabs;
      const markPressed = (attr: string, active: string) => {
        section!.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((btn) => {
          const on = btn.getAttribute(attr) === active;
          btn.setAttribute('aria-pressed', String(on));
          btn.setAttribute(
            'style',
            on ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)' : '',
          );
        });
      };
      markPressed('data-curve-season-btn', layers.season);
      markPressed('data-curve-occupancy-btn', layers.occupancy);
      // La courbe journalière reste synchrone de l'onglet de profil actif.
      if (layers.variant !== currentCurveVariant) applyCurveVariant(layers.variant);
      // ORDRE FONDATEUR (24/08/2026) — activer/désactiver « Avec batterie »
      // ajoute/retire la COUCHE sur la courbe : elle est redessinée à chaque
      // bascule du calque (et à ce moment-là seulement).
      if (layers.battery !== lastBatteryLayer) {
        lastBatteryLayer = layers.battery;
        rerenderCurves();
      }
      // PACT-battery — le calque batterie REMPLACE la courbe nue mais doit
      // continuer à réagir à l'onglet de profil : on rejoue le simulateur (autre
      // île <script>, pont window comme __propApplyLang ci-dessous) avec la MÊME
      // variante, exactement comme au déplacement du curseur d'unités.
      if (layers.battery) {
        (window as unknown as { __propSetBatteryVariant?: (v: CurveVariantId, occ?: OccupancyId) => void })
          .__propSetBatteryVariant?.(layers.variant, layers.occupancy);
      }
    }

    section.querySelectorAll<HTMLElement>('[data-prod-view-btn]').forEach((btn) => {
      const view = btn.getAttribute('data-prod-view-btn') as ProductionView | null;
      if (!view) return;
      btn.addEventListener('click', () => {
        state = setProductionView(state, view, availability);
        apply();
      });
    });
    // PACT-battery — les onglets Standard/Été/Ramadan passent par la même
    // machine à états (setCurveVariant) que la vue et la case batterie : le
    // calque affiché (courbe nue OU batterie) suit toujours le même profil.
    section.querySelectorAll<HTMLElement>('[data-curve-variant-btn]').forEach((btn) => {
      const variant = btn.getAttribute('data-curve-variant-btn') as CurveVariantId | null;
      if (!variant) return;
      btn.addEventListener('click', () => {
        state = setCurveVariant(state, variant, availability);
        apply();
      });
    });
    // CJ1 — puces de saison : elles changent la SAISON SERVIE (forme PVGIS +
    // kWh/jour de cette saison), donc les SVG sont redessinés par la même
    // fonction pure que le serveur avant d'être ré-affichés.
    section.querySelectorAll<HTMLElement>('[data-curve-season-btn]').forEach((btn) => {
      const season = btn.getAttribute('data-curve-season-btn') as SeasonId | null;
      if (!season) return;
      btn.addEventListener('click', () => {
        const next = setSeason(state, season, availability);
        if (next === state) return;
        state = next;
        rerenderCurves();
        apply();
      });
    });
    // CJ1 — puces d'occupation : elles changent la SILHOUETTE de base, donc la
    // courbe nue ET (via le pont) le simulateur batterie.
    section.querySelectorAll<HTMLElement>('[data-curve-occupancy-btn]').forEach((btn) => {
      const occ = btn.getAttribute('data-curve-occupancy-btn') as OccupancyId | null;
      if (!occ) return;
      btn.addEventListener('click', () => {
        const next = setOccupancy(state, occ, availability);
        if (next === state) return;
        state = next;
        rerenderCurves();
        apply();
      });
    });
    // CJ2b — bouton (plus une case à cocher isolée) : pas de bascule native, on
    // inverse `state.battery` nous-mêmes et `apply()` reflète le résultat (le
    // même chemin `setBatteryLayer` qu'avant — machine à états inchangée).
    const batteryToggle = document.getElementById('prod-battery-toggle') as HTMLButtonElement | null;
    batteryToggle?.addEventListener('click', () => {
      state = setBatteryLayer(state, !state.battery, availability);
      apply();
    });
    // CJ1 — la phrase « d'où vient ce profil » se retraduit comme les autres
    // libellés pilotés par un état (elle est réécrite en JS, donc invisible au
    // mécanisme data-i18n).
    propI18nBusyLabels.push(() => renderProfileNote());
    apply();
  })();

  // ——— L-PCMP : le sélecteur « et si je vivais autrement ? » ———————————————
  // IL NE CALCULE RIEN. Les trois blocs de chiffres sont rendus par le serveur
  // (`profils_comparatifs`, moteur horaire + balayage de dimensionnement) et ce
  // script se contente de MONTRER celui que le visiteur choisit, de mettre en
  // avant la silhouette correspondante et d'accorder l'état `aria-pressed`.
  // Zéro arithmétique ici : c'est la garantie que le chiffre lu par le client
  // est celui du moteur (règle « zéro chiffre inventé »).
  (() => {
    const zone = document.querySelector<HTMLElement>('[data-occ-compare]');
    if (!zone) return;
    const boutons = Array.from(zone.querySelectorAll<HTMLElement>('[data-occ-btn]'));
    const panneaux = Array.from(zone.querySelectorAll<HTMLElement>('[data-occ-panel]'));
    const carte = zone.closest('#occ-silhouettes');
    const traits = Array.from(carte?.querySelectorAll<SVGElement>('[data-occ-path]') ?? []);
    const aires = Array.from(carte?.querySelectorAll<SVGElement>('[data-occ-area]') ?? []);
    // La couleur de chaque silhouette est LUE sur son propre trait SVG (source
    // unique : `OCC_CURVE_STYLE` côté serveur) — jamais recopiée en dur ici.
    const couleurs = new Map<string, string>();
    for (const trait of traits) {
      const id = trait.getAttribute('data-occ-path');
      if (id) couleurs.set(id, trait.getAttribute('stroke') || '');
    }
    const selectionner = (choix: string) => {
      for (const btn of boutons) {
        const id = btn.getAttribute('data-occ-btn');
        const actif = id === choix;
        btn.setAttribute('aria-pressed', actif ? 'true' : 'false');
        const teinte = (id && couleurs.get(id)) || '';
        btn.style.background = actif ? teinte : '';
        btn.style.color = actif ? '#fff' : '';
        btn.style.borderColor = actif ? teinte : '';
        const puce = btn.querySelector<HTMLElement>('span[aria-hidden="true"]');
        if (puce) puce.style.background = actif ? '#fff' : teinte;
      }
      for (const panneau of panneaux) {
        panneau.hidden = panneau.getAttribute('data-occ-panel') !== choix;
      }
      for (const trait of traits) {
        const actif = trait.getAttribute('data-occ-path') === choix;
        trait.setAttribute('stroke-width', actif ? '3' : '2');
        trait.setAttribute('opacity', actif ? '1' : '0.55');
      }
      for (const aire of aires) {
        aire.setAttribute('opacity', aire.getAttribute('data-occ-area') === choix ? '1' : '0');
      }
    };
    for (const btn of boutons) {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-occ-btn');
        if (id) selectionner(id);
      });
    }
  })();
  // Exposé aux AUTRES <script> de cette page (PDF affordance) — chaque bloc
  // <script> d'une île Astro est un module séparé, donc pas de portée
  // partagée native ; `window` est le pont volontairement minimal ici.
  (window as unknown as { __propApplyLang?: (l: PropLang) => void }).__propApplyLang = applyLang;
  (window as unknown as { __propCurrentLang?: () => PropLang }).__propCurrentLang = () => currentLang;
  (window as unknown as { __propRegisterBusyLabel?: (fn: (l: PropLang) => void) => void }).__propRegisterBusyLabel =
    (fn: (l: PropLang) => void) => propI18nBusyLabels.push(fn);

  // ——— WJ45 : bandeau hors-ligne (navigator.onLine + online/offline) ———
  // Une coupure réseau au moment de signer ne doit jamais ressembler à un
  // échec muet : le bandeau apparaît/disparaît en direct, indépendamment de
  // toute soumission. Exposé sur `window` pour que le formulaire de
  // signature (autre <script>/module plus bas) puisse re-vérifier l'état
  // au moment précis d'un échec fetch.
  const propOfflineBanner = document.getElementById('prop-offline-banner');
  function syncPropOfflineBanner(): void {
    if (propOfflineBanner) propOfflineBanner.hidden = navigator.onLine;
  }
  syncPropOfflineBanner();
  window.addEventListener('online', syncPropOfflineBanner);
  window.addEventListener('offline', syncPropOfflineBanner);
  (window as unknown as { __propSyncOfflineBanner?: () => void }).__propSyncOfflineBanner = syncPropOfflineBanner;

  const root = document.querySelector<HTMLElement>('.proposition');
  const raw = root?.dataset.signConfig;
  if (root && raw) {
    const cfg = JSON.parse(raw) as SignConfig;

    // ── WJ55 · Télémétrie de vue/engagement — proxy same-origin vers le fil
    // lead existant (voir lib/proposition.ts buildProposalTrackPayload pour le
    // garde-fou anti-pollution CRM : sans téléphone client, rien n'est posté).
    // Best-effort strict, `keepalive` pour survivre à une navigation immédiate.
    const sentTrackEvents = new Set<string>();
    function trackProposalEvent(event: 'proposal_first_view' | 'proposal_scrolled_financing'): void {
      if (sentTrackEvents.has(event)) return; // une fois par événement/session de page
      sentTrackEvents.add(event);
      fetch('/api/proposition-track', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          token: cfg.token,
          reference: cfg.reference,
          clientPhone: cfg.clientPhone ?? '',
          event,
        }),
      }).catch(() => {
        // Jamais bloquant : une panne réseau ne doit rien changer côté client.
      });
    }
    trackProposalEvent('proposal_first_view');
    // Défilement jusqu'au bloc financement (« Argent dans le temps » — WJ9,
    // id="financing-headline") : le moment où le client regarde vraiment les
    // chiffres. Observé une seule fois (IntersectionObserver déconnecté après
    // le premier passage). Absent quand le backend ne fournit aucun chiffre
    // d'économie (headline vide) — rien à observer alors.
    const financingSection = document.getElementById('financing-headline');
    if (financingSection && 'IntersectionObserver' in window) {
      const financingIo = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            financingIo.disconnect();
            trackProposalEvent('proposal_scrolled_financing');
          }
        },
        { threshold: 0.4 },
      );
      financingIo.observe(financingSection);
    }

    // ── WJ104 — DELTA d'instrumentation funnel : `proposal_viewed`/
    // `proposal_signed` via le MÊME beacon step-level que /devis/mon-toit
    // (WJ59 `pages/api/funnel-beacon.ts` → FUNNEL_WEBHOOK_URL, log-only sinon)
    // — jamais le fil lead (voir WJ109 ci-dessus pour la distinction), jamais
    // un second canal. Session token anonyme PAR ONGLET, même contrat privacy
    // que mon-toit.astro (lib/funnelBeacon.ts : 4 champs seulement, aucune PII).
    const PROPOSAL_FUNNEL_TOKEN_KEY = 'prop-funnel-token-v1';
    function getProposalFunnelToken(): string {
      try {
        let t = sessionStorage.getItem(PROPOSAL_FUNNEL_TOKEN_KEY);
        if (!t) {
          t = Math.random().toString(36).slice(2) + Date.now().toString(36);
          sessionStorage.setItem(PROPOSAL_FUNNEL_TOKEN_KEY, t);
        }
        return t;
      } catch {
        return Math.random().toString(36).slice(2);
      }
    }
    const proposalFunnelToken = getProposalFunnelToken();
    const proposalFunnelSent = new Set<string>();
    function sendProposalFunnelBeacon(action: 'viewed' | 'signed'): void {
      const key = `proposal:${action}`;
      if (proposalFunnelSent.has(key)) return;
      proposalFunnelSent.add(key);
      try {
        const payload = JSON.stringify({
          step: 'proposal',
          action,
          sessionToken: proposalFunnelToken,
          path: location.pathname,
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/funnel-beacon', new Blob([payload], { type: 'application/json' }));
        } else {
          void fetch('/api/funnel-beacon', { method: 'POST', headers: { 'content-type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
        }
      } catch {
        // Mesure best-effort seulement — ne doit jamais perturber le parcours.
      }
    }
    sendProposalFunnelBeacon('viewed');

    const form = document.getElementById('sign-form') as HTMLFormElement | null;
    const success = document.getElementById('sign-success');
    const successName = document.getElementById('sign-success-name');
    const successTime = document.getElementById('sign-success-time');
    // WJ78 — écho de l'artefact du client dans le bloc de succès.
    const successEchoImg = document.getElementById('sign-success-echo-img') as HTMLImageElement | null;
    const successEchoSeal = document.getElementById('sign-success-echo-seal');
    const stampEl = document.getElementById('sign-stamp');
    const errorEl = document.getElementById('sign-error');
    const submitBtn = document.getElementById('sign-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('sign-submit-label');
    const spinner = document.getElementById('sign-spinner');
    // ── WJ17/WJ43 — état « Signature… » n'est pas couvert par prepareI18n (il
    // écrase le libellé APRÈS le premier rendu) : on le pilote via un petit
    // état + le registre partagé, pour rester correct FR/EN/AR à chaque bascule.
    let submitBusy = false;
    const SUBMIT_LABEL = { fr: 'Signer en ligne', en: 'Sign online', ar: 'التوقيع إلكترونياً' } as const;
    const SUBMIT_LABEL_BUSY = { fr: 'Signature…', en: 'Signing…', ar: 'جارٍ التوقيع…' } as const;
    function renderSubmitLabel(lang: PropLang): void {
      if (!submitLabel) return;
      submitLabel.textContent = submitBusy ? SUBMIT_LABEL_BUSY[lang] : SUBMIT_LABEL[lang];
    }
    propI18nBusyLabels.push(renderSubmitLabel);
    const sticky = document.getElementById('sticky-cta');

    // ── WJ11 · Pad de signature manuscrite (canvas natif, tactile + souris) ──
    const canvas = document.getElementById('sign-pad') as HTMLCanvasElement | null;
    const clearBtn = document.getElementById('sign-clear');
    let hasInk = false;

    function setupSignaturePad(c: HTMLCanvasElement): void {
      // Adapte la résolution interne au DPR pour un trait net (sans CLS : la
      // hauteur CSS est fixée par .sign-pad, on n'ajuste que le bitmap).
      const ctx = c.getContext('2d');
      if (!ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const resize = (): void => {
        const rect = c.getBoundingClientRect();
        if (rect.width === 0) return;
        c.width = Math.round(rect.width * dpr);
        c.height = Math.round(rect.height * dpr);
        ctx.scale(dpr, dpr);
        ctx.lineWidth = 2.2;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.strokeStyle = '#f3cc66';
      };
      resize();
      window.addEventListener('resize', resize);

      let drawing = false;
      const pos = (e: PointerEvent): { x: number; y: number } => {
        const rect = c.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      };
      c.addEventListener('pointerdown', (e) => {
        drawing = true;
        hasInk = true;
        const p = pos(e);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        c.setPointerCapture(e.pointerId);
        e.preventDefault();
      });
      c.addEventListener('pointermove', (e) => {
        if (!drawing) return;
        const p = pos(e);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        e.preventDefault();
      });
      const stop = (): void => { drawing = false; };
      c.addEventListener('pointerup', stop);
      c.addEventListener('pointercancel', stop);
      c.addEventListener('pointerleave', stop);
    }
    if (canvas) setupSignaturePad(canvas);

    function clearSignature(): void {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasInk = false;
    }
    clearBtn?.addEventListener('click', clearSignature);

    // WJ101 — affordance clavier explicite : le canvas de signature reste
    // pointeur-seul (dessiner au clavier n'a pas de sens), mais un visiteur au
    // clavier ne doit pas rester bloqué à se demander comment continuer. Ce
    // bouton avance simplement le focus vers le champ nom — aucune signature
    // n'est requise : la validation (validateSign, lib/proposition.ts) n'a
    // jamais exigé de trait dessiné, seulement le nom + (si deux options)
    // l'option choisie.
    document.getElementById('sign-pad-skip')?.addEventListener('click', () => {
      (document.getElementById('sign-nom') as HTMLInputElement | null)?.focus();
    });

    // ── WJ108 · OTP e-signature — LATENT tant que le backend n'exige rien ────
    // (ESIGN_OTP_ENABLED côté ERP). Ce bloc reste masqué et n'affecte AUCUNE
    // soumission tant que /accept/ ne renvoie pas l'un des 3 messages
    // reconnus par isOtpRequiredDetail (lib/proposition.ts) — comportement
    // d'aujourd'hui inchangé.
    const otpBlock = document.getElementById('sign-otp-block');
    const otpCodeInput = document.getElementById('sign-otp-code') as HTMLInputElement | null;
    const otpRequestBtn = document.getElementById('sign-otp-request') as HTMLButtonElement | null;
    const otpStatusEl = document.getElementById('sign-otp-status');
    const OTP_SENT_MSG: Record<PropLang, string> = {
      fr: 'Code envoyé — vérifiez WhatsApp ou vos e-mails.',
      en: 'Code sent — check WhatsApp or your email.',
      ar: 'تم إرسال الرمز — تحققوا من واتساب أو بريدكم الإلكتروني.',
    };
    const OTP_SEND_FAILED_MSG: Record<PropLang, string> = {
      fr: 'Impossible d\'envoyer le code pour le moment. Réessayez.',
      en: 'Could not send the code right now. Please try again.',
      ar: 'تعذر إرسال الرمز حالياً. يرجى إعادة المحاولة.',
    };
    function revealOtpBlock(): void {
      if (otpBlock) otpBlock.hidden = false;
      otpCodeInput?.focus();
    }
    otpRequestBtn?.addEventListener('click', async () => {
      if (!otpRequestBtn) return;
      otpRequestBtn.disabled = true;
      try {
        const res = await fetch('/api/proposition-otp', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: cfg.token }),
        });
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean };
        if (otpStatusEl) {
          otpStatusEl.textContent = data.ok ? OTP_SENT_MSG[currentLang] : OTP_SEND_FAILED_MSG[currentLang];
          otpStatusEl.hidden = false;
        }
      } catch {
        if (otpStatusEl) {
          otpStatusEl.textContent = OTP_SEND_FAILED_MSG[currentLang];
          otpStatusEl.hidden = false;
        }
      } finally {
        otpRequestBtn.disabled = false;
      }
    });

    // ── WJ42 — Horodatage localisé (FR/EN/AR), affiché en direct dans le récap.
    // AVANT : `stampEl.textContent = frenchStamp(now)` écrasait le markup
    // tri-node data-i18n du <p id="sign-stamp"> (ses deux <span data-i18n>
    // portant Réf./« l'horodatage s'affichera ici ») avec une chaîne FR figée,
    // JAMAIS ré-inscrite dans `propI18nBusyLabels` — résultat : au moindre
    // aller-retour de langue, cette seule ligne restait en français au beau
    // milieu d'une page par ailleurs pleinement AR (ou EN). Cette fonction est
    // désormais une busy-label REGISTRÉE (même discipline que
    // `renderSubmitLabel`) : elle régénère tout le texte, dans la langue
    // courante, à CHAQUE bascule — jamais un remplacement ponctuel figé.
    const signedAtLocal = new Date();
    function renderStamp(lang: PropLang): void {
      if (!stampEl) return;
      stampEl.textContent = signStampLabel(cfg.reference, signedAtLocal, lang as SignPropLang);
    }
    propI18nBusyLabels.push(renderStamp);
    renderStamp(currentLang);

    function showError(msg: string): void {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError(): void {
      if (errorEl) errorEl.hidden = true;
    }
    // ── WJ42 — `successTime` portait le même défaut que le stamp : une chaîne
    // FR figée (« · signé le … ») jamais ré-inscrite au registre. `signedWhen`
    // garde la Date brute ; `renderSuccessTime` (busy-label enregistrée) la
    // reformate dans la langue courante à chaque bascule.
    let signedWhen: Date | null = null;
    const SUCCESS_TIME_PREFIX = { fr: ' · signé le ', en: ' · signed on ', ar: ' · تم التوقيع بتاريخ ' } as const;
    function renderSuccessTime(lang: PropLang): void {
      if (!successTime) return;
      successTime.textContent = signedWhen
        ? `${SUCCESS_TIME_PREFIX[lang]}${localizedStamp(signedWhen, lang as SignPropLang)}`
        : '';
    }
    propI18nBusyLabels.push(renderSuccessTime);
    // WJ78 — « le moment après la signature » : accusé visuel + écho de
    // l'artefact du client + scroll dans la vue (reduced-motion-safe : le
    // scroll lui-même n'est pas une "animation" au sens strict, mais on lui
    // demande explicitement un comportement 'auto' — pas de smooth-scroll
    // forcé — quand le client préfère un mouvement réduit).
    function showSuccess(name: string, when?: Date, signatureDataUrl?: string, scrollIntoView = false): void {
      // WJ104 — « proposition signée » : émis à chaque affichage de l'état
      // confirmé (chargement déjà accepté OU signature qui vient d'aboutir),
      // dédupliqué comme les autres beacons (une fois par onglet/session).
      sendProposalFunnelBeacon('signed');
      if (form) form.hidden = true;
      if (sticky) sticky.hidden = true;
      if (successName) successName.textContent = name || '';
      if (when) {
        signedWhen = when;
        renderSuccessTime(currentLang);
      }
      // Écho de la signature manuscrite si dessinée, sinon le sceau textuel
      // « Signature enregistrée ✓ » reste affiché (déjà visible par défaut).
      if (signatureDataUrl && successEchoImg) {
        successEchoImg.src = signatureDataUrl;
        successEchoImg.hidden = false;
        if (successEchoSeal) successEchoSeal.hidden = true;
      }
      if (success) success.hidden = false;
      if (scrollIntoView && success) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        success.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      }
    }

    // Déjà accepté au chargement → affiche directement l'état confirmé (pas de
    // scroll : le client arrive déjà sur une page qui affiche l'état confirmé,
    // rien à "faire défiler jusqu'à" au premier paint).
    if (cfg.accepted) {
      showSuccess(cfg.acceptedName);
    }

    function selectedOption(): OptionKey | null {
      if (!cfg.twoOptions) return cfg.preselect;
      const checked = form?.querySelector<HTMLInputElement>('input[name="option"]:checked');
      return (checked?.value as OptionKey) ?? null;
    }

    let submitting = false;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      clearError();

      const accord = (document.getElementById('sign-accord') as HTMLInputElement | null)?.checked;
      const consent = (document.getElementById('sign-consent') as HTMLInputElement | null)?.checked;
      const nom = (document.getElementById('sign-nom') as HTMLInputElement | null)?.value ?? '';
      // WJ87 — facultatif : « je signe au nom de… » (MRE signant pour ses
      // parents, foyer, etc.). Le signataire enregistré reste `nom` ci-dessus.
      const onBehalfOf = (document.getElementById('sign-on-behalf-of') as HTMLInputElement | null)?.value ?? '';
      const state: SignFormState = { nom, option: selectedOption() };

      const v = validateSign(state, cfg.twoOptions);
      if (!v.valid) {
        showError(v.error ?? 'Formulaire incomplet.');
        return;
      }
      if (!accord) {
        showError('Veuillez cocher « Bon pour accord » pour valider.');
        return;
      }
      if (!consent) {
        showError('Veuillez accepter de signer électroniquement pour continuer.');
        return;
      }

      // Capture la signature manuscrite (PNG data URL) UNIQUEMENT si dessinée.
      let signatureDataUrl = '';
      if (canvas && hasInk) {
        try {
          signatureDataUrl = canvas.toDataURL('image/png');
        } catch {
          signatureDataUrl = '';
        }
      }
      const signedAt = new Date();
      const signedAtIso = signedAt.toISOString();

      submitting = true;
      if (submitBtn) submitBtn.disabled = true;
      if (spinner) spinner.hidden = false;
      submitBusy = true;
      renderSubmitLabel(currentLang);

      // WJ81 — jamais un « Signature… » désactivé pour l'éternité : une
      // connexion lente/un backend qui ne répond pas laissait auparavant ce
      // bouton bloqué SANS limite. 15 s est le seuil documenté par le
      // founder pour ce moment de très haute intention — au-delà, on annule
      // la requête et on rend la main avec un message honnête + un chemin de
      // repli (WhatsApp, déjà visible juste au-dessus dans « Une question
      // avant de signer ? »).
      const SIGN_SUBMIT_TIMEOUT_MS = 15000;
      const submitController = new AbortController();
      const submitTimer = window.setTimeout(() => submitController.abort(), SIGN_SUBMIT_TIMEOUT_MS);
      try {
        // WJ108 — code OTP OPTIONNEL : vide tant que le bloc n'a jamais été
        // révélé (backend/toggle OFF ignore le champ vide, comportement
        // inchangé). Une fois révélé, le client peut le remplir et resoumettre.
        const otpCode = otpCodeInput?.value.trim() ?? '';
        // Corps RÉTRO-COMPATIBLE : base (token/nom/option) + champs optionnels
        // (signature, consentement, horodatage, otp_code) que le backend peut ignorer.
        const richBody = buildAcceptBodyRich(state, cfg.twoOptions, {
          signature_data_url: signatureDataUrl,
          consent_esign: true,
          signed_at_client: signedAtIso,
          on_behalf_of: onBehalfOf,
          otp_code: otpCode,
        });
        const res = await fetch('/api/proposition-accept', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            token: cfg.token,
            twoOptions: cfg.twoOptions,
            ...richBody,
          }),
          signal: submitController.signal,
        });
        const data = (await res.json()) as {
          ok?: boolean;
          detail?: string;
          accepte_par_nom?: string;
        };
        if (res.ok && data.ok) {
          showSuccess(data.accepte_par_nom || nom.trim(), signedAt, signatureDataUrl, true);
          return;
        }
        // 400 / 409 / 404 : message backend inline. 409 = déjà accepté →
        // on bascule quand même sur l'état confirmé (double-clic sûr).
        if (res.status === 409) {
          showSuccess(data.accepte_par_nom || nom.trim(), undefined, signatureDataUrl, true);
          return;
        }
        // WJ108 — LATENT : ce chemin ne se déclenche QUE si le backend a le
        // toggle ESIGN_OTP_ENABLED actif et renvoie l'un des 3 messages OTP
        // reconnus (isOtpRequiredDetail) — jamais aujourd'hui (toggle OFF par
        // défaut). Révèle le bloc de saisie au lieu d'un message d'erreur
        // générique, et lance automatiquement l'envoi du code la première fois.
        if (isOtpRequiredDetail(data.detail)) {
          const firstReveal = otpBlock?.hidden !== false;
          revealOtpBlock();
          showError(
            isOtpIncorrectDetail(data.detail)
              ? (data.detail ?? '')
              : 'Un code de confirmation vous a été envoyé — saisissez-le ci-dessus pour finaliser votre signature.',
          );
          if (firstReveal) otpRequestBtn?.click();
          return;
        }
        showError(data.detail || 'Une erreur est survenue. Veuillez réessayer.');
      } catch (err) {
        // WJ45 — si le navigateur se sait hors-ligne au moment de l'échec, on
        // l'affirme explicitement (bandeau + message dédié, dans la langue
        // courante) plutôt que la formule générique de panne/lenteur : rien
        // n'a été soumis, le formulaire reste rempli tel quel.
        syncPropOfflineBanner();
        if (!navigator.onLine) {
          const OFFLINE_SIGN_MSG: Record<PropLang, string> = {
            fr: 'Pas de connexion — vos réponses sont conservées, on réessaie dès le retour du réseau.',
            en: "No connection — your answers are kept, we'll retry as soon as the network is back.",
            ar: 'لا يوجد اتصال — إجاباتكم محفوظة، سنعيد المحاولة فور عودة الشبكة.',
          };
          showError(OFFLINE_SIGN_MSG[currentLang]);
        } else {
          const timedOut = err instanceof Error && err.name === 'AbortError';
          showError(
            timedOut
              ? 'La connexion est lente — réessayez, ou contactez-nous sur WhatsApp ci-dessus.'
              : 'Service momentanément indisponible. Veuillez réessayer.',
          );
        }
      } finally {
        window.clearTimeout(submitTimer);
        submitting = false;
        if (submitBtn) submitBtn.disabled = false;
        if (spinner) spinner.hidden = true;
        submitBusy = false;
        renderSubmitLabel(currentLang);
      }
    });
  }
</script>

<script>
  // ── WJ25/WJ27 — boot DIFFÉRÉ de la visionneuse 3D (jamais au premier paint).
  // Three.js est chargé par import() dynamique : au scroll (IntersectionObserver)
  // en conditions normales, UNIQUEMENT au tap en reduced-motion / Save-Data.
  // Échec WebGL / import → le poster (photo d'étude) reste, avec une note claire.
  import type { RoofLayout, ViewerModel } from '../../lib/proposition';
  import type { RoofImageSpec } from '../../scripts/roofPro11/viewerOnly';

  const section3d = document.getElementById('roof3d');
  const stage = document.getElementById('roof3d-stage');
  const overlay = document.getElementById('roof3d-overlay');
  const startBtn = document.getElementById('roof3d-start') as HTMLButtonElement | null;
  const noteEl = document.getElementById('roof3d-note');
  const hintEl = document.getElementById('roof3d-hint');

  if (section3d && stage && section3d.dataset.viewerConfig) {
    let model: ViewerModel | null = null;
    // WJ118 — contour [lat,lng] (calculé côté serveur par
    // roofLayoutOutlineLatLng, roof_layout.zones[].vertices aplati) pour la
    // photo satellite drapée sur la 3D ; vide si aucun roof_layout exploitable
    // (le client saute alors l'appel réseau de buildPublicRoofImageSpec).
    let roofOutlineLatLng: Array<[number, number]> = [];
    // Le layout PUBLIC brut (parseRoofLayout côté serveur) : il porte le
    // calepinage RÉEL, seule source de la visionneuse PLEINE (le vrai builder).
    let layout: RoofLayout | null = null;
    try {
      const parsed = JSON.parse(section3d.dataset.viewerConfig) as {
        model: ViewerModel;
        roofOutlineLatLng?: Array<[number, number]>;
        layout?: RoofLayout | null;
      };
      model = parsed.model;
      roofOutlineLatLng = Array.isArray(parsed.roofOutlineLatLng) ? parsed.roofOutlineLatLng : [];
      layout = parsed.layout ?? null;
    } catch {
      model = null;
      layout = null;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };

    let booted = false;
    let handle: { dispose: () => void } | null = null;

    function showFallback(msg: string): void {
      if (startBtn) startBtn.hidden = true;
      if (noteEl) noteEl.textContent = msg;
    }

    async function boot(): Promise<void> {
      if (booted || !model || !stage) return;
      booted = true;
      if (startBtn) startBtn.disabled = true;
      try {
        // WJ27 — la décision device/réseau (bas de gamme, WebGL, repli) vit dans
        // viewerOnly.viewerBootStrategy (pure, testée) : même logique ici et en
        // test, une seule source de vérité.
        const mod = await import('../../scripts/roofPro11/viewerOnly');
        const strategy = mod.viewerBootStrategy({
          deviceMemory: nav.deviceMemory,
          hardwareConcurrency: navigator.hardwareConcurrency,
          reducedMotion: reduced,
          webglAvailable: mod.webglAvailable(),
        });
        if (!strategy.canBoot) {
          showFallback(strategy.fallbackMessage ?? 'Vue 3D indisponible sur cet appareil — voici la photo de votre étude.');
          return;
        }
        // VISIONNEUSE PLEINE : le VRAI rendu de l'ERP (scene3d) sur la carte
        // satellite complète. Tout refus (ancien lien sans calepinage réel, pas
        // de clé d'imagerie, WebGL absent) renvoie null → on garde EXACTEMENT le
        // chemin viewerOnly ci-dessous, inchangé.
        const fullLayout = layout;
        if (fullLayout) {
          const cfg = (await fetch('/api/roof-config', { signal: AbortSignal.timeout(10_000) })
            .then((r) => (r.ok ? r.json() : null))
            .catch(() => null)) as { maptilerKey?: string; mapboxToken?: string } | null;
          if (cfg && (cfg.maptilerKey || cfg.mapboxToken)) {
            const full = await import('../../scripts/roofPro11/viewerFullBoot');
            const fullHandle = full.bootViewerFull(stage, fullLayout, {
              maptilerKey: cfg.maptilerKey,
              mapboxToken: cfg.mapboxToken,
              reducedMotion: reduced,
              lowEnd: strategy.lowEnd,
              onReady: () => {
                if (overlay) overlay.hidden = true;
                if (hintEl) {
                  hintEl.hidden = false;
                  // Gestes carte ≠ gestes Three : réécrit data-i18n ET le texte,
                  // sinon le sélecteur de langue remet l'ancien libellé.
                  hintEl.dataset.fr = 'Deux doigts pour déplacer et zoomer · clic droit ou Ctrl + glisser pour tourner';
                  hintEl.dataset.en = 'Two fingers to pan and zoom · right-click or Ctrl + drag to rotate';
                  hintEl.dataset.ar = 'إصبعان للتحريك والتكبير · زر أيمن أو Ctrl + سحب للتدوير';
                  hintEl.textContent = hintEl.dataset.fr;
                }
                stage.classList.add('roof3d-stage--sky', 'roof3d-stage--map');
              },
              onMapError: () => showFallback('Vue 3D interrompue — voici la photo de votre étude.'),
            });
            if (fullHandle) {
              handle = { dispose: () => fullHandle.destroy() };
              return;
            }
          }
        }
        // WJ118 — photo satellite RÉELLE du toit du client (contrat viewerOnly
        // ci-dessus) : TOUT échec (pas de clé MAPTILER/MAPBOX, contour < 3
        // sommets, /api/roof-config en échec, image cassée/trop lente) → null,
        // jamais un throw — createRoofViewer traite alors roofImage absent/null
        // EXACTEMENT comme avant (rendu abstrait, aucune régression).
        let roofImage: RoofImageSpec | null = null;
        if (roofOutlineLatLng.length >= 3) {
          roofImage = await mod.buildPublicRoofImageSpec({ outline: roofOutlineLatLng }).catch(() => null);
        }
        handle = mod.createRoofViewer(stage, model, {
          reducedMotion: reduced,
          lowEnd: strategy.lowEnd,
          roofImage,
          onReady: () => {
            if (overlay) overlay.hidden = true;
            if (hintEl) hintEl.hidden = false;
            // WJ118 — bascule le fond en ciel clair/jour UNIQUEMENT quand la
            // photo a été réellement drapée ; sans elle, le fond nuit abstrait
            // actuel reste (aucune classe ajoutée = dégradation byte-identique).
            if (roofImage && stage) stage.classList.add('roof3d-stage--sky');
          },
          onFail: () => {
            if (overlay) overlay.hidden = false;
            showFallback('Vue 3D interrompue — voici la photo de votre étude.');
          },
        });
        if (!handle) {
          showFallback('Vue 3D indisponible sur cet appareil — voici la photo de votre étude.');
        }
      } catch {
        // Réseau lent / import échoué : le poster reste, message honnête.
        showFallback('Vue 3D momentanément indisponible — voici la photo de votre étude.');
      }
    }

    startBtn?.addEventListener('click', () => void boot());

    // Conditions normales : pré-charge au scroll (proche du viewport). En
    // reduced-motion ou Save-Data : rien ne bouge/charge sans geste explicite
    // (même règle que viewerBootStrategy.autoPreload, évaluée ici sans import
    // dynamique pour ne déclencher AUCUN chargement avant un vrai scroll).
    const saveData = nav.connection?.saveData === true;
    const autoPreload = !reduced && !saveData;
    if (autoPreload && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            void boot();
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(section3d);
    }

    // Libère le GPU au départ de la page (aucune fuite de contexte WebGL).
    window.addEventListener('pagehide', () => {
      handle?.dispose();
      handle = null;
    });
  }

  // ── WJ26 — visite guidée : surlignage d'étape (progressive enhancement).
  // Les 4 étapes sont TOUJOURS toutes visibles (zéro mouvement, zéro CLS,
  // lisible sans JS) ; Précédent/Suivant ne déplacent que le surlignage +
  // l'annonce aria-live. Rien n'anime la caméra 3D (reduced-motion-safe).
  const walk = document.getElementById('roof3d-walk');
  if (walk) {
    const steps = Array.from(walk.querySelectorAll<HTMLElement>('.walk-step'));
    const prev = document.getElementById('roof3d-walk-prev') as HTMLButtonElement | null;
    const next = document.getElementById('roof3d-walk-next') as HTMLButtonElement | null;
    const count = document.getElementById('roof3d-walk-count');
    let idx = 0;
    function setStep(i: number): void {
      idx = Math.max(0, Math.min(steps.length - 1, i));
      steps.forEach((s, j) => {
        if (j === idx) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = idx === 0;
      if (next) next.disabled = idx === steps.length - 1;
      if (count) count.textContent = `Étape ${idx + 1} sur ${steps.length}`;
    }
    prev?.addEventListener('click', () => setStep(idx - 1));
    next?.addEventListener('click', () => setStep(idx + 1));
    setStep(0);
  }
</script>

<script>
  // ── WJ29 — « Être contacté » / « Demander un rappel » : notifie l'équipe EN
  // PLUS du lien instantané (wa.me / tel:), sans jamais le bloquer. On laisse
  // le navigateur suivre le lien normalement (tel:/wa.me s'ouvrent tout de
  // suite) et on poste en parallèle vers le proxy same-origin — un échec ne
  // gêne jamais le client, il garde de toute façon son canal instantané.
  // PV80 — l'échéancier « comptant / échelonné » a été retiré de la page (aucune
  // mensualité, aucun crédit) : son import client `installmentSplit` disparaît
  // avec lui. `formatMAD` reste importé ici — le curseur batterie le réutilise.
  import {
    buildContactBody,
    formatMAD,
    type ContactChannel,
  } from '../../lib/proposition';
  // WJ120 — moteur du simulateur batterie (PUR) importé ES pour un recalcul 100 %
  // local au curseur (aucun re-fetch). Regroupé dans CE script (cf. note WJ34/WJ53
  // ci-dessous) ; batterySim n'a aucune dépendance runtime lourde.
  import { simulateBattery, renderBatterySplitSvg, HOURS_PER_DAY } from '../../lib/batterySim';
  // PACT-battery (2026-08-15) — MÊME fonction pure que le rendu serveur initial
  // (voir l'astro plus haut, `batteryConsShape`) : reconstruit la silhouette de
  // consommation pour la variante active des onglets Standard/Été/Ramadan, sans
  // jamais diverger entre les deux passes.
  import { consumptionShapeHours, type ProposalCurveVariant, type ProposalCurveMode } from '../../lib/proposalCurve';
  // CJ1 — la silhouette du simulateur suit AUSSI la puce d'occupation choisie
  // (présent / absent / partiel en journée) : le calque batterie et la courbe
  // nue décrivent le même foyer, jamais deux foyers différents.
  import type { OccupancyId } from '../../lib/dayProfiles';
  // WJ129 — géométrie PURE (testée sous vitest, propositionSldViewerWJ129.test.ts)
  // de la visionneuse plein écran du schéma électrique. Regroupée dans CE
  // script (cf. note WJ34/WJ53 ci-dessous : un <script> supplémentaire isolé
  // sur cette route perd son chunk au bundling).
  import {
    type Point,
    type Size,
    type TapRecord,
    SLD_MIN_SCALE,
    SLD_MAX_SCALE,
    clamp,
    clampTranslate,
    centeredTranslate,
    fitScale,
    isDoubleTap,
    parseViewBoxSize,
    pinchScale,
    pointDistance,
    pointMidpoint,
    doubleTapScale,
    zoomAtPoint,
  } from '../../lib/sldViewer';

  const contactSection = document.querySelector<HTMLElement>('[data-contact-token]');
  const confirmEl = document.getElementById('contact-confirm');
  const token = contactSection?.dataset.contactToken ?? '';

  if (contactSection && token) {
    let confirmTimer: number | undefined;
    function showConfirm(msg: string): void {
      if (!confirmEl) return;
      confirmEl.textContent = msg;
      confirmEl.hidden = false;
      window.clearTimeout(confirmTimer);
      confirmTimer = window.setTimeout(() => {
        confirmEl.hidden = true;
      }, 8000);
    }

    async function notifyTeam(channel: ContactChannel): Promise<void> {
      try {
        const body = buildContactBody({ channel });
        const res = await fetch('/api/proposition-contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token, ...body }),
        });
        const data = (await res.json()) as { detail?: string };
        if (data.detail) showConfirm(data.detail);
      } catch {
        // Best-effort : le lien instantané (wa.me / tel:) a déjà fait son travail,
        // on ne montre rien d'alarmant si la notification interne échoue.
      }
    }

    contactSection.querySelectorAll<HTMLAnchorElement>('[data-contact-channel]').forEach((el) => {
      el.addEventListener('click', () => {
        const channel = (el.dataset.contactChannel as ContactChannel) || 'rappel';
        void notifyTeam(channel);
        if (channel === 'rappel') showConfirm('Merci — nous vous rappelons très vite.');
      });
    });
  }

  // ── WJ54 — « Demander une modification » : formulaire de révision
  // structurée, posté vers le MÊME proxy /api/proposition-contact que WJ29
  // ci-dessus (canal `revision` distinct) — jamais un nouvel endpoint. Le
  // formulaire est gâté côté serveur (rendu uniquement quand `ok`, voir
  // l'astro plus haut) : ce script ne fait qu'attacher son comportement s'il
  // est bien présent dans le DOM.
  (function setupRevisionForm(): void {
    const revisionSection = document.querySelector<HTMLElement>('[data-revision-token]');
    const revisionToken = revisionSection?.dataset.revisionToken ?? '';
    if (!revisionSection || !revisionToken) return;

    const form = document.getElementById('revision-form') as HTMLFormElement | null;
    const detailEl = document.getElementById('revision-detail') as HTMLTextAreaElement | null;
    const errorEl = document.getElementById('revision-error');
    const confirmEl = document.getElementById('revision-confirm');
    const submitBtn = document.getElementById('revision-submit') as HTMLButtonElement | null;
    const kindBtns = Array.from(revisionSection.querySelectorAll<HTMLButtonElement>('[data-revision-kind]'));
    if (!form) return;

    type RevisionKind = 'kwc' | 'batterie' | 'autre';
    let selectedKind: RevisionKind | null = null;

    function selectKind(kind: RevisionKind): void {
      selectedKind = kind;
      kindBtns.forEach((btn) => {
        const on = btn.dataset.revisionKind === kind;
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute(
          'style',
          on
            ? 'background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)'
            : '',
        );
      });
    }
    kindBtns.forEach((btn) => {
      btn.addEventListener('click', () => selectKind((btn.dataset.revisionKind as RevisionKind) || 'autre'));
    });

    let submitting = false;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (submitting) return;

      if (errorEl) errorEl.hidden = true;
      if (confirmEl) confirmEl.hidden = true;

      const detail = (detailEl?.value ?? '').trim();
      const kind = selectedKind;
      if (!kind) {
        if (errorEl) {
          errorEl.textContent = 'Veuillez choisir le type de modification souhaitée.';
          errorEl.hidden = false;
        }
        return;
      }
      if (kind === 'autre' && !detail) {
        if (errorEl) {
          errorEl.textContent = 'Merci de préciser votre demande en quelques mots.';
          errorEl.hidden = false;
        }
        return;
      }

      submitting = true;
      if (submitBtn) submitBtn.disabled = true;

      const labels: Record<RevisionKind, string> = {
        kwc: 'Ajuster la puissance (kWc)',
        batterie: 'Changer l’option batterie',
        autre: 'Autre modification',
      };
      const message = detail ? `${labels[kind]} — ${detail}` : labels[kind];

      void (async () => {
        try {
          const res = await fetch('/api/proposition-contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              token: revisionToken,
              channel: 'revision',
              revision_kind: kind,
              message,
            }),
          });
          const data = (await res.json()) as { detail?: string };
          if (confirmEl) {
            confirmEl.textContent = data.detail || 'Merci — votre demande a bien été transmise.';
            confirmEl.hidden = false;
          }
          form.reset();
          selectedKind = null;
          kindBtns.forEach((btn) => {
            btn.setAttribute('aria-pressed', 'false');
            btn.setAttribute('style', '');
          });
        } catch {
          if (confirmEl) {
            confirmEl.textContent = 'Merci — votre demande a bien été transmise.';
            confirmEl.hidden = false;
          }
        } finally {
          submitting = false;
          if (submitBtn) submitBtn.disabled = false;
        }
      })();
    });
  })();

  // ── WJ34 — affordance « génération du PDF… » sur le lien de téléchargement.
  // Le rendu backend (WeasyPrint) prend quelques secondes : sans signal, le
  // visiteur peut croire que le clic n'a rien fait. Le lien continue de
  // s'ouvrir normalement (target=_blank, jamais bloqué par preventDefault) ;
  // on affiche juste un état visuel temporaire, remis à zéro dès que
  // l'utilisateur revient sur cet onglet (le PDF est alors soit ouvert dans
  // un nouvel onglet, soit l'échec est visible là-bas) ou après un délai de
  // sécurité (le rendu le plus lent observé reste sous quelques secondes).
  // Regroupé dans CE script (au lieu d'un 5ᵉ <script> séparé) : un bundling
  // observé sur cette route perdait le chunk d'un <script> isolé sans import
  // ES — le manifeste SSR le référençait mais le fichier n'était jamais écrit
  // côté client. Même page, même effet, zéro risque de chunk manquant.
  const pdfLink = document.getElementById('pdf-download') as HTMLAnchorElement | null;
  const pdfIcon = document.getElementById('pdf-download-icon');
  const pdfSpinner = document.getElementById('pdf-download-spinner');
  const pdfLabel = document.getElementById('pdf-download-label');
  const PDF_LABEL_DEFAULT = { fr: 'Télécharger le devis (PDF)', en: 'Download the quote (PDF)', ar: 'تحميل العرض (PDF)' } as const;
  const PDF_LABEL_LOADING = { fr: 'Génération du PDF…', en: 'Generating the PDF…', ar: 'جارٍ إنشاء PDF…' } as const;
  // WJ17/WJ43 — le libellé bascule FR/EN/AR APRÈS le premier rendu (état
  // « génération »), donc hors du mécanisme tri-node data-i18n : on lit la
  // langue courante via le pont __propCurrentLang exposé par le script de
  // bascule (module séparé), et on se réinscrit pour être retraduit à chaque
  // clic FR/EN/عربي.
  type PropLang = 'fr' | 'en' | 'ar';
  const propWin = window as unknown as {
    __propCurrentLang?: () => PropLang;
    __propRegisterBusyLabel?: (fn: (l: PropLang) => void) => void;
  };
  const getLang = (): PropLang => propWin.__propCurrentLang?.() ?? 'fr';

  if (pdfLink && pdfLabel) {
    let pdfLoading = false;
    let pdfResetTimer: number | undefined;
    const renderPdfLabel = (lang: PropLang): void => {
      pdfLabel.textContent = pdfLoading ? PDF_LABEL_LOADING[lang] : PDF_LABEL_DEFAULT[lang];
    };
    const setPdfLoading = (loading: boolean): void => {
      pdfLoading = loading;
      if (pdfIcon) pdfIcon.toggleAttribute('hidden', loading);
      if (pdfSpinner) pdfSpinner.hidden = !loading;
      renderPdfLabel(getLang());
    };
    propWin.__propRegisterBusyLabel?.(renderPdfLabel);
    pdfLink.addEventListener('click', () => {
      setPdfLoading(true);
      window.clearTimeout(pdfResetTimer);
      pdfResetTimer = window.setTimeout(() => setPdfLoading(false), 6000);
    });
    // Dès que l'utilisateur revient sur CET onglet (après avoir consulté le
    // PDF dans le nouvel onglet), on considère la génération terminée.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') setPdfLoading(false);
    });
  }

  // ── WJ56 — « Partager sur WhatsApp » : Web Share API native quand disponible
  // (feuille de partage système — la meilleure expérience sur mobile/tablette,
  // laisse le client choisir WhatsApp OU tout autre canal), repli sur le lien
  // wa.me générique (déjà posé en `href`, fonctionne SANS JS) sinon. On ne
  // bloque JAMAIS le clic : navigator.share() réussi → preventDefault (évite
  // une double feuille de partage) ; échec/absence → le lien wa.me s'ouvre
  // normalement.
  (function setupShareWhatsapp(): void {
    const shareBtn = document.getElementById('prop-share-whatsapp') as HTMLAnchorElement | null;
    if (!shareBtn || typeof navigator.share !== 'function') return;
    shareBtn.addEventListener('click', (e) => {
      const url = shareBtn.dataset.shareUrl || shareBtn.href;
      const ref = shareBtn.dataset.shareRef || '';
      e.preventDefault();
      navigator
        .share({
          title: 'Proposition solaire Taqinor',
          text: ref ? `Voici ma proposition solaire Taqinor (réf. ${ref})` : 'Voici ma proposition solaire Taqinor',
          url,
        })
        .catch(() => {
          // Annulé par l'utilisateur ou API indisponible en pratique : on
          // rouvre le repli wa.me pour ne jamais laisser le clic sans effet.
          window.open(shareBtn.href, '_blank', 'noopener,noreferrer');
        });
    });
  })();

  // ── WJ80 — Tap-to-reveal des valeurs du graphe + de la courbe journalière.
  // Le `<title>` SVG (survol souris) est INVISIBLE au tactile — l'essentiel du
  // trafic de cette page. Délégation d'événement sur le conteneur visible
  // (peu importe la langue active) : un tap/clic/Entrée sur une barre ou le
  // repère pic/moyenne affiche son libellé déjà formaté (data-month/
  // data-value ou data-peak/data-avg, posés côté serveur — aucun recalcul).
  (function setupChartTapReveal(): void {
    function nearestTarget(el: EventTarget | null): HTMLElement | null {
      if (!(el instanceof Element)) return null;
      return el.closest<HTMLElement>('[data-chart-bar], [data-curve-scale]');
    }

    function reveal(target: HTMLElement): void {
      if (target.matches('[data-chart-bar]')) {
        const caption = document.getElementById('chart-tap-caption');
        if (!caption) return;
        const month = target.dataset.month ?? '';
        const value = target.dataset.value ?? '';
        caption.textContent = `${month} · ${value}`;
      } else if (target.matches('[data-curve-scale]')) {
        const caption = document.getElementById('curve-tap-caption');
        if (!caption) return;
        const peak = target.dataset.peak ?? '';
        const avg = target.dataset.avg ?? '';
        caption.textContent = [peak, avg].filter(Boolean).join(' · ');
      }
    }

    function wireTapReveal(container: HTMLElement | null): void {
      if (!container) return;
      container.addEventListener('click', (e) => {
        const target = nearestTarget(e.target);
        if (target) reveal(target);
      });
      container.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const target = nearestTarget(e.target);
        if (target) {
          e.preventDefault();
          reveal(target);
        }
      });
    }

    document.querySelectorAll<HTMLElement>('.chart-svg, .daily-curve-wrap').forEach(wireTapReveal);
  })();

  // ── WJ120 — Simulateur « et avec N batteries ? » : recalcul EN DIRECT au
  // curseur, 100 % côté client (aucun re-fetch). Le moteur horaire glouton
  // (lib/batterySim, jour 2 simulé) tourne dans le navigateur à partir des
  // silhouettes + totaux déjà posés côté serveur (data-battery-sim-config).
  // Regroupé dans CE script (import ES → chunk garanti, cf. WJ34/WJ53). Les
  // nombres sont formatés localement (séparateur d'espace, virgule décimale —
  // même convention que proposition.formatNumber) pour ne dépendre d'aucun
  // import supplémentaire ; le prix batterie n'est JAMAIS inventé (prix réel du
  // devis quand N == offre, sinon « sur étude »).
  (function setupBatterySim(): void {
    type BsLang = 'fr' | 'en' | 'ar';
    interface BsConfig {
      consShape: number[];
      solarShape: number[];
      dailyConsKwh: number;
      dailyProdKwh: number;
      capacityPerUnit: number;
      maxUnits: number;
      initialN: number;
      offeredUnits: number;
      sansTtc: number | null;
      avecTtc: number | null;
      // PACT-battery — mode courant (résidentiel/commercial, seuls modes
      // éligibles au simulateur batterie) : nécessaire pour recalculer
      // consShape via consumptionShapeHours() à chaque onglet de profil.
      mode: ProposalCurveMode;
      // CJ1 — occupation de DÉPART (drapeau serveur) et fenêtre de Ramadan
      // CALCULÉE : les mêmes entrées que le rendu serveur, pour que le recalcul
      // client produise exactement la même silhouette.
      occupancy: OccupancyId;
      ramadan: { imsakHour: number; iftarHour: number } | null;
      // ORDRE FONDATEUR (24/08/2026, soir) — paliers RÉELS du mini-balayage de
      // stockage (prix TTC par N de packs) + premier palier REFUSÉ (N +
      // remplissage du pire mois, RÉEL) : jamais un chiffre inventé, relus
      // tels quels au curseur.
      // ORDRE FONDATEUR (24/08/2026) — `payback` (années) et `remplissagePct`
      // par palier : DEUX NOMBRES DU MOTEUR, relus tels quels (aucun calcul).
      storagePaliers: Array<{
        n: number; ttc: number | null;
        payback: number | null; remplissagePct: number | null;
      }>;
      storageRefuse: { n: number; pireMoisPct: number | null } | null;
    }
    const section = document.getElementById('battery-sim');
    if (!section) return;
    const raw = section.getAttribute('data-battery-sim-config');
    if (!raw) return;
    let cfg: BsConfig;
    try {
      cfg = JSON.parse(raw) as BsConfig;
    } catch {
      return;
    }
    const bsWin = window as unknown as {
      __propCurrentLang?: () => BsLang;
      __propRegisterBusyLabel?: (fn: (l: BsLang) => void) => void;
    };
    const curLang = (): BsLang => bsWin.__propCurrentLang?.() ?? 'fr';

    // Formatage local (aucun import) : espace de milliers, virgule décimale —
    // exactement proposition.formatNumber (virgule quelle que soit la langue).
    const group = (s: string): string => s.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    function fmtNum(v: number, decimals: number): string {
      const n = Number.isFinite(v) ? v : 0;
      const factor = 10 ** decimals;
      const r = Math.round(n * factor) / factor;
      const sign = r < 0 ? '-' : '';
      const abs = Math.abs(r);
      const intPart = group(Math.trunc(abs).toString());
      if (decimals <= 0) return `${sign}${intPart}`;
      const frac = (abs - Math.trunc(abs)).toFixed(decimals).slice(2).replace(/0+$/, '');
      return frac ? `${sign}${intPart},${frac}` : `${sign}${intPart}`;
    }
    const fmtPct = (v: number): string => `${fmtNum(v, 0)} %`;
    const fmtMad = (v: number): string => `${fmtNum(Math.round(v), 0)} MAD`;
    const ON_STUDY: Record<BsLang, string> = {
      fr: 'Sur étude',
      en: 'On request',
      ar: 'حسب الدراسة',
    };

    const setText = (id: string, text: string): void => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    let currentN = Math.max(0, Math.min(cfg.maxUnits, Math.trunc(cfg.initialN)));
    let lastHourly: { direct: number[]; battery: number[]; grid: number[] } | null = null;
    // PACT-battery — onglet de profil actif (Standard/Été/Ramadan). Le rendu
    // serveur initial est TOUJOURS 'normal' (cfg.consShape en hérite) ; ce
    // n'est qu'après hydratation qu'un clic sur un autre onglet, pendant que
    // ce calque batterie est actif, fait bouger cette variable (pont
    // __propSetBatteryVariant, exposé plus bas).
    let currentVariant: ProposalCurveVariant = 'normal';
    // CJ1 — même logique pour l'occupation : le rendu serveur a utilisé
    // `cfg.occupancy`, on part de là et on ne bouge qu'au clic d'une puce.
    let currentOccupancy: OccupancyId = cfg.occupancy ?? 'presence_partielle';

    // ORDRE FONDATEUR — le prix réel du devis (offeredUnits) l'emporte
    // toujours (même chiffre, cohérent avec les cartes d'options plus haut) ;
    // à défaut, le prix RÉEL du palier de stockage à ce N (balayage) si le
    // moteur en a chiffré un ; sinon « sur étude », jamais un prix inventé.
    function palierPriceAt(n: number): number | null {
      const p = cfg.storagePaliers.find((x) => x.n === n);
      return p ? p.ttc : null;
    }

    function renderPrice(n: number): void {
      const el = document.getElementById('battery-sim-price');
      if (!el) return;
      const palierTtc = palierPriceAt(n);
      if (n === cfg.offeredUnits && cfg.avecTtc != null) el.textContent = fmtMad(cfg.avecTtc);
      else if (n === 0 && cfg.sansTtc != null) el.textContent = fmtMad(cfg.sansTtc);
      else if (palierTtc != null) el.textContent = fmtMad(palierTtc);
      else el.textContent = ON_STUDY[curLang()];
    }

    // ORDRE FONDATEUR (24/08/2026) — LA PÉRIODE DE RETOUR, AU CURSEUR.
    // `palierAt(n).payback` est la valeur DU MOTEUR pour ce palier ; ce script
    // ne fait que la choisir, l'habiller de son unité et — quand le curseur
    // s'écarte de la configuration du devis — l'afficher À CÔTÉ de celle de
    // départ (« X ans → Y ans »). Aucune arithmétique : les deux nombres sont
    // servis. Palier sans payback ⇒ ligne masquée (omission).
    const YEARS_UNIT: Record<BsLang, string> = { fr: 'ans', en: 'years', ar: 'سنوات' };
    function palierAt(n: number): { n: number; ttc: number | null; payback: number | null; remplissagePct: number | null } | null {
      return cfg.storagePaliers.find((x) => x.n === n) ?? null;
    }
    const refPayback = palierAt(cfg.initialN)?.payback ?? null;
    function renderPayback(n: number): void {
      const row = document.getElementById('battery-sim-payback');
      const el = document.getElementById('battery-sim-payback-value');
      if (!row || !el) return;
      const payback = palierAt(n)?.payback ?? null;
      row.hidden = payback == null;
      if (payback == null) return;
      const unit = YEARS_UNIT[curLang()];
      const now = `${fmtNum(payback, 1)} ${unit}`;
      el.textContent = refPayback != null && n !== cfg.initialN && refPayback !== payback
        ? `${fmtNum(refPayback, 1)} ${unit} → ${now}`
        : now;
    }

    // ORDRE FONDATEUR (24/08/2026) — CHARGE INCOMPLÈTE d'un palier ACCEPTÉ :
    // le moteur retient ce palier, mais sa batterie n'est remplie qu'à
    // `remplissagePct` en moyenne. Le pourcentage est SERVI ; ≥ 100 % ⇒ aucun
    // message (elle se remplit chaque jour, même règle de libellé que le bloc
    // « régime batterie »). Distinct du message de SUR-STOCKAGE ci-dessous, qui
    // ne concerne que le palier REFUSÉ.
    function renderFill(n: number): void {
      const el = document.getElementById('battery-sim-fill');
      if (!el) return;
      const pct = palierAt(n)?.remplissagePct ?? null;
      const show = pct != null && pct < 100;
      el.hidden = !show;
      if (!show || pct == null) return;
      const numEl = el.querySelector<HTMLElement>('[data-fill-pct-num]');
      if (numEl) numEl.textContent = fmtPct(pct);
    }

    // ORDRE FONDATEUR — message de sur-stockage : visible UNIQUEMENT quand N
    // atteint le premier palier REFUSÉ par le moteur (la batterie ne se
    // rechargerait plus chaque jour à cette capacité). Le pourcentage inséré
    // est celui, RÉEL, que le backend a déjà calculé — jamais un nouveau
    // calcul ici, seulement son insertion dans un gabarit FR/EN/AR fixe.
    function renderOverStorage(n: number): void {
      const el = document.getElementById('battery-sim-overstorage');
      if (!el) return;
      const refuse = cfg.storageRefuse;
      const hit = !!refuse && refuse.n === n;
      el.hidden = !hit;
      if (!hit || !refuse) return;
      const pctEl = el.querySelector<HTMLElement>('[data-overstorage-pct]');
      if (pctEl) {
        pctEl.hidden = refuse.pireMoisPct == null;
        if (refuse.pireMoisPct != null) {
          const numEl = pctEl.querySelector<HTMLElement>('[data-overstorage-pct-num]');
          if (numEl) numEl.textContent = fmtPct(refuse.pireMoisPct);
        }
      }
    }

    // Silhouette de consommation active : le rendu serveur ('normal') reste
    // cfg.consShape tel quel (zéro recalcul redondant) ; toute autre variante
    // passe par la MÊME fonction pure que le rendu serveur (consumptionShapeHours,
    // proposalCurve.ts) — jamais un chiffre inventé ici.
    function activeConsShape(): number[] {
      return currentVariant === 'normal' && currentOccupancy === (cfg.occupancy ?? 'presence_partielle')
        ? cfg.consShape
        : consumptionShapeHours(HOURS_PER_DAY, {
            mode: cfg.mode,
            variant: currentVariant,
            occupancy: currentOccupancy,
            ramadan: cfg.ramadan,
          });
    }

    function update(n: number): void {
      currentN = n;
      const res = simulateBattery({
        consumptionShape: activeConsShape(),
        productionShape: cfg.solarShape,
        dailyConsumptionKwh: cfg.dailyConsKwh,
        dailyProductionKwh: cfg.dailyProdKwh,
        capacityKwhPerUnit: cfg.capacityPerUnit,
        units: n,
      });
      lastHourly = res.hourly;
      setText('battery-sim-units', String(n));
      setText('battery-sim-selfconso', fmtPct(res.selfConsumptionPct));
      setText('battery-sim-selfsuff', fmtPct(res.selfSufficiencyPct));
      setText('battery-sim-backup', fmtNum(res.backupHours, 0));
      setText('battery-sim-direct', fmtNum(res.directKwh, 1));
      setText('battery-sim-battery', fmtNum(res.fromBatteryKwh, 1));
      setText('battery-sim-grid', fmtNum(res.fromGridKwh, 1));
      const chart = document.getElementById('battery-sim-chart');
      if (chart) chart.innerHTML = renderBatterySplitSvg(res.hourly, undefined, curLang());
      renderPrice(n);
      renderPayback(n);
      renderFill(n);
      renderOverStorage(n);
      // ORDRE FONDATEUR (24/08/2026) — la COURBE de la vue « Sur une journée »
      // porte la couche batterie : elle est redessinée avec la série horaire
      // que ce moteur vient de produire (`res.hourly.battery`). Le pont est
      // volontairement dans ce sens (le simulateur POSSÈDE la série, la courbe
      // la LIT) — jamais deux moteurs.
      (window as unknown as { __propRerenderCurves?: () => void }).__propRerenderCurves?.();
    }

    // QRES66 — délégation au NIVEAU DOCUMENT, jamais un listener direct sur le
    // nœud : constaté en prod, le curseur présent au chargement n'était plus le
    // nœud du DOM final (les scripts d'init de la page reconstruisent des
    // sous-arbres après l'exécution de ce module) → le listener direct mourait
    // avec le nœud remplacé et le curseur restait muet, sans aucune erreur.
    // La délégation sur `document` capte l'événement `input` quel que soit le
    // nœud curseur vivant, quel que soit l'ordre d'exécution des modules.
    document.addEventListener('input', (ev) => {
      const t = ev.target as HTMLInputElement | null;
      if (!t || t.id !== 'battery-sim-slider') return;
      const n = Math.max(0, Math.min(cfg.maxUnits, Number(t.value) || 0));
      update(n);
    });

    // Re-localise le prix « sur étude » ET le SVG (title/desc) à chaque bascule
    // de langue — même registre que le libellé PDF (busy-label non couvert par
    // data-i18n car réécrit en JS après le premier rendu).
    bsWin.__propRegisterBusyLabel?.((l: BsLang) => {
      renderPrice(currentN);
      // ORDRE FONDATEUR — « ans / years / سنوات » suit la langue (le nombre, lui,
      // ne bouge jamais : c'est celui du moteur).
      renderPayback(currentN);
      const chart = document.getElementById('battery-sim-chart');
      if (chart && lastHourly) chart.innerHTML = renderBatterySplitSvg(lastHourly, undefined, l);
    });

    // ORDRE FONDATEUR (24/08/2026) — la série horaire « fourni par la batterie »
    // du dernier calcul, exposée à l'île de la courbe journalière (qui la
    // DESSINE sans jamais la recalculer). `null` tant qu'aucun calcul n'a eu
    // lieu, ou quand le curseur est à 0 batterie (aucune couche à dessiner).
    (window as unknown as { __propBatteryHourly?: () => number[] | null }).__propBatteryHourly =
      () => (currentN > 0 ? (lastHourly?.battery ?? null) : null);

    // Recalcule une fois au chargement (idempotent avec le rendu serveur).
    update(currentN);

    // PACT-battery — pont exposé à l'AUTRE île <script> (setupProductionChart,
    // productionLayers/lib/propositionPage) : appelé quand le calque batterie
    // est affiché ET que l'onglet Standard/Été/Ramadan change, pour rejouer
    // EXACTEMENT le même chemin que le curseur d'unités (activeConsShape →
    // simulateBattery → renderBatterySplitSvg), jamais un second moteur.
    // CJ1 — le pont porte AUSSI l'occupation choisie : changer de puce
    // « Présent / Absent / Présence partielle » pendant que le calque batterie
    // est affiché rejoue le simulateur sur la NOUVELLE silhouette, exactement
    // comme un changement d'onglet Standard/Été/Ramadan.
    (window as unknown as { __propSetBatteryVariant?: (v: ProposalCurveVariant, occ?: OccupancyId) => void })
      .__propSetBatteryVariant = (v: ProposalCurveVariant, occ?: OccupancyId) => {
        const nextOcc = occ ?? currentOccupancy;
        if (v === currentVariant && nextOcc === currentOccupancy) return;
        currentVariant = v;
        currentOccupancy = nextOcc;
        update(currentN);
      };
  })();

  // ── WJ128 — « Télécharger le schéma (SVG) » : Blob + URL.createObjectURL,
  // AUCUNE requête réseau (le SVG est déjà dans le DOM, injecté serveur via
  // set:html quand le backend l'a fourni — voir hasSldSvg/sld_svg). Section
  // absente → ni bouton ni conteneur dans le DOM, cette IIFE ne trouve rien et
  // ne fait rien. Regroupé dans CE script (voir la note WJ34/WJ53 ci-dessus :
  // un <script> supplémentaire isolé sur cette route est un risque connu de
  // chunk perdu au bundling), même si ce bloc n'a besoin d'aucun import.
  (function setupSldDownload(): void {
    const btn = document.getElementById('sld-download') as HTMLButtonElement | null;
    const wrap = document.getElementById('sld-svg-wrap');
    if (!btn || !wrap) return;
    const svgEl = wrap.querySelector('svg');
    if (!svgEl) return;
    const filename = btn.dataset.sldFilename || 'schema-electrique.svg';
    btn.addEventListener('click', () => {
      const markup = svgEl.outerHTML;
      const blob = new Blob([markup], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  })();

  // ── WJ129 — visionneuse plein écran du schéma électrique : pan (Pointer
  // Events + capture), pincement à deux doigts, molette (simple ET ctrl+
  // molette), double-tap/double-clic, boutons +/−/⟲, piège de focus léger,
  // fermeture Échap/✕/clic-fond — AUCUNE bibliothèque, toute la géométrie
  // vient de lib/sldViewer.ts (testée sous vitest). Le SVG affiché dans la
  // visionneuse est un CLONE du SVG déjà injecté par le serveur dans la
  // carte-teaser (#sld-svg-wrap) — cloné UNE SEULE FOIS à la première
  // ouverture, jamais un second `set:html` côté Astro (éviterait de doubler
  // le poids de page pour un schéma que beaucoup de visiteurs n'ouvriront
  // jamais en plein écran). Section absente (pas d'étude électrique) → tous
  // les `getElementById` renvoient null, l'IIFE ne fait rien.
  (function setupSldViewer(): void {
    const teaser = document.getElementById('sld-teaser') as HTMLButtonElement | null;
    const expandBtn = document.getElementById('sld-expand') as HTMLButtonElement | null;
    const overlay = document.getElementById('sld-viewer');
    const closeBtn = document.getElementById('sld-viewer-close') as HTMLButtonElement | null;
    const viewport = document.getElementById('sld-viewer-viewport');
    const content = document.getElementById('sld-viewer-content') as HTMLElement | null;
    const zoomInBtn = document.getElementById('sld-viewer-zoom-in');
    const zoomOutBtn = document.getElementById('sld-viewer-zoom-out');
    const zoomResetBtn = document.getElementById('sld-viewer-zoom-reset');
    const sourceWrap = document.getElementById('sld-svg-wrap');
    const sourceSvg = sourceWrap?.querySelector('svg') ?? null;
    if (!teaser || !overlay || !closeBtn || !viewport || !content || !sourceSvg) return;

    let contentSize: Size | null = null;
    let scale = 1;
    let translate: Point = { x: 0, y: 0 };
    let fitScaleValue = 1;
    let lastFocus: HTMLElement | null = null;
    let cloned = false;

    const viewportEl = viewport as HTMLElement;

    function viewportSize(): Size {
      const r = viewportEl.getBoundingClientRect();
      return { width: r.width, height: r.height };
    }

    function apply(): void {
      content!.style.transform = `translate(${translate.x}px, ${translate.y}px) scale(${scale})`;
    }

    // Clone paresseux : le SVG de la carte-teaser reste la SEULE copie tant
    // que la visionneuse n'a jamais été ouverte.
    function ensureClone(): void {
      if (cloned) return;
      const clone = sourceSvg!.cloneNode(true) as SVGSVGElement;
      clone.removeAttribute('id');
      clone.style.width = '100%';
      clone.style.height = '100%';
      content!.appendChild(clone);
      cloned = true;
      const viewBoxSize = parseViewBoxSize(clone.getAttribute('viewBox'));
      const wAttr = Number(clone.getAttribute('width'));
      const hAttr = Number(clone.getAttribute('height'));
      contentSize =
        viewBoxSize ?? (wAttr > 0 && hAttr > 0 ? { width: wAttr, height: hAttr } : { width: 1122, height: 794 });
      content!.style.width = `${contentSize.width}px`;
      content!.style.height = `${contentSize.height}px`;
    }

    function resetToFit(): void {
      if (!contentSize) return;
      const vp = viewportSize();
      fitScaleValue = fitScale(vp, contentSize);
      scale = fitScaleValue;
      translate = centeredTranslate(vp, contentSize, scale);
      apply();
    }

    function setScale(nextScale: number, anchor: Point): void {
      if (!contentSize) return;
      const clamped = clamp(nextScale, SLD_MIN_SCALE, SLD_MAX_SCALE);
      translate = zoomAtPoint(translate, scale, clamped, anchor);
      scale = clamped;
      translate = clampTranslate(translate, viewportSize(), contentSize, scale);
      apply();
    }

    function open(trigger: HTMLElement): void {
      lastFocus = trigger;
      ensureClone();
      overlay!.hidden = false;
      overlay!.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      // L'overlay `fixed` vient d'apparaître : un reflow FORCÉ (lecture
      // d'offsetWidth) suffit pour que getBoundingClientRect() du viewport
      // reflète sa taille réelle — SYNCHRONE, donc le fit s'applique même
      // quand requestAnimationFrame est suspendu (onglet caché/arrière-plan,
      // le navigateur gèle les frames : un fit-par-rAF laissait alors le
      // schéma à l'échelle 1, débordant l'écran). rAF ne reste qu'en FILET
      // pour le cas résiduel d'un viewport mesuré à 0 pendant l'ouverture.
      void viewportEl.offsetWidth;
      resetToFit();
      closeBtn!.focus();
      if (!(viewportEl.getBoundingClientRect().width > 0)) {
        requestAnimationFrame(() => resetToFit());
      }
    }

    function close(): void {
      overlay!.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    teaser.addEventListener('click', () => open(teaser));
    if (expandBtn) {
      const expandBtnEl = expandBtn;
      expandBtnEl.addEventListener('click', () => open(expandBtnEl));
    }
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    overlay.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusable = Array.from(
        overlay!.querySelectorAll<HTMLElement>('button, [href], [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => !el.hidden && el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    zoomInBtn?.addEventListener('click', () => {
      const vp = viewportSize();
      setScale(scale * 1.5, { x: vp.width / 2, y: vp.height / 2 });
    });
    zoomOutBtn?.addEventListener('click', () => {
      const vp = viewportSize();
      setScale(scale / 1.5, { x: vp.width / 2, y: vp.height / 2 });
    });
    zoomResetBtn?.addEventListener('click', resetToFit);

    // ── Pan (un pointeur) + pincement (deux pointeurs) ─────────────────────
    const pointers = new Map<number, Point>();
    let panStart: Point | null = null;
    let translateStart: Point | null = null;
    let pinchStartDistance = 0;
    let pinchStartScale = 1;
    let gestureKind: 'none' | 'pan' | 'pinch' = 'none';
    let tapDownPoint: Point | null = null;
    let tapDownTime = 0;
    let lastTap: TapRecord | null = null;

    function pointFromEvent(e: PointerEvent): Point {
      const r = viewportEl.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    viewportEl.addEventListener('pointerdown', (e: PointerEvent) => {
      viewportEl.setPointerCapture(e.pointerId);
      const p = pointFromEvent(e);
      pointers.set(e.pointerId, p);
      if (pointers.size === 1) {
        panStart = p;
        translateStart = { ...translate };
        gestureKind = 'pan';
        tapDownPoint = p;
        tapDownTime = e.timeStamp;
      } else if (pointers.size === 2) {
        const pts = Array.from(pointers.values());
        pinchStartDistance = pointDistance(pts[0]!, pts[1]!);
        pinchStartScale = scale;
        panStart = null;
        gestureKind = 'pinch';
      }
      viewportEl.dataset.panning = 'true';
      e.preventDefault();
    });

    viewportEl.addEventListener('pointermove', (e: PointerEvent) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, pointFromEvent(e));
      if (pointers.size >= 2 && contentSize) {
        const pts = Array.from(pointers.values());
        const a = pts[0]!;
        const b = pts[1]!;
        const dist = pointDistance(a, b);
        const mid = pointMidpoint(a, b);
        const newScale = pinchScale(pinchStartScale, pinchStartDistance, dist);
        translate = zoomAtPoint(translate, scale, newScale, mid);
        scale = newScale;
        translate = clampTranslate(translate, viewportSize(), contentSize, scale);
        apply();
      } else if (panStart && translateStart && contentSize) {
        const p = pointFromEvent(e);
        translate = {
          x: translateStart.x + (p.x - panStart.x),
          y: translateStart.y + (p.y - panStart.y),
        };
        translate = clampTranslate(translate, viewportSize(), contentSize, scale);
        apply();
      }
      e.preventDefault();
    });

    function endPointer(e: PointerEvent): void {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchStartDistance = 0;
      if (pointers.size === 1) {
        // Un doigt reste après un pincement : redémarre un pan propre depuis
        // sa position actuelle plutôt que de sauter sur l'ancien panStart.
        const remaining = Array.from(pointers.values())[0]!;
        panStart = remaining;
        translateStart = { ...translate };
        gestureKind = 'pan';
        return;
      }
      if (pointers.size > 0) return;
      viewportEl.dataset.panning = 'false';
      // Double-tap/double-clic UNIQUEMENT si ce pointeur n'a quasiment pas
      // bougé (un pan/pincement qui se termine près d'un point ne doit pas
      // se faire passer pour un tap) et n'a pas traîné trop longtemps. Le
      // viewport occupe TOUT l'espace sous l'en-tête (aucun « fond » nu
      // n'entoure l'en-tête ou les boutons flottants) : un simple tap qui
      // tombe HORS du rectangle actuel du schéma (translate/scale connus) EST
      // le « clic sur le fond » qui doit fermer la visionneuse — un tap SUR
      // le schéma continue de suivre la logique double-tap ci-dessous.
      const p = pointFromEvent(e);
      const wasPan = gestureKind === 'pan';
      const movedFar = tapDownPoint ? pointDistance(tapDownPoint, p) > 10 : true;
      const tookTooLong = e.timeStamp - tapDownTime > 500;
      if (wasPan && !movedFar && !tookTooLong) {
        const withinContent =
          !!contentSize &&
          p.x >= translate.x &&
          p.x <= translate.x + contentSize.width * scale &&
          p.y >= translate.y &&
          p.y <= translate.y + contentSize.height * scale;
        if (!withinContent) {
          lastTap = null;
          close();
        } else {
          const tap: TapRecord = { x: p.x, y: p.y, time: e.timeStamp };
          if (isDoubleTap(lastTap, tap)) {
            lastTap = null;
            const next = doubleTapScale(scale, fitScaleValue);
            if (Math.abs(next - fitScaleValue) < 0.001) {
              resetToFit();
            } else {
              setScale(next, p);
            }
          } else {
            lastTap = tap;
          }
        }
      } else {
        lastTap = null;
      }
      panStart = null;
      translateStart = null;
      gestureKind = 'none';
    }
    viewportEl.addEventListener('pointerup', endPointer);
    viewportEl.addEventListener('pointercancel', endPointer);

    // ── Molette : simple OU ctrl+molette (trackpad pinch du navigateur) —
    // les deux zooment au curseur, jamais un scroll de page (preventDefault
    // systématique, cohérent avec touch-action:none ci-dessus en CSS).
    viewportEl.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        if (!contentSize) return;
        e.preventDefault();
        const r = viewportEl.getBoundingClientRect();
        const anchor = { x: e.clientX - r.left, y: e.clientY - r.top };
        const factor = e.deltaY > 0 ? 1 / 1.15 : 1.15;
        setScale(scale * factor, anchor);
      },
      { passive: false },
    );

    // Note double-clic souris : PointerEvent unifie souris/tactile/stylet —
    // le détecteur pointerdown/pointerup ci-dessus (`isDoubleTap`) couvre
    // DÉJÀ le double-clic sans listener `dblclick` séparé. En ajouter un
    // ferait doublonner le geste (deux bascules au lieu d'une, la seconde
    // annulant visuellement la première) : un seul chemin de détection.

    // ── Redimensionnement (rotation d'écran, barre d'adresse qui se
    // rétracte…) : re-fit si l'utilisateur n'avait pas zoomé manuellement,
    // sinon reclampe juste la translation dans les nouvelles bornes.
    window.addEventListener('resize', () => {
      if (overlay!.hidden || !contentSize) return;
      const wasFit = Math.abs(scale - fitScaleValue) < 0.001;
      if (wasFit) {
        resetToFit();
      } else {
        translate = clampTranslate(translate, viewportSize(), contentSize, scale);
        apply();
      }
    });
  })();
</script>

<style is:global>
  /* Fondateur 2026-08-15 — « retirer tout crédit/financement pour l'instant » :
     sur CETTE page uniquement, les entrées de navigation du site vers
     /financement (en-tête ×2 + pied de page) sont masquées ; le composant
     global Header/Footer reste intact pour tout le reste du site. */
  a[href='/financement'] {
    display: none !important;
  }
</style>

<style>
  /* P2 — réserve le ratio du graphe (viewBox 360×150 = 2.4:1) AVANT le rendu du
     SVG inline pour garantir zéro CLS. Le SVG enfant occupe 100 % de la largeur,
     hauteur auto ; aucune transition (mouvement réduit respecté par construction). */
  .chart-svg {
    width: 100%;
    aspect-ratio: 360 / 150;
  }
  .chart-svg :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* WJ80 — affordance tap-to-reveal : curseur main sur les barres (souris) ;
     le tactile n'a pas besoin de curseur mais bénéficie du focus-visible
     ci-dessous (navigation clavier — les barres portent tabindex="0"). */
  .chart-svg :global([data-chart-bar]) {
    cursor: pointer;
  }
  .chart-svg :global([data-chart-bar]:focus-visible) {
    outline: 2px solid var(--color-brass-300, #f3cc66);
    outline-offset: 1px;
  }

  /* WJ16 — courbe journalière : ratio réservé AVANT rendu (viewBox 360×170)
     → zéro CLS. Le SVG enfant occupe 100 % de la largeur. */
  .daily-curve-wrap {
    width: 100%;
    aspect-ratio: 360 / 170;
  }
  .daily-curve-wrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* WJ120 — aire empilée « direct/batterie/réseau » : ratio réservé AVANT rendu
     (viewBox 360×150) → zéro CLS ; le SVG (re-rendu au curseur) occupe la boîte. */
  .battery-split-wrap {
    width: 100%;
    aspect-ratio: 360 / 150;
  }
  .battery-split-wrap :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* WJ129 — carte-teaser du schéma électrique (SLD). Mobile-first : cadre à
     hauteur MAÎTRISÉE (320px, ni le ratio 302×213 illisible d'origine ni un
     CLS — c'est une hauteur fixe, pas un ratio dépendant du contenu), le SVG
     backend (contenu variable, aucun viewBox connu d'avance) est affiché en
     LÉGER SURCADRAGE (155 % de la largeur du cadre) ancré haut-gauche et
     rogné par `overflow: hidden` — un aperçu, pas une lecture (la lecture se
     fait dans la visionneuse plein écran ci-dessous). Desktop (sm+, la carte
     fait ~896px de large en max-w-4xl) : le SVG entier, hauteur auto,
     redevient lisible tel quel (~×0.8) — plus de cadrage fixe. */
  .sld-teaser-frame {
    position: relative;
    display: block;
    height: 320px;
    overflow: hidden;
    background: var(--color-azur-950, #0a1a33);
  }
  .sld-teaser-frame .sld-svg-wrap {
    position: absolute;
    inset: 0;
  }
  .sld-teaser-frame .sld-svg-wrap :global(svg) {
    display: block;
    width: 155%;
    max-width: none;
    height: auto;
  }
  @media (min-width: 640px) {
    .sld-teaser-frame {
      height: auto;
      overflow: visible;
    }
    .sld-teaser-frame .sld-svg-wrap {
      position: static;
      inset: auto;
    }
    .sld-teaser-frame .sld-svg-wrap :global(svg) {
      width: 100%;
    }
  }
  /* Voile sombre bas + affordance « Agrandir » — pleine intensité en mobile
     (le SVG y est de toute façon illisible, le voile ne cache rien d'utile) ;
     très légère en desktop (le schéma y est déjà lisible, on ne veut pas
     l'assombrir). */
  .sld-teaser-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(7 11 29 / 0.88) 0%, rgb(7 11 29 / 0.5) 40%, transparent 78%);
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .sld-teaser-veil {
      background: linear-gradient(to top, rgb(7 11 29 / 0.5) 0%, transparent 34%);
    }
  }
  .sld-teaser-cta {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    pointer-events: none;
    white-space: nowrap;
  }
  .sld-teaser:hover .sld-teaser-cta,
  .sld-teaser:focus-visible .sld-teaser-cta {
    background: var(--color-brass-400);
    border-color: var(--color-brass-400);
    color: var(--color-nuit);
  }

  /* ─── WJ129 — visionneuse plein écran (pan/pointeur + pinch + molette +
     double-tap, géométrie pure dans lib/sldViewer.ts). Même recette que le
     lightbox photo de realisations/[slug].astro : overlay fixed inset-0,
     fond nuit quasi opaque, bouton fermer 44px, piège de focus léger,
     fermeture Échap/✕/clic-fond. z-index dédié à CETTE page, largement
     au-dessus de tout le reste (sélecteur de langue z-50, CTA collant z-40).
     Boutons flottants ancrés en position PHYSIQUE (right/bottom, jamais
     inset-inline-end) : la visionneuse fonctionne identiquement en RTL sans
     aucune bascule liée à `dir` — seul le TITRE (texte traduit) suit le sens
     naturel de la langue via le flex du header. */
  .sld-viewer {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    flex-direction: column;
    background: rgb(7 11 29 / 0.97);
  }
  .sld-viewer[hidden] {
    display: none;
  }
  .sld-viewer-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: max(0.75rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) 0.75rem max(1rem, env(safe-area-inset-left));
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .sld-viewer-title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-lune);
  }
  .sld-viewer-close {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-lune);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 9999px;
    background: transparent;
    cursor: pointer;
    transition: color 200ms, border-color 200ms;
  }
  .sld-viewer-close:hover,
  .sld-viewer-close:focus-visible {
    color: var(--color-brass-300);
    border-color: var(--color-brass-400);
  }
  /* touch-action: none — le pan/pincement ne doit JAMAIS scroller la page
     derrière (voir aussi document.body.style.overflow verrouillé en JS). */
  .sld-viewer-viewport {
    position: relative;
    flex: 1 1 auto;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }
  .sld-viewer-viewport[data-panning="true"] {
    cursor: grabbing;
  }
  .sld-viewer-content {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }
  .sld-viewer-content :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sld-viewer-controls {
    position: absolute;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sld-viewer-fab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-lune);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 9999px;
    background: rgb(7 11 29 / 0.85);
    cursor: pointer;
    transition: color 200ms, border-color 200ms;
  }
  .sld-viewer-fab:hover,
  .sld-viewer-fab:focus-visible {
    color: var(--color-brass-300);
    border-color: var(--color-brass-400);
  }

  /* WJ80 — même affordance tap-to-reveal sur le repère pic/moyenne. */
  .daily-curve-wrap :global([data-curve-scale]) {
    cursor: pointer;
  }
  .daily-curve-wrap :global([data-curve-scale]:focus-visible) {
    outline: 2px solid var(--color-brass-300, #f3cc66);
    outline-offset: 1px;
  }

  /* WJ11 — pad de signature : hauteur fixe (zéro CLS) ; pas de débordement.
     touch-none (classe utilitaire) empêche le scroll pendant le tracé.
     WJ101 — le canvas est désormais focusable (tabindex="0") : un contour de
     focus visible est requis (WCAG 2.4.7), jamais un `outline: none` implicite. */
  .sign-pad {
    height: 160px;
    cursor: crosshair;
  }
  .sign-pad:focus-visible {
    outline: 2px solid var(--color-brass-400, #e8b54a);
    outline-offset: 2px;
  }

  /* WJ25/WJ27 — scène 3D : ratio RÉSERVÉ avant tout chargement (zéro CLS).
     Le poster occupe la boîte ; le canvas (créé par la visionneuse) la recouvre.
     touch-action: none sur le canvas = orbite/pinch sans scroller la page. */
  .roof3d-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-azur-950, #0a1a33);
  }
  /* WJ129 — en mobile étroit, le ratio 16/10 réduisait la scène à ~209px de
     haut (largeur de carte ~335px) : trop court pour orbiter confortablement.
     `min-height` reste un réservoir STATIQUE (zéro CLS, comme l'aspect-ratio
     ci-dessus — il ne dépend d'aucune donnée async) qui prend le dessus sur
     la hauteur dérivée du ratio quand celle-ci est plus petite ; le ratio
     16/10 continue de s'appliquer tel quel dès que la largeur suffit (sm+, où
     209px n'était de toute façon jamais le problème). */
  @media (max-width: 639.98px) {
    .roof3d-stage {
      min-height: 300px;
    }
  }
  /* WJ118 — la scène Three.js est transparente (setClearColor 0,0,
     roofPro11/viewerOnly.ts) : sans photo satellite, le fond nuit ci-dessus
     reste (rendu abstrait actuel, inchangé). Quand la photo est RÉELLEMENT
     drapée (roofImage résolu côté client, clé MAPTILER/MAPBOX configurée +
     contour ≥3 sommets + image chargée), la visionneuse ajoute cette classe :
     un ciel clair/jour, cohérent avec une vraie vue satellite plutôt qu'un
     vide bleu nuit. Même dégradé que mon-toit.astro (.mt-panels3d-stage). */
  .roof3d-stage.roof3d-stage--sky {
    background: linear-gradient(180deg, #b9d7ee 0%, #dcebf7 55%, #f2ecdf 100%);
  }
  .roof3d-stage :global(canvas) {
    touch-action: none;
    cursor: grab;
  }
  .roof3d-stage :global(canvas:active) {
    cursor: grabbing;
  }
  /* VISIONNEUSE PLEINE : MapLibre gère lui-même curseur et `touch-action`
     (gestes coopératifs — un doigt fait défiler la PAGE, deux doigts déplacent
     la carte). Les deux règles ci-dessus, écrites pour le canvas Three.js seul,
     doivent être neutralisées quand la carte est montée, sinon un doigt posé sur
     la carte bloque le défilement de la proposition. */
  .roof3d-stage.roof3d-stage--map :global(canvas) {
    touch-action: unset;
    cursor: unset;
  }
  /* Scrim léger pour la lisibilité du bouton/note posés sur la photo. */
  .roof3d-scrim {
    background: linear-gradient(to top, rgb(7 11 29 / 0.55), rgb(7 11 29 / 0.15));
  }

  /* WJ26 — étape active de la visite guidée : simple surlignage laiton (aucun
     mouvement, aucune hauteur qui change → zéro CLS, reduced-motion-safe). */
  .walk-step[aria-current='step'] {
    border-color: rgb(232 181 74 / 0.45);
  }

  /* WJ16 — animation : tracé des courbes + lever de soleil, GATÉE derrière
     prefers-reduced-motion. Sans préférence de mouvement, les courbes sont
     dessinées statiquement (dasharray neutre) — jamais cachées. */
  @media (prefers-reduced-motion: no-preference) {
    /* La ligne de production est tracée (dasharray sur une ligne pleine). */
    .daily-curve-wrap :global(.curve-solar-line) {
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
      animation: curve-draw 1.6s ease-out forwards;
    }
    /* La conso (pointillée 4 3) ne peut pas être « tracée » sans casser son
       motif : on la fait simplement apparaître en fondu, motif préservé. */
    .daily-curve-wrap :global(.curve-cons-line) {
      opacity: 0;
      animation: curve-fade 1s ease-out 0.6s forwards;
    }
    .daily-curve-wrap :global(.curve-solar-fill) {
      opacity: 0;
      animation: curve-fade 1.2s ease-out 0.8s forwards;
    }
    .daily-curve-wrap :global(.curve-sun) {
      transform-box: fill-box;
      transform-origin: center;
      opacity: 0;
      animation: sun-rise 1.4s ease-out 0.3s forwards;
    }
  }
  @keyframes curve-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes curve-fade {
    to { opacity: 1; }
  }
  @keyframes sun-rise {
    from { opacity: 0; transform: translateY(10px) scale(0.6); }
    to { opacity: 0.9; transform: translateY(0) scale(1); }
  }

  /* WJ34 — poster blur-up du héros : dégradé « heure dorée » tenant le cadre
     jusqu'à ce que la vraie photo (URL backend dynamique) ait fini de charger.
     L'image LCP reste TOUJOURS dans le DOM/peinte dès que possible (jamais
     display:none) — seule son opacité anime, gated reduced-motion ; sans JS
     ou en reduced-motion l'image est directement opaque (aucune dépendance à
     l'événement onload pour être visible). */
  .hero-lqip {
    background: linear-gradient(160deg, #1a2e4d 0%, #0a1730 60%, #070b1d 100%);
  }
  .hero-photo {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo {
      opacity: 0;
      transition: opacity 0.5s ease-out;
    }
    .hero-photo.is-loaded {
      opacity: 1;
    }
  }

  /* WJ78 — sceau ✓ du moment après signature. Statique (visible, opacité 1)
     par défaut ; l'anneau se dessine et le check apparaît en fondu UNIQUEMENT
     sans préférence de mouvement réduit (jamais caché en reduced-motion —
     juste immobile). Zéro CLS : taille fixe, pas de mise en page dépendante. */
  .success-seal {
    width: 52px;
    height: 52px;
  }
  .success-seal-ring,
  .success-seal-check {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .success-seal-ring {
      stroke-dasharray: 151;
      stroke-dashoffset: 151;
      animation: seal-ring-draw 0.5s ease-out forwards;
    }
    .success-seal-check {
      stroke-dasharray: 34;
      stroke-dashoffset: 34;
      opacity: 0;
      animation: seal-check-draw 0.35s ease-out 0.45s forwards;
    }
  }
  @keyframes seal-ring-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes seal-check-draw {
    to { stroke-dashoffset: 0; opacity: 1; }
  }

  /* WJ84 — page imprimable propre. Ctrl-P est un réflexe naturel sur une
     proposition ; sans ces règles, le chrome flottant (bascule langue, CTA
     collant) et le fond sombre produisaient du "dark-on-dark" par-dessus le
     contenu imprimé. `.print-hint` est masqué à l'écran (classe utilitaire
     `hidden`) et réapparaît UNIQUEMENT en impression. */
  .print-hint {
    display: none;
  }
  @media print {
    .print-hint {
      display: block;
      margin: 0 0 1rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid #999;
      font-size: 11px;
      color: #111;
      background: #fff;
