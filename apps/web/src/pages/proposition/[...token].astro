      <!-- ── PV80 · FAQ — les TROIS objections qui reviennent vraiment. La liste
           complète (objectionFaq) reste dans la lib ; on n’en rend plus que le
           haut du panier — un accordéon de 5 items lit comme un mode d’emploi. -->
      <section id="faq" class="mx-auto max-w-4xl px-5 pt-16 sm:px-8">
        <p class="tech-label rule-brass text-brass-300" data-i18n data-fr="Vos questions, nos réponses" data-en="Your questions, our answers" data-ar="أسئلتكم، وأجوبتنا">Vos questions, nos réponses</p>
        <div class="mt-5 space-y-3">
          {faq.slice(0, 3).map((item) => (
            <details class="cine-card rounded-xl p-5">
