                    ))}
                  </div>
                  <p class="mt-3 text-sm text-lune-soft">
                    <span data-i18n data-fr="Total annuel estimé :" data-en="Estimated annual total:" data-ar="المجموع السنوي المقدّر:">Total annuel estimé :</span>{' '}
                    <span class="font-semibold text-lune" dir="ltr">{formatMAD(ecoMensuelles.totalSans)}</span>
                    {ecoMensuelles.totalAvec !== null && (
                      <>
                        {' '}<span data-i18n data-fr="· avec batterie :" data-en="· with a battery:" data-ar="· مع بطارية:">· avec batterie :</span>{' '}
                        <span class="font-semibold text-brass-300" dir="ltr">{formatMAD(ecoMensuelles.totalAvec)}</span>
                      </>
                    )}
                  </p>
                  {ecoMensuelles.estimation && (
                    <p class="mt-1 text-xs text-lune-faint" data-i18n
                      data-fr="(estimation — consommation déduite de votre facture)"
