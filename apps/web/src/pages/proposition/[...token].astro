 * fonction ne fait que choisir QUELLE valeur servie montrer (celle « avec
 * batterie » quand le devis EN PORTE une, celle « sans » sinon : on compare
 * toujours la famille d'installation que CE devis propose) et l'habiller.
 */
const occEcoTri = (s: { economieSansMad: number; economieAvecMad: number | null }): OccTri => {
  const avec = occScenarios?.avecBatterie === true && s.economieAvecMad !== null;
  const montant = formatMAD(avec ? (s.economieAvecMad as number) : s.economieSansMad);
  return avec
    ? { fr: `${montant}/an avec votre batterie`, en: `${montant}/year with your battery`, ar: `${montant}/سنة مع بطاريتك` }
    : { fr: `${montant}/an`, en: `${montant}/year`, ar: `${montant}/سنة` };
};
/** Le second chiffre (sans batterie), montré UNIQUEMENT quand le devis porte
 *  du stockage — sinon il ferait doublon avec la ligne principale. */
const occEcoSecondTri = (s: { economieSansMad: number; economieAvecMad: number | null }): OccTri | null => {
  if (occScenarios?.avecBatterie !== true || s.economieAvecMad === null) return null;
  const montant = formatMAD(s.economieSansMad);
  return { fr: `${montant}/an sans batterie`, en: `${montant}/year without battery`, ar: `${montant}/سنة بدون بطارية` };
};
/** Autoconsommation + couverture, dans la même variante que la ligne d'économies. */
const occTauxTri = (s: {
  tauxAutoconsoSansPct: number | null; tauxAutoconsoAvecPct: number | null;
  couvertureSansPct: number | null; couvertureAvecPct: number | null;
}): OccTri | null => {
  const avec = occScenarios?.avecBatterie === true;
  const auto = avec ? (s.tauxAutoconsoAvecPct ?? s.tauxAutoconsoSansPct) : s.tauxAutoconsoSansPct;
  const couv = avec ? (s.couvertureAvecPct ?? s.couvertureSansPct) : s.couvertureSansPct;
  if (auto === null && couv === null) return null;
  const bouts = (labelAuto: string, labelCouv: string) => [
    auto === null ? null : `${labelAuto} ${formatNumber(auto, 1)} %`,
    couv === null ? null : `${labelCouv} ${formatNumber(couv, 1)} %`,
  ].filter((p): p is string => p !== null).join(' · ');
  return {
    fr: bouts('Autoconsommation', 'Couverture'),
    en: bouts('Self-consumption', 'Coverage'),
    ar: bouts('الاستهلاك الذاتي', 'التغطية'),
  };
};
/**
 * « L'installation optimale pour ce comportement » — LA RECOMMANDATION DU
 * MOTEUR pour cette silhouette, jamais une règle inventée ici. `null` quand le
 * moteur ne recommande rien (catalogue incomplet) : on se tait plutôt que de
 * proposer une taille au hasard.
 */
const occOptimalTri = (s: {
  optimal: { kwc: number; batterieKwh: number; avecBatterie: boolean; identiqueAuDevis: boolean | null } | null;
}): OccTri | null => {
  const o = s.optimal;
  if (!o) return null;
  if (o.identiqueAuDevis === true) {
    return {
      fr: 'Votre devis est déjà optimal pour ce profil.',
      en: 'Your quote is already optimal for this profile.',
      ar: 'عرضكم مثالي بالفعل لهذا النمط.',
    };
  }
  const kwc = formatNumber(o.kwc, 2);
  const batt = o.avecBatterie && o.batterieKwh > 0 ? occKwh(o.batterieKwh) : null;
  return {
    fr: `Installation optimale pour ce comportement : ${kwc} kWc${batt ? ` + ${batt} kWh de batterie` : ''}.`,
    en: `Optimal system for this behaviour: ${kwc} kWp${batt ? ` + ${batt} kWh battery` : ''}.`,
    ar: `النظام الأمثل لهذا السلوك: ${kwc} kWc${batt ? ` + ${batt} kWh بطارية` : ''}.`,
  };
};

// ── WJ14 — Impact environnemental humain (CO₂ ≈ arbres), depuis la production ─
const enviro = ok ? environmentalImpact(prodKwh) : null;

// ── PV80 — AUCUN CRÉDIT, AUCUNE MENSUALITÉ, AUCUNE BANQUE SUR CETTE PAGE ────
// Trois blocs « argent emprunté » y vivaient (comparatif éco-prêt WJ10, bloc
// financement backend WJ32, toggle comptant/échelonné WJ53). Ils ont été
// RETIRÉS : cette page vend une installation, pas un crédit — et un tableau de
// mensualités indicatives « à confirmer avec votre banque » au milieu d'une
// proposition affaiblit le seul chiffre qui compte (le prix TTC clé en main).
// Les fonctions correspondantes de lib/proposition.ts (financingComparison,
// backendFinancing, installmentSplit) restent INTACTES — d'autres surfaces
// peuvent les utiliser ; seul leur USAGE ici disparaît. Rien n'est retiré du
// payload backend : on choisit ce qu'on REND, pas ce qu'on reçoit.

// ── WJ12 — Contact intégré : deep-link WhatsApp prérempli avec la réf devis ──
// « Demander un rappel » = appeler le numéro TAQINOR (NAP), jamais le numéro du
// client. Numéro réel (= lib/nap NAP.phone), affiché tel quel.
const waLink = ok ? whatsappLink(reference) : '';
const TAQINOR_TEL = '+212661850410';
const callbackHref = ok ? `tel:${TAQINOR_TEL}` : '';
// WJ85 — « Discuter » et « Poser une question » pointaient vers le MÊME
// waLink (un seul message générique) : deux boutons faisant la même chose au
// point de décision de la page lisent comme du remplissage. Prérempli DISTINCT
// par intention (voir whatsappLinkForIntent) ; waLinkVoice sert l'invitation
// à la note vocale (canal natif WhatsApp, plus rapide pour beaucoup de clients).
const waLinkDiscuss = ok ? whatsappLinkForIntent(reference, 'discuss') : '';
const waLinkQuestion = ok ? whatsappLinkForIntent(reference, 'question') : '';
const waLinkVoice = ok ? whatsappLinkForIntent(reference, 'voice') : '';

// ── WJ56 — « Partager sur WhatsApp » : le lien TOKENISÉ lui-même (même page),
// pour qu'un conjoint/co-décideur le reçoive sans rien ressaisir. `Astro.url`
// est l'URL COMPLÈTE réellement servie (jamais reconstruite manuellement).
const shareUrl = ok ? Astro.url.href : '';
const waLinkShare = ok ? whatsappShareLink(shareUrl, reference) : '';

// ── W343 — « Partager avec un proche » (parrainage, état signé/merci) : lien
// TAGUÉ vers /parrainage (utm_campaign = référence du devis SIGNÉ), DISTINCT
// du partage WJ56 ci-dessus (qui partage CE devis avec un co-décideur du même
// foyer, pas le programme de parrainage avec un proche différent).
const waLinkReferral = ok ? whatsappReferralLink(Astro.url.origin, reference) : '';

// ── P3 — Lien public du devis PDF premium (même token, nouvel onglet) ────────
const pdfUrl = ok ? proposalPdfEndpoint(API_BASE, token) : '';

// ── WJ25 — visionneuse 3D en lecture seule (layout backend QJ26) ────────────
// Le backend expose `roof_layout` depuis QJ26 (_safe_roof_layout,
// apps/ventes/public_views.py) : quand le devis porte un layout exploitable,
// le modèle 3D (JSON pur) est calculé ICI côté serveur — le client ne charge
// que le rendu Three.js, en différé (jamais au premier paint). Layout
// absent/invalide → le parse renvoie null et la page garde EXACTEMENT le héros
// statique d'aujourd'hui.
const roofLayout = ok ? parseRoofLayout(data?.roof_layout) : null;
const viewerModel = roofLayout ? buildViewerModel(roofLayout) : null;
const show3d = !!viewerModel && viewerModel.totalPanels >= 0;
// PVUNI (fondateur 2026-08-18) — LE CALEPINAGE 3D EST-IL PÉRIMÉ ?
// Servi par le backend, jamais recalculé ici : c'est lui qui compare le compte
// de panneaux pour lequel la 3D a été jouée à celui des LIGNES du devis (la
// seule source de vérité). Sur le devis DEV-202608-0007, les lignes étaient
// passées de 8 à 9 panneaux sans que la 3D soit rejouée — le client voyait
// donc un toit qui n'était plus le sien, sans que rien ne l'en avertisse.
// false/absent (le cas de très loin le plus courant) → aucun rendu de plus.
const layoutStale = ok && data?.layout_stale === true;
const layoutPanneaux = layoutStale ? (data?.layout_nb_panneaux ?? null) : null;
// WJ118 — contour aplati [lat,lng] (roof_layout.zones[].vertices, [lng,lat] →
// [lat,lng] — même convention que captureOutline) transmis au client pour
// draper la VRAIE photo satellite sur la 3D (buildPublicRoofImageSpec) ; vide
// si aucun roof_layout exploitable, le client saute alors l'appel réseau.
const roofOutlineLatLng = roofLayout ? roofLayoutOutlineLatLng(roofLayout) : [];
const viewerConfig = show3d ? JSON.stringify({ model: viewerModel, roofOutlineLatLng, layout: roofLayout }) : null;

// ── WJ128 — Schéma électrique (SLD) : rendu UNIQUEMENT quand le backend
// fournit `sld_svg` (étude électrique du devis existante) — absent/null →
// rien de nouveau sur la page (comportement actuel inchangé). Le SVG est déjà
// nettoyé côté serveur (client-safe) : injecté tel quel, jamais reparsé.
const showSld = ok && data ? hasSldSvg(data) : false;
const sldSvg = showSld ? (data!.sld_svg ?? '') : '';
const sldFilename = showSld ? sldSvgFilename(reference) : '';

// ── W342 — « L'installation la plus proche de chez vous » ────────────────────
// Priorité au VRAI GPS du toit (premier sommet du premier pan de
// roofLayout — [lng, lat]) quand le backend l'expose (QJ26) ; à défaut,
// correspondance texte du nom de ville dans `client_addr` (déjà exposé).
// Honnêtement scopé aux villes réelles de REALISATIONS (nearestRealisation
// borne à 80 km) — jamais une ville devinée.
const roofPinLngLat = roofLayout?.zones?.[0]?.vertices?.[0] ?? null;
const nearestInstall = ok
  ? (roofPinLngLat ? nearestRealisation(roofPinLngLat[1], roofPinLngLat[0])?.realisation ?? null : null) ??
    (q?.client_addr ? nearestRealisationByCityText(q.client_addr) : null)
  : null;
const nearestInstallHref = nearestInstall ? `/realisations/${nearestInstall.slug}` : '';
// (fondateur 2026-08-17) production MESURÉE de ce chantier — affichée UNIQUEMENT
// quand la réalisation déclare son appariement avec la flotte supervisée
// (measuredPlantFor : aucun appariement heuristique ville/puissance). Le cumul
// est « depuis la mise en service », jamais converti en production annuelle. Il
// n'existe AUCUNE estimation publiée par chantier (WB1 les a toutes retirées) :
// la comparaison mesuré/estimé se réduit donc au chiffre mesuré, ou à rien.
const nearestMeasured = measuredPlantFor(nearestInstall);
const nearestMeasuredMwh = nearestMeasured ? formatNumber(nearestMeasured.lifetimeMWh, 2) : '';
const nearestMeasuredDate = nearestMeasured ? formatDateFr(nearestMeasured.readAt) : '';
const nearestMeasuredFr = nearestMeasured
  ? `Production mesurée : ${nearestMeasuredMwh} MWh depuis la mise en service`
    + (nearestMeasuredDate ? ` (relevé au ${nearestMeasuredDate})` : '')
  : '';
const nearestMeasuredEn = nearestMeasured
  ? `Measured output: ${nearestMeasuredMwh} MWh since commissioning`
    + (nearestMeasuredDate ? ` (as measured on ${nearestMeasuredDate})` : '')
  : '';
const nearestMeasuredAr = nearestMeasured
  ? `إنتاج مقيس: ${nearestMeasuredMwh} ميغاواط-ساعة منذ التشغيل`
    + (nearestMeasuredDate ? ` (قراءة بتاريخ ${nearestMeasuredDate})` : '')
  : '';

// ── WJ26 — « Tout est expliqué » : légende par pan + visite guidée en 4 étapes.
// Chaque chiffre vient du layout serveur ou du payload quote (les fonctions
// renvoient null / « estimation indisponible » quand la donnée manque).
// (fondateur 2026-08-15) zoneAnnotations/walkthroughSteps ne sont plus rendues
// ici — cartes « ZONE n » et visite guidée retirées de la page.

// ── PV80 · CHAPITRE 3 — « VOTRE INSTALLATION » (équipement STRUCTURÉ) ────────
// Le reproche « beaucoup de données non structurées » visait exactement ceci :
// l'équipement était une liste à puces noyée DANS la carte de prix, mélangée
// aux totaux HT/TVA/TTC. Il devient un tableau propre, à sa place — désignation
// × quantité, groupé par famille, SANS aucun prix par ligne (le prix vit au
// chapitre 7, une seule fois). Le tableau montre l'option retenue ; quand le
// devis en porte deux, `equipmentExtra` dit en UNE ligne ce que la seconde
// ajoute, au lieu d'un second tableau.
const equipmentOption: OptionKey = reco ?? 'sans_batterie';
const equipmentItems = ok ? optionItems(data!, equipmentOption) : [];
// WJ131 — chaque ligne emporte le slug de SA fiche technique, calculé UNE fois
// ici (fonction pure, testée) : le tableau se contente d'afficher le lien quand
// il existe. `null` = ligne sans lien, l'affichage ne change pas d'un pixel.
// (fondateur 2026-08-18) « DANS VOTRE INSTALLATION » — le détail électrique du
// devis, exposé SANS PRIX. Le backend n'envoie ce bloc que lorsque l'étude
// électrique existe ; sinon `null` et rien ne change sur la page. Chaque ligne
// d'équipement reçoit la PART qui la concerne (protections DC / protections AC /
// sections de câble / chaînage), ou `null` — et un `null` ne rend aucun
// dépliant : jamais un volet vide sous une ligne.
const conception = ok ? parseConceptionElectrique(data!) : null;
// Deux corrections de CATALOGUE RÉEL (le devis résidentiel type ne porte comme
// postes génériques que « Tableau De Protection AC/DC », « Accessoires »,
// « Socles », « Structures acier/aluminium ») :
//  · la ligne « AC/DC » tombe sur la fiche protection-dc, donc le dépliant
//    n'aurait montré que le côté continu — la moitié AC (disjoncteur, parafoudre,
//    différentiel, terre, liaison équipotentielle) disparaissait sous une ligne
//    qui s'appelle pourtant « AC/DC » : `estProtectionAcDc` la rend entière ;
//  · aucune ligne « câble » n'est facturée, donc les sections et longueurs
//    calculées par l'étude n'apparaissaient nulle part : `indexHoteDesCables`
//    les accroche à UNE seule ligne de protection (jamais deux), sous un
//    intertitre « Câblage ». Dès qu'un devis porte une vraie ligne câblage, il
//    rend -1 et rien ne change.
const equipmentGrouped = groupEquipment(equipmentItems);
const equipmentRendered = equipmentGrouped.flatMap((group) => group.lines);
const equipmentSlugs = equipmentRendered.map((it) => ficheSlugPourLigne(it.designation, it.marque));
const cableHostIndex = indexHoteDesCables(equipmentSlugs);
// La ligne hôte est désignée PAR IDENTITÉ (jamais par un index recalculé) :
// `null` quand il n'y en a pas, et alors aucune ligne ne se compare vraie.
const cableHostLine = cableHostIndex >= 0 ? equipmentRendered[cableHostIndex] : null;
const equipmentGroups = equipmentGrouped.map((group) => ({
  id: group.id,
  lines: group.lines.map((it) => {
    const ficheSlug = ficheSlugPourLigne(it.designation, it.marque);
    return {
      ...it,
      ficheSlug,
      detail: conceptionPourLigne(conception, ficheSlug, {
        designation: it.designation,
        rattacherCables: it === cableHostLine,
      }),
    };
  }),
}));
const equipmentExtra = ok && twoOptions && equipmentOption === 'sans_batterie'
  ? equipmentDelta(equipmentItems, optionItems(data!, 'avec_batterie'))
  : [];

// ── (fondateur 2026-08-17) BADGES DU BLOC CONFIANCE ──────────────────────────
// RÈGLE : un badge n'existe QUE s'il est cliquable vers une page réelle et bien
// remplie. Concrètement :
//  · garanties panneaux/onduleur → /garanties (tableau de garanties complet,
//    exclusions, marche à suivre, FAQ assurance) ;
//  · IEC 61215 / 61730 → la fiche du panneau RÉELLEMENT devisé
//    (/produits/<slug>), qui porte ces certifications dans `fiches.ts` — aucun
//    panneau apparié (marque absente/inconnue) ⇒ badge OMIS, jamais un lien
//    vers la fiche d'une autre marque ;
//  · « Loi 82-21 » → /loi-82-21 (page dédiée FR/EN/AR + guide, dans la nav).
const panelFicheSlug = equipmentGroups
  .flatMap((group) => group.lines)
  .map((line) => line.ficheSlug)
  .find((slug) => !!slug && ficheBySlug(slug)?.categorie === 'Panneaux photovoltaïques') ?? null;
// (fondateur 2026-08-18) LES GARANTIES NE PARLENT QUE DU MATÉRIEL DEVISÉ.
// Le bloc annonçait « N ans de performance panneaux · N ans onduleur » et poussait
// les deux badges correspondants sur TOUS les devis — y compris un pompage
// (pompe + variateur, aucun onduleur). La présence est désormais lue sur les
// LIGNES RÉELLES des deux options (`equipmentPresence`, qui réutilise le
// classement déjà line-driven de `groupEquipment`) : pas de ligne ⇒ pas de
// promesse, ni dans la phrase, ni en badge.
const equipPresence = equipmentPresence(
  ok ? [...optionItems(data!, 'sans_batterie'), ...optionItems(data!, 'avec_batterie')] : [],
);
const certKeys = [
  ...(panelFicheSlug ? ['iec' as const] : []),
  'loi8221' as const,
  ...(equipPresence.panneaux ? ['panneaux' as const] : []),
  ...(equipPresence.onduleur ? ['onduleur' as const] : []),
];
const certHrefs = {
  ...(panelFicheSlug ? { iec: `/produits/${panelFicheSlug}` } : {}),
  loi8221: '/loi-82-21',
  ...(equipPresence.panneaux ? { panneaux: '/garanties' } : {}),
  ...(equipPresence.onduleur ? { onduleur: '/garanties' } : {}),
};

/**
 * « N ans » en arabe, avec le DUEL. L'arabe ne pluralise pas comme le français :
 * 1 → سنة واحدة, 2 → سنتان (duel, pas « 2 سنة »), 3 à 10 → N سنوات (pluriel de
 * petit nombre), au-delà → N سنة. La durée de pose était écrite « سنتان » EN
 * DUR : passer INSTALL_WARRANTY_YEARS à 3 dans warranty.ts affichait « 3 ans /
 * 3 years » en FR/EN et laissait le client arabophone lire « deux ans » —
 * exactement la divergence que warranty.ts existe pour empêcher. Les trois
 * durées du bloc confiance passent donc par ici.
 */
function anneesAr(n: number): string {
  if (n === 1) return 'سنة واحدة';
  if (n === 2) return 'سنتان';
  if (n >= 3 && n <= 10) return `${n} سنوات`;
  return `${n} سنة`;
}

// ── WJ32 — Complétude du contenu : variantes, « Et après ? », « Nos
// hypothèses », accompagnement, FAQ objections. Chaque bloc dégrade proprement
// (masqué) quand sa donnée backend manque. PV80 — le bloc financement backend
// (backendFinancing) n'est plus rendu : aucune mention de crédit sur la page.
const variants = ok ? proposalVariants(data!) : [];
// ── GAMMES (fondateur 2026-08-18) — choix de gamme AVANT/AVEC la signature.
// `null` en mode d'envoi « seule » (le backend n'envoie alors RIEN de l'autre
// gamme) : la page est byte-identique à aujourd'hui. En mode « les_deux » :
// deux cartes (nom, TTC, badge « Recommandé », écart en MAD ABSOLUS) + un
// tableau comparatif FACTUEL des seules lignes qui diffèrent. Choisir l'autre
// gamme ouvre SON lien (document complet et PDF de CETTE gamme) : la signature
// porte donc toujours sur le devis réellement choisi.
const gammes = ok ? proposalGammes(data!) : null;
const gammeEcart = gammes ? gammeEcartLabel(gammes.soeur.ecart_ttc) : null;
const gammeRows = gammeComparatif(gammes);
const steps = nextSteps();
const assumptions = ok ? proposalAssumptions(data!) : [];
// (fondateur 2026-08-18) « Suivi de production via l'application de votre
// onduleur » n'est plus un point inconditionnel : il n'est dit que si le devis
// porte vraiment une ligne onduleur (un pompage n'en a pas). Les points
// génériques de maintenance/SAV restent, eux, toujours vrais.
const monitoring = monitoringPoints(equipPresence);
const faq = objectionFaq();

// ── WJ86 — « Nos chantiers » (photos réelles) et « Le mot du fondateur »
// n'ont AUCUNE source de données réelle aujourd'hui (WG5/WG6, toujours GATED
// dans docs/WEB_PLAN.md) : « (Photos à venir.) » et la citation-scaffold du
// fondateur s'affichaient comme du contenu FINI sur un document commercial —
// « bientôt disponible » sur sa propre proposition lit comme un produit
// inachevé au moment le plus critique pour la confiance. Même discipline
// « no-op » que <TestimonialCarousel/>/<InstallCounter/> (hasTestimonials()) :
// tant que ces constantes restent `false`, les deux blocs ne rendent RIEN —
// pas de squelette vide, pas de mention "à venir". Basculer à `true` (et
// fournir le VRAI contenu ci-dessous) le jour où Reda livre WG5/WG6.
const REAL_PROJECT_PHOTOS_AVAILABLE = false;
const REAL_FOUNDER_QUOTE_AVAILABLE = false;

// PV80 — le second bandeau « confiance » (témoignage + certifications) posé
// juste au-dessus du formulaire de signature RÉPÉTAIT mot pour mot le chapitre
// « Pourquoi nous faire confiance » (mêmes faits, même <CertLogoRow/>, même
// source `TESTIMONIALS`) : 332 px de doublon à l'endroit exact où le client
// doit décider. Supprimé — la preuve de confiance vit à UN seul endroit.

const pageTitle = ok ? `Proposition ${reference} — ${clientName} | Taqinor` : 'Proposition | Taqinor';
// WJ76 — fuite de confidentialité de l'aperçu de partage : cette page est un
// lien tokenisé PRIVÉ que le client transfère lui-même (WhatsApp, SMS, email)
// à sa famille/son entourage pour discuter du projet. `pageTitle` ci-dessus
// (référence + nom du client) reste dans l'onglet du navigateur — utile au
// client — mais NE DOIT JAMAIS apparaître dans la carte de partage
// (og:title/twitter:title), affichée à TOUTE personne qui reçoit le lien
// transféré, au-dessus de l'image d'accueil générique par défaut. Titre de
// partage neutre + image OG dédiée (public/og/proposition.png, aucune photo
// de chantier client, aucune donnée personnelle) — la page reste noindex.
const ogTitle = 'Votre proposition solaire | Taqinor';

// ── WJ81 — Lien WhatsApp de repli utilisable MÊME quand la proposition n'a pas
// pu être chargée (`!ok` : timeout, panne, lien invalide). `whatsappLink('')`
// dégrade déjà proprement sur un message générique sans référence.
const waLinkFallback = whatsappLink(reference || '');

// Données passées au script de signature (sérialisées en JSON dans un data-attr).
// WJ55 — `clientPhone` est AJOUTÉ ici (jamais un nouvel attribut DOM) pour que
// le script de télémétrie de vue/engagement puisse construire un événement
// corrélable côté CRM (voir buildProposalTrackPayload) sans jamais fabriquer
// de lead fantôme quand le devis n'a pas de téléphone client.
const signConfig = ok
  ? JSON.stringify({
      token,
      twoOptions,
      preselect,
      accepted,
      acceptedName: data?.accepte_par_nom ?? '',
      reference,
      clientPhone: q?.client_phone ?? '',
    })
  : null;
---

<Layout
  title={pageTitle}
  description="Votre proposition solaire personnalisée Taqinor."
  noindex={true}
  ogTitle={ogTitle}
  ogSlug="proposition"
  ogImageAlt="Taqinor — votre proposition solaire"
  footerMinimal={true}
>
  {!ok ? (
    <!-- ── État « lien expiré / introuvable » ─────────────────────────────── -->
    <!-- WJ81 — la page ne reste JAMAIS blanche : ce cadre de marque (rappel
         visuel Taqinor, jamais une page d'erreur générique du navigateur/
         plateforme) affiche un message honnête. Pour un TIMEOUT (backend
         lent) spécifiquement, un bouton « Réessayer » (recharge la MÊME URL,
         lien pur — fonctionne sans JS) et un repli WhatsApp direct sont
         proposés, plutôt que le seul lien « Retour à l'accueil ». W316 — un
         429 (rate-limit) est tout aussi RETRYABLE (relire dans un instant) :
         même bouton « Réessayer », jamais un cul-de-sac. -->
    <section class="mx-auto flex min-h-[60dvh] max-w-2xl flex-col items-center justify-center px-5 py-24 text-center">
      <div class="rule-brass mx-auto text-brass-300" aria-hidden="true"></div>
      <h1 class="display mt-6 text-3xl text-lune sm:text-4xl">Proposition indisponible</h1>
      <p class="v2-body mt-4 max-w-md">{errorDetail}</p>
      {(isTimeout || httpStatus === 429) ? (
        <>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={Astro.url.href} class="btn-pill" style="background: var(--color-brass-400); color: var(--color-nuit); border-color: var(--color-brass-400)">
              Réessayer
            </a>
            <a href={waLinkFallback} target="_blank" rel="noopener noreferrer" class="btn-pill">
              Contacter sur WhatsApp
            </a>
          </div>
          <a href="/" class="mt-4 text-sm text-lune-faint underline-offset-2 hover:underline">Retour à l’accueil</a>
        </>
      ) : (
        <>
          <p class="mt-8 text-sm text-lune-faint">
            Besoin d’un nouveau lien ? Contactez votre conseiller Taqinor.
          </p>
          <a href="/" class="btn-pill mt-8">Retour à l’accueil</a>
        </>
      )}
    </section>
  ) : (
    <div class="proposition pb-28" data-sign-config={signConfig}>
      <!-- WJ84 — imprimable proprement : invisible à l'écran (print:block only),
           rappelle qu'un Ctrl-P sur cette page « UI » n'est pas le document
           officiel — le PDF premium (même token) est le document contractuel.
           Le reste du chrome (bascule langue, CTA collant, overlay 3D) est
           masqué en impression par les règles @media print ci-dessous. -->
      <p class="print-hint hidden">
        <span data-i18n
          data-fr="Pour un PDF officiel, utilisez « Télécharger le devis (PDF) » — cette page imprimée est une vue d'écran, pas le document contractuel."
          data-en="For an official PDF, use “Download the quote (PDF)” — this printed page is a screen view, not the contractual document."
          data-ar="للحصول على PDF رسمي، استخدموا «تحميل العرض (PDF)» — هذه الصفحة المطبوعة عرض شاشة، وليست الوثيقة التعاقدية.">
          Pour un PDF officiel, utilisez « Télécharger le devis (PDF) » — cette page imprimée est une vue d'écran, pas le document contractuel.
        </span>
      </p>

      <!-- WJ45 — bandeau hors-ligne (navigator.onLine + online/offline) : une
           coupure réseau au moment de signer ne doit jamais ressembler à un
           échec muet. Le formulaire de signature reste rempli (aucune
           soumission n'a eu lieu) : on prévient explicitement ET on rassure
           que rien n'est perdu, plutôt que le message générique de panne. -->
      <div id="prop-offline-banner" hidden role="status" aria-live="polite"
        class="mx-auto mt-4 flex max-w-4xl items-start gap-2 border border-brass-400/40 bg-brass-400/10 p-3 text-sm text-white sm:px-8">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none text-brass-300">
          <line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.58 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
        <span data-i18n
          data-fr="Pas de connexion — vos réponses sont conservées, on réessaie dès le retour du réseau."
          data-en="No connection — your answers are kept, we'll retry as soon as the network is back."
          data-ar="لا يوجد اتصال — إجاباتكم محفوظة، سنعيد المحاولة فور عودة الشبكة.">
          Pas de connexion — vos réponses sont conservées, on réessaie dès le retour du réseau.
        </span>
      </div>

      <!-- WJ17/WJ43 — bascule de langue FR/EN/عربي, flottante (ne perturbe aucun
           rythme existant, zéro CLS). Même mécanisme tri-node (dual-node élargi)
           que WJ33 (mon-toit.astro) : voir le <script> de fin de page. Le contenu
           reste TOUJOURS lisible FR sans JS (pas de gate v2-js ici, page déjà
           rendue serveur). WJ43 — EN ajouté comme 3ᵉ langue (segment
           marocains-du-monde), au même niveau que FR/AR, jamais un repli dégradé. -->
      <div class="prop-lang-switch fixed right-3 z-50 flex gap-1 rounded-sm border border-white/15 bg-nuit/80 p-0.5 backdrop-blur" style="top: calc(0.75rem + env(safe-area-inset-top));" role="group" aria-label="Langue / Language / اللغة">
        <button type="button" id="prop-lang-fr" aria-pressed="true"
          class="min-h-11 px-2.5 py-2.5 text-xs font-semibold text-azur-950 bg-brass-400 transition-colors">FR</button>
        <button type="button" id="prop-lang-en" aria-pressed="false"
          class="min-h-11 px-2.5 py-2.5 text-xs font-semibold text-lune-soft transition-colors hover:text-white">EN</button>
        <button type="button" id="prop-lang-ar" aria-pressed="false"
          class="min-h-11 px-2.5 py-2.5 text-xs font-semibold text-lune-soft transition-colors hover:text-white">عربي</button>
      </div>

      <!-- ── HÉRO (WJ28 — cinéma du chantier : ancré bas, entrée cine-in ; WJ35 —
           rythme rehaussé, cohérent avec l'accueil élevé v3, zéro CLS : min-h). -->
      <section class="relative min-h-[72dvh] overflow-hidden sm:min-h-[78dvh]">
        {roofImg ? (
          <>
            <!-- WJ34 — poster blur-up : la photo backend (URL dynamique, pas de
