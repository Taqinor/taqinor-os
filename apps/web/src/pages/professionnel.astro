    <Faq schema={false} heading="Questions fréquentes — solaire professionnel" items={faqItems} />
    <section class="section-tight bg-blanc-azur px-4 text-encre">
      <ServiceWarrantyTable />
    </section>

    <!-- ACTE FINAL (CIW401) — deux entrées vers le tunnel, SANS aucun chiffre : l'estimateur
         résidentiel n'a rien à faire ici ; un chiffre public ne reviendra que dérivé du moteur serveur. -->
    <section class="section-tight bg-blanc-azur px-4 text-encre">
      <div class="mx-auto max-w-4xl">
        <h2 class="display text-2xl text-azur-700">Quel est votre type de site ?</h2>
