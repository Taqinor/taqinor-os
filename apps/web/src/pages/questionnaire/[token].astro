  four: L('Votre four est électrique ou à gaz ?', 'Is your oven electric or gas?', 'هل فرنكم كهربائي أم يشتغل بالغاز؟'),
  cuisson_nocturne: L('Cuisez-vous la nuit ?', 'Do you bake at night?', 'هل تخبزون ليلاً؟'),
  temperature_consigne: L('Quelle est votre température de consigne ? (°C)', 'What is your set-point temperature? (°C)', 'ما هي درجة الحرارة المضبوطة؟ (°م)'),
  volume_m3: L('Quel volume réfrigéré avez-vous ? (m³)', 'What refrigerated volume do you have? (m³)', 'ما هو حجم التبريد لديكم؟ (م³)'),
  saisonnalite_recolte: L('Avez-vous un pic saisonnier lié à la récolte ?', 'Do you have a seasonal peak tied to harvest?', 'هل لديكم ذروة موسمية مرتبطة بالحصاد؟'),
};
const CAT_OPTION_LABELS: Record<string, L3> = {
  midi: L('Midi', 'Lunch', 'الغداء'),
  soir: L('Soir', 'Evening', 'المساء'),
  continu: L('Continu', 'Continuous', 'متواصل'),
  electrique: L('Électrique', 'Electric', 'كهربائي'),
  gaz: L('Gaz', 'Gas', 'غاز'),
};
const catLabel = (cat: string, key: string): L3 => CAT_Q_LABELS[`${cat}.${key}`] ?? CAT_Q_LABELS[key];
// Les réponses déjà connues reviennent pré-remplies (on ne redemande jamais).
const categoriePrefill = prefillStr('categorie_commerciale');
const reponsesCategoriePrefill: Record<string, unknown> =
  prefill.reponses_categorie && typeof prefill.reponses_categorie === 'object' && !Array.isArray(prefill.reponses_categorie)
    ? (prefill.reponses_categorie as Record<string, unknown>)
    : {};
const entiersPrefill = (key: string): number[] =>
  Array.isArray(prefill[key])
    ? (prefill[key] as unknown[]).map(Number).filter((n) => Number.isInteger(n))
    : [];
const joursPrefill = entiersPrefill('jours_ouverture');
const fermeturePrefill = entiersPrefill('fermeture_mois');
const tensionPrefill = prefillStr('tension_raccordement');
const groupePrefill = prefillStr('groupe_electrogene');
// Relevé de consommation déjà connu : { mois: [{ mois, kwh, kwh_pointe… }] }.
const relevePrefill: Array<Record<string, unknown>> =
  prefill.releve_conso && typeof prefill.releve_conso === 'object' && Array.isArray((prefill.releve_conso as { mois?: unknown }).mois)
    ? ((prefill.releve_conso as { mois: Array<Record<string, unknown>> }).mois).slice(0, RELEVE_CONSO_MAX_MOIS)
    : [];
const releveVal = (i: number, key: string): string => {
  const v = relevePrefill[i]?.[key];
  return typeof v === 'string' || typeof v === 'number' ? String(v) : '';
};
const releveRows = Array.from({ length: RELEVE_CONSO_MAX_MOIS }, (_, i) => i);
// Un industriel (cos φ ou secteur servis par le serveur) : sa consommation en
// kWh du dernier mois passe EN PREMIER, avant la tension.
const estIndustriel =
  (champs.reseau ?? []).includes('cos_phi') ||
  (champs.activite ?? []).includes('secteur_industriel') ||
  prefillStr('secteur_industriel') !== '';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
  footerMinimal={true}
  skipVisitBeacon={interne}
>
  <section class="scroll-mt-20 bg-blanc-azur px-4 pb-20 pt-10 text-encre sm:pb-24">
    <div class="mx-auto max-w-2xl">

      {!ok && (
        <div class="border border-azur-900/15 bg-blanc p-6 text-center shadow-[0_24px_60px_-28px_rgb(15_28_84/0.35)] sm:p-10">
          <p class="tech-label text-azur-600">Questionnaire</p>
          <h1 class="display mt-3 text-xl sm:text-2xl">
            {httpStatus === 429
              ? 'Trop de tentatives'
              : isTimeout
