---
/**
 * LANE Q-B — /questionnaire/<token> — QUESTIONNAIRE CLIENT PUBLIC.
 *
 * « Remplissez chez vous, à votre rythme » : lien magique WhatsApp envoyé au
 * lead, mobile-first, UNE section par écran, enregistrement PAR SECTION (le
 * client peut fermer et rouvrir le lien — il reprend où il s'est arrêté).
 * Rendu côté serveur (prerender=false) : le frontmatter lit l'état du
 * questionnaire depuis l'endpoint backend public/token (même discipline que
 * /proposition/<token> — W116/W117) ; toute la suite (progression, POST par
 * section, GPS, photos) vit dans le script client, qui n'appelle QUE des
 * fonctions PURES de `lib/questionnaire.ts`. noindex=true : page privée et
 * tokenisée.
 *
 * ADDENDUM (ordre fondateur, en cours de lane) — un jeton d'APERÇU INTERNE
 * (le commercial relit le questionnaire depuis l'ERP) fait porter
 * `interne: true` par le GET : bandeau discret, tous les champs visibles
 * mais DÉSACTIVÉS, aucune barre de progression, aucun POST n'est jamais
 * tenté (le backend le refuserait de toute façon).
 */
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import {
  type QuestionnaireGetResponse,
  type QuestionnaireSectionId,
  champDemande,
  ecransActifs,
  initialEcranIndex,
  CATEGORIE_COMMERCIALE_VALUES,
  IRRIGATION_METHODE_VALUES,
  JOURS_OUVERTURE_VALUES,
  isPhotoSection,
  MOIS_IRRIGATION_VALUES,
  parseQuestionnaireGet,
  POMPE_ALIM_VALUES,
  RELEVE_CONSO_MAX_MOIS,
  REGIME_EQUIPES_VALUES,
  REPONSES_CATEGORIE_QUESTIONS,
  TENSION_VALUES,
  TVA_RECUPERABLE_VALUES,
  TYPE_SURFACE_VALUES,
  TYPE_TOITURE_PRO_VALUES,
  questionnaireEndpoint,
  SECTION_META,
  SOURCE_EAU_VALUES,
  TYPE_TOITURE_VALUES,
} from '../../lib/questionnaire';
import { clientIpFromRequest, rateLimit } from '../../lib/rateLimit';
import { NAP, WHATSAPP_LEADS } from '../../lib/nap';
import { whatsappLink } from '../../lib/whatsapp';

const API_BASE = (import.meta.env.PUBLIC_API_BASE as string | undefined) ?? 'https://api.taqinor.ma';
const token = typeof Astro.params.token === 'string' ? Astro.params.token.trim() : '';

// ── Lecture serveur du questionnaire (même discipline W316/WJ81 que /proposition) ──
const SSR_FETCH_TIMEOUT_MS = 8000;
let data: QuestionnaireGetResponse | null = null;
let errorDetail: string | null = null;
let httpStatus = 200;
let isTimeout = false;

const visitorIp = clientIpFromRequest(Astro.request);
const rl = rateLimit(`questionnaire-view:${visitorIp}`, { limit: 60, windowMs: 60_000 });
if (!rl.allowed) {
  httpStatus = 429;
  errorDetail = 'Trop de tentatives depuis cette connexion — réessayez dans un instant.';
} else if (!token) {
  httpStatus = 404;
  errorDetail = 'Ce lien de questionnaire est introuvable ou a expiré.';
} else {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), SSR_FETCH_TIMEOUT_MS);
  try {
    const res = await fetch(questionnaireEndpoint(API_BASE, token), {
      headers: {
        accept: 'application/json',
        // F3#8-web — transmet l'IP RÉELLE du visiteur au backend (même
        // discipline que /proposition/[...token].astro) : sans ceci, le
        // backend enregistrait l'IP de sortie du Worker pour toutes les
        // visites. Best-effort : en-têtes omis si l'IP n'est pas identifiable.
        ...(visitorIp && visitorIp !== 'unknown'
          ? { 'X-Forwarded-For': visitorIp, 'CF-Connecting-IP': visitorIp }
          : {}),
      },
      signal: controller.signal,
    });
    httpStatus = res.status;
    if (res.ok) {
      const json = await res.json();
      data = parseQuestionnaireGet(json);
      if (!data) {
        httpStatus = 502;
        errorDetail = 'Réponse inattendue du serveur. Réessayez dans un instant.';
      }
    } else {
      let detail = '';
      try {
        const body = (await res.json()) as { detail?: string };
        detail = typeof body.detail === 'string' ? body.detail : '';
      } catch {
        detail = '';
      }
      errorDetail =
        detail ||
        (res.status === 404
          ? 'Ce lien de questionnaire est introuvable ou a expiré.'
          : 'Ce questionnaire n’est pas accessible pour le moment.');
    }
  } catch (err) {
    httpStatus = 502;
    isTimeout = err instanceof Error && err.name === 'AbortError';
    errorDetail = isTimeout
      ? 'La connexion est lente — réessayez, ou contactez votre conseiller sur WhatsApp.'
      : 'Questionnaire momentanément indisponible. Veuillez réessayer dans un instant.';
  } finally {
    clearTimeout(timer);
  }
}

if (!data && (httpStatus === 404 || httpStatus === 200)) {
  Astro.response.status = httpStatus === 200 ? 404 : httpStatus;
} else if (!data) {
  Astro.response.status = httpStatus;
}

const ok = !!data;
const entreprise = data?.entreprise || 'Taqinor';
const prenom = data?.prenom || '';
const sections = data?.sections ?? [];
const interne = data?.interne ?? false;
const prefill = data?.prefill ?? {};
const repondu = data?.repondu ?? {};
const champs = data?.champs ?? {};

// ── ÉCRANS (ordre fondateur 25/08/2026 « the number of pages ») ───────────
// Les sections servies sont regroupées en écrans (lib/questionnaire.ts) : la
// barre de progression compte les ÉCRANS RÉELLEMENT traversés, jamais les
// sections (Baymard : un indicateur de progression est un miroir 1:1 des
// étapes). La section reste l'unité d'ENREGISTREMENT — un écran POSTe
// chacune des siennes séparément, le contrat POST ne bouge pas.
const ecrans = ok ? ecransActifs(sections) : [];
const total = ecrans.length;
const startIndex = ok ? initialEcranIndex(ecrans, repondu) : 0;
// section -> index de son écran (attribut `data-ecran` porté par le fieldset).
const ecranDeSection = new Map<QuestionnaireSectionId, number>();
ecrans.forEach((ecran, i) => ecran.actives.forEach((s) => ecranDeSection.set(s, i)));

/** `true` si la page a le droit de dessiner la question `cle` de `section`.
 *  Une donnée que le lead porte déjà revient pré-remplie ; une donnée vide
 *  qu'une autre déjà connue couvre (l'adresse d'un client qui a donné son
 *  GPS) n'est PAS dessinée — c'est LA règle « on ne redemande jamais ». */
const demande = (section: QuestionnaireSectionId, cle: string) =>
  champDemande(champs, section, cle);

const noscriptWaHref = whatsappLink(
  WHATSAPP_LEADS,
  `Bonjour, je n'arrive pas à ouvrir mon questionnaire ${entreprise} (mon navigateur n'active pas JavaScript).`,
);

const pageTitle = ok ? `Questionnaire — ${entreprise}` : 'Questionnaire indisponible';
const pageDescription = 'Complétez votre profil énergétique à votre rythme, depuis votre téléphone.';

function prefillStr(key: string): string {
  const v = prefill[key];
  return typeof v === 'string' ? v : typeof v === 'number' ? String(v) : '';
}
function prefillBoolRadio(key: string): 'oui' | 'non' | '' {
  const v = prefill[key];
  if (v === true) return 'oui';
  if (v === false) return 'non';
  return '';
}
// AGW408 — section pompage (agricole). Libellés FR = la question orale du
// contrat `lead_pompage.json` / help_text de la colonne ; EN/AR traduits.
const POMPAGE_INPUT_CLS =
  'w-full min-h-[44px] border border-azur-900/20 bg-blanc px-3 py-3 text-base outline-none transition-colors focus:border-azur-600 focus:ring-2 focus:ring-azur-600/50';
const POMPAGE_NUM = {
  niveau_statique_m: { id: 'q-niveau-statique', fr: "À quelle profondeur se trouve l'eau quand la pompe est arrêtée ? (m)", en: 'How deep is the water when the pump is off? (m)', ar: 'على أي عمق يوجد الماء عندما تكون المضخة متوقفة؟ (م)' },
  besoin_eau_m3j: { id: 'q-besoin-eau', fr: "De combien de mètres cubes d'eau avez-vous besoin par jour au plus fort de la saison ? (m³/jour)", en: 'How many cubic metres of water do you need per day at the peak of the season? (m³/day)', ar: 'كم متراً مكعباً من الماء تحتاجون يومياً في ذروة الموسم؟ (م³/اليوم)' },
  surface_irriguee_ha: { id: 'q-surface-irriguee', fr: "Combien d'hectares irriguez-vous ? (ha)", en: 'How many hectares do you irrigate? (ha)', ar: 'كم هكتاراً تسقون؟ (هكتار)' },
  butane_bouteilles_jour: { id: 'q-butane-bouteilles', fr: 'Combien de bouteilles de butane par jour en saison ? (bouteilles de 12 kg)', en: 'How many butane cylinders per day in season? (12 kg cylinders)', ar: 'كم قنينة بوتان في اليوم خلال الموسم؟ (قنينات 12 كلغ)' },
  carburant_prix_unitaire_mad: { id: 'q-carburant-prix', fr: 'Vous la payez combien, la bouteille (ou le litre de gasoil) ? (MAD)', en: 'How much do you pay for a cylinder (or a litre of diesel)? (MAD)', ar: 'بكم تشترون القنينة (أو لتر الغازوال)؟ (درهم)' },
  depense_carburant_mad_mois: { id: 'q-depense-carburant', fr: 'Combien dépensez-vous en carburant par mois ? (MAD/mois)', en: 'How much do you spend on fuel per month? (MAD/month)', ar: 'كم تنفقون على الوقود شهرياً؟ (درهم/الشهر)' },
} as const;
const SOURCE_EAU_LABELS: Record<string, string> = {
  puits: 'Puits', forage: 'Forage', bassin: 'Bassin', riviere: 'Rivière',
};
const IRRIGATION_LABELS: Record<string, string> = {
  goutte: 'Goutte-à-goutte', aspersion: 'Aspersion', gravitaire: 'Gravitaire (à la raie)',
};
const ALIM_LABELS: Record<string, string> = {
  aucune: 'Pas de pompe actuellement', diesel: 'Diesel (gasoil)', butane: 'Butane', electrique: 'Électricité',
};
const MOIS_LABELS: Record<number, { fr: string; en: string; ar: string }> = {
  1: { fr: 'Janv.', en: 'Jan', ar: 'يناير' }, 2: { fr: 'Févr.', en: 'Feb', ar: 'فبراير' },
  3: { fr: 'Mars', en: 'Mar', ar: 'مارس' }, 4: { fr: 'Avr.', en: 'Apr', ar: 'أبريل' },
  5: { fr: 'Mai', en: 'May', ar: 'ماي' }, 6: { fr: 'Juin', en: 'Jun', ar: 'يونيو' },
  7: { fr: 'Juil.', en: 'Jul', ar: 'يوليوز' }, 8: { fr: 'Août', en: 'Aug', ar: 'غشت' },
  9: { fr: 'Sept.', en: 'Sep', ar: 'شتنبر' }, 10: { fr: 'Oct.', en: 'Oct', ar: 'أكتوبر' },
  11: { fr: 'Nov.', en: 'Nov', ar: 'نونبر' }, 12: { fr: 'Déc.', en: 'Dec', ar: 'دجنبر' },
};
const moisPrefill: number[] = Array.isArray(prefill.mois_irrigation)
  ? (prefill.mois_irrigation as unknown[]).map(Number).filter((n) => Number.isInteger(n) && n >= 1 && n <= 12)
  : [];
const alimPrefill = prefillStr('pompe_alim_actuelle');
const carburantMasque = alimPrefill === 'aucune' || alimPrefill === 'electrique';
const butaneMasque = carburantMasque || alimPrefill === 'diesel';
/** Le lead porte-t-il déjà sa position ? (les DEUX coordonnées, jamais une
 *  seule) — sert à dire au client qu'on ne la lui redemande pas. */
const gpsDejaConnu = prefillStr('gps_lat') !== '' && prefillStr('gps_lng') !== '';

// ── CIW406 — sections PRO (réseau, activité, site, société) ──────────────
// Libellés FR/EN/AR. FR = la question orale du contrat `lead_pro.json` ; la
// darija sera relue par Reda ensuite (modèle D-AGR-11). AUCUNE question
// résidentielle ici (ni maison, ni foyer, ni équipements domestiques) et rien
// de Q21 (budget, délai, décideur, concurrents) : jamais demandés par écrit.
type L3 = { fr: string; en: string; ar: string };
const L = (fr: string, en: string, ar: string): L3 => ({ fr, en, ar });
const PRO_INPUT_CLS = POMPAGE_INPUT_CLS;
const PRO_TOGGLE_CLS = 'min-h-[44px] border p-3 text-center text-sm font-semibold text-encre transition-colors';
