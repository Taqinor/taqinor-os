---
/**
 * AR — City pages (W67, RTL). Faithful Arabic (MSA) translation of the FR
 * `installation-solaire-[city].astro`. Same 5 cities, same numeric data from
 * `realisations.ts`/CITIES (untouched) in Latin digits — only the prose is
 * translated, from `cityContentBySlug(slug, 'ar')`. No invented figure or claim;
 * honesty of `hasLocalInstall` preserved (only Casablanca has a local install).
 * The Layout auto-sets lang=ar + dir=rtl; only text changes, classes intact.
 * Internal links via localizeNavHref. FR untouched.
 */
import CityPageBody from '../../components/CityPageBody.astro';
import Layout from '../../layouts/Layout.astro';
import { CITIES } from '../../lib/realisations';
import { cityPageBase, cityServiceJsonLd, NEUTRAL_CITY_HERO } from '../../lib/cityPageData';
import { getLocaleFromPath } from '../../i18n/utils';
import { localizeNavHref } from '../../i18n/pages';

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const L = (href: string) => localizeNavHref(href, locale);

// Nom de ville en arabe (slug Latin inchangé) + forme localisée « في <مدينة> ».
const AR_CITY_NAME: Record<string, string> = {
  casablanca: 'الدار البيضاء',
  rabat: 'الرباط',
  marrakech: 'مراكش',
  tanger: 'طنجة',
  agadir: 'أكادير',
};
const cityNameAr = AR_CITY_NAME[c.slug] ?? c.name;
const intro = `في ${cityNameAr}`;

// ENF19 — calcul commun FR/EN/AR (listes de chantiers, rendement mesuré, prose, alt des cartes) : lib/cityPageData.ts
const city = cityPageBase(c, intro, locale);
const { inCity, avgYieldPerKwc, cardAlt, southOptimalYield, title, description, nearestInstallNote } = city;

const heroPhoto = inCity[0]?.photos[0] ?? NEUTRAL_CITY_HERO;

const serviceJsonLd = cityServiceJsonLd('تركيب شمسي فوتوضوئي', `تركيب شمسي ${intro}`, c.name);
const t = {
  kicker: `منطقة التدخّل · ${cityNameAr}`,
  h1: `تركيب شمسي ${intro}`,
  potential: 'الإمكان الشمسي',
  hoursUnit: 'ساعة/سنة',
  sunshineLabel: `إشعاع سنوي إرشادي · ${cityNameAr}`,
  publicData: 'معطى مناخي عمومي، على سبيل الإرشاد.',
  statBill: 'من الفاتورة مُغطّاة',
  statRoiValue: '3–7 سنوات',
  statRoi: 'عائد الاستثمار',
  statWarrantyValue: '25 سنة',
  statWarranty: 'ضمان الأداء',
  stat8221: 'تصريح بسيط للقانون 82-21',
  projectsKicker: `أوراشنا · ${cityNameAr}`,
  projectsH2: `تركيبات حقيقية ${intro}`,
  caseStudy: 'شاهد دراسة الحالة',
  nearbyKicker: 'في الجهة',
  nearbyH2: `أوراش أخرى في جهة ${cityNameAr}`,
  coveredKicker: 'مدينتك مُغطّاة',
  coveredH2: `نتدخّل ${intro} — وأوراشنا تتحدّث عنّا`,
  closestLead: 'إليك أقرب أوراشنا:',
  latest: 'آخر إنجازاتنا',
  residential: 'طاقة شمسية سكنية',
  business: 'طاقة شمسية مهنية',
};
const bodyProps = { c, rtl: true, L, cardAlt: cardAlt, t, breadcrumbItems: [{ label: 'الرئيسية', href: L('/') }, { label: `تركيب شمسي ${intro}` }], heroPhoto, showYieldNote: !!(avgYieldPerKwc && southOptimalYield), city };
---

<Layout title={title} description={description} ogSlug="accueil">
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <CityPageBody {...bodyProps}>
    <Fragment slot="yieldNote">
      للإشارة: هذه التركيبات تقيس في المتوسط <span dir="ltr">≈{avgYieldPerKwc?.toLocaleString('fr-FR')} kWh/kWc/سنة</span>، وهو
      أقل من <span dir="ltr">≈{southOptimalYield?.toLocaleString('fr-FR')} kWh/kWc/سنة</span> التي يفترضها جدول الإنتاجية
      المُنمذَج المُستخدَم للتقديرات — التركيبات الحقيقية ليست كلها متّجهة جنوباً بميل <span dir="ltr">29°</span>، خلافاً
      لافتراض النموذج. الدراسة تُدقّق هذا الرقم على سطحك الحقيقي.
    </Fragment>
    <Fragment slot="coveredNote">
      {nearestInstallNote ?? `${cityNameAr} ضمن منطقة تدخّلنا. أقرب تركيباتنا التي هي قيد الخدمة توجد في جهة الدار البيضاء — ` +
        'نفس مناهج الدراسة، نفس العتاد من الفئة الأولى، نفس متابعة الإنتاج في الوقت الحقيقي.'}
    </Fragment>
  </CityPageBody>
</Layout>
