---
/**
 * AR — Blog post (W295, RTL): How much does a solar installation cost in
 * Morocco in 2026? Faithful Arabic translation of
 * src/content/blog/prix-installation-solaire-maroc-2026.md. WAUD68 (D-WAUD-5 = a): no amount
 * without a dated source (lib/prixConstants.ts); single VAT sentence = PHRASE_TVA. Static page mirroring the guides pattern (blog collection has no
 * locale field — out of this lane's scope). Internal links use
 * localizeNavHref (EN/AR if available, else the existing FR page — never a
 * dead link). FR untouched.
 */
import Layout from '../../../layouts/Layout.astro';
import { pageLocale, articleMeta } from '../../../lib/pageCtx';
import V2Enhance from '../../../components/V2Enhance.astro';
import Article33Ribbon from '../../../components/Article33Ribbon.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaBand from '../../../components/CtaBand.astro';
import StickyCta from '../../../components/StickyCta.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { NAP } from '../../../lib/nap';
import { localizeNavHref } from '../../../i18n/pages';
import { PHRASE_TVA } from '../../../lib/prixConstants';
import '../../../styles/prose.css';
import { DATE_LONGUE_AR as dateFmt } from '../../../lib/format';

const { locale, L } = pageLocale(Astro.url.pathname);

const pubDate = new Date('2026-06-21');

const bodyText = `
ما يُكوّن الثمن في 2026: الألواح والعاكس واليد العاملة والملحقات والإجراءات، والضريبة سطراً بسطر في عرض الأسعار. العائد يتوقّف على الاستهلاك وشطر ONEE.
`;
const { readingMinutes, url, schemaImageUrl } = articleMeta(bodyText, Astro.url.pathname, Astro.site, '/og/accueil.png');
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: 'أسعار الطاقة الشمسية بالمغرب في 2026: مكوّنات الفاتورة',
  description: "الألواح والعاكس والتركيب والإجراءات والضريبة: مكوّنات سعر التركيب الشمسي في 2026، وكيف يُقرأ عرض الأسعار بنداً بنداً.",
  image: schemaImageUrl,
  datePublished: pubDate.toISOString(),
  keywords: 'كلفة, ثمن, تركيبة, 2026',
  author: { '@type': 'Person', name: 'Reda Kasri' },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};


---

<Layout
  title="أسعار الطاقة الشمسية بالمغرب في 2026: مكوّنات الفاتورة | Taqinor"
  description="الألواح والعاكس والتركيب والإجراءات والضريبة: مكوّنات سعر التركيب الشمسي في 2026، وكيف يُقرأ عرض الأسعار بنداً بنداً."
  ogSlug="accueil"
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'الرئيسية', href: L('/') }, { label: 'المدوّنة', href: L('/blog') }, { label: 'أسعار الطاقة الشمسية بالمغرب في 2026: مكوّنات الفاتورة' }]} />

    <article class="mx-auto max-w-[68ch] px-4 pb-24 pt-12 sm:pb-28">
      <p class="tech-label v2-kicker rule-brass text-brass-300">
        المدوّنة · {dateFmt.format(pubDate)} · بقلم Reda Kasri
      </p>
      <h1 class="display v2-page-title mt-5 text-white">أسعار الطاقة الشمسية بالمغرب في 2026: مكوّنات الفاتورة</h1>

      <p class="article-meta mt-3 flex items-center gap-2 text-xs text-lune-faint">
        {readingMinutes} دقائق قراءة
      </p>

      <p class="prose-lead mt-5">ما يتكوّن منه ثمن التركيب في 2026 — العتاد والتركيب والإجراءات والضريبة — وكيف يُقرأ عرض الأسعار بنداً بنداً.</p>

      <div class="prose mt-10">
        <p>
          «كم تكلّف حقاً؟» هي الجملة الأولى في جلّ لقاءاتي. والسبب الذي يجعل الأرقام الموجودة على
          الإنترنت تتراوح من الواحد إلى الثلاثة سهل الشرح: ثمن لوح موضوع على رفّ لا علاقة له بثمن
          تركيبة جاهزة، مُركَّبة على سقفكم ومربوطة. يشرح هذا المقال ما تتكوّن منه الفاتورة — دون نقل
          أي مبلغ لا أستطيع أن أُريكم مصدره المؤرَّخ.
        </p>
        <p class="text-xs text-lune-faint">
          <em>(ما يصنع الثمن، والسقف، وحالة البطارية توجد في صفحتنا <a href={L('/prix-panneaux-solaires-maroc')}>أثمنة الألواح الشمسية بالمغرب</a>.)</em>
        </p>

        <h2>ما يُكوّن الثمن: العتاد والتركيب</h2>
        <h3>الألواح الكهروضوئية</h3>
        <p>
          تمثّل الألواح من <span dir="ltr" style="unicode-bidi:isolate">550–600 W</span> المعيار الحالي —
          احسبوا لوحين تقريباً لكل kWc مركَّب. في عرض الأسعار، ابحثوا عن العلامة والطراز والقدرة
          الفعلية لكل لوح، لا عن مجموع بالـkWc فقط.
        </p>
        <h3>العاكس</h3>
        <p>
          يتوقّف ثمنه على القدرة والنوع (شبكة أو هجين مع بطارية) والعلامة. عرض الأسعار الجادّ يُسمّي
          الطراز بدقّة وضمان الصانع.
        </p>
        <h3>اليد العاملة والملحقات</h3>
        <p>
          بنية التثبيت، أسلاك التيار المستمر/المتردّد، لوحة الحماية، الإجراءات الإدارية (تصريح القانون
          <span dir="ltr" style="unicode-bidi:isolate">82-21</span> للتركيبات دون <span dir="ltr" style="unicode-bidi:isolate">11 kW</span> في التوتر المنخفض) — تُمثّل هذه البنود حصّة معتبرة من الكلفة الإجمالية الجاهزة، وهي ما يغيب عن «ثمن العُدّة».
        </p>

        <h2>الضريبة على القيمة المضافة</h2>
        <p>{PHRASE_TVA.ar} إن كنتم مقاولة أو مستثمراً، اطلبوا من محاسب التحقّق من وضعيتكم الضريبية.</p>

        <h2>العائد على الاستثمار</h2>
        <p>
          يعتمد هذا الحساب بشدّة على استهلاككم الفعلي وشطركم التعريفي لدى ONEE/الوكالة. أسرة تستهلك
          أكثر من <span dir="ltr">310 kWh</span>/شهر (شطر بـ<span dir="ltr">1,381704</span> درهم/kWh، أو أبعد من <span dir="ltr">510 kWh</span> بـ<span dir="ltr">1,622856</span> درهم/kWh) تسترجع
          كلفة تركيبتها أسرع من مستهلك ضعيف — الطاقة الشمسية أكثر ربحاً كلما كانت فاتورتكم الحالية
          مرتفعة، والبطارية تُطيل مدّة الاسترجاع. (الشبكة التعريفية المُحدَّثة: انظروا <a href={L('/blog/rentabilite-solaire-par-ville-maroc')}>مقالنا حول الربحية حسب المدينة</a>.)
        </p>
        <p>
          لمزيد حول التوفير الفعلي حسب المدينة، انظروا مقالنا
          <a href={L('/blog/rentabilite-solaire-par-ville-maroc')}>الربحية الشمسية حسب المدينة بالمغرب</a>.
        </p>

        <p>

          الرقم الوحيد الصالح لبيتكم يخرج من قراءة فاتورتكم وزيارة. هذا بالضبط ما يفعله تشخيصنا، مجاناً
          ودون التزام.
        </p>
      </div>

      <RelatedLinks
        links={[
          { href: L('/blog'), label: 'كل المقالات' },
          { href: L('/guides'), label: 'الأدلّة الدائمة' },
          { href: L('/prix-panneaux-solaires-maroc'), label: 'أثمنة الألواح الشمسية بالمغرب (دائم)' },
        ]}
      />
    </article>

    <CtaBand title="فاتورتكم وحدها تعطي الرقم الدقيق." href={L('/devis/mon-toit')} />

    <StickyCta />
  </div>
</Layout>
