---
/**
 * AR — Article 33 regularization (W67, RTL). Faithful Arabic translation of
 * /regularization-article-33 ; no new figure or claim (law number 82-21,
 * Article 33, decree 2-25-100, date 9 June 2026 and all amounts kept exact, in
 * Latin digits). Internal links use localizeNavHref (EN/AR if available, else
 * the existing FR page — never a dead link). FR untouched.
 *
 * ÉLÉVATION (W241) — mirrors the FR regularization-article-33.astro elevation:
 *  1. brass discipline: eyebrow text-lune (not text-brass-300);
 *  2. timeline steps: solid brass discs → fig lum numbers in azur rings (bg-nuit);
 *  3. timeline rail: border-brass-400/60 → border-white/15;
 *  4. diamond bullets: border-brass-400 → border-azur-200/70;
 *  5. .section + seam-soft tokens;
 *  6. glow on primary CTA WhatsApp button;
 *  7. RTL structural fixes preserved from original AR page.
 */
import Layout from '../../layouts/Layout.astro';
import { pageLocale } from '../../lib/pageCtx';
import V2Enhance from '../../components/V2Enhance.astro';
import Article33Ribbon from '../../components/Article33Ribbon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StickyCta from '../../components/StickyCta.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { WHATSAPP_LEADS } from '../../lib/nap';
import { whatsappLink, regularizationWhatsappText } from '../../lib/whatsapp';
import { localizeNavHref } from '../../i18n/pages';
import RegularisationDossier from '../../components/blocs/RegularisationDossier.astro';

const { locale, L } = pageLocale(Astro.url.pathname);

const waFallback = whatsappLink(WHATSAPP_LEADS, regularizationWhatsappText(undefined, 'ar'));

const steps = [
  { title: 'الجرد التقني', body: 'معاينة التركيبة القائمة: القدرة المُركّبة، نمط الربط، مستوى الجهد، معدات الحماية والعدّ.' },
  { title: 'تحديد النظام', body: 'حسب القدرة والربط، تندرج التركيبة ضمن التصريح أو اتفاق الربط أو الترخيص (مرسوم <span dir="ltr">2-25-100</span>).' },
  { title: 'تكوين الملف', body: 'بطاقات تقنية، مخطط أحادي الخط، شهادات المطابقة واستمارات النظام المطبَّق — مُعدّة من طرفنا.' },
  { title: 'إيداع طلب التسوية', body: 'الإيداع لدى مدبّر الشبكة أو السلطة المختصة، في إطار الأجل الذي تنص عليه المادة <span dir="ltr">33</span>.' },
  { title: 'المتابعة حتى المطابقة', body: 'متابعة الدراسة، الردّ على المستندات التكميلية المطلوبة، وعند الاقتضاء تحيين تقني للتركيبة.' },
];

const sanctions = [
  { title: 'وضعية غير قانونية', body: 'تركيبة قائمة غير مُسوّاة هي في وضعية غير قانونية إزاء القانون <span dir="ltr">82-21</span>، الساري المفعول الآن.' },
];
---

<Layout
  title="تسوية المادة 33 — التركيبات الشمسية القائمة | Taqinor"
  description="المرسوم التطبيقي 2-25-100 ساري المفعول. تؤطّر المادة 33 من القانون 82-21 تسوية التركيبات الشمسية القائمة: مسطرة من 5 مراحل وتكفّل كامل بالملف."
  ogSlug="article-33"
>
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'الرئيسية', href: L('/') }, { label: 'تسوية المادة 33' }]} />

    <section class="section px-4 text-white">
      <div class="mx-auto max-w-6xl">
        {/* eyebrow مُخفَّض إلى lune (انضباط النحاس) */}
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">القانون <span dir="ltr">82-21</span> — المادة <span dir="ltr">33</span></p>
        <h1 class="display v2-page-title cine-in cine-in-1 mt-5 max-w-3xl">تركيبتك الشمسية قائمة بالفعل؟ سوّها الآن.</h1>
        <p class="v2-lead cine-in cine-in-2 mt-6 max-w-xl text-white/85">
          المرسوم التطبيقي <span dir="ltr">2-25-100</span> ساري المفعول. وقرار ANRE رقم <span dir="ltr">04/26</span> يحدّد تعريفة الفائض للتركيبات المربوطة بالتوتر
          المتوسط والعالي والعالي جداً (<span dir="ltr">MT/HT/THT</span>)؛ أمّا في التوتر المنخفض، فإعادة بيع الفائض غير مفتوحة،
          حتى بقدرة <span dir="ltr">11 kW</span> فأكثر بموجب اتفاق ربط. ويُطبَّق نظام القانون <span dir="ltr">82-21</span> على جميع تركيبات الإنتاج الذاتي — حتى تلك
                    المُركّبة قبل صدور النص بزمن.
        </p>
      </div>
    </section>

    <!-- W259 — «أين وصل القانون؟»: يميّز بين السّاري (MT/HT) والمنتظَر (BT سكني). -->
    <div class="seam-soft" aria-hidden="true"></div>
    <section class="section mx-auto max-w-3xl px-4">
      <div class="v2-rise border-2 border-brass-400/50 bg-nuit-800/60 p-6 sm:p-8">
        <p class="tech-label v2-kicker text-brass-300">أين وصل القانون؟ · تم التحقّق في <span dir="ltr">5 أكتوبر 2026</span></p>
        {/* CIW413 — نفس جمل التعريفة في CIW412 (مقرر ANRE 04/26 المادتان 6-7؛ المرسوم 2.25.100 المادة 12؛
            D-CIQ-4): التعريفة تخص التوتر، والتوتر المنخفض غير مفتوح. */}
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <p class="tech-label text-lune">ساري المفعول</p>
            <p class="mt-2 text-sm leading-relaxed text-lune-soft">
              المرسوم التطبيقي <strong class="text-white" dir="ltr">2-25-100</strong> (ساري المفعول) وقرار ANRE رقم <strong class="text-white" dir="ltr">04/26</strong>.
              تعريفة الفائض (قرار ANRE 04/26):
              <strong class="text-white" dir="ltr"> 0,18 درهم/kWh خارج الذروة، 0,21 درهم/kWh في الذروة، دون احتساب الرسوم</strong>،
              للتركيبات المربوطة بـ<strong class="text-white">التوتر المتوسط أو العالي أو العالي جداً (<span dir="ltr">MT/HT/THT</span>)</strong>،
              أياً كان نظامها.
            </p>
          </div>
          <div>
            <p class="tech-label text-lune">لم يُنشَر بعد</p>
            <p class="mt-2 text-sm leading-relaxed text-lune-soft">
              في <strong class="text-white">التوتر المنخفض (<span dir="ltr">BT</span>)</strong>، أياً كان النظام — بما في ذلك محل
              تجاري بقدرة <span dir="ltr">11 kW</span> فأكثر بموجب اتفاق ربط — إعادة بيع الفائض غير مفتوحة إلى حدود اليوم.
              أودِعوا ملف المادة <span dir="ltr">33</span> دون انتظار، بصرف النظر عن هذه التعريفة.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section mx-auto max-w-3xl px-4">
      <div class="v2-rise">
        {/* eyebrow مُخفَّض إلى lune */}
        <p class="tech-label v2-kicker rule-brass text-lune">النص</p>
        <h2 class="display v2-section-title mt-4 text-white">ما تقوله المادة <span dir="ltr">33</span></h2>
        <p class="v2-lead mt-5 text-lune-soft">
          تؤطّر المادة <span dir="ltr">33</span> من القانون <span dir="ltr">82-21</span> تسوية التركيبات القائمة؛
          نصّها الحرفي مذكور في <a href={L('/loi-82-21')} class="border-b border-brass-300/60 font-semibold text-brass-300">صفحة القانون 82-21</a>.
          بعد تسوية الملف، تصبح التركيبة مطابقة للقانون مثل تركيبة جديدة.
        </p>
      </div>

      <h2 class="display v2-section-title v2-rise mt-14 text-white">من المعني؟</h2>
      {/* معيّنات بحدود azur (الذهب يبقى للأرقام/CTA) */}
      <ul class="v2-rise mt-5 space-y-2.5 text-sm leading-relaxed text-lune-soft">
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>كل تركيبة شمسية للإنتاج الذاتي شُغّلت قبل دخول النظام حيّز التنفيذ — فيلا، مستودع، فندق، ضيعة فلاحية.</span></li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>مربوطة بالشبكة أو في موقع معزول، أياً كانت القدرة.</span></li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>دون تصريح، دون اتفاق ربط أو دون ترخيص إزاء النظام المطبَّق.</span></li>
      </ul>

      <h2 class="display v2-section-title v2-rise mt-14 text-white">التسوية في 5 مراحل</h2>
      {/* خط الجدول الزمني خُفِّف؛ أرقام الخطوات .lum في حلقة azur — لا قرص نحاسي */}
      <ol class="mt-8 border-s-2 border-white/15 ar-timeline" data-stagger>
        {steps.map((s, i) => (
          <li class="v2-rise relative pb-8 ps-8 last:pb-0" style={`--v2-i:${i}`}>
            <span class="fig lum ar-timeline-step absolute flex h-10 w-10 items-center justify-center rounded-full border border-azur-200/40 bg-nuit text-lg" dir="ltr">{i + 1}</span>
            <h3 class="display pt-1.5 text-lg text-white" set:html={s.title}></h3>
            <p class="mt-1.5 text-sm leading-relaxed text-lune-soft" set:html={s.body}></p>
          </li>
        ))}
      </ol>

      <h2 class="display v2-section-title v2-rise mt-14 text-white">وضعية تركيبة غير مسوّاة</h2>
      <p class="v2-rise mt-2 text-sm text-lune-soft">في نظر القانون <span dir="ltr">82-21</span>:</p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2" data-stagger>
        {sanctions.map((s, i) => (
          <div class="v2-rise cine-card border-alert-300/30 p-5" style={`--v2-i:${i}`}>
            <h3 class="font-display text-sm font-bold text-alert-300" set:html={s.title}></h3>
            <p class="mt-1.5 text-sm leading-relaxed text-lune-soft" set:html={s.body}></p>
          </div>
        ))}
      </div>

      <RelatedLinks mt="mt-8" links={[
        { href: L('/loi-82-21'), label: 'الأنظمة الثلاثة للقانون 82-21' },
        { href: L('/guides/loi-82-21-expliquee'), label: 'القانون 82-21 مشروحاً ببساطة' },
        { href: L('/résidentiel'), label: 'تسوية منزل سكني' },
        { href: L('/professionnel'), label: 'تسوية موقع مهني' },
      ]} />
    </section>

    <!-- ACTE FINAL — le dossier se confie en pleine lumière -->
    <RegularisationDossier kicker="تكفّل كامل" titre="اعهد إلينا بالملف" intro="سؤالان، ورسالة واتساب تنطلق كاملة بالفعل — نحدّد النظام المطبَّق ونكوّن الملف." kwcLabel={`القدرة التقريبية (<span dir="ltr">kWc</span>)`} kwcPlaceholder="مثلاً 5" inconnu="لا أعرف القدرة" villeLabel="مدينة التركيبة" villePlaceholder="مثلاً الدار البيضاء" cta="ابدأ على واتساب" waFallback={waFallback} />

    <StickyCta />
  </div>
</Layout>

<style>
  /*
   * W214 — RTL structural fix: timeline dots.
   * In RTL, the inline-start side is the RIGHT. The timeline rail uses
   * border-s-2 (logical = border-inline-start = right in RTL).
   * The step circle is positioned absolutely at the inline-start edge.
   */
  [dir="rtl"] .ar-timeline {
    /* border-inline-start already correct via border-s-2 */
  }
  [dir="rtl"] .ar-timeline > li {
    padding-inline-start: 2rem; /* ps-8 = 2rem */
  }
  [dir="rtl"] .ar-timeline .ar-timeline-step {
    /* position at inline-start edge (right in RTL), inset -1.25rem */
    inset-inline-start: -1.25rem;
    inset-inline-end: auto;
  }
  /* LTR fallback */
  [dir="ltr"] .ar-timeline .ar-timeline-step {
    left: -1.25rem;
  }
</style>
