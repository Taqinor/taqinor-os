---
/**
 * AR — Pillar (W293, RTL): Solar panel prices in Morocco. Faithful Arabic
 * translation of /prix-panneaux-solaires-maroc — every figure kept in Latin
 * digits, mirrored 1:1 from the FR (same source: the dated blog post
 * prix-installation-solaire-maroc-2026). Internal links use localizeNavHref
 * (EN/AR if available, else the existing FR page — never a dead link). FR
 * untouched.
 */
import Layout from '../../layouts/Layout.astro';
import { pageLocale } from '../../lib/pageCtx';
import V2Enhance from '../../components/V2Enhance.astro';
import Article33Ribbon from '../../components/Article33Ribbon.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaLigne from '../../components/CtaLigne.astro';
import CtaBand from '../../components/CtaBand.astro';
import StickyCta from '../../components/StickyCta.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Faq from '../../components/Faq.astro';
import { NAP } from '../../lib/nap';
import { localizeNavHref } from '../../i18n/pages';
import { DATE_LONGUE_AR as dateFmt } from '../../lib/format';
import { PHRASE_TVA } from '../../lib/prixConstants';

const { locale, L } = pageLocale(Astro.url.pathname);

const verifiedDate = new Date('2026-11-04');

// WAUD68 (D-WAUD-5 = a) — لا مبلغ ما دام lib/prixConstants.ts بلا مصدر مؤرَّخ (قائمة الأرقام المسحوبة هناك).
// schema={false}: تبقى /faq الصفحة الوحيدة الحاملة لـFAQPage في الموقع.
const faq = [
  {
    q: 'كم تكلّف تركيبة شمسية جاهزة بالمغرب؟',
    a: 'يتوقّف الثمن على القدرة المعتمدة انطلاقاً من فاتورتكم، وعلى السقف، والبطارية إن وُجدت، والعلامات المركَّبة. لا ننشر هامش أسعار بلا مصدر مؤرَّخ: ثمن تركيبكم يخرج من دراسة مجانية لفاتورتكم.',
  },
  {
    q: 'لماذا يجب أن يثير ثمن منخفض جداً للـkWc الانتباه؟',
    a: 'غالباً ما يطابق ثمن العُدّة وحدها (ألواح + عاكس)، دون التركيب والأسلاك والهيكل والربط — لا تركيبة جاهزة منتهية. قارِنوا دائماً بين عرضين سطراً بسطر.',
  },
  {

    q: 'ما العائد على الاستثمار لتركيبة شمسية بالمغرب؟',
    a: 'يعتمد الحساب بشدّة على استهلاككم الفعلي وشطركم التعريفي لدى ONEE.',
  },
];

const url = new URL(Astro.url.pathname, Astro.site).href;
const schemaImageUrl = new URL('/og/residentiel.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'أثمنة الألواح الشمسية بالمغرب: ما يصنع الثمن',
  description: 'ما يصنع ثمن تركيبة شمسية جاهزة بالمغرب: القدرة (kWc)، السقف، البطارية، العلامات — ولماذا يأتي الرقم الحقيقي من فاتورتكم.',
  image: schemaImageUrl,
  dateModified: verifiedDate.toISOString().slice(0, 10),
  about: { '@type': 'Thing', name: 'ثمن التركيبة الشمسية بالمغرب' },
  author: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: url,
};
---

<Layout
  title="ثمن الألواح الشمسية بالمغرب: ما يصنع الثمن | Taqinor"
  description="كم تكلّف تركيبة شمسية بالمغرب؟ ما يصنع الثمن: القدرة (kWc)، السقف، البطارية، العلامات، الضريبة — ولماذا يأتي الرقم الحقيقي من فاتورتكم."
  ogSlug="residentiel"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'الرئيسية', href: L('/') }, { label: 'أثمنة الألواح الشمسية بالمغرب' }]} />

    <article class="mx-auto max-w-[68ch] px-4 pb-24 pt-12 sm:pb-28">
      <p class="tech-label v2-kicker rule-brass text-lune">الأثمنة وعروض الأسعار</p>
      <h1 class="display v2-page-title mt-5 text-white">أثمنة الألواح الشمسية بالمغرب</h1>

      <p class="guide-byline mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-lune-faint">
        <span>صفحة رُوجعت في {dateFmt.format(verifiedDate)} · بقلم Reda Kasri</span>
      </p>

      <p class="v2-lead mt-6 text-lune-soft">
        «كم تكلّف حقاً؟» هو السؤال الأول في جلّ لقاءاتنا. تشرح هذه الصفحة ما يصنع ثمن التركيب وكيف
        تُقرأ العروض — دون نقل هوامش أسعار لا نستطيع إظهار مصدرها المؤرَّخ. ثمن تركيبكم أنتم يخرج من
        دراسة مجانية لفاتورتكم.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">ما يشمله ثمن التركيب الجاهز</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        يشمل الثمن الجاهز توريد العتاد <strong class="text-white">و</strong>التركيب الكامل: الألواح،
        العاكس، الهيكل، الأسلاك، الحمايات من جهتي التيار المتناوب والمستمر، التشغيل، وحسب القدرة
        التصريح وفق القانون <span dir="ltr" style="unicode-bidi:isolate">82-21</span>. يتوقّف المجموع
        أولاً على <strong class="text-white">القدرة (kWc)</strong> المعتمدة انطلاقاً من استهلاككم، ثم
        على نوع السقف، والمسافة إلى اللوحة الكهربائية، والعلامات المركَّبة، والبطارية إن وُجدت. تبقى
        الزيارة التقنية ضرورية.
      </p>
      <CtaLigne />

      <h2 class="display v2-section-title mt-12 text-white">احذروا من ثمن منخفض جداً للـkWc</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        ثمن للـkWc يبدو بلا منافس يطابق غالباً <strong class="text-white">ثمن العُدّة وحدها</strong>
        (ألواح + عاكس، دون التركيب والأسلاك والهيكل والربط) — لا تركيبة منتهية. قارِنوا بين عرضين سطراً
        بسطر: صفحتنا <a href={L('/devis-panneaux-solaires-maroc')} class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">مقارنة عرضين</a>
        تعطي جدول المشمولات.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">السقف يُحرِّك الثمن</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        يبقى السطح الإسمنتي سهل الولوج أقلّ التهيئات كلفة. سقف القرميد أو الصفيح يتطلّب تركيباً أكثر
        تقنية، والانحدار القوي (أكثر من <span dir="ltr" style="unicode-bidi:isolate">30°</span>) تجهيزات
        سلامة: تظهر هذه التكاليف الإضافية في سطر التركيب من عرض أسعاركم.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">حالة البطارية: مفيدة، لكن ليست محايدة على الكلفة</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        تبقى التركيبة <strong class="text-white">دون بطارية</strong> (المربوطة بالشبكة) الحلّ الأكثر
        شيوعاً لأغلب المنازل الحضرية. بطارية LFP، لتخزين الطاقة للمساء أو لتجاوز الانقطاعات، تضيف بنداً
        مهمّاً إلى عرض الأسعار وتُطيل مدّة الاسترجاع: لا يبرّرها إلا ملف استهلاككم.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">الضريبة على القيمة المضافة</h2>
      <p class="v2-lead mt-5 text-lune-soft">{PHRASE_TVA.ar}</p>

      <h2 class="display v2-section-title mt-12 text-white">العائد على الاستثمار</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        يعتمد هذا الحساب بشدة على استهلاككم الفعلي وشطركم التعريفي لدى ONEE — انظروا صفحتنا
        <a href={L('/financement')} class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">التمويل والربحية</a>
        للتفصيل، ومقالنا
        <a href={L('/blog/rentabilite-solaire-par-ville-maroc')} class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">الربحية حسب المدينة</a>
        للأرقام الجهوية.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">كم لوحاً تحتاجون؟</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        قبل مقارنة الأثمنة، يجب معرفة القدرة المناسبة لبيتكم. أسرة تستهلك بين <span dir="ltr" style="unicode-bidi:isolate">4 000</span> و<span dir="ltr" style="unicode-bidi:isolate">6 000 kWh/سنة</span>
        تحتاج عموماً <span dir="ltr" style="unicode-bidi:isolate">3</span> إلى <span dir="ltr" style="unicode-bidi:isolate">5 kWc</span>؛ بين <span dir="ltr" style="unicode-bidi:isolate">6 000</span> و<span dir="ltr" style="unicode-bidi:isolate">10 000 kWh/سنة</span>، بالأحرى <span dir="ltr" style="unicode-bidi:isolate">5</span> إلى <span dir="ltr" style="unicode-bidi:isolate">8 kWc</span>. دليلنا المخصّص يفصّل
        المنهجية الكاملة:
        <a href={L('/guides/combien-de-panneaux-pour-ma-maison')} class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">كم لوحاً لبيتي؟</a>
      </p>

      <h2 class="display v2-section-title mt-12 text-white">كلمة أخيرة قبل توقيع أي شيء</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        لا يعطي أي هامش عمومي ثمناً نهائياً. تهيئة سقفكم، استهلاككم، شطركم لدى ONEE، والمسافة بين الألواح
        واللوحة الكهربائية تُحرِّك المجموع النهائي. الرقم الوحيد الصالح لبيتكم يخرج من قراءة فاتورتكم
        وزيارة — مجانية ودون التزام.
      </p>
      <p class="v2-lead mt-3 text-xs text-lune-faint">
        لما يتكوّن منه ثمن التركيب سنة 2026 (العتاد، التركيب، الإجراءات)، انظروا مقالنا
        <a href={L('/blog/prix-installation-solaire-maroc-2026')} class="border-b border-white/40 pb-0.5 font-semibold text-white transition-colors hover:border-white">كم تكلّف تركيبة شمسية بالمغرب سنة 2026؟</a>
      </p>

      <RelatedLinks links={[
        { href: L('/résidentiel'), label: 'حلولنا السكنية' },
        { href: L('/nos-solutions'), label: 'كل حلولنا' },
        { href: L('/guides'), label: 'كل الأدلّة' },
        { href: L('/blog'), label: 'المدوّنة' },
      ]} />
    </article>

    <!-- W297 — FAQ مرئية: schema={false}، تبقى /faq الصفحة الوحيدة الحاملة لـFAQPage -->
    <Faq items={faq} heading="أثمنة الألواح الشمسية — أسئلة متكرّرة" schema={false} />

    <CtaBand title="الرقم الوحيد المهم هو رقمكم. أطلِقوا الدراسة المجانية." href={L('/devis/mon-toit')} />

    <StickyCta />
  </div>
</Layout>
