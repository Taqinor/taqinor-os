---
/**
 * AR — « Mon toit » CAPTURE CLIENT (WJ38, RTL-native). Portage FIDÈLE du parcours
 * FR reconstruit (src/pages/devis/mon-toit.astro) : MÊME contrat de soumission
 * /api/capture-lead (validateLead, seuil 1 000 MAD, roofPoint/roofOutline/profil
 * énergétique facultatifs), MÊME logique client (assistant 3 étapes par profil,
 * estimation instantanée dans un DOCUMENT type devis premium, WhatsApp-first,
 * récupération d'abandon) — seul le texte visible est en arabe.
 *
 * Réutilise le markup dual-node `data-i18n`/`data-fr`/`data-ar` (WJ33/WJ17) : cette
 * route /ar/ affiche la paire AR par défaut (applyLang('ar') au chargement), tout en
 * gardant le sélecteur FR/عربي câblé (retour ponctuel au FR). `dir="rtl"` est posé au
 * niveau <html> par Layout.astro via Astro.currentLocale ; les valeurs numériques /
 * unités / dates restent en chiffres occidentaux isolés (dir="ltr").
 */
import Layout from '../../../layouts/Layout.astro';
import { BILL_RANGES } from '../../../lib/billRange';
// « Type de toit » (ROOF_TYPES) retirée du tunnel (coupe fondateur 18/08) — le
// commercial la complète dans l'ERP. `roofType` reste EXIGÉ par validateLead :
// il est désormais DÉRIVÉ (resolveRoofType → 'autre'), plus jamais demandé.
// WJ122 — بطاقات الفئات التجارية مولّدة عند البناء من المصدر الوحيد المنقول من
// solar.js (QX44). الأسئلة الخاصة بكل فئة (COMMERCIAL_CATEGORY_QUESTIONS) رُفعت
// من المسار (قطع فوندر 18/08) : لم تكن أي منها تُغذّي التقدير — يُكمّلها التجاري
// في ERP.
import { COMMERCIAL_CATEGORIES } from '../../../lib/commercialCategories';
const CC_CAT_LABEL: Record<string, string> = {
  hotel: 'فندق / رياض', restaurant: 'مطعم / مقهى', commerce: 'متجر / سوبر ماركت',
  bureau: 'مكتب / مقرّ', sante: 'صحّة (عيادة)', ecole: 'مدرسة خاصة',
  hammam: 'حمّام / سبا / نادٍ رياضي', boulangerie: 'مخبزة', froid: 'مخزن تبريد', autre: 'نشاط آخر',
};
// WJ124 — بطاقات الزراعة + الجهة مولّدة عند البناء من محرّك الزراعة QX48 (مصدر
// وحيد). القيم = مفاتيح CROP_STAGES / ET0_MONTHLY (تقود محرّك الماء) ؛ التسميات
// أدناه مُعرَّبة (الأرقام تبقى غربية).
import { CROP_KEYS, REGION_KEYS } from '../../../lib/agronomy';
const CROP_META: Record<string, { label: string; icon: string }> = {
  agrumes: { label: 'حمضيات', icon: '🍊' }, olivier: { label: 'زيتون', icon: '🫒' },
  dattier: { label: 'نخيل', icon: '🌴' }, avocatier: { label: 'أفوكادو', icon: '🥑' },
  arganier: { label: 'أركان', icon: '🌳' }, 'banane-serre': { label: 'موز (بيت زجاجي)', icon: '🍌' },
  luzerne: { label: 'فصّة', icon: '🌿' }, myrtille: { label: 'توت أزرق', icon: '🫐' },
  amandier: { label: 'لوز', icon: '🌰' }, vigne: { label: 'كرمة', icon: '🍇' },
  grenadier: { label: 'رمّان', icon: '🔴' }, figuier: { label: 'تين', icon: '🌳' },
  'tomate-serre': { label: 'طماطم (بيت زجاجي)', icon: '🍅' }, 'poivron-serre': { label: 'فلفل (بيت زجاجي)', icon: '🫑' },
  'pomme-de-terre': { label: 'بطاطس', icon: '🥔' }, oignon: { label: 'بصل', icon: '🧅' },
  'melon-pasteque': { label: 'بطيخ / دلّاح', icon: '🍉' }, cereales: { label: 'حبوب', icon: '🌾' },
  fraise: { label: 'فراولة', icon: '🍓' }, cannabis: { label: 'قنّب (مرخّص)', icon: '🌿' },
};
const REGION_LABEL: Record<string, string> = {
  'souss-massa': 'سوس-ماسة', doukkala: 'دكالة', tadla: 'تادلة', saiss: 'سايس',
  oriental: 'الجهة الشرقية', 'draa-tafilalet': 'درعة-تافيلالت', 'gharb-loukkos': 'الغرب-اللكوس', haouz: 'الحوز',
};
import { NAP, WHATSAPP_LEADS } from '../../../lib/nap';
import { whatsappLink } from '../../../lib/whatsapp';
import Logo from '../../../components/Logo.astro';
import StarRating from '../../../components/StarRating.astro';
import CertLogoRow from '../../../components/CertLogoRow.astro';
import InstallCounter from '../../../components/InstallCounter.astro';
import ZelligeSignature from '../../../components/ZelligeSignature.astro';

const inputClass =
  'w-full border border-white/15 bg-white/5 px-3 py-3 text-base text-white placeholder:text-lune-faint outline-none transition-colors focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 aria-[invalid=true]:border-alert-300 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-alert-300/30';
// BILL_RANGES sont partagées (contrat lead.ts INCHANGÉ) : les `id` restent
// identiques FR/AR, seul le libellé affiché est traduit ici (lib/billRange.ts
// n'est pas modifié — hors périmètre).
const BILL_RANGE_LABEL_AR: Record<string, string> = {
  lt800: 'أقل من 800 درهم',
  '800-1000': '800 – 1 000 درهم',
  '1000-1500': '1 000 – 1 500 درهم',
  '1500-3000': '1 500 – 3 000 درهم',
  '3000-5000': '3 000 – 5 000 درهم',
  '5000-10000': '5 000 – 10 000 درهم',
  gt10000: 'أكثر من 10 000 درهم',
};
const billRanges = BILL_RANGES.map((b) => ({ ...b, label: BILL_RANGE_LABEL_AR[b.id] ?? b.label }));

// WJ6 — étapes de l'assistant (libellés FR + AR). data-i18n pour bascule de langue.
// COUPE FONDATEUR 21/08 — le tunnel passe de TROIS écrans à DEUX : les questions
// de profil (ex-écran « Votre facture ») et l'estimation + le formulaire de
// contact vivent désormais sur le MÊME écran, la révélation se faisant sur place
// au clic de « Voir mon estimation » (aucune navigation d'étape supplémentaire).
const STEPS = [
  { fr: 'Votre toit', ar: 'سطحك' },
  { fr: 'Votre estimation', ar: 'تقديرك' },
];

// WJ6 — sélecteur de mode, FR + AR. WJ121 — 4 vrais modes : la carte
// « Professionnel » est scindée en 🏭 Industriel (usine, production) et
// 🏪 Commercial (hôtel, commerce, services) ; le site n'émet plus jamais
// 'professionnel' (alias serveur conservé côté lib/lead.ts + backend).
const MODES = [
  { id: 'residentiel', fr: 'Résidentiel', ar: 'سكني', desc_fr: 'Villa, appartement', desc_ar: 'فيلا، شقة' },
  { id: 'industriel', fr: '🏭 Industriel', ar: '🏭 صناعي', desc_fr: 'Usine, production', desc_ar: 'مصنع، إنتاج' },
  { id: 'commercial', fr: '🏪 Commercial', ar: '🏪 تجاري', desc_fr: 'Hôtel, commerce, services', desc_ar: 'فندق، تجارة، خدمات' },
  { id: 'agricole', fr: 'Agricole', ar: 'فلاحي', desc_fr: 'Pompage, ferme', desc_ar: 'ضخ، مزرعة' },
];

// WJ8 — villes desservies (réelles, NAP) pour la preuve de proximité.
const TOWNS = ['Casablanca', 'Rabat', 'Marrakech', 'Tanger', 'Agadir', 'Kénitra', 'Fès', 'Settat'];

// WJ65 — sortie honnête sans JavaScript : ce formulaire dépend entièrement du
// script (calcul d'estimation, soumission fetch) — sans JS, rien ne fonctionne.
const noscriptWaHref = whatsappLink(
  WHATSAPP_LEADS,
  'مرحباً، أرغب في استلام تقديري الشمسي من taqinor.ma (متصفحي لا يفعّل جافاسكريبت).',
);
const noscriptTelHref = `tel:${NAP.phone}`;
import DevisMonToitFieldset60A5 from '../../../components/blocs/DevisMonToitFieldset60A5.astro';
import DevisMonToitLegend2097 from '../../../components/blocs/DevisMonToitLegend2097.astro';
import DevisMonToitDetails955C from '../../../components/blocs/DevisMonToitDetails955C.astro';
import DevisMonToitPE62C from '../../../components/blocs/DevisMonToitPE62C.astro';
import DevisMonToitDiv2129 from '../../../components/blocs/DevisMonToitDiv2129.astro';
import DevisMonToitP680B from '../../../components/blocs/DevisMonToitP680B.astro';
import DevisMonToitDiv3598 from '../../../components/blocs/DevisMonToitDiv3598.astro';
import DevisMonToitPB974 from '../../../components/blocs/DevisMonToitPB974.astro';
import DevisMonToitDiv6C75 from '../../../components/blocs/DevisMonToitDiv6C75.astro';
import DevisMonToitDiv6985 from '../../../components/blocs/DevisMonToitDiv6985.astro';
import DevisMonToitDivFEAA from '../../../components/blocs/DevisMonToitDivFEAA.astro';
import DevisMonToitDiv7D9F from '../../../components/blocs/DevisMonToitDiv7D9F.astro';
import DevisMonToitLi1880 from '../../../components/blocs/DevisMonToitLi1880.astro';
import DevisMonToitTransitionOpacity10D0 from '../../../components/blocs/DevisMonToitTransitionOpacity10D0.astro';
import '../../../styles/mon-toit-doc.css';
import MonToitPart01 from '../../../components/blocs/MonToitPart01.astro';
import MonToitPart02 from '../../../components/blocs/MonToitPart02.astro';
import MonToitPart03 from '../../../components/blocs/MonToitPart03.astro';
import MonToitPart04 from '../../../components/blocs/MonToitPart04.astro';
import MonToitPart05 from '../../../components/blocs/MonToitPart05.astro';
import MonToitPart06 from '../../../components/blocs/MonToitPart06.astro';
import MonToitPart07 from '../../../components/blocs/MonToitPart07.astro';
import MonToitPart08 from '../../../components/blocs/MonToitPart08.astro';
import MonToitPart09 from '../../../components/blocs/MonToitPart09.astro';
---

<Layout
  title="تقدير شمسي فوري — سطحكم | Taqinor"
  description="تقدير فوري + تصميم ثلاثي الأبعاد لسطحكم + توقيع إلكتروني: أدخلوا العنوان والفاتورة، واستلموا القدرة والتوفير ومدة الاسترداد في ثوانٍ، مجاناً."
  ogSlug="accueil"
  locales={['fr', 'en', 'ar']}
>
  <!-- W320 — préconnexion à l'origine carte (MapTiler + tuiles raster Mapbox/Maxar). -->
  <link rel="preconnect" href="https://api.maptiler.com" crossorigin />
  <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
  <!-- QX — le « document d'estimation » (la révélation) utilise DM Serif Display / DM Sans,
       les MÊMES polices que le devis premium PDF. Préchargée ici uniquement. -->
  <link rel="preload" href="/fonts/dm-serif-display-400.woff2" as="font" type="font/woff2" crossorigin />
  <section class="bg-nuit px-4 py-8 sm:py-12">
    <!-- WJ98 — mise en page bureau : élargie au-delà de `max-w-2xl` dès `lg`
         (mobile/tablette inchangés) ; voir la page FR pour la justification. -->
    <div class="mx-auto max-w-2xl lg:max-w-4xl">
      <!-- WJ65 — سطر خروج صادق بدون جافاسكريبت: هذه الصفحة مدفوعة بالكامل
           بالسكربت (الخريطة، الحساب، الإرسال) — بدونه ستبقى صامتة. نوفر هنا
           مخرجاً لا يحتاج أي جافاسكريبت على الإطلاق. -->
      <noscript>
        <div class="cine-card mb-6 border border-brass-400/40 p-5 text-sm text-white">
          <p class="font-semibold">تحتاج هذه الصفحة إلى جافاسكريبت لحساب تقديركم.</p>
          <p class="mt-1 text-lune-soft">
            لا مشكلة: تواصلوا معنا مباشرة، مجاناً وبدون التزام.
          </p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <a href={noscriptWaHref} target="_blank" rel="noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 bg-ok-600 px-5 py-3 text-base font-bold text-white transition-opacity hover:opacity-90">
              الكتابة على واتساب
            </a>
            <a href={noscriptTelHref}
              class="inline-flex flex-1 items-center justify-center gap-2 border border-white/25 px-5 py-3 text-base font-bold text-white transition-colors hover:border-brass-400 hover:text-brass-300">
              الاتصال بـ {NAP.phoneDisplayIntl}
            </a>
          </div>
        </div>
      </noscript>

      <!-- WJ45 — bandeau hors-ligne (navigator.onLine + écouteurs online/offline). -->
      <DevisMonToitDiv2129 />

      <!-- En-tête + bascule de langue FR/عربي (WJ6/WJ38). Sur /ar/, l'arabe est
           affiché par défaut ; le toggle reste câblé pour un retour ponctuel au FR. -->
      <div class="flex items-start justify-between gap-3">
        <DevisMonToitDiv6985 />
        <div class="flex flex-none gap-1 rounded-sm border border-white/15 p-0.5" role="group" aria-label="اللغة">
          <button type="button" id="mt-lang-fr" aria-pressed="true"
            class="px-3 py-1.5 text-sm font-semibold text-azur-950 bg-brass-400 transition-colors">FR</button>
          <button type="button" id="mt-lang-ar" aria-pressed="false"
            class="px-3 py-1.5 text-sm font-semibold text-lune-soft transition-colors hover:text-white">عربي</button>
        </div>
      </div>

      <!-- WJ6/WJ58 — microcopie « pas de pression » + promesse de délai honnête. -->
      <MonToitPart05 />
      <ol id="mt-progress" class="mt-6 grid grid-cols-2 gap-2" aria-label="التقدم">
        <DevisMonToitLi1880 STEPS={STEPS} />
      </ol>

      <!-- ============ ÉTAPE 0/1 — VOTRE TOIT (mode + carte/repère) ============ -->
      <div id="mt-panel-0" class="mt-step-panel">
        <!-- WJ88 — landmark h2 réel par étape (masqué visuellement, sr-only). -->
        <h2 id="mt-h2-0" class="sr-only" data-i18n data-fr={STEPS[0].fr} data-ar={STEPS[0].ar}>{STEPS[0].fr}</h2>
        <!-- WJ6/QX — sélecteur de mode : AUCUN mode présélectionné (le profil pilote
             des questions d'étape 2 entièrement différentes) ; « Continuer » exige un
             choix explicite (nudge inline sur les cartes, jamais une alerte). -->
        <fieldset class="mt-6">
          <legend class="text-sm text-lune-soft" data-i18n data-fr="Votre type de projet" data-ar="نوع مشروعك">Votre type de projet</legend>
          <!-- WJ121 : 4 cartes — 1 colonne sur mobile, 2×2 dès `sm:` (640 px). -->
          <div id="mt-mode-grid" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {MODES.map((m) => (
              <button type="button" class="mt-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-start transition-colors"
                data-mode={m.id} aria-pressed="false" aria-describedby="mt-mode-err">
                <span class="text-sm font-semibold text-white" data-i18n data-fr={m.fr} data-ar={m.ar}>{m.fr}</span>
                <span class="text-xs text-lune-faint" data-i18n data-fr={m.desc_fr} data-ar={m.desc_ar}>{m.desc_fr}</span>
              </button>
            ))}
          </div>
          <span id="mt-mode-err" hidden role="alert" class="mt-2 block text-xs text-alert-300"></span>
        </fieldset>

        <!-- WJ68/QX — les champs entreprise (raison sociale / type de site / nb de
             sites) ont DÉMÉNAGÉ dans le sous-panneau PROFESSIONNEL de l'étape 2. -->

        <DevisMonToitPE62C />

        <!-- Repli sans JavaScript / sans clé carte (WJ4). -->
        <div id="mt-fallback" hidden class="cine-card mt-5 border-s-4 border-alert-300 p-5">
          <DevisMonToitP680B />
          <label class="mt-3 block text-sm text-lune-soft">
            <span data-i18n data-fr="Adresse complète" data-ar="العنوان الكامل">Adresse complète</span>
            <input id="mt-fallback-address" type="text" autocomplete="street-address"
              placeholder="مثال: تجزئة الوفاق، حي الرياض، الرباط" class={`${inputClass} mt-1`} />
          </label>
        </div>

        <!-- CHOIX EXPLICITE du geste de repérage (cf. variante FR) : le flux
             implicite (clic = repère, double-clic = contour) n'était annoncé
             nulle part et le double-clic n'existe pas au doigt. -->
        <div id="mt-roof-mode-group" class="mt-5" role="group" aria-labelledby="mt-roof-mode-label">
          <p id="mt-roof-mode-label" class="text-sm text-lune-soft" data-i18n
            data-fr="Comment souhaitez-vous nous montrer votre toit ?"
            data-ar="كيف تريدون أن تُرونا سطحكم؟">
            Comment souhaitez-vous nous montrer votre toit ?
          </p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <button type="button" id="mt-roof-mode-point" data-value="point" aria-pressed="true"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-start transition-colors">
              <span class="text-sm font-semibold text-white" data-i18n
                data-fr="📍 Pointer mon toit" data-ar="📍 تحديد سطحي بنقطة">📍 Pointer mon toit</span>
              <span class="text-xs text-lune-faint" data-i18n
                data-fr="Un seul appui sur votre toit — le plus rapide."
                data-ar="ضغطة واحدة على سطحكم — الأسرع.">Un seul appui sur votre toit — le plus rapide.</span>
            </button>
            <button type="button" id="mt-roof-mode-draw" data-value="draw" aria-pressed="false"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-start transition-colors">
              <span class="text-sm font-semibold text-white" data-i18n
                data-fr="✏️ Dessiner mon toit" data-ar="✏️ رسم سطحي">✏️ Dessiner mon toit</span>
              <span class="text-xs text-lune-faint" data-i18n
                data-fr="Tracez le contour — plus précis pour l'étude."
                data-ar="ارسموا المحيط — أدق للدراسة.">Tracez le contour — plus précis pour l'étude.</span>
            </button>
          </div>
        </div>

        <!-- CARTE — recherche d'adresse + repère (ids rp9-* câblés par captureBoot). -->
        <div id="mt-stage" class="cine-card mt-5 overflow-hidden">
          <form id="rp9-search" class="flex flex-col gap-3 border-b border-white/10 p-4 sm:flex-row">
            <label for="rp9-address" class="sr-only">عنوانكم</label>
            <div class="relative flex-1">
              <input id="rp9-address" name="address" type="text" autocomplete="off"
                role="combobox" aria-autocomplete="list" aria-expanded="false"
                aria-controls="rp9-suggestions" aria-haspopup="listbox"
                placeholder="العنوان، الحي أو المدينة (مثال: الدار البيضاء، المعاريف)" class={inputClass} />
              <ul id="rp9-suggestions" role="listbox" aria-label="اقتراحات العناوين" hidden
                class="absolute left-0 right-0 top-full z-20 mt-1 max-h-72 overflow-auto border border-white/15 bg-nuit-900 shadow-xl">
              </ul>
            </div>
            <button type="submit"
              class="flex-none bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
              تحديد الموقع
            </button>
          </form>

          <!-- WJ88 — role="application" retiré : aria-label seul suffit à nommer la carte. -->
          <!-- WJ98 — carte plus haute sur bureau (`lg:h-[62vh]`, plafonnée 640px) ; téléphone/tablette inchangés. -->
          <div id="rp9-map" class="mt-skeleton-shimmer mt-0 h-[44dvh] min-h-[280px] w-full bg-nuit-700 lg:h-[62vh] lg:max-h-[640px]"
            aria-label="خريطة الأقمار الصناعية لتحديد سطحكم"></div>

          <div class="flex flex-wrap items-center gap-3 border-t border-white/10 p-4">
            <button type="button" id="rp9-finish" disabled
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-400 hover:text-brass-300 disabled:cursor-not-allowed disabled:opacity-40">
              إنهاء الرسم
            </button>
            <button type="button" id="rp9-undo-point" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              التراجع عن آخر نقطة
            </button>
            <button type="button" id="rp9-add-pan" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              إضافة جزء من السطح
            </button>
            <button type="button" id="rp9-remove-pan" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              إزالة هذا الجزء
            </button>
            <button type="button" id="rp9-clear"
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-white/50 hover:text-white">
              مسح
            </button>
            <p class="ms-auto text-sm text-lune-faint">
              <span>العلامة&nbsp;: </span><span id="rp9-area-value" class="text-white" dir="ltr">—</span>
            </p>
          </div>
          <p id="rp9-status" class="border-t border-white/10 px-4 py-3 text-sm text-lune-faint" aria-live="polite">
            ابحثوا عن عنوانكم، ثم ضعوا علامة على سطحكم (اختياري).
          </p>

          <!-- CONFIRMATION VISUELLE du repère (flux « pointer » uniquement) :
               la carte atterrit serrée sur le repère (captureBoot.landOn) et on
               pose la question à côté de l'image. Le flux « dessiner » a déjà
               son propre retour visuel : le contour. -->
          <div id="mt-pin-confirm" hidden class="border-t border-white/10 p-4">
            <p class="text-sm font-semibold text-white" data-i18n
              data-fr="C'est bien votre toit ?" data-ar="هل هذا هو سطحكم؟">C'est bien votre toit ?</p>
            <p class="mt-1 text-xs text-lune-faint" data-i18n
