                  aria-describedby="mt-cc-bill-err" dir="ltr" placeholder="مثال: 25000" class={`${inputClass} mt-1`} />
                <span id="mt-cc-bill-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
              </label>
            </div>
<MonToitPart01 />
            <p class="text-xs text-lune-faint">
              تقدير إرشادي (الاستهلاك الذاتي، القانون 82-21). تُنجَز دراسة مفصّلة على يد مهندس.
            </p>
          </div>
