<script>
  import { estimateFromBill, formatMad, formatMadRange } from '../../lib/billEstimate';
  // QX — les deux nouveaux moteurs par profil (contrat Lane A) : PRO
  // (autoconsommation C&I) et AGRICOLE (pompage). Le résidentiel reste sur
  // estimateFromBill, inchangé.
  import { estimatePro } from '../../lib/estimatorPro';
  import { estimateAgricole } from '../../lib/estimatorAgricole';
  // WJ122 — les questions commerciales par catégorie (et leur mapping webhook)
  // sont retirées du tunnel (coupe fondateur 18/08) : aucune n'entrait dans
  // estimatePro — le commercial les complète dans l'ERP. lib/commercialCategories
  // reste inchangé (COMMERCIAL_QUESTION_WEBHOOK_KEY sert encore au backend).
  // WJ124 — moteur eau agronomique (culture → besoin m³/jour) — miroir QX48.
  import { monthlyWaterDemand } from '../../lib/agronomy';
  // QX — dérivation automatique de la tranche depuis le montant exact (fix
  // « tranche redondante ») + libellé pour la ligne de confirmation.
  import { billRangeFromExact, billRangeLabel, type BillRangeId } from '../../lib/billRange';
  import { captureWhatsappText, whatsappLink } from '../../lib/whatsapp';
  import { WHATSAPP_LEADS } from '../../lib/nap';
  import { buildClientRef, buildIdempotencyKey, MAX_BILL_BY_MODE } from '../../lib/lead';
  // QJW5 — LE seul constructeur de corps du tunnel, partagé par les trois
  // locales (`src/lib/tunnel/`). Cette page n'a plus de `buildBody()` à elle :
  // elle LIT son DOM dans un état simple et le donne à `construireCorps`, qui
  // applique le registre de champs et appelle `validateLead` lui-même.
  import { construireCorps } from '../../lib/tunnel/corps';
  import type { RoofLayoutPublic } from '../../scripts/roofPro11/captureBoot';
  import { etatVide, type EtatTunnel } from '../../lib/tunnel/champs';
  import { lireChampsDomTunnel } from '../../lib/tunnel/lecture';
  import { ERREURS } from '../../lib/tunnel/i18n';
  // LANE T-WEB (25/08/2026) — empreinte d'appareil anonyme (voir lib/visite.ts) :
  // échoée telle quelle sur le lead pour corréler avec les visites de balise.
  import { appareilId } from '../../lib/visite';
  // QX/Lane C — TYPE seul (effacé au build : Three.js/viewerOnly ne rejoint
  // JAMAIS le bundle initial — WJ18 ; le module réel reste en import() lazy).
  import type { RoofImageSpec } from '../../scripts/roofPro11/viewerOnly';
  // WJ72 — UN SEUL style de nombre kWc, partagé avec la proposition
  // (src/lib/proposition.ts) : virgule décimale, zéros de fin retirés — plus
  // jamais le point brut de `String(est.kwc)`.
  import { formatKwc } from '../../lib/proposition';
  // W342 — « installation la plus proche » : haversine client-side sur le
  // repère GPS posé (aucun appel réseau). (2026-09) pool restreint aux
  // chantiers publiant un `kwc` — cette carte l'affiche, donc jamais un
  // chantier réel mais sans chiffre publié (ex. Bouskoura).
  import { nearestRealisation, REALISATIONS } from '../../lib/realisations';
  const REALISATIONS_WITH_KWC = REALISATIONS.filter((r) => r.kwc);
  // L-WEBT — silhouettes d'occupation SERVEUR (CJ2a) : lib/dayProfiles.ts
  // recopie VERBATIM backend/django_core/apps/ventes/courbes_journalieres.py
  // SILHOUETTES_OCCUPATION (test croisé backend↔TS). Aucun poids inventé ici.
  import { OCCUPANCY_IDS, OCCUPANCY_SHAPES, type OccupancyId } from '../../lib/dayProfiles';
  // L-WEBT TASK2 / QJR664 — « Une journée type » (rendu partagé fr/en/ar).
  import { renderJourType } from '../../scripts/tunnel/jourType';
  import { brancherAffiner } from '../../scripts/tunnel/affiner';

  import { creerContexte, type ConfigLocale } from '../../lib/tunnel/contexte';
  import { creerDom } from '../../lib/tunnel/dom';
  import { creerEtat } from '../../lib/tunnel/etat';
  import { installerPersistance, loadWizardState } from '../../lib/tunnel/persistance';
  import { installerParcours } from '../../lib/tunnel/parcours';
  import { installerSelections } from '../../lib/tunnel/selections';
  import { installerCarteApercu3d, installerCarteBoot, installerCarteInstantane, type ContexteCarte } from '../../lib/tunnel/carte';
  import { installerEstimationPro, type ContexteEstimationPro } from '../../lib/tunnel/estimationPro';
  import { installerEstimationResidentielleAffichage, installerEstimationResidentielleCalcul, installerEstimationResidentielleSuivi, installerEstimationResidentielleZones, type ContexteEstimationResidentielle } from '../../lib/tunnel/estimationResidentielle';
  import { installerCorpsLead, installerValidationChamps } from '../../lib/tunnel/validation';
  import { installerEnvoi } from '../../lib/tunnel/envoi';

  // RWEB17-M10 — UN état et UN registre de crochets pour les trois pages : les
  // `let` de haut niveau vivent dans `ctx.etat` (valeurs initiales de
  // `creerEtat`, identiques à celles de la page), et les fonctions appelées par
  // une AUTRE section passent par `ctx.crochets` (liaison tardive, sans TDZ).
  const CONFIG_FR: ConfigLocale = {
    locale: 'fr',
    langueBasculable: true,
    formatNombre: (n: number): string => (Math.round(n * 10) / 10).toLocaleString('fr-FR'),
  };
  const savedWizard = loadWizardState();
  const ctx = creerContexte(creerDom(document), creerEtat(savedWizard, 'fr'), CONFIG_FR);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id: string) => document.getElementById(id);
  const fallback = $('mt-fallback');
  const cityEl = $('mt-city') as HTMLInputElement | null;
  const addressEl = $('rp9-address') as HTMLInputElement | null;
  const fallbackAddrEl = $('mt-fallback-address') as HTMLInputElement | null;
  // ——— RWEB17-M11 — section « persistance » (lib/tunnel/persistance.ts) : jeton et
  // balises de funnel (WJ59/WB30), bandeau hors ligne (WJ45), instantané `mt-wizard-v1`
  // (WJ61), garde `beforeunload`, jetons de dédoublonnage, référence client (WJ52) et
  // clés de suivi ; ses crochets sont inscrits ici. ———
  const persistance = installerPersistance(ctx, savedWizard);
  // ——— RWEB17-M12 — section « parcours » (lib/tunnel/parcours.ts) : ville facultative
  // avec GPS, bascule FR/AR (FR et AR seulement), `?mode=` et migration 'professionnel' ;
  // puis, à leur place d'origine, modes, étapes, rappel et clic « estimation ». ———
  const parcours = installerParcours(ctx, savedWizard);
  // QX/WJ121 — cartes de mode, fil d'étapes et sous-panneaux par profil.
  parcours.brancherModes();
  // ——— RWEB17-M13 — section « sélections » (lib/tunnel/selections.ts) : créneau de visite
  // (W353), occupation de la journée et équipements (L-WEBT), « journée type » (QJR664) ;
  // les groupes de cartes et la facture sont branchés plus bas, à leur place. ———
  const selections = installerSelections(ctx);
  selections.brancherVisiteOccupationEquipements();
  // ——— RWEB17-M14 — section « carte et toiture » (lib/tunnel/carte.ts) : boot de la carte
  // (W324 : un seul /api/roof-config, à l'écran 0), repli adresse, geste pointer/dessiner
  // et confirmation du repère ; MapLibre/Three restent en import() dynamique (WJ18). ———
  Object.assign(ctx.config, {
    doc: document,
    reducedMotion,
    statutsSuiventLangue: false,
    optionsBootLocale: {},
    chargeurs: {
      captureBoot: () => import('../../scripts/roofPro11/captureBoot'),
      viewerOnly: () => import('../../scripts/roofPro11/viewerOnly'),
    },
  });
  const ctxCarte = ctx as unknown as ContexteCarte;
  installerCarteBoot(ctxCarte);
  // WJ61 — étapes : historique, popstate, « Continuer » / « Retour », premier rendu.
  parcours.brancherEtapes();

  // ——— helpers de saisie ———
  const val = (id: string) => (($(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '');
  const num = (id: string): number | null => {
    const raw = val(id).trim();
    if (raw === '') return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  };
  // WJ105 — SLA de rappel visible seulement si « Un conseiller peut m'appeler ».
  parcours.brancherRappel();
  // WJ61 — réhydratation des champs, du repère et du contour (avant le boot de la carte).
  persistance.rehydrater();
  // WJ61 — persiste sur toute frappe/changement des champs listés.
  persistance.brancherPersistanceSurSaisie();
  // Geste « pointer » / « dessiner » et confirmation du repère : branchés par installerCarteBoot (plus haut).
  // QX/WJ122/WJ123/WJ124/AGW403 — groupes de cartes, cultures, heures de pompage, recalcul en direct.
  selections.brancherGroupes();
  // WJ65/QX — plafond de bon sens PAR PROFIL (MAX_BILL_BY_MODE, lib/lead.ts) :
  // au-delà, une faute de frappe produirait un chiffre affirmé avec assurance —
  // on demande de vérifier (résidentiel) ou on route vers l'étude dédiée (pro).
  // Ne s'applique qu'au montant EXACT saisi, jamais aux tranches.
  function maxBillFor(m: string): number {
    return MAX_BILL_BY_MODE[m as keyof typeof MAX_BILL_BY_MODE] ?? 200_000;
  }

  // ——— WJ1/QX : calculer + afficher l'estimation dans LE DOCUMENT ———
  // QX — le document a-t-il déjà été rendu au moins une fois (fallback compris) ?
  // QX — estimateShown : EXACTEMENT les chiffres calculés, joints au lead (le
  // conseiller CRM voit tout). WJ125 — ils ne sont PLUS rendus à l'écran public.
  // ——— WJ125 — RÈGLE FONDATEUR anti-concurrent : en parcours public, le
  // document d'estimation chiffré (#mt-doc), l'« installation la plus proche »
  // (kWc + km) et le « coût de l'attente » (MAD) NE SE RENDENT PLUS. Le calcul
  // continue en silence (estimateShown + labels partent au CRM et au deeplink
  // WhatsApp) mais AUCUN chiffre précis n'est écrit dans le DOM public : une
  // carte teaser verrouillée (aperçu flouté SANS le moindre chiffre) renvoie au
  // formulaire. Le document complet + « Imprimer » vivent UNIQUEMENT sur
  // /proposition/<token> (envoyé par le commercial). ———
  const PUBLIC_ESTIMATE_GATED: boolean = true;
  // ——— Décision fondateur 13/09/2026 (modèle « Palmetto ») : l'aperçu 3D des
  // panneaux redevient visible AVANT la porte de contact — VISUEL SEUL, aucun
  // chiffre dans le DOM (ni kWc, ni nombre de panneaux, ni prix : vérifié dans
  // le bloc #mt-panels3d et viewerOnly). Le wow pré-contact aide la conversion
  // (les meilleurs tunnels mondiaux montrent l'implantation et verrouillent le
  // PRIX) ; WJ125 reste intact pour tous les chiffres, qui vivent sur
  // /proposition/<token>. Repasser à false pour ré-masquer le 3D public.
  const PUBLIC_3D_PREVIEW: boolean = true;
  const GATED_ANNOUNCE = 'Votre estimation est prête. Renseignez vos coordonnées pour recevoir votre étude complète et personnalisée.';
  // ——— RWEB17-M16 — section « estimation résidentielle et document » (lib/tunnel/
  // estimationResidentielle.ts) : teaser gaté (WJ125), annonce aria-live (WJ88), cartes KPI,
  // graphique mensuel, habillage du document ; zones, calcul et suivi branchés plus bas. ———
  Object.assign(ctx.config, { estimationGatee: PUBLIC_ESTIMATE_GATED, dateSuitLangue: false });
  const ctxResidentiel = ctx as unknown as ContexteEstimationResidentielle;
  installerEstimationResidentielleAffichage(ctxResidentiel);
  // QX/Lane C — « Votre toit » dans le document : instantané satellite partagé avec l'aperçu 3D.
  installerCarteInstantane(ctxCarte);
  // QX — remise à zéro des zones du document entre deux calculs.
  installerEstimationResidentielleZones(ctxResidentiel);
  // ——— RWEB17-M15 — section « estimation pro et agricole » (lib/tunnel/estimationPro.ts) :
  // C&I (estimatePro, WJ121/WJ122/WJ123) et pompage (estimateAgricole, WJ111/WJ124), annonces
  // aria-live par locale ; le gate WJ125 et son annonce viennent de la page. ———
  Object.assign(ctx.config, { estimationGatee: PUBLIC_ESTIMATE_GATED, annonceGatee: GATED_ANNOUNCE });
  installerEstimationPro(ctx as unknown as ContexteEstimationPro);
  // WJ1/QX — calcul résidentiel (estimateFromBill) ; délègue pro/agricole à leur section.
  installerEstimationResidentielleCalcul(ctxResidentiel);
  // WJ34/WJ48 — squelette, délai de calcul et révélation sur place au clic « estimation ».
  parcours.brancherEstimation();
  // QX — « engagé » (formulaire / impression) et recalcul à la volée sur la facture.
  installerEstimationResidentielleSuivi(ctxResidentiel);
  // WJ2 — aperçu 3D des panneaux (visuel seul, PUBLIC_3D_PREVIEW) et impression du document.
  Object.assign(ctx.config, { estimationGatee: PUBLIC_ESTIMATE_GATED, apercu3dPublic: PUBLIC_3D_PREVIEW });
  installerCarteApercu3d(ctxCarte);
  // ——— RWEB17-M17 — section « validation et corps du lead » (lib/tunnel/validation.ts) :
  // validation en direct au blur (jamais de « snap » des valeurs tapées), « Continuer » valide
  // son étape ; le corps du lead est branché plus bas, à sa place. ———
  installerValidationChamps(ctx, document);
  // QJW5 — état de la page -> construireCorps (registre partagé de champs), erreurs inline.
  installerCorpsLead(ctx, document);
  // ——— RWEB17-M18 — section « envoi et sortie » (lib/tunnel/envoi.ts) : lien WhatsApp (WJ52,
  // D-RWEB17-WA-REF : « Ma référence : <code> » sur les trois locales), relève de la référence
  // serveur (WREF2-L3), « Affiner » (CIW405), soumission /api/capture-lead (WJ60 : 15 s), modale
  // de sortie (WJ33/WJ46/WJ102), puis l'état initial après réhydratation complète. ———
  installerEnvoi(ctx, document);
</script>
