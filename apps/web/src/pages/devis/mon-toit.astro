<script>
  import { estimateFromBill, formatMad, formatMadRange } from '../../lib/billEstimate';
  // QX — les deux nouveaux moteurs par profil (contrat Lane A) : PRO
  // (autoconsommation C&I) et AGRICOLE (pompage). Le résidentiel reste sur
  // estimateFromBill, inchangé.
  import { estimatePro } from '../../lib/estimatorPro';
  import { estimateAgricole } from '../../lib/estimatorAgricole';
  // WJ122 — les questions commerciales par catégorie (et leur mapping webhook)
  // sont retirées du tunnel (coupe fondateur 18/08) : aucune n'entrait dans
  // estimatePro — le commercial les complète dans l'ERP. lib/commercialCategories
  // reste inchangé (COMMERCIAL_QUESTION_WEBHOOK_KEY sert encore au backend).
  // WJ124 — moteur eau agronomique (culture → besoin m³/jour) — miroir QX48.
  import { monthlyWaterDemand } from '../../lib/agronomy';
  // QX — dérivation automatique de la tranche depuis le montant exact (fix
  // « tranche redondante ») + libellé pour la ligne de confirmation.
  import { billRangeFromExact, billRangeLabel, type BillRangeId } from '../../lib/billRange';
  import { captureWhatsappText, whatsappLink } from '../../lib/whatsapp';
  import { WHATSAPP_LEADS } from '../../lib/nap';
  import { buildClientRef, buildIdempotencyKey, validateLead, MAX_BILL_BY_MODE } from '../../lib/lead';
  // QX/Lane C — TYPE seul (effacé au build : Three.js/viewerOnly ne rejoint
  // JAMAIS le bundle initial — WJ18 ; le module réel reste en import() lazy).
  import type { RoofImageSpec } from '../../scripts/roofPro11/viewerOnly';
  // WJ72 — UN SEUL style de nombre kWc, partagé avec la proposition
  // (src/lib/proposition.ts) : virgule décimale, zéros de fin retirés — plus
  // jamais le point brut de `String(est.kwc)`.
  import { formatKwc } from '../../lib/proposition';
  // W342 — « installation la plus proche » : haversine client-side sur le
  // repère GPS posé (aucun appel réseau).
  import { nearestRealisation } from '../../lib/realisations';
  // L-WEBT — silhouettes d'occupation SERVEUR (CJ2a) : lib/dayProfiles.ts
  // recopie VERBATIM backend/django_core/apps/ventes/courbes_journalieres.py
  // SILHOUETTES_OCCUPATION (test croisé backend↔TS). Aucun poids inventé ici.
  import { OCCUPANCY_IDS, OCCUPANCY_SHAPES, type OccupancyId } from '../../lib/dayProfiles';
  // L-WEBT TASK2 — « Une journée type » : jeu de données VIDE par construction
  // (voir jourTypeData.ts, [HANDOFF]) — le composant se masque tant qu'aucune
  // vraie donnée moteur n'a été collée.
  import { JOUR_TYPE_MONTH_IDS, JOUR_TYPE_MONTH_LABELS, JOUR_TYPE_DATA, hasJourTypeData } from '../../lib/jourTypeData';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (id: string) => document.getElementById(id);
  const fallback = $('mt-fallback');
  const cityEl = $('mt-city') as HTMLInputElement | null;
  const addressEl = $('rp9-address') as HTMLInputElement | null;
  const fallbackAddrEl = $('mt-fallback-address') as HTMLInputElement | null;

  // ——— WJ59 : beacon de funnel étape par étape (privacy-light, aucune PII) ———
  // Jeton anonyme PAR ONGLET (sessionStorage, jamais un identifiant
  // d'appareil/utilisateur) : sert uniquement à dédupliquer/corréler les
  // événements « atteint »/« abandonné » d'UNE MÊME visite, jamais à
  // identifier un visiteur. Voir src/lib/funnelBeacon.ts pour le contrat
  // complet (allowlist stricte de 4 champs, jamais nom/téléphone/e-mail/
  // adresse/GPS/contour).
  const FUNNEL_TOKEN_KEY = 'mt-funnel-token-v1';
  function getFunnelToken(): string {
    try {
      let t = sessionStorage.getItem(FUNNEL_TOKEN_KEY);
      if (!t) {
        t = Math.random().toString(36).slice(2) + Date.now().toString(36);
        sessionStorage.setItem(FUNNEL_TOKEN_KEY, t);
      }
      return t;
    } catch {
      // sessionStorage indisponible : jeton éphémère (une seule requête, pas
      // de corrélation possible) — jamais un blocage de la mesure ni de l'UX.
      return Math.random().toString(36).slice(2);
    }
  }
  const funnelToken = getFunnelToken();
  const funnelStepReached = new Set<string>(); // évite les doublons « reached » sur re-render.
  // WB30 — le consentement (case à cocher) n'existe QUE dans le bloc contact :
  // tant que le visiteur ne l'a pas atteint, aucun signal comportemental ne doit
  // partir, même anonyme/best-effort. `hasReachedConsentStep` lit `step` et
  // `revealed` (déclarés plus bas) — vérifiée à l'APPEL, jamais dans
  // `sendFunnelBeacon` (dont le paramètre `step` masque volontairement la
  // variable homonyme).
  // COUPE FONDATEUR 21/08 — la garantie WB30 est STRICTEMENT la même, seule sa
  // coordonnée change : le bloc contact était l'écran 2 (`step >= 2`), il est
  // désormais la RÉVÉLATION de l'écran 1. Tant qu'elle n'est pas ouverte, la
  // case de consentement n'est pas à l'écran — donc aucun beacon.
  function hasReachedConsentStep(): boolean {
    return step >= 1 && revealed;
  }
  /** Best-effort, JAMAIS bloquant : sendBeacon survit à la fermeture d'onglet,
   *  avec repli fetch(keepalive) si sendBeacon est indisponible. Aucune PII
   *  possible dans ce corps (4 champs seulement — cf. lib/funnelBeacon.ts).
   *  WB30 : n'émet rien avant que l'étape de consentement (la révélation) soit
   *  atteinte — voir hasReachedConsentStep, vérifiée par chaque appelant.
   *  WJ104 — `action` élargi à `viewed`/`callback_requested` (delta
   *  d'instrumentation, cf. lib/telemetryEvents.ts toFunnelWire) ; `reached`/
   *  `abandoned` restent inchangés pour tout appelant existant. */
  function sendFunnelBeacon(
    step: 'toit' | 'facture' | 'estimation' | 'contact',
    action: 'reached' | 'abandoned' | 'viewed' | 'callback_requested',
  ) {
    // WJ104 — même discipline de déduplication que « reached » : un événement
    // « atteint une fois » ne doit jamais être renvoyé en boucle (ex. l'estimation
    // qui se recalcule plusieurs fois pendant que le visiteur ajuste sa facture).
    if (action === 'reached' || action === 'viewed' || action === 'callback_requested') {
      const key = `${step}:${action}`;
      if (funnelStepReached.has(key)) return;
      funnelStepReached.add(key);
    }
    try {
      const payload = JSON.stringify({ step, action, sessionToken: funnelToken, path: location.pathname });
      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'application/json' });
        navigator.sendBeacon('/api/funnel-beacon', blob);
      } else {
        void fetch('/api/funnel-beacon', { method: 'POST', headers: { 'content-type': 'application/json' }, body: payload, keepalive: true }).catch(() => {});
      }
    } catch {
      // Mesure best-effort seulement — ne doit jamais perturber le parcours.
    }
  }

  // ——— état capture (repère / contour) tenu par onCaptureChange ———
  let capturePin: { lat: number; lng: number } | null = null;
  let captureOutline: Array<[number, number]> = [];
  let cityTouched = false;
  cityEl?.addEventListener('input', () => { cityTouched = true; });

  // ——— WJ6/WJ33 : bascule de langue FR/AR (data-i18n) ———
  // WJ30 — la langue active est transmise au webhook (langue_preferee).
  //
  // WJ33 — FIX : `el.textContent = v` APLATISSAIT toute balise imbriquée à
  // l'intérieur d'un élément `data-i18n` (ex. un futur <strong>/<a> perdu au
  // premier passage AR→FR→AR). On bascule désormais par PAIRE DE NŒUDS
  // show/hide : au premier appel, chaque élément `data-i18n` est ENVELOPPÉ de
  // deux <span> — un FR (markup ORIGINAL, capturé une fois via innerHTML avant
  // toute mutation) et un AR (texte simple depuis data-ar, car les libellés AR
  // du DOM sont aujourd'hui du texte brut) — puis on masque/affiche la bonne
  // paire. Aucune balise n'est plus jamais perdue, quel que soit le nombre
  // d'allers-retours FR↔AR.
  let currentLang: 'fr' | 'ar' = 'fr';
  const i18nPairs: Array<{ fr: HTMLElement; ar: HTMLElement }> = [];
  function prepareI18n() {
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const arText = el.dataset.ar;
      if (typeof arText !== 'string') return;
      const frSpan = document.createElement('span');
      // Le markup FR ORIGINAL (pouvant contenir des balises imbriquées) est
      // préservé tel quel — capturé UNE SEULE fois, avant toute mutation.
      frSpan.innerHTML = el.innerHTML;
      const arSpan = document.createElement('span');
      arSpan.textContent = arText;
      arSpan.hidden = true;
      el.textContent = '';
      el.append(frSpan, arSpan);
      i18nPairs.push({ fr: frSpan, ar: arSpan });
    });
  }
  function applyLang(lang: 'fr' | 'ar') {
    const isAr = lang === 'ar';
    currentLang = lang;
    i18nPairs.forEach(({ fr, ar }) => {
      fr.hidden = isAr;
      ar.hidden = !isAr;
    });
    // WJ33 — RTL/langue au niveau DOCUMENT (pas seulement un bloc local) :
    // un lecteur d'écran ou le rendu natif du navigateur doivent voir la vraie
    // langue de la page, pas seulement une classe locale.
    document.documentElement.lang = isAr ? 'ar' : 'fr';
    document.documentElement.dir = isAr ? 'rtl' : 'ltr';
    const root = document.querySelector('section') as HTMLElement | null;
    if (root) {
      root.dir = isAr ? 'rtl' : 'ltr';
      root.style.lineHeight = isAr ? '1.75' : '';
    }
    const frBtn = $('mt-lang-fr');
    const arBtn = $('mt-lang-ar');
    frBtn?.setAttribute('aria-pressed', String(!isAr));
    arBtn?.setAttribute('aria-pressed', String(isAr));
    for (const [btn, on] of [[frBtn, !isAr], [arBtn, isAr]] as const) {
      if (!btn) continue;
      btn.className = on
        ? 'px-3 py-1.5 text-sm font-semibold text-azur-950 bg-brass-400 transition-colors'
        : 'px-3 py-1.5 text-sm font-semibold text-lune-soft transition-colors hover:text-white';
    }
  }
  prepareI18n();
  $('mt-lang-fr')?.addEventListener('click', () => applyLang('fr'));
  $('mt-lang-ar')?.addEventListener('click', () => applyLang('ar'));

  // ——— WJ45 : bandeau hors-ligne (navigator.onLine + online/offline) ———
  // Une coupure réseau mobile ne doit jamais ressembler à un échec muet : le
  // bandeau apparaît/disparaît en direct, indépendamment de toute soumission.
  const offlineBanner = $('mt-offline-banner');
  function syncOfflineBanner() {
    if (offlineBanner) offlineBanner.hidden = navigator.onLine;
  }
  syncOfflineBanner();
  window.addEventListener('online', syncOfflineBanner);
  window.addEventListener('offline', syncOfflineBanner);

  // ——— WJ61 : l'état de l'assistant survit à un rafraîchissement/retour ———
  // Un appel téléphonique ou un balayage arrière accidentel détruisait TOUT ce
  // qui avait été tapé, en silence — l'échec UX le plus coûteux du tunnel. On
  // persiste un instantané minimal (étape/mode/facture/repère-contour/réponses
  // facultatives) dans sessionStorage (par onglet, jamais partagé entre
  // visiteurs) : réhydraté au chargement, effacé au succès. Ne bloque JAMAIS la
  // soumission si sessionStorage est indisponible (navigation privée stricte…).
  const WIZARD_STORAGE_KEY = 'mt-wizard-v1';
  interface WizardSnapshot {
    step?: number;
    // COUPE FONDATEUR 21/08 — `revealed` : sur l'écran 1, l'estimation + le
    // formulaire de contact sont révélés SUR PLACE (plus d'étape 3). Persisté
    // pour qu'un rafraîchissement ne renvoie pas le visiteur à ses questions
    // alors qu'il avait déjà son estimation à l'écran. Un instantané de
    // l'ANCIEN assistant 3 étapes (step === 2, sans `revealed`) est migré à la
    // relecture — voir `let revealed` plus bas.
    revealed?: boolean;
    mode?: string;
    // `ombrage` retiré du tunnel (ordre fondateur 21/08) — plus rien à
    // persister ; un ancien instantané qui en porte encore un est simplement
    // ignoré (champ inconnu, aucune lecture).
    visitWindowPart?: string;
    visitWindowWeek?: string;
    // `futureLoads` retirée du tunnel (coupe fondateur 18/08) — le commercial
    // la complète dans l'ERP ; plus rien à persister.
    // QX — états des groupes de cartes/segments PRO + AGRICOLE (tension,
    // activité, surface, source d'eau, unités).
    sel?: Record<string, string>;
    capturePin?: { lat: number; lng: number } | null;
    captureOutline?: Array<[number, number]>;
    fields?: Record<string, string>;
    checks?: Record<string, boolean>;
    // Jetons de dédoublonnage : persistés AVEC le reste du brouillon pour qu'un
    // rafraîchissement/retour arrière ne fabrique pas une 2ᵉ identité technique
    // pour la MÊME saisie (c'est exactement le doublon qu'ils doivent empêcher).
    idempotencyKey?: string;
    eventId?: string;
  }
  // Coupe fondateur 18/08 — les champs retirés du tunnel quittent aussi la
  // persistance : 'mt-facture-ete', 'mt-roof', 'mt-raccordement',
  // 'mt-distributeur', 'mt-bill-kwh', 'mt-roof-age', 'mt-occupant-type',
  // 'mt-project-timing', 'mt-facility-type', 'mt-site-count',
  // 'mt-puissance-kva', 'mt-cos-phi', 'mt-groupe-kva', 'mt-diesel-dh',
  // 'mt-pompe-actuelle' et 'mt-pompe-cv' n'existent plus dans le DOM — les
  // persister n'aurait rien à lire. `mt-raison-sociale` reste : elle est
  // DÉPLACÉE sur l'écran contact, pas supprimée.
  const PERSISTED_TEXT_FIELDS = [
    'mt-name', 'mt-phone', 'mt-city', 'mt-email', 'mt-facture-hiver',
    'mt-bill', 'mt-fallback-address',
    'rp9-address',
    // WJ68 — raison sociale (écran contact depuis la coupe du 18/08).
    'mt-raison-sociale',
    // QX — sous-panneau PROFESSIONNEL (étape 2).
    'mt-pro-bill', 'mt-surface-m2',
    // WJ122 — sous-panneau COMMERCIAL (facture).
    'mt-cc-bill',
    // QX — sous-panneau AGRICOLE (étape 2).
    'mt-profondeur', 'mt-hmt', 'mt-water-need', 'mt-heures-pompage',
    'mt-culture', 'mt-surface-ha', 'mt-fuel-spend',
    // L-WEBT — équipements (facultatifs, section repliable « Affiner mon
    // profil de consommation »).
    'mt-equip-ve-km', 'mt-equip-clim-pieces', 'mt-equip-piscine-kw',
  ];
  // 'mt-ete-differente', 'mt-battery-interest' et 'mt-weekend' retirés du tunnel
  // (coupe fondateur 18/08) — le commercial les complète dans l'ERP.
  const PERSISTED_CHECK_FIELDS = [
    'mt-contact-whatsapp', 'mt-contact-phone', 'mt-consent',
    // L-WEBT — équipements (facultatifs).
    'mt-equip-chauffe-eau', 'mt-equip-ve', 'mt-equip-clim', 'mt-equip-piscine',
  ];
  let restoring = false; // WJ61 — évite de ré-enregistrer PENDANT la réhydratation elle-même.
  function saveWizardState() {
    if (restoring) return;
    try {
      const fields: Record<string, string> = {};
      for (const id of PERSISTED_TEXT_FIELDS) {
        const v = val(id);
        if (v) fields[id] = v;
      }
      const checks: Record<string, boolean> = {};
      for (const id of PERSISTED_CHECK_FIELDS) {
        const el = $(id) as HTMLInputElement | null;
        if (el) checks[id] = el.checked;
      }
      const snapshot: WizardSnapshot = {
        step, revealed, mode,
        visitWindowPart, visitWindowWeek,
        sel: { proUnit, tension, activity, surfaceType, waterSource, waterUnit, commercialCategory, ccUnit, equipes, regionAgricole, roofInputMode, occupationJour },
        capturePin, captureOutline,
        fields, checks,
        idempotencyKey: dedupIdempotencyKey, eventId: dedupEventId,
      };
      sessionStorage.setItem(WIZARD_STORAGE_KEY, JSON.stringify(snapshot));
    } catch {
      // sessionStorage indisponible (navigation privée stricte, quota…) : la
      // persistance est un CONFORT, jamais un blocage de la saisie/l'envoi.
    }
  }
  function loadWizardState(): WizardSnapshot | null {
    try {
      const raw = sessionStorage.getItem(WIZARD_STORAGE_KEY);
      return raw ? (JSON.parse(raw) as WizardSnapshot) : null;
    } catch {
      return null;
    }
  }
  function clearWizardState() {
    try { sessionStorage.removeItem(WIZARD_STORAGE_KEY); } catch { /* confort seulement */ }
  }
  // WJ61 — garde-fou de sortie : une fois que le visiteur a commencé à saisir
  // quelque chose, un rafraîchissement/fermeture ACCIDENTEL affiche l'invite de
  // confirmation native du navigateur (texte non personnalisable par spec).
  let hasEnteredData = false;
  function markDataEntered() { hasEnteredData = true; }
  window.addEventListener('beforeunload', (e) => {
    if (!hasEnteredData || submitted) return;
    e.preventDefault();
    e.returnValue = '';
  });

  const savedWizard = loadWizardState();

  // ——— Jetons de DÉDOUBLONNAGE technique (CRM + Meta CAPI) ———
  // `idempotencyKey` (signal de dédup CRM) et `eventId` (champ `event_id` de la
  // spec Meta CAPI) sont validés par lib/lead.ts DEPUIS LE DÉBUT, mais ce tunnel
  // ne les a jamais émis : le CRM ne pouvait pas reconnaître deux envois d'une
  // même saisie, et `fireCapi` retombait sur un id dérivé de l'horodatage — donc
  // DIFFÉRENT à chaque renvoi, ce qui ne déduplique rien côté Meta.
  // Générés au PREMIER affichage, repris du brouillon s'il en existe un, stables
  // ensuite. Deux jetons DISTINCTS : ils ne servent pas le même système.
  function newDedupToken(): string {
    try {
      const c = globalThis.crypto;
      // `randomUUID` n'existe qu'en contexte sécurisé : repli sur le générateur
      // maison déjà validé par le même regex (^[A-Za-z0-9_-]{8,64}$).
      if (c && typeof c.randomUUID === 'function') return c.randomUUID();
    } catch { /* accès crypto refusé : on prend le repli */ }
    return buildIdempotencyKey();
  }
  let dedupIdempotencyKey = savedWizard?.idempotencyKey || newDedupToken();
  let dedupEventId = savedWizard?.eventId || newDedupToken();
  function getOrCreateDedupTokens(): { idempotencyKey: string; eventId: string } {
    if (!dedupIdempotencyKey) dedupIdempotencyKey = newDedupToken();
    if (!dedupEventId) dedupEventId = newDedupToken();
    return { idempotencyKey: dedupIdempotencyKey, eventId: dedupEventId };
  }

  // ——— WJ6/QX : sélecteur de mode — plus AUCUN défaut silencieux (le profil
  // pilote des questions d'étape 2 entièrement différentes) ; « Continuer »
  // exige un choix explicite (validateStep0, nudge inline sur les cartes). ———
  let mode = savedWizard?.mode || '';
  // WJ121 — migration des sessions en cours : l'ancien profil unique
  // 'professionnel' est réhydraté comme 'industriel' (le backend mappe déjà
  // professionnel→industriel) — le site n'ÉMET plus jamais 'professionnel'.
  if (mode === 'professionnel') mode = 'industriel';
  /** WJ121 — les deux modes C&I partagent le sous-panneau/moteur pro existant
   *  (panneaux dédiés = WJ122/WJ123) ; 'professionnel' couvert par défense en
   *  profondeur (la migration ci-dessus l'élimine déjà). */
  function isProMode(m: string): boolean {
    return m === 'industriel' || m === 'commercial' || m === 'professionnel';
  }
  // QX — libellés du fil d'étapes + habillage du document par profil.
  // COUPE FONDATEUR 21/08 — DEUX libellés par profil : l'ancien libellé de
  // l'étape 2 (« Votre facture »/« Votre énergie »/« Votre pompage ») et celui
  // de l'étape 3 (« Votre estimation ») décrivaient deux moitiés d'un écran
  // désormais UNIQUE. On garde celui de la DESTINATION (« Votre estimation »),
  // qui est aussi le libellé du bouton qui la révèle — le fil d'étapes annonce
  // où l'on va, jamais un écran qui n'existe plus.
  const STEP_LABELS_BY_MODE: Record<string, [string, string]> = {
    residentiel: ['Votre toit', 'Votre estimation'],
    industriel: ['Votre site', 'Votre estimation'],
    commercial: ['Votre établissement', 'Votre estimation'],
    agricole: ['Votre terrain', 'Votre estimation'],
  };
  const MODE_LABEL: Record<string, string> = {
    residentiel: 'Résidentiel', industriel: 'Industriel', commercial: 'Commercial', agricole: 'Agricole',
  };
  const MODE_DOC_SUBTITLE: Record<string, string> = {
    residentiel: 'Résidentielle', industriel: 'Autoconsommation Industrielle',
    commercial: 'Autoconsommation Commerciale', agricole: 'Pompage Agricole',
  };
  /** QX — le fil d'étapes suit le profil. Page FR figée en français (WJ106) :
   *  textContent direct — la paire data-i18n dormante de ces nœuds n'est plus
   *  jamais basculée (aucun bouton de langue sur cette route). */
  function syncStepLabels() {
    const labels = STEP_LABELS_BY_MODE[mode] || STEP_LABELS_BY_MODE.residentiel;
    document.querySelectorAll<HTMLElement>('.mt-step-label').forEach((el, i) => {
      if (labels[i]) el.textContent = labels[i];
    });
    [0, 1].forEach((i) => {
      const h = $(`mt-h2-${i}`);
      if (h && labels[i]) h.textContent = labels[i];
    });
  }
  /** QX — un seul sous-panneau de questions visible sur l'écran 1, selon le
   *  profil. (Le nom `syncStep2Panels` est resté celui de l'assistant à trois
   *  écrans : ces sous-panneaux sont ceux de l'ex-étape 2.) */
  function syncStep2Panels() {
    const m = mode || 'residentiel';
    const res = $('mt-sub-residentiel');
    const pro = $('mt-sub-professionnel');
    const commercial = $('mt-sub-commercial');
    const agri = $('mt-sub-agricole');
    if (res) res.hidden = m !== 'residentiel';
    // WJ122 — 'commercial' a désormais son PROPRE panneau (cartes catégorie) ;
    // 'industriel' (et l'alias hérité 'professionnel') gardent le panneau pro.
    if (pro) pro.hidden = !(m === 'industriel' || m === 'professionnel');
    if (commercial) commercial.hidden = m !== 'commercial';
    if (agri) agri.hidden = m !== 'agricole';
    syncRaisonSociale();
  }
  /** La raison sociale vit désormais sur l'écran CONTACT (coupe fondateur
   *  18/08) : elle ne nourrit aucun calcul, elle n'a donc rien à faire avant
   *  l'estimation. On ne la montre qu'aux profils professionnels — un
   *  particulier n'a pas de raison sociale à donner. */
  function syncRaisonSociale() {
    const wrap = $('mt-raison-sociale-wrap');
    if (wrap) wrap.hidden = !isProMode(mode);
  }
  function syncModeCards() {
    document.querySelectorAll<HTMLButtonElement>('.mt-mode').forEach((b) => {
      const on = mode !== '' && b.dataset.mode === mode;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('border-brass-400', on);
      b.classList.toggle('border-white/15', !on);
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.mt-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode || '';
      syncModeCards();
      const modeErr = $('mt-mode-err');
      if (modeErr) { modeErr.textContent = ''; modeErr.hidden = true; }
      syncStepLabels();
      syncStep2Panels();
      markDataEntered();
      saveWizardState();
      // WJ111 — si l'estimation (la révélation de l'écran 1) a déjà été
      // calculée, basculer de/vers
      // agricole doit mettre à jour le document IMMÉDIATEMENT (numérique <->
      // carte qualitative) sans attendre un nouveau clic sur « Voir mon estimation ».
      if (!$('mt-estimate-body')?.hidden || !$('mt-estimate-agricole')?.hidden) computeEstimate();
      else if (docRendered) computeEstimate();
    });
  });
  // état initial : réhydraté depuis l'instantané, sinon AUCUN mode marqué.
  syncModeCards();
  syncStepLabels();
  syncStep2Panels();

  // Les cartes « type de toit » (.mt-roof-card + le <select> sr-only mt-roof)
  // sont retirées du tunnel (coupe fondateur 18/08) : plus rien à synchroniser
  // ni à valider ici. `roofType` reste exigé par validateLead — resolveRoofType
  // le DÉRIVE désormais pour tous les profils.

  // ——— OMBRAGE : question RETIRÉE du tunnel (ordre fondateur 21/08) ———
  // La puce à bascule WJ31/WJ112 et son état n'existent plus : plus aucun
  // visiteur ne déclare son ombrage sur cette page. (Sa classe CSS est épinglée
  // ABSENTE de ce fichier par tests/wj112RefineEstimate.test.ts, qui lit la
  // source BRUTE — ne pas la réécrire ici, même en commentaire.)
  // Le dérate reste INTACT côté
  // moteur (billEstimate.ts OMBRAGE_DERATE + ombrageDerateFactor) — simplement,
  // `estimateFromBill` n'en reçoit plus, et `ombrageDerateFactor(undefined)`
  // rend 1 : c'est LE MÊME chemin, au facteur près, que suivait déjà tout
  // visiteur qui n'avait cliqué aucune puce (l'état initial `''` partait en
  // `ombrage: undefined`). Aucun changement de chiffre pour ce visiteur-là.

  // ——— W353 : créneau de visite technique — deux puces à bascule unique
  // INDÉPENDANTES (moment + semaine), même patron d'aria-pressed que les autres
  // groupes de cartes de ce tunnel.
  // Préférence STATIQUE et FACULTATIVE : aucun calendrier, aucune réservation
  // confirmée — un humain valide le créneau réel après contact. ———
  let visitWindowPart = savedWizard?.visitWindowPart || '';
  let visitWindowWeek = savedWizard?.visitWindowWeek || '';
  function wireVisitToggle(selector: string, getCurrent: () => string, setCurrent: (v: string) => void) {
    document.querySelectorAll<HTMLButtonElement>(selector).forEach((btn) => {
      btn.addEventListener('click', () => {
        const same = getCurrent() === btn.dataset.value;
        setCurrent(same ? '' : (btn.dataset.value || ''));
        document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
          const on = !same && b === btn;
          b.setAttribute('aria-pressed', String(on));
          b.classList.toggle('border-brass-400', on);
          b.classList.toggle('border-white/15', !on);
        });
        markDataEntered();
        saveWizardState();
      });
    });
    const current = getCurrent();
    if (current) {
      document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
        const on = b.dataset.value === current;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('border-brass-400', on);
        b.classList.toggle('border-white/15', !on);
      });
    }
  }
  wireVisitToggle('.mt-visit-part', () => visitWindowPart, (v) => { visitWindowPart = v; });
  wireVisitToggle('.mt-visit-week', () => visitWindowWeek, (v) => { visitWindowWeek = v; });

  // ════════════════════════════════════════════════════════════════════════
  // L-WEBT TASK1/3 — « Passez-vous la journée à la maison ? » : trois
  // silhouettes 24 h superposées (couleurs VALIDÉES fondateur, reproduites à
  // l'identique) — présent bleu plein #2a78d6 (remplissage 10 %), absent
  // orange pointillé [6,3] #eb6834, partiel vert pointillé [2,3] #1baf7a.
  // Les 24 poids par silhouette sont ceux du SERVEUR (import ci-dessus) —
  // ce bloc ne fait QUE tracer, il n'invente aucun chiffre.
  // ════════════════════════════════════════════════════════════════════════
  const OCC_COLORS: Record<OccupancyId, { stroke: string; dash: string | null; fill?: string }> = {
    presence_jour: { stroke: '#2a78d6', dash: null, fill: 'rgba(42,120,214,0.10)' },
    absence_jour: { stroke: '#eb6834', dash: '6,3' },
    presence_partielle: { stroke: '#1baf7a', dash: '2,3' },
  };
  // Lead.occupation_jour (backend crm.Lead, apps/crm/models.py) n'utilise PAS
  // le même vocabulaire que les identifiants d'affichage OCCUPANCY_IDS —
  // cette table est la SEULE traduction entre les deux (voir aussi
  // apps/ventes/courbes_journalieres.py _OCCUPATION_JOUR_VERS_DRAPEAU côté
  // serveur, sens inverse).
  const OCC_TO_LEAD_FIELD: Record<OccupancyId, 'present' | 'absent' | 'partiel'> = {
    presence_jour: 'present', absence_jour: 'absent', presence_partielle: 'partiel',
  };

  function occShapePaths(shape: readonly number[], w: number, h: number, pad: number): { line: string; area: string } {
    const max = Math.max(...OCCUPANCY_IDS.flatMap((id) => OCCUPANCY_SHAPES[id] as readonly number[]));
    const x = (i: number) => pad + (i / (shape.length - 1)) * (w - 2 * pad);
    const y = (v: number) => pad + (1 - (max > 0 ? v / max : 0)) * (h - 2 * pad);
    const pts = shape.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`);
    const line = `M${pts.join(' L')}`;
    const area = `${line} L${x(shape.length - 1).toFixed(1)},${(h - pad).toFixed(1)} L${x(0).toFixed(1)},${(h - pad).toFixed(1)} Z`;
    return { line, area };
  }

  function renderOccupancyChart() {
    const svg = $('mt-occ-chart');
    if (!svg) return;
    const W = 320;
    const H = 140;
    const PAD = 8;
    let markup = '';
    for (const id of OCCUPANCY_IDS) {
      const shape = OCCUPANCY_SHAPES[id];
      const { line, area } = occShapePaths(shape, W, H, PAD);
      const c = OCC_COLORS[id];
      if (c.fill) markup += `<path d="${area}" fill="${c.fill}" stroke="none"></path>`;
      markup += `<path data-occ-line="${id}" d="${line}" fill="none" stroke="${c.stroke}" stroke-width="2"${c.dash ? ` stroke-dasharray="${c.dash}"` : ''}></path>`;
    }
    svg.innerHTML = markup;
  }
  renderOccupancyChart();

  let occupationJour = savedWizard?.sel?.occupationJour || '';
  function syncOccupancySelection() {
    document.querySelectorAll<HTMLButtonElement>('.mt-occ-btn').forEach((btn) => {
      const id = (btn.dataset.occId || '') as OccupancyId;
      const field = OCC_TO_LEAD_FIELD[id];
      const on = !!field && occupationJour === field;
      btn.setAttribute('aria-pressed', String(on));
      btn.classList.toggle('border-brass-400', on);
      btn.classList.toggle('border-white/15', !on);
      const badge = btn.querySelector<HTMLElement>('.mt-occ-chosen');
      if (badge) badge.hidden = !on;
    });
    document.querySelectorAll<SVGPathElement>('[data-occ-line]').forEach((p) => {
      const id = (p.getAttribute('data-occ-line') || '') as OccupancyId;
      const on = !occupationJour || OCC_TO_LEAD_FIELD[id] === occupationJour;
      p.style.opacity = on ? '1' : '0.25';
      p.setAttribute('stroke-width', OCC_TO_LEAD_FIELD[id] === occupationJour ? '3' : '2');
    });
    const hidden = $('mt-occupation-jour') as HTMLInputElement | null;
    if (hidden) hidden.value = occupationJour;
  }
  document.querySelectorAll<HTMLButtonElement>('.mt-occ-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = (btn.dataset.occId || '') as OccupancyId;
      const field = OCC_TO_LEAD_FIELD[id];
      if (!field) return;
      occupationJour = occupationJour === field ? '' : field;
      syncOccupancySelection();
      markDataEntered();
      saveWizardState();
    });
  });
  syncOccupancySelection();

  // ════════════════════════════════════════════════════════════════════════
  // L-WEBT TASK3 — équipements (facultatifs, jamais bloquants) : la case
  // révèle son détail SEULEMENT si coché (case décochée = question jamais
  // posée, jamais un « Non » fabriqué — buildBody() plus bas omet la clé
  // entière tant que la case n'est pas cochée).
  // ════════════════════════════════════════════════════════════════════════
  const EQUIP_TOGGLES: Array<{ checkId: string; detailId?: string }> = [
    { checkId: 'mt-equip-chauffe-eau' },
    { checkId: 'mt-equip-ve', detailId: 'mt-equip-ve-km' },
    { checkId: 'mt-equip-clim', detailId: 'mt-equip-clim-pieces' },
    { checkId: 'mt-equip-piscine', detailId: 'mt-equip-piscine-kw' },
  ];
  // Ré-appelée après la réhydratation WJ61 (plus bas) : affecter `.checked`
  // par script ne déclenche pas `change`, donc un détail restauré coché
  // resterait masqué sans ce second passage — même patron que syncCallbackSla.
  function syncEquipDetails() {
    for (const { checkId, detailId } of EQUIP_TOGGLES) {
      const chk = $(checkId) as HTMLInputElement | null;
      const detail = detailId ? $(detailId) : null;
      const wrap = detail?.closest<HTMLElement>('[data-equip-detail]') || null;
      if (wrap) wrap.hidden = !chk?.checked;
    }
  }
  for (const { checkId } of EQUIP_TOGGLES) {
    const chk = $(checkId) as HTMLInputElement | null;
    chk?.addEventListener('change', () => { syncEquipDetails(); markDataEntered(); saveWizardState(); });
  }
  syncEquipDetails();

  // ════════════════════════════════════════════════════════════════════════
  // L-WEBT TASK2 — « Une journée type » : production (doré #eda100, fond
  // 18 %) vs consommation (bleu #2a78d6, pointillé [6,3]) sur 24 h, 4 petits
  // multiples (janvier/avril/juillet/novembre). `hasJourTypeData()` (voir
  // lib/jourTypeData.ts) est `false` tant que personne n'a collé la vraie
  // sortie du moteur (apps.ventes.etude_horaire.jours_types_annee) — cette
  // fonction masque alors ENTIÈREMENT la section, jamais un graphe dessiné
  // sur des zéros inventés.
  // ════════════════════════════════════════════════════════════════════════
  function jourTypeChartSvg(prodKw: number[], consoKw: number[], w: number, h: number, pad: number): string {
    const max = Math.max(0.001, ...prodKw, ...consoKw);
    const x = (i: number) => pad + (i / (prodKw.length - 1)) * (w - 2 * pad);
    const y = (v: number) => pad + (1 - v / max) * (h - 2 * pad);
    const lineOf = (arr: number[]) => `M${arr.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' L')}`;
    const prodLine = lineOf(prodKw);
    const prodArea = `${prodLine} L${x(prodKw.length - 1).toFixed(1)},${(h - pad).toFixed(1)} L${x(0).toFixed(1)},${(h - pad).toFixed(1)} Z`;
    const consoLine = lineOf(consoKw);
    return `<svg viewBox="0 0 ${w} ${h}" width="100%" height="120" preserveAspectRatio="none" role="img" aria-label="Production (doré) et consommation (bleu pointillé) sur 24 h, en kW">` +
      `<path d="${prodArea}" fill="rgba(237,161,0,0.18)" stroke="none"></path>` +
      `<path d="${prodLine}" fill="none" stroke="#eda100" stroke-width="2"><title>Production (kW)</title></path>` +
      `<path d="${consoLine}" fill="none" stroke="#2a78d6" stroke-width="2" stroke-dasharray="6,3"><title>Consommation (kW)</title></path>` +
      `</svg>`;
  }
  function renderJourType() {
    const wrap = $('mt-jourtype-wrap');
    const grid = $('mt-jourtype-grid');
    if (!wrap || !grid) return;
    if (!hasJourTypeData()) {
      wrap.hidden = true;
      return;
    }
    let markup = '';
    for (const m of JOUR_TYPE_MONTH_IDS) {
      const d = JOUR_TYPE_DATA[m];
      if (!d) continue;
      const label = JOUR_TYPE_MONTH_LABELS[m].fr;
      markup += `<div class="border border-white/10 bg-white/5 p-2">` +
        `<p class="text-xs font-semibold text-white">${label}</p>` +
        jourTypeChartSvg(d.prodKw, d.consoKw, 280, 120, 6) +
        `<p class="mt-1 text-[11px] text-lune-faint">Conso ${d.consoJourKwh.toFixed(2)}&nbsp;kWh · Prod ${d.prodJourKwh.toFixed(2)}&nbsp;kWh · Autoconso ${d.autoconsommeKwh.toFixed(2)}&nbsp;kWh · Surplus ${d.surplusKwh.toFixed(2)}&nbsp;kWh</p>` +
        `</div>`;
    }
    grid.innerHTML = markup;
    wrap.hidden = false;
  }
  renderJourType();

  // « Charges futures envisagées » (.mt-future-load) et « Photo du compteur ou
  // de la facture » (mt-meter-photo) sont retirées du tunnel (coupe fondateur
  // 18/08) — le commercial les complète dans l'ERP. Avec le champ fichier
  // disparaît aussi la fenêtre de grâce WJ46 de l'exit-intent : elle n'existait
  // QUE pour éviter un faux déclenchement pendant l'ouverture du sélecteur de
  // photo, et plus aucun sélecteur de fichier n'est ouvert par cette page.

  // ——— boot carte (captureOnly). Repli sans clé carte AUTORISE la suite (WJ4) ———
  let started = false;
  const mapEl = $('rp9-map');
  // WJ34 — retire le squelette de chargement dès que la carte annonce son
  // premier rendu (onReady) ou dès qu'on bascule sur le repli sans carte.
  function clearMapSkeleton() { mapEl?.classList.remove('mt-skeleton-shimmer'); }
  async function boot(key: string, mapboxToken: string) {
    if (started) return;
    started = true;
    try {
      // WJ47 — importe roofPro11/captureBoot DIRECTEMENT (pas tout
      // roof-tool-pro11.ts) : le boot complet entraîne scene3d/optimizer/matrix
      // (Three.js + le moteur de calepinage), du code interne à l'outil que
      // cette page publique de capture n'exécute jamais. Ce chunk lazy ne
      // charge plus que MapLibre + le géocodeur + le pin/tracé.
      const { bootCaptureOnly } = await import('../../scripts/roofPro11/captureBoot');
      bootCaptureOnly({
        maptilerKey: key,
        mapboxToken: mapboxToken || undefined,
        reducedMotion,
        onReady: clearMapSkeleton,
        // Le geste choisi par le visiteur, lu à CHAQUE clic (il peut changer
        // d'avis) : « dessiner » ouvre le contour dès le premier appui, «
        // pointer » fait atterrir la carte serrée sur le repère pour la
        // confirmation ci-dessous.
        roofInputMode: () => roofInputMode,
        // WJ61 — un repère/contour restauré depuis sessionStorage (rafraîchissement
        // ou retour navigateur en cours de parcours) est semé directement dans la
        // carte au boot, via le même mécanisme que l'hydratation depuis un lead
        // existant (W113) : le visiteur n'a pas à re-pointer son toit.
        hydrate: capturePin
          ? { lead: { roof_point: capturePin, roof_outline: captureOutline.length >= 3 ? captureOutline : null } }
          : undefined,
        onCaptureChange: (s) => {
          capturePin = s.pin;
          captureOutline = s.outline;
          // QX/Lane C — le contour a changé : l'instantané satellite mis en
          // cache ne correspond plus, on le laissera se reconstruire.
          roofImageSpecPromise = null;
          if (cityEl && !cityTouched) {
            const fromMap = (s.address && s.address.trim()) || addressEl?.value.trim() || '';
            if (fromMap) cityEl.value = fromMap;
          }
          // Confirmation visuelle du repère : l'adresse arrive souvent APRÈS le
          // repère (géocodage inverse asynchrone), d'où la re-synchronisation à
          // chaque notification. Fonctions hissées, déclarées plus bas.
          setPinConfirmAddress(s.address);
          syncPinConfirm();
          // WJ2 — le contour peut arriver/changer APRÈS le calcul d'estimation :
          // on ré-évalue l'éligibilité du bouton « voir les panneaux » à chaque
          // changement de tracé (fonction déclarée plus bas, hissée par `function`).
          updatePanels3dVisibility();
        },
      });
    } catch {
      started = false;
      showFallback();
    }
  }
  // WJ4 — repli carte : on montre le champ d'adresse en clair ET on garde la suite ouverte.
  // QX — et on MASQUE le bloc carte entier (#mt-stage : géocodeur « Localiser »,
  // canevas, boutons de tracé) : sans clé imagerie, ces contrôles sont morts —
  // deux champs d'adresse visibles dont un inerte, c'était de l'UI mensongère.
  function showFallback() {
    clearMapSkeleton();
    if (fallback) fallback.hidden = false;
    const stage = $('mt-stage');
    if (stage) stage.hidden = true;
    // …et le choix « pointer / dessiner » avec : proposer un geste de carte
    // au-dessus d'un repli adresse serait exactement l'UI mensongère que le
    // masquage de #mt-stage vient d'éliminer.
    const roofModeGroup = $('mt-roof-mode-group');
    if (roofModeGroup) roofModeGroup.hidden = true;
  }

  // WJ60 — sur 3G lente, un fetch sans délai peut rester en attente indéfiniment
  // (l'UI restait bloquée sur le squelette de la carte). 10 s laisse largement le
  // temps à une connexion lente de répondre tout en bornant l'attente ; l'échec
  // (timeout inclus) tombe dans le repli adresse existant (WJ4), jamais un blocage.
  const FETCH_TIMEOUT_MS = 10_000;
  // W324 — n'engage le fetch /api/roof-config (→ import maplibre-gl, ~200 KB+)
  // QUE lorsque l'étape 0 (carte) est réellement l'étape ACTIVE — jamais au
  // simple chargement de page. Un visiteur qui reprend son parcours à l'étape
  // 1/2 (WJ61 : instantané sessionStorage restauré, ou bouton précédent) ne
  // paie plus jamais ce poids pour une carte qu'il ne verra pas. `mapFetchDone`
  // garde l'appel idempotent (un seul fetch par visite, y compris si l'on
  // revient plusieurs fois à l'étape 0 via Retour/Continuer).
  let mapFetchDone = false;
  function ensureMapBooted() {
    if (mapFetchDone) return;
    mapFetchDone = true;
    (async () => {
      try {
        const res = await fetch('/api/roof-config', { signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
        const cfg = (await res.json()) as { available?: boolean; maptilerKey?: string; mapboxToken?: string };
        if (!cfg.available || !cfg.maptilerKey) { showFallback(); return; }
        void boot(cfg.maptilerKey, cfg.mapboxToken || '');
      } catch {
        showFallback();
      }
    })();
  }

  // ——— WJ6 : assistant multi-étapes + barre de progression ———
  // WJ61 — l'étape initiale reprend l'instantané sessionStorage s'il existe
  // (rafraîchissement/retour en cours de parcours), sinon 0 comme avant.
  // COUPE FONDATEUR 21/08 — MIGRATION DÉFENSIVE des instantanés de l'ANCIEN
  // assistant à 3 étapes : un `step` de 2 (ex-écran estimation+contact) devient
  // l'écran 1 AVEC sa révélation déjà ouverte — le visiteur retrouve exactement
  // ce qu'il avait à l'écran, jamais un plantage ni un retour en arrière muet.
  // Le `Math.min(1, …)` borne aussi toute valeur aberrante (3, 42, NaN écarté
  // par le `!= null` + les bornes) : l'assistant ne peut plus viser un panneau
  // qui n'existe pas.
  const savedStepRaw = savedWizard?.step;
  let step = savedStepRaw != null ? Math.max(0, Math.min(1, savedStepRaw)) : 0;
  /** COUPE FONDATEUR 21/08 — l'estimation + le contact sont RÉVÉLÉS sur l'écran
   *  1 (jamais une étape de plus). `revealed` est le seul état qui pilote leur
   *  visibilité ; il survit à un rafraîchissement (instantané WJ61) et se migre
   *  depuis un ancien `step === 2`. */
  let revealed = savedWizard?.revealed === true || savedStepRaw === 2;
  const panels = [0, 1].map((i) => $(`mt-panel-${i}`));
  const revealEl = $('mt-reveal');
  let firstRender = true;
  function renderStep() {
    panels.forEach((p, i) => { if (p) p.hidden = i !== step; });
    // La révélation vit DANS l'écran 1 : elle ne s'affiche que sur cet écran, et
    // seulement une fois « Voir mon estimation » pressé (ou restauré).
    if (revealEl) revealEl.hidden = !(step === 1 && revealed);
    document.querySelectorAll<HTMLElement>('.mt-step').forEach((li, i) => {
      const bar = li.querySelector<HTMLElement>('.mt-step-bar');
      const label = li.querySelector<HTMLElement>('.mt-step-label');
      const active = i <= step;
      if (bar) bar.className = `h-1.5 w-full rounded-full mt-step-bar transition-colors ${active ? 'bg-brass-400' : 'bg-white/10'}`;
      if (label) label.classList.toggle('text-white', i === step);
    });
    // W324 — l'étape carte est ACTIVE : c'est ICI (jamais au simple chargement
    // de page) qu'on engage le fetch de config + l'import lazy de maplibre-gl.
    if (step === 0) ensureMapBooted();
    // WJ59 — « étape atteinte », dédupliquée par sendFunnelBeacon (une seule
    // fois par étape et par visite, y compris après un aller-retour Retour/Continuer).
    // WB30 — pas de beacon avant l'étape de consentement (la RÉVÉLATION, qui
    // porte la case de consentement — voir hasReachedConsentStep).
    // WJ59/WJ104 — VOCABULAIRE D'ÉVÉNEMENTS INCHANGÉ (4 identifiants figés dans
    // lib/telemetryEvents.ts) : la fusion d'écrans ne renomme RIEN, elle
    // reprojette. ANCIEN → NOUVEAU : 'toit' = écran 0 (inchangé) ; 'facture' =
    // écran 1 AVANT révélation (ex-écran 1) ; 'estimation' = écran 1 APRÈS
    // révélation (ex-écran 2, désormais émis par le bouton « Voir mon
    // estimation ») ; 'contact' inchangé (émis par computeEstimate).
    if (hasReachedConsentStep()) sendFunnelBeacon(step === 0 ? 'toit' : revealed ? 'estimation' : 'facture', 'reached');
    // WJ61 — au tout premier rendu (chargement/réhydratation), ne pas imposer de
    // défilement : le visiteur vient d'arriver/de revenir, la page n'a pas
    // encore bougé sous lui. Le défilement reste pour chaque étape SUIVANTE.
    if (firstRender) { firstRender = false; return; }
    const root = document.querySelector('section');
    root?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
  }
  // WJ61 — pushState PAR ÉTAPE : le bouton précédent du navigateur recule d'une
  // étape de l'assistant au lieu de quitter carrément la page (l'échec le plus
  // fréquent d'un « retour » accidentel). `fromPopstate` évite de repousser un
  // état pendant qu'on réagit déjà à un `popstate`.
  function goStep(n: number, fromPopstate = false) {
    step = Math.max(0, Math.min(1, n));
    renderStep();
    saveWizardState();
    if (!fromPopstate) {
      history.pushState({ mtStep: step, mtRevealed: revealed }, '', location.href);
    }
  }
  // COUPE FONDATEUR 21/08 — l'historique porte désormais la PAIRE (étape,
  // révélation) : la révélation ayant remplacé une étape entière, le bouton
  // précédent du navigateur doit encore pouvoir la refermer, exactement comme
  // il ramenait de l'ancien écran 3 à l'écran 2. Une entrée d'historique
  // héritée (assistant 3 étapes, sans `mtRevealed`) est migrée à la lecture :
  // `mtStep === 2` valait « estimation affichée ».
  window.addEventListener('popstate', (e) => {
    const st = e.state as { mtStep?: number; mtRevealed?: boolean } | null;
    const n = st?.mtStep != null ? st.mtStep : Math.max(0, step - 1);
    revealed = st?.mtRevealed === true || st?.mtStep === 2;
    goStep(n, true);
  });
  // QX — l'étape carte exige un PROFIL choisi (nudge inline sur les cartes,
  // jamais une alerte) : le profil pilote tout le questionnaire de l'écran 1.
  $('mt-next-0')?.addEventListener('click', () => {
    if (validateStep0()) goStep(1);
  });
  $('mt-back-1')?.addEventListener('click', () => goStep(0));
  // `mt-back-2` retiré avec l'ancienne étape 3 (voir la note dans le markup).
  // WJ61 — pose une première entrée d'historique dès le chargement pour que le
  // tout premier « retour » ait un état `mtStep` à consulter.
  history.replaceState({ mtStep: step, mtRevealed: revealed }, '', location.href);
  renderStep();
  // WJ96(c) — un visiteur qui REPREND son parcours (instantané sessionStorage
  // WJ61) directement à l'écran 1 ne déclenche PAS `ensureMapBooted()` via
  // `renderStep()` (qui ne boote qu'à `step === 0`) : cliquer « Retour » vers
  // l'étape carte affichait alors le squelette de chargement à chaque fois,
  // au lieu d'une carte déjà prête. On préchauffe la config/carte en arrière-
  // plan dès que l'on sait que ce visiteur a déjà une étape restaurée > 0 —
  // sans jamais bloquer le rendu de l'étape actuelle (best-effort, idempotent
  // via `mapFetchDone`).
  if (savedWizard?.step != null && savedWizard.step > 0) ensureMapBooted();

  // ——— helpers de saisie ———
  const val = (id: string) => (($(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '');
  const num = (id: string): number | null => {
    const raw = val(id).trim();
    if (raw === '') return null;
    const n = Number(raw);
    return Number.isFinite(n) ? n : null;
  };

  // La case « L'été est différent de l'hiver ? » et la facture d'été qu'elle
  // révélait sont retirées du tunnel (coupe fondateur 18/08) — le commercial
  // les complète dans l'ERP. `factureEte`/`eteDifferente` ne partent plus.

  // WJ105 — SLA de rappel concret : visible UNIQUEMENT quand « Un conseiller
  // peut m'appeler » est la préférence active. `sync` est ré-appelée après une
  // éventuelle réhydratation (WJ61, plus bas) : affecter `.checked` par script
  // ne déclenche pas l'événement `change` natif.
  const contactPhoneRadio = $('mt-contact-phone') as HTMLInputElement | null;
  const contactWhatsappRadio = $('mt-contact-whatsapp') as HTMLInputElement | null;
  const callbackSla = $('mt-callback-sla') as HTMLElement | null;
  function syncCallbackSla(): void {
    if (callbackSla) callbackSla.hidden = contactPhoneRadio?.checked !== true;
  }
  contactPhoneRadio?.addEventListener('change', syncCallbackSla);
  contactWhatsappRadio?.addEventListener('change', syncCallbackSla);
  syncCallbackSla();

  // WJ61 — réhydratation des champs de saisie + du repère/contour de carte à
  // partir de l'instantané (AVANT le boot de la carte : `hydrate` plus bas sème
  // le pin/contour directement dans captureBoot, sans attendre un premier
  // clic). `restoring` empêche saveWizardState() de s'auto-déclencher pendant
  // qu'on peuple les champs (les événements `input`/`change` natifs se
  // déclenchent en JS lors d'une affectation `.value`/`.checked`).
  if (savedWizard) {
    restoring = true;
    for (const [id, v] of Object.entries(savedWizard.fields ?? {})) {
      const el = $(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = v;
    }
    for (const [id, v] of Object.entries(savedWizard.checks ?? {})) {
      const el = $(id) as HTMLInputElement | null;
      if (el) el.checked = v;
    }
    // WJ61 — une ville restaurée compte comme « déjà touchée » : affecter
    // `.value` par script ne déclenche pas l'événement `input` natif qui pose
    // normalement `cityTouched`, et sans ce garde-fou le prochain repère posé
    // sur la carte écraserait silencieusement la ville qu'on vient de restaurer.
    if (savedWizard.fields?.['mt-city']) cityTouched = true;
    // WJ105 — une préférence de contact restaurée doit re-synchroniser la
    // visibilité de la SLA de rappel (affecter `.checked` par script ne
    // déclenche pas `change`).
    syncCallbackSla();
    // L-WEBT — même raison : un détail équipement restauré coché reste masqué
    // sans ce second passage (`.checked` affecté par script ne déclenche pas
    // `change`).
    syncEquipDetails();
    if (savedWizard.capturePin) capturePin = savedWizard.capturePin;
    if (savedWizard.captureOutline?.length) captureOutline = savedWizard.captureOutline;
    if (Object.keys(savedWizard.fields ?? {}).length > 0 || savedWizard.capturePin) markDataEntered();
    restoring = false;
  }
  // WJ61 — persiste sur toute frappe/changement des champs texte/select/case à
  // cocher restants (au-delà des puces déjà câblées plus haut).
  const PERSIST_ON_INPUT_IDS = [...PERSISTED_TEXT_FIELDS, ...PERSISTED_CHECK_FIELDS];
  for (const id of PERSIST_ON_INPUT_IDS) {
    const el = $(id);
    el?.addEventListener('input', () => { markDataEntered(); saveWizardState(); });
    el?.addEventListener('change', () => { markDataEntered(); saveWizardState(); });
  }

  // ——— QX : groupes de cartes/segments à sélection unique des sous-panneaux
  // PRO et AGRICOLE (même patron visuel/ARIA aria-pressed). `recompute`
  // relance l'estimation en direct quand le choix pilote un chiffre affiché.
  // BT + « Journée » sont présélectionnés : des défauts VISIBLES à l'écran
  // (jamais une hypothèse cachée), modifiables d'un tap. ———
  const savedSel = savedWizard?.sel ?? {};
  let proUnit = savedSel.proUnit || 'mad';
  let tension = savedSel.tension || 'bt';
  let activity = savedSel.activity || 'day';
  let surfaceType = savedSel.surfaceType || '';
  let waterSource = savedSel.waterSource || '';
  // `generator` (groupe électrogène) et `irrigation` retirés du tunnel (coupe
  // fondateur 18/08) : aucun n'entrait dans estimatePro/estimateAgricole.
  let waterUnit = savedSel.waterUnit || 'm3h';
  // WJ122 — mode COMMERCIAL : catégorie active + unité de facture (MAD/kWh).
  let commercialCategory = savedSel.commercialCategory || '';
  let ccUnit = savedSel.ccUnit || 'mad';
  // WJ123 — mode INDUSTRIEL : pattern d'équipes (plafond d'autoconsommation).
  let equipes = savedSel.equipes || '';
  // WJ124 — mode AGRICOLE : région agronomique (pilote le moteur eau FAO-56).
  let regionAgricole = savedSel.regionAgricole || '';

  // ——— CHOIX EXPLICITE « pointer » / « dessiner » + CONFIRMATION VISUELLE ———
  // Le geste de repérage était implicite (clic = repère, double-clic = contour,
  // rien ne le disait), et un visiteur qui pointait ne voyait JAMAIS ce qu'il
  // venait de désigner : il validait un point sur une vue large. On demande donc
  // le geste, puis — en mode « pointer » — la carte atterrit serrée sur le
  // repère (captureBoot.landOn) et on lui pose la question à côté de l'image.
  let roofInputMode: 'point' | 'draw' = savedSel.roofInputMode === 'draw' ? 'draw' : 'point';
  const pinConfirmEl = $('mt-pin-confirm');
  const pinConfirmAddrEl = $('mt-pin-confirm-address');
  /** Clé du repère DÉJÀ confirmé : déplacer le repère redemande confirmation,
   *  un simple re-rendu (adresse qui arrive plus tard) ne la redemande pas. */
  let confirmedPinKey = '';
  const pinKey = (p: { lat: number; lng: number } | null) =>
    p ? `${p.lat.toFixed(6)},${p.lng.toFixed(6)}` : '';
  function setMapStatus(msg: string) {
    const el = $('rp9-status');
    if (el) el.textContent = msg;
  }
  function syncRoofModeCards() {
    document.querySelectorAll<HTMLButtonElement>('.mt-roof-mode').forEach((b) => {
      const on = b.dataset.value === roofInputMode;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('border-brass-400', on);
      b.classList.toggle('border-white/15', !on);
    });
    // « Terminer le tracé » ne veut rien dire quand on ne trace pas.
    const finishBtn = $('rp9-finish');
    if (finishBtn) finishBtn.hidden = roofInputMode !== 'draw';
  }
  /** Montre la confirmation UNIQUEMENT quand elle a un sens : geste « pointer »,
   *  un repère posé, aucun contour tracé, et pas déjà confirmé pour ce repère. */
  function syncPinConfirm() {
    if (!pinConfirmEl) return;
    pinConfirmEl.hidden = !(
      roofInputMode === 'point'
      && capturePin != null
      && captureOutline.length < 3
      && pinKey(capturePin) !== confirmedPinKey
    );
  }
  /** Adresse du repère — affichée seulement si le géocodage inverse en a rendu
   *  une (W2) : jamais une adresse devinée, jamais une ligne vide. */
  function setPinConfirmAddress(addr?: string | null) {
    if (!pinConfirmAddrEl) return;
    const a = (addr || '').trim();
    pinConfirmAddrEl.textContent = a;
    pinConfirmAddrEl.hidden = a === '';
  }
  document.querySelectorAll<HTMLButtonElement>('.mt-roof-mode').forEach((b) => {
    b.addEventListener('click', () => {
      const v: 'point' | 'draw' = b.dataset.value === 'draw' ? 'draw' : 'point';
      if (v === roofInputMode) return;
      roofInputMode = v;
      syncRoofModeCards();
      syncPinConfirm();
      setMapStatus(roofInputMode === 'draw'
        ? 'Tracez le contour de votre toit : appuyez sur chaque coin, puis « Terminer le tracé ».'
        : 'Appuyez sur votre toit pour y poser le repère.');
      markDataEntered();
      saveWizardState();
    });
  });
  $('mt-pin-confirm-yes')?.addEventListener('click', () => {
    confirmedPinKey = pinKey(capturePin);
    syncPinConfirm();
    setMapStatus('Repère confirmé. Continuez avec vos coordonnées ci-dessous.');
  });
  $('mt-pin-confirm-adjust')?.addEventListener('click', () => {
    // On ne SUPPRIME pas le repère : le visiteur en pose simplement un autre,
    // et s'il change d'avis il n'a rien perdu.
    confirmedPinKey = '';
    if (pinConfirmEl) pinConfirmEl.hidden = true;
    setMapStatus('Appuyez sur le bon endroit de votre toit pour déplacer le repère.');
    $('rp9-map')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
  });
  syncRoofModeCards();

  function wireCardGroup(
    selector: string,
    getCurrent: () => string,
    setCurrent: (v: string) => void,
    opts: { allowUnset?: boolean; recompute?: boolean; onChange?: () => void } = {},
  ) {
    const paint = () => {
      const current = getCurrent();
      document.querySelectorAll<HTMLButtonElement>(selector).forEach((b) => {
        const on = current !== '' && b.dataset.value === current;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('border-brass-400', on);
        b.classList.toggle('border-white/15', !on);
      });
    };
    document.querySelectorAll<HTMLButtonElement>(selector).forEach((btn) => {
      btn.addEventListener('click', () => {
        const same = getCurrent() === btn.dataset.value;
        setCurrent(same && opts.allowUnset ? '' : (btn.dataset.value || ''));
        paint();
        opts.onChange?.();
        markDataEntered();
        saveWizardState();
        if (opts.recompute) computeEstimate();
      });
    });
    paint();
  }
  // Le champ « Puissance souscrite (kVA) » (et donc son affichage conditionnel
  // en moyenne tension) est retiré du tunnel — comme les cartes « groupe
  // électrogène » (coupe fondateur 18/08).
  wireCardGroup('.mt-pro-unit', () => proUnit, (v) => { proUnit = v || 'mad'; }, { recompute: true });
  wireCardGroup('.mt-tension', () => tension, (v) => { tension = v || 'bt'; }, { recompute: true });
  wireCardGroup('.mt-activity', () => activity, (v) => { activity = v || 'day'; }, { recompute: true });
  wireCardGroup('.mt-surface-type', () => surfaceType, (v) => { surfaceType = v; }, { allowUnset: true, recompute: true });
  // WJ122 — COMMERCIAL : cartes catégorie + bascule d'unité de facture. Le choix
  // de catégorie recalcule l'estimation (day-share par archétype → hôtel ≠
  // bureau à facture égale). Les grilles de questions PAR CATÉGORIE qu'il
  // révélait sont retirées du tunnel (coupe fondateur 18/08) : elles ne
  // changeaient aucun chiffre — le commercial les complète dans l'ERP.
  wireCardGroup('.mt-commercial-cat', () => commercialCategory, (v) => { commercialCategory = v; }, { allowUnset: true, recompute: true });
  wireCardGroup('.mt-cc-unit', () => ccUnit, (v) => { ccUnit = v || 'mad'; }, { recompute: true });
  // WJ123 — INDUSTRIEL : pattern d'équipes (le plafond d'autoconsommation recalcule).
  wireCardGroup('.mt-equipes', () => equipes, (v) => { equipes = v; }, { allowUnset: true, recompute: true });
  // WJ124 — AGRICOLE : région (cartes) pilote le moteur eau ; culture (cartes)
  // synchronise le <select> sr-only mt-culture (source de vérité du payload).
  wireCardGroup('.mt-region-card', () => regionAgricole, (v) => { regionAgricole = v; }, { allowUnset: true, recompute: true });
  const cultureSelect = $('mt-culture') as HTMLSelectElement | null;
  function syncCultureCards() {
    const current = cultureSelect?.value || '';
    document.querySelectorAll<HTMLButtonElement>('.mt-culture-card').forEach((b) => {
      const on = current !== '' && b.dataset.value === current;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('border-brass-400', on);
      b.classList.toggle('border-white/15', !on);
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.mt-culture-card').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (cultureSelect) cultureSelect.value = cultureSelect.value === btn.dataset.value ? '' : (btn.dataset.value || '');
      syncCultureCards();
      markDataEntered();
      saveWizardState();
      computeEstimate();
    });
  });
  syncCultureCards();
  // AGRICOLE — la source d'eau pilote le type de pompe (immergée/surface).
  // « Votre irrigation » est retirée du tunnel (coupe fondateur 18/08).
  wireCardGroup('.mt-water-source', () => waterSource, (v) => { waterSource = v; }, { allowUnset: true, recompute: true });
  wireCardGroup('.mt-water-unit', () => waterUnit, (v) => { waterUnit = v || 'm3h'; }, { recompute: true });
  // Curseur « heures de pompage / jour » — valeur affichée en direct.
  const heuresInput = $('mt-heures-pompage') as HTMLInputElement | null;
  function syncHeuresLabel() {
    const out = $('mt-heures-pompage-value');
    if (out && heuresInput) out.textContent = `${heuresInput.value} h`;
  }
  heuresInput?.addEventListener('input', () => {
    syncHeuresLabel();
    computeEstimate();
  });
  syncHeuresLabel();
  // Recalcul en direct sur chaque champ numérique qui pilote un chiffre affiché
  // (même patron que mt-facture-hiver côté résidentiel).
  for (const id of ['mt-pro-bill', 'mt-cc-bill', 'mt-surface-m2', 'mt-profondeur', 'mt-hmt', 'mt-water-need', 'mt-fuel-spend']) {
    $(id)?.addEventListener('input', computeEstimate);
  }

  // ——— WJ1 : résoudre la facture mensuelle (montant exact prioritaire, sinon tranche) ———
  /** Milieu indicatif d'une tranche (MAD) — uniquement pour ESTIMER quand le montant
   *  exact est absent ; ne sert jamais au seuil (le seuil reste sur billRange/qualifies). */
  const RANGE_MIDPOINT: Record<string, number> = {
    'lt800': 600, '800-1000': 900, '1000-1500': 1250, '1500-3000': 2250,
    '3000-5000': 4000, '5000-10000': 7500, 'gt10000': 12000,
  };
  // WJ65/QX — plafond de bon sens PAR PROFIL (MAX_BILL_BY_MODE, lib/lead.ts) :
  // au-delà, une faute de frappe produirait un chiffre affirmé avec assurance —
  // on demande de vérifier (résidentiel) ou on route vers l'étude dédiée (pro).
  // Ne s'applique qu'au montant EXACT saisi, jamais aux tranches.
  function maxBillFor(m: string): number {
    return MAX_BILL_BY_MODE[m as keyof typeof MAX_BILL_BY_MODE] ?? 200_000;
  }
  function resolveMonthlyBill(): number | null {
    const exact = num('mt-facture-hiver');
    if (exact != null && exact > 0) return exact;
    const range = val('mt-bill');
    if (range && RANGE_MIDPOINT[range] != null) return RANGE_MIDPOINT[range];
    return null;
  }

  // ——— QX : FIX « tranche redondante » (résidentiel) — un montant exact VALIDE
  // dérive la tranche automatiquement (billRangeFromExact), masque le <select>
  // et affiche une ligne de confirmation discrète. Le payload billRange (lu sur
  // le <select>) reste ainsi TOUJOURS cohérent avec ce qui a piloté l'estimation
  // affichée. Champ exact vide/invalide → le <select> réapparaît, comme avant. ———
  function syncBillRangeFromExact() {
    const wrap = $('mt-bill-wrap');
    const detected = $('mt-bill-detected');
    const detectedValue = $('mt-bill-detected-value');
    const billSelect = $('mt-bill') as HTMLSelectElement | null;
    const exact = num('mt-facture-hiver');
    if (exact != null && exact > 0 && exact <= maxBillFor('residentiel')) {
      const rid = billRangeFromExact(exact);
      if (rid && billSelect) {
        billSelect.value = rid;
        if (detectedValue) detectedValue.textContent = billRangeLabel(rid as BillRangeId);
        if (wrap) wrap.hidden = true;
        if (detected) detected.hidden = false;
        setFieldError('mt-bill', 'mt-bill-err', null);
        return;
      }
    }
    if (wrap) wrap.hidden = false;
    if (detected) detected.hidden = true;
  }

  // ——— WJ1/QX : calculer + afficher l'estimation dans LE DOCUMENT ———
  let lastKwcLabel = '';
  let lastSavingsLabel = '';
  let lastKwc: number | null = null;
  // QX — le document a-t-il déjà été rendu au moins une fois (fallback compris) ?
  let docRendered = false;
  // QX — estimateShown : EXACTEMENT les chiffres calculés, joints au lead (le
  // conseiller CRM voit tout). WJ125 — ils ne sont PLUS rendus à l'écran public.
  let estimateShown: Record<string, number | string> | null = null;
