---
/**
 * « Mon toit » — CAPTURE CLIENT (PUBLIC, INDEXABLE depuis W245). Élevée WJ1-WJ8.
 *
 * Parcours mobile-first en assistant (WJ6) : Votre toit → Votre facture → Votre
 * estimation. La carte/le repère sont FACULTATIFS (WJ4) : on peut soumettre avec
 * l'adresse seule si la carte est indisponible. À l'étape estimation, une
 * FOURCHETTE instantanée (kWc, ≈MAD/mois économisés, amortissement) est calculée
 * par le VRAI moteur (billEstimate → estimatorBrain) AVANT la porte de contact
 * (WJ1). La capture est WhatsApp-first (WJ3) : CTA « Recevoir mon estimation sur
 * WhatsApp » prérempli + e-mail/opt-in transmis au webhook. Le seuil 1 000 MAD est
 * préservé et HONNÊTE (WJ5) : sous le seuil, on n'affiche pas un faux
 * « enregistré » mais un message adapté. Récupération d'abandon (WJ7) + bandeau de
 * confiance (WJ8). Microcopie FR + AR (WJ6).
 *
 * Le contrat de soumission /api/capture-lead est INCHANGÉ (validateLead, seuil,
 * consentement/UTM/fbclid, roofPoint/roofOutline/profil énergétique facultatifs).
 * L'outil 3D est booté en captureOnly : aucun panneau ne s'affiche ici.
 *
 * W245 — la page était noindex depuis sa création ("tunnel privé"), alors
 * qu'elle est devenue le CTA principal du site. Retrait du noindex + hreflang
 * (déjà déclarée dans STATIC_TRANSLATED) + meta description vendant
 * l'estimation instantanée + OG dédié.
 */
import Layout from '../../layouts/Layout.astro';
import { BILL_RANGES } from '../../lib/billRange';
// « Type de toit » (ROOF_TYPES) retirée du tunnel (coupe fondateur 18/08) — le
// commercial la complète dans l'ERP. `roofType` reste EXIGÉ par validateLead :
// il est désormais DÉRIVÉ (resolveRoofType → 'autre'), plus jamais demandé.
// WJ122 — cartes catégorie rendues au build depuis la source unique portée de
// solar.js (QX44). Les questions PAR CATÉGORIE (COMMERCIAL_CATEGORY_QUESTIONS)
// sont retirées du tunnel (coupe fondateur 18/08) : aucune n'alimentait
// l'estimation — le commercial les complète dans l'ERP.
import { COMMERCIAL_CATEGORIES } from '../../lib/commercialCategories';
// WJ124 — cartes culture + région rendues au build depuis le moteur agronomique
// QX48 (source unique). Valeurs = clés CROP_STAGES / ET0_MONTHLY (pilotent le
// moteur eau) ; labels/pictos localisés ci-dessous.
import { CROP_KEYS, REGION_KEYS } from '../../lib/agronomy';
const CROP_META: Record<string, { label: string; icon: string }> = {
  agrumes: { label: 'Agrumes', icon: '🍊' }, olivier: { label: 'Olivier', icon: '🫒' },
  dattier: { label: 'Dattier', icon: '🌴' }, avocatier: { label: 'Avocatier', icon: '🥑' },
  arganier: { label: 'Arganier', icon: '🌳' }, 'banane-serre': { label: 'Banane (serre)', icon: '🍌' },
  luzerne: { label: 'Luzerne', icon: '🌿' }, myrtille: { label: 'Myrtille', icon: '🫐' },
  amandier: { label: 'Amandier', icon: '🌰' }, vigne: { label: 'Vigne', icon: '🍇' },
  grenadier: { label: 'Grenadier', icon: '🔴' }, figuier: { label: 'Figuier', icon: '🌳' },
  'tomate-serre': { label: 'Tomate (serre)', icon: '🍅' }, 'poivron-serre': { label: 'Poivron (serre)', icon: '🫑' },
  'pomme-de-terre': { label: 'Pomme de terre', icon: '🥔' }, oignon: { label: 'Oignon', icon: '🧅' },
  'melon-pasteque': { label: 'Melon / Pastèque', icon: '🍉' }, cereales: { label: 'Céréales', icon: '🌾' },
  fraise: { label: 'Fraise', icon: '🍓' }, cannabis: { label: 'Cannabis (licite)', icon: '🌿' },
};
const REGION_LABEL: Record<string, string> = {
  'souss-massa': 'Souss-Massa', doukkala: 'Doukkala', tadla: 'Tadla', saiss: 'Saïss',
  oriental: 'Oriental', 'draa-tafilalet': 'Drâa-Tafilalet', 'gharb-loukkos': 'Gharb-Loukkos', haouz: 'Haouz',
};
import { NAP, WHATSAPP_LEADS } from '../../lib/nap';
import { whatsappLink } from '../../lib/whatsapp';
import Logo from '../../components/Logo.astro';
import StarRating from '../../components/StarRating.astro';
import CertLogoRow from '../../components/CertLogoRow.astro';
import InstallCounter from '../../components/InstallCounter.astro';
import ZelligeSignature from '../../components/ZelligeSignature.astro';

const inputClass =
  'w-full border border-white/15 bg-white/5 px-3 py-3 text-base text-white placeholder:text-lune-faint outline-none transition-colors focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30 aria-[invalid=true]:border-alert-300 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-alert-300/30';
const billRanges = BILL_RANGES;
// WJ65 — sortie honnête sans JavaScript : ce formulaire dépend entièrement du
// script (calcul d'estimation, soumission fetch) — sans JS, rien ne fonctionne.
// Plutôt qu'une page muette, un lien wa.me + tel: statique (aucun JS requis).
const noscriptWaHref = whatsappLink(
  WHATSAPP_LEADS,
  "Bonjour, je souhaite recevoir mon estimation solaire de taqinor.ma (mon navigateur n'active pas JavaScript).",
);
const noscriptTelHref = `tel:${NAP.phone}`;

// WJ6 — étapes de l'assistant (libellés FR + AR). data-i18n pour bascule de langue.
// COUPE FONDATEUR 21/08 — le tunnel passe de TROIS écrans à DEUX : les questions
// de profil (ex-écran « Votre facture ») et l'estimation + le formulaire de
// contact vivent désormais sur le MÊME écran, la révélation se faisant sur place
// au clic de « Voir mon estimation » (aucune navigation d'étape supplémentaire).
const STEPS = [
  { fr: 'Votre toit', ar: 'سطحك' },
  { fr: 'Votre estimation', ar: 'تقديرك' },
];

// WJ6 — sélecteur de mode, FR + AR. WJ121 — 4 vrais modes : la carte
// « Professionnel » est scindée en 🏭 Industriel (usine, production) et
// 🏪 Commercial (hôtel, commerce, services) ; le site n'émet plus jamais
// 'professionnel' (alias serveur conservé côté lib/lead.ts + backend).
const MODES = [
  { id: 'residentiel', fr: 'Résidentiel', ar: 'سكني', desc_fr: 'Villa, appartement', desc_ar: 'فيلا، شقة' },
  { id: 'industriel', fr: '🏭 Industriel', ar: '🏭 صناعي', desc_fr: 'Usine, production', desc_ar: 'مصنع، إنتاج' },
  { id: 'commercial', fr: '🏪 Commercial', ar: '🏪 تجاري', desc_fr: 'Hôtel, commerce, services', desc_ar: 'فندق، تجارة، خدمات' },
  { id: 'agricole', fr: 'Agricole', ar: 'فلاحي', desc_fr: 'Pompage, ferme', desc_ar: 'ضخ، مزرعة' },
];

// WJ8 — villes desservies (réelles, NAP) pour la preuve de proximité.
const TOWNS = ['Casablanca', 'Rabat', 'Marrakech', 'Tanger', 'Agadir', 'Kénitra', 'Fès', 'Settat'];
---

<Layout
  title="Estimation solaire instantanée — Mon toit | Taqinor"
  description="Estimation instantanée + design 3D de votre toit + signature en ligne : indiquez votre adresse et votre facture, recevez votre puissance, vos économies et votre amortissement en quelques secondes, gratuitement."
  ogSlug="accueil"
  locales={['fr', 'en', 'ar']}
>
  <!-- W320 — préconnexion à l'origine carte (MapTiler style JSON + tuiles
       raster Mapbox/Maxar quand configuré) : le moment le plus interactif de
       cette page (poser un repère sur son toit) payait jusqu'ici une
       poignée de main DNS+TLS série (~100–300 ms sur connexion froide).
       Layout.astro n'expose pas de slot <head> (hors périmètre ici) : ces
       hints sont honorés par le navigateur dès qu'ils sont analysés, où
       qu'ils apparaissent dans le document — sans dépendre du <head>. Coût
       nul si la carte n'est jamais bootée (repli sans clé/adresse). -->
  <link rel="preconnect" href="https://api.maptiler.com" crossorigin />
  <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
  <!-- QX — le « document d'estimation » (la révélation) est composé en DM Serif
       Display / DM Sans, les MÊMES polices que le devis premium PDF (copiées
       depuis quote_engine/assets/fonts). Préchargée UNIQUEMENT sur cette page
       (le reste du site reste sur Archivo/Hanken) ; font-display:swap dans le
       bloc @font-face plus bas — jamais un texte invisible en attendant. -->
  <link rel="preload" href="/fonts/dm-serif-display-400.woff2" as="font" type="font/woff2" crossorigin />
  <section class="bg-nuit px-4 py-8 sm:py-12">
    <!-- WJ98 — au-delà de `lg` (≥1024 px), le formulaire restait figé à
         `max-w-2xl` (672 px) : sur un écran de bureau, l'assistant flottait
         dans une colonne étroite avec un vide énorme des deux côtés — aucune
         mise en page « desktop » réelle. On élargit à `lg:max-w-4xl` (896 px)
         UNIQUEMENT à partir de `lg` (le mobile/tablette garde `max-w-2xl`,
         inchangé) ; la largeur récupérée profite directement à la carte
         (hauteur augmentée ci-dessous) et aux formulaires en grille. -->
    <div class="mx-auto max-w-2xl lg:max-w-4xl">
      <!-- WJ65 — sortie honnête SANS JavaScript : cette page est entièrement
           pilotée par script (carte, calcul, envoi) — sans JS elle resterait
           muette. On propose ici même une sortie qui ne demande AUCUN JS. -->
      <noscript>
        <div class="cine-card mb-6 border border-brass-400/40 p-5 text-sm text-white">
          <p class="font-semibold">Cette page nécessite JavaScript pour calculer votre estimation.</p>
          <p class="mt-1 text-lune-soft">
            Pas de souci : contactez-nous directement, gratuitement et sans engagement.
          </p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row">
            <a href={noscriptWaHref} target="_blank" rel="noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 bg-ok-600 px-5 py-3 text-base font-bold text-white transition-opacity hover:opacity-90">
              Écrire sur WhatsApp
            </a>
            <a href={noscriptTelHref}
              class="inline-flex flex-1 items-center justify-center gap-2 border border-white/25 px-5 py-3 text-base font-bold text-white transition-colors hover:border-brass-400 hover:text-brass-300">
              Appeler {NAP.phoneDisplayIntl}
            </a>
          </div>
        </div>
      </noscript>

      <!-- WJ45 — bandeau hors-ligne (navigator.onLine + écouteurs online/offline) :
           les réseaux mobiles marocains coupent souvent en cours de parcours ;
           plutôt qu'un échec silencieux après un délai d'attente, on prévient
           explicitement ET on rassure que rien n'est perdu (le formulaire reste
           rempli, l'instantané sessionStorage WJ61 persiste). -->
      <div id="mt-offline-banner" hidden role="status" aria-live="polite"
        class="mb-4 flex items-start gap-2 border border-brass-400/40 bg-brass-400/10 p-3 text-sm text-white">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 flex-none text-brass-300">
          <line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.58 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>
        </svg>
        <span data-i18n
          data-fr="Pas de connexion — vos réponses sont conservées, on réessaie dès le retour du réseau."
          data-ar="لا يوجد اتصال — إجاباتكم محفوظة، سنعيد المحاولة فور عودة الشبكة.">
          Pas de connexion — vos réponses sont conservées, on réessaie dès le retour du réseau.
        </span>
      </div>

      <!-- WJ106 — la bascule de langue FR/AR EN PLACE (boutons FR/عربي, WJ6)
           est retirée : `/ar/devis/mon-toit` est désormais la route arabe
           CANONIQUE (dédiée, indexable séparément), rendant ce toggle en
           place redondant — un visiteur arabophone arrive directement sur la
           bonne route plutôt que de re-basculer une page FR en place. La
           plomberie `data-i18n`/`applyLang` sous-jacente reste EN PLACE
           (retrait complet hors périmètre, risque de régression élevé sur un
           mécanisme qui couvre 140+ nœuds) — cette page reste donc figée en
           français, comme le contenu affiché par défaut avant tout clic sur
           l'ancien bouton. -->
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="tech-label rule-brass text-brass-300" data-i18n data-fr="Estimation solaire · gratuit · sans engagement" data-ar="تقدير شمسي · مجاني · بدون التزام">
            Estimation solaire · gratuit · sans engagement
          </p>
          <h1 class="display mt-4 text-2xl text-white sm:text-3xl" data-i18n data-fr="Recevez votre estimation solaire" data-ar="استلم تقديرك الشمسي">
            Recevez votre estimation solaire
          </h1>
        </div>
      </div>

      <!-- WJ6/WJ58 — microcopie « pas de pression » + promesse de délai honnête
           (WG9 résolu par le fondateur, 2026-07-03 : « sous 1 h, 7j/7 »). -->
      <p class="mt-3 text-sm text-lune-soft" data-i18n
        data-fr="Réponse WhatsApp sous 1 h, 7j/7 · pas d'appels commerciaux."
        data-ar="رد واتساب خلال ساعة واحدة، 7 أيام على 7 · بدون مكالمات تجارية.">
        Réponse WhatsApp sous 1 h, 7j/7 · pas d'appels commerciaux.
      </p>

      <!-- WJ6 — barre de progression étiquetée -->
      <ol id="mt-progress" class="mt-6 grid grid-cols-2 gap-2" aria-label="Progression">
        {STEPS.map((s, i) => (
          <li class="mt-step flex flex-col gap-1.5" data-step={i}>
            <span class="h-1.5 w-full rounded-full bg-white/10 mt-step-bar transition-colors"></span>
            <span class="text-xs text-lune-faint mt-step-label" data-i18n data-fr={s.fr} data-ar={s.ar}>{s.fr}</span>
          </li>
        ))}
      </ol>

      <!-- ============ ÉTAPE 0/1 — VOTRE TOIT (mode + carte/repère) ============ -->
      <div id="mt-panel-0" class="mt-step-panel">
        <!-- WJ88 — landmark h2 réel par étape (repère de navigation pour lecteur
             d'écran) : visuellement masqué (sr-only), la barre de progression
             visible reste la même — mais la page a désormais un vrai plan de
             titres au lieu d'un unique <h1> sur 1 200 lignes. -->
        <h2 id="mt-h2-0" class="sr-only" data-i18n data-fr={STEPS[0].fr} data-ar={STEPS[0].ar}>{STEPS[0].fr}</h2>
        <!-- WJ6 — sélecteur de mode. QX — plus AUCUN mode présélectionné : le
             choix du profil pilote désormais des questions d'étape 2 ENTIÈREMENT
             différentes (facture / énergie pro / pompage), donc un défaut
             silencieux « résidentiel » enverrait un industriel ou un fermier
             dans le mauvais questionnaire. « Continuer » exige un choix
             explicite (nudge inline sur les cartes, jamais une alerte). -->
        <fieldset class="mt-6">
          <legend class="text-sm text-lune-soft" data-i18n data-fr="Votre type de projet" data-ar="نوع مشروعك">Votre type de projet</legend>
          <!-- WJ65 — sur les tout petits écrans (≲360 px), plusieurs colonnes
               serrent trop le texte (troncature/chevauchement) : on empile en
               1 colonne, puis 2×2 dès `sm:` (640 px) — WJ121 : 4 cartes. -->
          <div id="mt-mode-grid" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {MODES.map((m) => (
              <button type="button" class="mt-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors"
                data-mode={m.id} aria-pressed="false" aria-describedby="mt-mode-err">
                <span class="text-sm font-semibold text-white" data-i18n data-fr={m.fr} data-ar={m.ar}>{m.fr}</span>
                <span class="text-xs text-lune-faint" data-i18n data-fr={m.desc_fr} data-ar={m.desc_ar}>{m.desc_fr}</span>
              </button>
            ))}
          </div>
          <span id="mt-mode-err" hidden role="alert" class="mt-2 block text-xs text-alert-300"></span>
        </fieldset>

        <!-- WJ68/QX — les champs entreprise (raison sociale / type de site /
             nb de sites) ont DÉMÉNAGÉ dans le sous-panneau PROFESSIONNEL de
             l'étape 2 (accordéon « Votre contexte ») pour garder cette étape
             carte légère — mêmes id/name, contrat webhook inchangé. -->

        <p class="mt-5 text-lune-soft" data-i18n
          data-fr="Cherchez votre adresse et posez un repère sur votre toit. C'est facultatif — vous pouvez aussi continuer avec votre adresse seule."
          data-ar="ابحث عن عنوانك وضع علامة على سطحك. هذا اختياري — يمكنك أيضاً المتابعة بعنوانك فقط.">
          Cherchez votre adresse et posez un repère sur votre toit. C'est facultatif —
          vous pouvez aussi continuer avec votre adresse seule.
        </p>

        <!-- Repli sans JavaScript / sans clé carte (WJ4) : on demande l'adresse en clair
             et on AUTORISE la suite (plus de cul-de-sac sur le repère). -->
        <div id="mt-fallback" hidden class="cine-card mt-5 border-l-4 border-alert-300 p-5">
          <p class="font-semibold text-white" data-i18n data-fr="Carte momentanément indisponible" data-ar="الخريطة غير متوفرة مؤقتاً">Carte momentanément indisponible</p>
          <p class="mt-2 text-sm text-lune-soft" data-i18n
            data-fr="Pas de souci : indiquez votre adresse complète ci-dessous et continuez. Nous localiserons votre toit pour vous."
            data-ar="لا مشكلة: أدخل عنوانك الكامل أدناه وتابع. سنحدد موقع سطحك من أجلك.">
            Pas de souci : indiquez votre adresse complète ci-dessous et continuez. Nous
            localiserons votre toit pour vous.
          </p>
          <label class="mt-3 block text-sm text-lune-soft">
            <span data-i18n data-fr="Adresse complète" data-ar="العنوان الكامل">Adresse complète</span>
            <input id="mt-fallback-address" type="text" autocomplete="street-address"
              placeholder="Ex. Lot. Al Wifaq, Hay Riad, Rabat" class={`${inputClass} mt-1`} />
          </label>
        </div>

        <!-- CHOIX EXPLICITE du geste de repérage. Avant, le parcours était
             IMPLICITE : un clic posait un repère, et seul un double-clic (une
             interaction qui n'existe pas au doigt) démarrait un contour — rien
             ne l'annonçait, donc quasiment personne ne dessinait. On pose la
             question franchement, avec un défaut sûr (« pointer »). -->
        <div id="mt-roof-mode-group" class="mt-5" role="group" aria-labelledby="mt-roof-mode-label">
          <p id="mt-roof-mode-label" class="text-sm text-lune-soft" data-i18n
            data-fr="Comment souhaitez-vous nous montrer votre toit ?"
            data-ar="كيف تريدون أن تُرونا سطحكم؟">
            Comment souhaitez-vous nous montrer votre toit ?
          </p>
          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <button type="button" id="mt-roof-mode-point" data-value="point" aria-pressed="true"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors">
              <span class="text-sm font-semibold text-white" data-i18n
                data-fr="📍 Pointer mon toit" data-ar="📍 تحديد سطحي بنقطة">📍 Pointer mon toit</span>
              <span class="text-xs text-lune-faint" data-i18n
                data-fr="Un seul appui sur votre toit — le plus rapide."
                data-ar="ضغطة واحدة على سطحكم — الأسرع.">Un seul appui sur votre toit — le plus rapide.</span>
            </button>
            <button type="button" id="mt-roof-mode-draw" data-value="draw" aria-pressed="false"
              class="mt-roof-mode cine-card flex flex-col items-start gap-0.5 border border-white/15 p-3 text-left transition-colors">
              <span class="text-sm font-semibold text-white" data-i18n
                data-fr="✏️ Dessiner mon toit" data-ar="✏️ رسم سطحي">✏️ Dessiner mon toit</span>
              <span class="text-xs text-lune-faint" data-i18n
                data-fr="Tracez le contour — plus précis pour l'étude."
                data-ar="ارسموا المحيط — أدق للدراسة.">Tracez le contour — plus précis pour l'étude.</span>
            </button>
          </div>
        </div>

        <!-- CARTE — recherche d'adresse + repère (ids rp9-* câblés par captureBoot). -->
        <div id="mt-stage" class="cine-card mt-5 overflow-hidden">
          <form id="rp9-search" class="flex flex-col gap-3 border-b border-white/10 p-4 sm:flex-row">
            <label for="rp9-address" class="sr-only">Votre adresse</label>
            <div class="relative flex-1">
              <input id="rp9-address" name="address" type="text" autocomplete="off"
                role="combobox" aria-autocomplete="list" aria-expanded="false"
                aria-controls="rp9-suggestions" aria-haspopup="listbox"
                placeholder="Adresse, quartier ou ville (ex. Casablanca, Maârif)" class={inputClass} />
              <ul id="rp9-suggestions" role="listbox" aria-label="Suggestions d'adresses" hidden
                class="absolute left-0 right-0 top-full z-20 mt-1 max-h-72 overflow-auto border border-white/15 bg-nuit-900 shadow-xl">
              </ul>
            </div>
            <button type="submit"
              class="flex-none bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
              Localiser
            </button>
          </form>

          <!-- WJ88 — role="application" retiré : ce rôle ARIA place tout le
               sous-arbre en mode « application » pour un lecteur d'écran (les
               flèches/tab natifs sont désactivés), ce qui rend la carte
               clavier-inerte alors qu'elle n'expose ici aucune interaction
               clavier propre (le pin/tracé est à la souris/au tactile ; la
               recherche d'adresse au-dessus reste un vrai formulaire
               accessible). aria-label seul suffit à la nommer. -->
          <!-- WJ98 — la bande `44dvh` était un compromis TÉLÉPHONE (garder la
               recherche + les boutons visibles sans défiler) ; sur un viewport
               desktop `lg:`, la même hauteur relative laisse une carte trop
               courte pour tracer un contour de toit confortablement. `lg:h-[62vh]`
               (plafonné à 640 px) donne une zone de travail nettement plus
               généreuse dès que l'écran a la place, sans toucher au comportement
               téléphone/tablette (`h-[44dvh]` inchangé en dessous de `lg`). -->
          <div id="rp9-map" class="mt-skeleton-shimmer mt-0 h-[44dvh] min-h-[280px] w-full bg-nuit-700 lg:h-[62vh] lg:max-h-[640px]"
            aria-label="Carte satellite pour repérer votre toit"></div>

          <div class="flex flex-wrap items-center gap-3 border-t border-white/10 p-4">
            <button type="button" id="rp9-finish" disabled
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-400 hover:text-brass-300 disabled:cursor-not-allowed disabled:opacity-40">
              Terminer le tracé
            </button>
            <button type="button" id="rp9-undo-point" hidden
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
              Annuler le dernier point
            </button>
            <button type="button" id="rp9-clear"
              class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-white/50 hover:text-white">
              Effacer
            </button>
            <p class="ml-auto text-sm text-lune-faint">
              <span>Repère&nbsp;: </span><span id="rp9-area-value" class="text-white">—</span>
            </p>
          </div>
          <p id="rp9-status" class="border-t border-white/10 px-4 py-3 text-sm text-lune-faint" aria-live="polite">
            Cherchez votre adresse, puis posez un repère sur votre toit (facultatif).
          </p>

          <!-- CONFIRMATION VISUELLE du repère (flux « pointer » uniquement). Le
               visiteur posait un point sur une vue large et continuait sans
               jamais voir CE qu'il avait désigné ; la carte atterrit maintenant
               serrée sur son repère (captureBoot.landOn) et on lui pose la
               question. Le flux « dessiner » garde son propre retour visuel :
               le contour lui-même. -->
          <div id="mt-pin-confirm" hidden class="border-t border-white/10 p-4">
            <p class="text-sm font-semibold text-white" data-i18n
              data-fr="C'est bien votre toit ?" data-ar="هل هذا هو سطحكم؟">C'est bien votre toit ?</p>
            <p class="mt-1 text-xs text-lune-faint" data-i18n
              data-fr="La carte est centrée sur le repère que vous venez de poser."
              data-ar="الخريطة متمركزة على العلامة التي وضعتموها للتو.">
              La carte est centrée sur le repère que vous venez de poser.
            </p>
            <!-- Adresse REMPLIE seulement si le géocodage inverse en a trouvé une
                 (W2) — jamais une adresse devinée, jamais une ligne vide. -->
            <p id="mt-pin-confirm-address" hidden class="mt-2 text-sm text-lune-soft"></p>
            <div class="mt-3 flex flex-wrap gap-2">
              <button type="button" id="mt-pin-confirm-yes"
                class="bg-brass-400 px-4 py-2.5 text-sm font-bold text-azur-950 transition-colors hover:bg-brass-300">
                <span data-i18n data-fr="Oui, c'est mon toit" data-ar="نعم، هذا سطحي">Oui, c'est mon toit</span>
              </button>
              <button type="button" id="mt-pin-confirm-adjust"
                class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-brass-400 hover:text-brass-300">
                <span data-i18n data-fr="Non, déplacer le repère" data-ar="لا، غيّروا موضع العلامة">Non, déplacer le repère</span>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-5 flex justify-end">
          <button type="button" id="mt-next-0"
            class="inline-flex items-center justify-center gap-2 bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
            <span data-i18n data-fr="Continuer" data-ar="متابعة">Continuer</span>
            <!-- WJ89 — chevron SVG auto-retourné en RTL (règle globale.css
                 `[dir="rtl"] button svg[aria-hidden="true"]`), plus jamais un
                 glyphe « → » littéral figé dans le sens LTR. -->
            <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none">
              <polyline points="3,1 7,5 3,9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <!-- ============ ÉTAPE 2 — VOTRE FACTURE (+ profil énergétique) ============ -->
      <div id="mt-panel-1" class="mt-step-panel" hidden>
        <!-- WJ88 — landmark h2 réel (voir note étape 0). -->
        <h2 id="mt-h2-1" class="sr-only" data-i18n data-fr={STEPS[1].fr} data-ar={STEPS[1].ar}>{STEPS[1].fr}</h2>

        <!-- ===== QX — SOUS-PANNEAU RÉSIDENTIEL (questions facture, comportement
             historique + fix « tranche redondante ») — un seul sous-panneau
             visible à la fois selon le profil choisi à l'étape 1. ===== -->
        <div id="mt-sub-residentiel">
        <p class="mt-6 text-lune-soft" data-i18n
          data-fr="Indiquez votre facture pour calculer votre estimation. Le montant exact donne le chiffre le plus juste."
          data-ar="أدخل فاتورتك لحساب تقديرك. المبلغ الدقيق يعطي الرقم الأصح.">
          Indiquez votre facture pour calculer votre estimation. Le montant exact donne le
          chiffre le plus juste.
        </p>

        <div class="cine-card mt-5 space-y-4 p-5 sm:p-6">
          <label class="block text-sm text-lune-soft">
            <span data-i18n data-fr="Facture mensuelle exacte (MAD)" data-ar="الفاتورة الشهرية الدقيقة (درهم)">Facture mensuelle exacte (MAD)</span>
            <input id="mt-facture-hiver" name="factureHiver" type="number" step="any" inputmode="decimal"
              aria-describedby="mt-facture-hiver-err" placeholder="Ex. 1 200" class={`${inputClass} mt-1`} />
            <span id="mt-facture-hiver-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
            <!-- WJ67 — micro-transparence « pourquoi on vous demande ça » : copie
                 seule, repliée par défaut (native <details>, aucun JS requis). -->
            <details class="mt-1.5">
              <summary class="cursor-pointer select-none text-xs text-lune-faint hover:text-lune-soft" data-i18n
                data-fr="Pourquoi on vous demande ça ?" data-ar="لماذا نطلب منكم هذا؟">
                Pourquoi on vous demande ça&nbsp;?
              </summary>
              <p class="mt-1 text-xs text-lune-faint" data-i18n
                data-fr="Le montant exact permet un calcul juste — jamais partagé."
                data-ar="المبلغ الدقيق يتيح حساباً صحيحاً — لا يُشارَك أبداً.">
                Le montant exact permet un calcul juste — jamais partagé.
              </p>
            </details>
          </label>

          <!-- QX — FIX « on me redemande ma tranche alors que j'ai donné le
               montant exact » : dès qu'un montant exact VALIDE est saisi
               ci-dessus, la tranche est DÉRIVÉE automatiquement
               (billRangeFromExact), le <select> disparaît et une ligne de
               confirmation discrète prend sa place. Le <select> reste la
               source de vérité du payload (billRange) — toujours cohérent
               avec ce qui a piloté l'estimation affichée. -->
          <label id="mt-bill-wrap" class="block text-sm text-lune-soft">
            <span data-i18n data-fr="…ou choisissez une tranche" data-ar="…أو اختر شريحة">…ou choisissez une tranche</span>
            <select id="mt-bill" name="billRange" aria-describedby="mt-bill-err" class={`${inputClass} mt-1`}>
              <option value="">Choisir…</option>
              {billRanges.map((b) => <option value={b.id}>{b.label}</option>)}
            </select>
            <span id="mt-bill-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
          </label>
          <p id="mt-bill-detected" hidden class="flex items-center gap-1.5 text-sm text-lune-soft" aria-live="polite">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-ok-400">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>Tranche détectée&nbsp;: <strong id="mt-bill-detected-value" class="font-semibold text-white">—</strong></span>
          </p>

          <!-- OMBRAGE RETIRÉ DU TUNNEL (ordre fondateur 21/08) — aucun tunnel
               solaire de référence ne pose la question de l'ombrage en amont :
               Zolar l'annonce moyennée dans ses hypothèses, EDF ENR la renvoie à
               la visite technique, et Sunroof la DÉRIVE de l'imagerie. La poser
               ici demandait au visiteur un jugement d'expert (« partiel » ?
               « important » ?) pour un chiffre qui de toute façon sera repris à
               la visite. Le dérate (billEstimate.ts OMBRAGE_DERATE) reste en
               place et intact : sans réponse, `ombrageDerateFactor(undefined)`
               rend 1 — EXACTEMENT le chemin qu'empruntait déjà tout visiteur qui
               ne cliquait aucune puce. Le commercial renseigne l'ombrage réel
               dans l'ERP après la visite. -->
        </div>

        <!-- RETIRÉES DU TUNNEL (coupe fondateur 18/08) — le commercial les
             complète dans l'ERP (la fenêtre lead a désormais sa section dédiée) :
             type de toit, raccordement mono/triphasé, « l'été est différent »
             + facture d'été, distributeur d'électricité, consommation kWh/mois
             (la facture suffit — estimateFromBill fait la conversion lui-même),
             âge du toit, photo du compteur, charges futures, intérêt batterie,
             « Vous êtes… » (occupantType) et « Votre projet, c'est pour… »
             (projectTiming). Les trois accordéons mt-more-size / mt-more-needs /
             mt-more-financing (« Pour mieux vous conseiller ») disparaissent
             entièrement avec elles. -->
        </div>

        <!-- ===== QX — SOUS-PANNEAU PROFESSIONNEL : énergie du site, raccordement
             BT/MT, profil d'activité, équipes et surface — c'est-à-dire EXACTEMENT
             les entrées d'estimatorPro (autoconsommation C&I), rien d'autre depuis
             la coupe fondateur du 18/08. ===== -->
        <div id="mt-sub-professionnel" hidden>
          <p class="mt-6 text-lune-soft">
            Parlez-nous de l'énergie de votre site — deux réponses suffisent pour une
            première estimation, le reste l'affine.
          </p>

          <div class="cine-card mt-5 space-y-5 p-5 sm:p-6">
            <!-- (a) Facture mensuelle — bascule MAD ⇄ kWh, UN seul champ -->
            <div>
              <p class="text-sm text-lune-soft">Votre consommation mensuelle</p>
              <div class="mt-2 grid grid-cols-2 gap-2" role="group" aria-label="Unité de consommation">
                <button type="button" id="mt-pro-unit-mad" class="mt-pro-unit cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="mad" aria-pressed="true">MAD / mois</button>
                <button type="button" id="mt-pro-unit-kwh" class="mt-pro-unit cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="kwh" aria-pressed="false">kWh / mois</button>
              </div>
              <label class="mt-2 block text-sm text-lune-soft">
                <span class="sr-only">Montant mensuel</span>
                <input id="mt-pro-bill" name="proBill" type="number" step="any" inputmode="decimal"
                  aria-describedby="mt-pro-bill-err" placeholder="ex : 25 000" class={`${inputClass} mt-1`} />
                <span id="mt-pro-bill-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
              </label>
            </div>

            <!-- (b) Raccordement BT / MT (+ kVA si MT) -->
            <div id="mt-tension-raccordement">
              <p class="text-sm text-lune-soft">Raccordement</p>
              <div class="mt-2 grid grid-cols-2 gap-2" role="group" aria-label="Type de raccordement">
                <button type="button" id="mt-tension-bt" class="mt-tension cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="bt" aria-pressed="true">Basse tension</button>
                <button type="button" id="mt-tension-mt" class="mt-tension cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="mt" aria-pressed="false">Moyenne tension</button>
              </div>
              <!-- Puissance souscrite (kVA) retirée du tunnel (coupe fondateur
                   18/08) : estimatePro ne lit que le raccordement bt/mt, jamais
                   le kVA — le commercial le complète dans l'ERP. -->
            </div>

            <!-- (c) Profil d'activité — pilote le taux d'autoconsommation -->
            <fieldset>
              <legend class="text-sm text-lune-soft">Votre activité</legend>
              <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-3">
                <button type="button" class="mt-activity cine-card border p-3 text-center text-sm text-white transition-colors" data-value="day" aria-pressed="false">Journée (8h–18h)</button>
                <button type="button" class="mt-activity cine-card border p-3 text-center text-sm text-white transition-colors" data-value="day_evening" aria-pressed="false">Jour + soirée</button>
                <button type="button" class="mt-activity cine-card border p-3 text-center text-sm text-white transition-colors" data-value="continuous" aria-pressed="false">24h/24 · 7j/7</button>
              </div>
            </fieldset>

            <!-- WJ123 — (c bis) PATTERN D'ÉQUIPES : plafond d'autoconsommation
                 honnête (un 3x8 ne voit plus l'autoconso d'un bureau). C'est la
                 seule des questions WJ123 que le calcul lit vraiment — elle reste. -->
            <fieldset id="mt-equipes-wrap">
              <legend class="text-sm text-lune-soft">Rythme de production (équipes)</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <button type="button" class="mt-equipes cine-card border p-3 text-center text-sm text-white transition-colors" data-value="1x8" aria-pressed="false">Journée (1×8)</button>
                <button type="button" class="mt-equipes cine-card border p-3 text-center text-sm text-white transition-colors" data-value="2x8" aria-pressed="false">2×8</button>
                <button type="button" class="mt-equipes cine-card border p-3 text-center text-sm text-white transition-colors" data-value="3x8" aria-pressed="false">3×8 continu</button>
                <button type="button" class="mt-equipes cine-card border p-3 text-center text-sm text-white transition-colors" data-value="continu" aria-pressed="false">Continu 24/7</button>
              </div>
              <!-- « Production aussi le week-end » retirée du tunnel (coupe
                   fondateur 18/08) : le plafond d'autoconsommation vient des
                   ÉQUIPES seules (SHIFT_DAY_SHARE_CEILING) — le week-end
                   n'entrait dans aucun calcul. Le commercial le complète dans l'ERP. -->
              <p class="mt-2 text-xs text-lune-faint">
                Le solaire déplace vos heures PLEINES (~1,01 DH/kWh) ; la POINTE ne se
                couvre qu'avec une batterie — jamais l'inverse. Plus vous produisez la
                nuit (3×8, continu), moins le solaire seul couvre — une estimation
                honnête, affinée après étude.
              </p>
            </fieldset>

            <!-- cos φ retiré du tunnel (coupe fondateur 18/08) : jamais lu par
                 estimatePro — le commercial le complète dans l'ERP. -->

            <p class="text-xs text-lune-faint">
              Étude moyenne tension détaillée par un ingénieur — cette estimation est
              indicative (loi 82-21, autoconsommation).
            </p>
          </div>

          <!-- (d) Surface disponible (facultatif) -->
          <details id="mt-pro-surface" class="cine-card mt-3 p-5 sm:p-6">
            <summary class="cursor-pointer select-none text-sm font-semibold text-brass-300">
              Votre surface (facultatif)
            </summary>
            <fieldset class="mt-4">
              <legend class="text-sm text-lune-soft">Type de surface disponible</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                <button type="button" class="mt-surface-type cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="bac_acier" aria-pressed="false">Toiture bac acier</button>
                <button type="button" class="mt-surface-type cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="terrasse" aria-pressed="false">Toiture-terrasse</button>
                <button type="button" class="mt-surface-type cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="ombriere" aria-pressed="false">Ombrière parking</button>
                <button type="button" class="mt-surface-type cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="terrain" aria-pressed="false">Terrain</button>
              </div>
            </fieldset>
            <label class="mt-4 block text-sm text-lune-soft">
              <span>Surface approximative (m²)</span>
              <input id="mt-surface-m2" name="surfaceM2" type="number" step="any" inputmode="decimal"
                aria-describedby="mt-surface-m2-err" placeholder="Ex. 800" class={`${inputClass} mt-1`} />
              <span id="mt-surface-m2-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
            </label>
          </details>

          <!-- « Votre contexte (facultatif) » retiré du tunnel (coupe fondateur
               18/08) : groupe électrogène + puissance du groupe (kVA) + dépense
               diesel, type de site, nombre de sites — aucun n'entre dans
               estimatePro. La RAISON SOCIALE a été déplacée sur l'écran contact
               (mêmes id/name). Le commercial complète le reste dans l'ERP. -->
        </div>

        <!-- ===== WJ122 — SOUS-PANNEAU COMMERCIAL : catégorie d'activité (cartes)
             + facture MAD⇄kWh. Les 2-4 questions SPÉCIFIQUES à la catégorie sont
             sorties du tunnel (coupe fondateur 18/08) : seule la CATÉGORIE compte
             pour le calcul.
             Le day-share par archétype (commercialDayShare, SOURCE solar.js QX44)
             fait qu'un hôtel ≠ un bureau à facture égale. Alimente estimatorPro
             (autoconsommation C&I) via `categorieCommerciale`. ===== -->
        <div id="mt-sub-commercial" hidden>
          <p class="mt-6 text-lune-soft">
            Votre établissement a un profil de consommation particulier — choisissez
            votre activité pour une estimation adaptée.
          </p>

          <div class="cine-card mt-5 space-y-5 p-5 sm:p-6">
            <!-- (a) Catégorie d'activité -->
            <fieldset>
              <legend class="text-sm text-lune-soft">Votre activité</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
                {COMMERCIAL_CATEGORIES.map((c) => (
                  <button type="button" class="mt-commercial-cat cine-card flex flex-col items-center gap-1.5 border border-white/15 p-3 text-center transition-colors"
                    data-value={c.value} aria-pressed="false">
                    <span aria-hidden="true" class="text-2xl leading-none">{c.icon}</span>
                    <span class="text-xs font-semibold text-white">{c.label}</span>
                  </button>
                ))}
              </div>
            </fieldset>

            <!-- (b) Facture mensuelle — bascule MAD ⇄ kWh, UN seul champ -->
            <div>
              <p class="text-sm text-lune-soft">Votre consommation mensuelle</p>
              <div class="mt-2 grid grid-cols-2 gap-2" role="group" aria-label="Unité de consommation">
                <button type="button" class="mt-cc-unit cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="mad" aria-pressed="true">MAD / mois</button>
                <button type="button" class="mt-cc-unit cine-card border p-2.5 text-center text-sm text-white transition-colors" data-value="kwh" aria-pressed="false">kWh / mois</button>
              </div>
              <label class="mt-2 block text-sm text-lune-soft">
                <span class="sr-only">Montant mensuel</span>
                <input id="mt-cc-bill" name="ccBill" type="number" step="any" inputmode="decimal"
                  aria-describedby="mt-cc-bill-err" placeholder="ex : 25 000" class={`${inputClass} mt-1`} />
                <span id="mt-cc-bill-err" hidden role="alert" class="mt-1 block text-xs text-alert-300"></span>
              </label>
            </div>

            <!-- Questions PAR CATÉGORIE retirées du tunnel (coupe fondateur
                 18/08) : aucune n'entrait dans l'estimation — estimatePro ne lit
                 que la CATÉGORIE elle-même (day-share par archétype), la facture,
                 le raccordement, l'activité, les équipes et la surface. Elles
                 partaient au webhook sans changer un seul chiffre affiché ; le
                 commercial les complète désormais dans l'ERP. -->

            <p class="text-xs text-lune-faint">
              Estimation indicative (autoconsommation, loi 82-21). Une étude détaillée
              est réalisée par un ingénieur.
            </p>
          </div>
        </div>

        <!-- ===== QX — SOUS-PANNEAU AGRICOLE (nouveau) : hydraulique (source /
             profondeur / HMT / besoin / heures) + dépense carburant. Alimente
             estimatorAgricole (pompage) — JAMAIS estimateFromBill (garde WJ111).
             Irrigation et pompe actuelle/CV sont sorties du tunnel (coupe
             fondateur 18/08). ===== -->
        <div id="mt-sub-agricole" hidden>
          <p class="mt-6 text-lune-soft">
            Votre pompage se dimensionne sur l'eau, pas sur une facture. Dites-nous votre
            culture et votre région&nbsp;: on estime votre besoin en eau — ou indiquez
            directement votre débit/HMT si vous les connaissez.
          </p>

          <!-- WJ124 — (0) CULTURE + RÉGION : le moteur agronomique (FAO-56, QX48)
               déduit le besoin en eau du mois de pointe → débit requis → pompe.
               C'est le chemin « je ne connais pas mon débit » ; le chemin
               hydraulique ci-dessous (« je connais mon débit/HMT ») reste intact. -->
          <div class="cine-card mt-5 space-y-5 p-5 sm:p-6">
            <fieldset>
              <legend class="text-sm text-lune-soft">Votre culture principale</legend>
              <div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-5">
                {CROP_KEYS.map((k) => (
                  <button type="button" class="mt-culture-card cine-card flex flex-col items-center gap-1 border border-white/15 p-2.5 text-center transition-colors"
                    data-value={k} aria-pressed="false">
                    <span aria-hidden="true" class="text-xl leading-none">{CROP_META[k]?.icon ?? '🌱'}</span>
                    <span class="text-xs font-semibold text-white">{CROP_META[k]?.label ?? k}</span>
                  </button>
                ))}
              </div>
              <!-- Source de vérité du payload `culture` (clé CROP_STAGES), synchronisée par les cartes. -->
              <select id="mt-culture" name="culture" class="sr-only" tabindex="-1" aria-hidden="true">
                <option value="">Choisir…</option>
                {CROP_KEYS.map((k) => <option value={k}>{CROP_META[k]?.label ?? k}</option>)}
              </select>
            </fieldset>

            <fieldset>
              <legend class="text-sm text-lune-soft">Votre région</legend>
              <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                {REGION_KEYS.map((k) => (
                  <button type="button" class="mt-region-card cine-card border p-2.5 text-center text-sm text-white transition-colors"
                    data-value={k} aria-pressed="false">{REGION_LABEL[k] ?? k}</button>
                ))}
              </div>
            </fieldset>

            <label class="block text-sm text-lune-soft">
