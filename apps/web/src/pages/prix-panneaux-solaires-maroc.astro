---
/**
 * W293 — Pillar évergreen « Prix panneaux solaires Maroc ». Page NON datée,
 * pensée pour un rafraîchissement annuel (verifiedDate ci-dessous), qui reprend
 * les fourchettes déjà publiées et sourcées dans l'article daté
 * src/content/blog/prix-installation-solaire-maroc-2026.md — AUCUN chiffre
 * nouveau, uniquement une présentation pérenne (canonique) pointée par le
 * terme de recherche à plus fort intent commercial du site. L'article daté
 * reste la référence "actualité 2026" et renvoie ici comme contexte canonique ;
 * ce pilier renvoie vers résidentiel/nos-solutions/guides/blog pour le
 * dimensionnement et le détail méthode. Toutes les fourchettes portent leur
 * fenêtre de validité (indicatif <année>) — jamais un prix ferme.
 */
import Layout from '../layouts/Layout.astro';
import V2Enhance from '../components/V2Enhance.astro';
import Article33Ribbon from '../components/Article33Ribbon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CtaLigne from '../components/CtaLigne.astro';
import CtaBand from '../components/CtaBand.astro';
import StickyCta from '../components/StickyCta.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Faq from '../components/Faq.astro';
import { NAP } from '../lib/nap';
import { DATE_LONGUE_FR as dateFmt } from '../lib/format';
import { PHRASE_TVA } from '../lib/prixConstants';

// Rafraîchie à chaque révision de la page (voir
// CONTENT_SEO_NOTES.md §5/§6 pour les sources). Pas de contenu "collection" —
// page évergreen simple, comme les guides.
const verifiedDate = new Date('2026-11-04');

// WAUD68 (D-WAUD-5 = a) — aucun montant tant que lib/prixConstants.ts n'a pas sa source datée
// (export ERP des devis signés 2026) : fourchettes 3/5/10 kWc, prix au kWc, surcoûts, coût batterie,
// « 4 700 DH/kWc », douane et taux de TVA RETIRÉS (liste dans prixConstants.ts).
// W297 — AEO/GEO : Q&A autonome. schema={false} : /faq garde le seul FAQPage du site.
const faq = [
  {
    q: 'Combien coûte une installation solaire clé-en-main au Maroc ?',
    a: 'Le prix dépend de la puissance retenue sur votre facture, de la toiture, de la batterie éventuelle et des marques posées. Nous ne publions pas de fourchette sans source datée : le prix de votre installation sort d’une étude gratuite sur votre facture.',
  },
  {
    q: 'Pourquoi un prix au kWc très bas doit-il alerter ?',
    a: 'Il correspond souvent au kit équipement seul (panneaux + onduleur), sans la pose, le câblage, la structure ni le raccordement — pas à une installation clé-en-main terminée. Comparez toujours deux offres ligne à ligne.',
  },
  {
    q: 'Quel est le retour sur investissement d’une installation solaire au Maroc ?',
    a: 'Le calcul dépend fortement de votre consommation réelle et de votre tranche tarifaire ONEE.',
  },
];

const url = new URL(Astro.url.pathname, Astro.site).href;
const schemaImageUrl = new URL('/og/residentiel.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Prix des panneaux solaires au Maroc : ce qui fait le prix',
  description: 'Ce qui fait le prix d’une installation solaire clé-en-main au Maroc : puissance (kWc), toiture, batterie, marques — et pourquoi le vrai chiffre vient de votre facture.',
  image: schemaImageUrl,
  dateModified: verifiedDate.toISOString().slice(0, 10),
  about: { '@type': 'Thing', name: 'Prix installation solaire Maroc' },
  author: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: url,
};
---

<Layout
  title="Prix des panneaux solaires au Maroc : ce qui fait le prix | Taqinor"
  description="Combien coûte une installation solaire au Maroc ? Ce qui fait le prix : puissance (kWc), toiture, batterie, marques, TVA — et pourquoi le vrai chiffre vient de votre facture."
  ogSlug="residentiel"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Prix des panneaux solaires au Maroc' }]} />

    <article class="mx-auto max-w-[68ch] px-4 pb-24 pt-12 sm:pb-28">
      <p class="tech-label v2-kicker rule-brass text-lune">Prix &amp; devis</p>
      <h1 class="display v2-page-title mt-5 text-white">Prix des panneaux solaires au Maroc</h1>

      <p class="guide-byline mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-lune-faint">
        <span>Page revue le {dateFmt.format(verifiedDate)} · par Reda Kasri</span>
      </p>

      <p class="v2-lead mt-6 text-lune-soft">
        « Combien ça coûte, vraiment ? » C'est la première question de presque tous nos rendez-vous.
        Cette page dit ce qui fait le prix d'une installation et comment lire une offre — sans
        recopier de fourchette dont nous ne pouvons pas montrer la source datée. Le prix de VOTRE
        installation sort d'une étude gratuite sur votre facture.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">Ce que couvre un prix clé-en-main</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Un prix clé-en-main couvre la fourniture du matériel <strong class="text-white">et</strong> la
        pose complète : panneaux, onduleur, structure, câblage, protections AC/DC, mise en service et,
        selon la puissance, la déclaration loi 82-21. Le total dépend d'abord de la
        <strong class="text-white">puissance (kWc)</strong> retenue sur votre consommation, puis du
        type de toiture, de la distance au tableau électrique, des marques posées et d'une batterie
        éventuelle. Un devis sur site reste indispensable.
      </p>
      <CtaLigne />

      <h2 class="display v2-section-title mt-12 text-white">Méfiez-vous d'un prix au kWc très bas</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Un prix au kWc qui paraît imbattable correspond souvent au <strong class="text-white">coût du
        kit équipement seul</strong> (panneaux + onduleur, hors pose, hors câblage, hors structure,
        hors raccordement) — pas à une installation terminée. Comparez deux offres ligne à ligne :
        notre page <a href="/devis-panneaux-solaires-maroc/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">lire et comparer deux devis</a>
        donne le tableau des inclusions.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">La toiture déplace le prix</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Une terrasse en béton avec accès facile reste la configuration la moins onéreuse. Une toiture
        en tuiles ou en tôle demande une pose plus technique, et une forte pente (au-delà de 30°)
        des dispositifs de sécurité : ces surcoûts apparaissent sur la ligne de pose de votre devis —
        voir aussi notre guide
        <a href="/guides/mon-toit-peut-il-supporter-des-panneaux/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">mon toit peut-il supporter des panneaux ?</a>
      </p>

      <h2 class="display v2-section-title mt-12 text-white">Le cas de la batterie : utile, mais pas neutre sur le coût</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Une installation <strong class="text-white">sans batterie</strong> (raccordée au réseau) reste
        la solution la plus courante pour la majorité des maisons urbaines. Une batterie LFP, pour
        stocker l'énergie de la soirée ou passer les coupures, ajoute un poste important au devis et
        allonge le temps de retour : elle ne se justifie que sur votre profil de consommation.
      </p>
      <p class="v2-lead mt-5 text-lune-soft">
        Notre guide <a href="/guides/quelle-taille-de-batterie/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">quelle taille de batterie ?</a> détaille les paliers de dimensionnement et pourquoi, au Maroc, stocker rapporte plus qu'exporter.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">TVA</h2>
      <p class="v2-lead mt-5 text-lune-soft">{PHRASE_TVA.fr}</p>

      <h2 class="display v2-section-title mt-12 text-white">Retour sur investissement</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Ce calcul dépend fortement de votre consommation
        réelle et de votre tranche tarifaire ONEE — voir notre page
        <a href="/financement/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">financement & rentabilité</a>
        pour le détail, et l'article
        <a href="/blog/rentabilite-solaire-par-ville-maroc/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">rentabilité par ville</a>
        pour les chiffres par région.
      </p>

      <h2 class="display v2-section-title mt-12 text-white">De combien de panneaux avez-vous besoin ?</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Avant de comparer les prix, il faut connaître la bonne puissance pour votre foyer. Un ménage
        consommant entre 4 000 et 6 000 kWh/an nécessite généralement 3 à 5 kWc ; entre 6 000 et
        10 000 kWh/an, plutôt 5 à 8 kWc. Notre guide dédié détaille la méthode complète :
        <a href="/guides/combien-de-panneaux-pour-ma-maison/" class="border-b border-azur-200/60 pb-0.5 font-semibold text-azur-200 transition-colors hover:text-white">combien de panneaux pour ma maison ?</a>
      </p>

      <h2 class="display v2-section-title mt-12 text-white">Un dernier mot avant de signer quoi que ce soit</h2>
      <p class="v2-lead mt-5 text-lune-soft">
        Aucune fourchette publique ne donne un prix ferme. La configuration de votre toiture, votre
        consommation, votre tranche ONEE et la distance entre les panneaux et le tableau électrique
        déplacent le total final. Le seul chiffre qui vaut pour votre maison sort d'une lecture de
        votre facture et d'une visite — gratuite et sans engagement.
      </p>
      <p class="v2-lead mt-3 text-xs text-lune-faint">
        Pour ce qui compose la facture en 2026 (matériel, pose, démarches), voir
        notre article <a href="/blog/prix-installation-solaire-maroc-2026/" class="border-b border-white/40 pb-0.5 font-semibold text-white transition-colors hover:border-white">Combien coûte une installation solaire au Maroc en 2026 ?</a>
      </p>

      <RelatedLinks links={[
        { href: '/résidentiel/', label: 'Nos solutions résidentielles' },
        { href: '/nos-solutions/', label: 'Toutes nos solutions' },
        { href: '/guides/', label: 'Tous les guides' },
        { href: '/blog/', label: 'Le blog' },
      ]} />
    </article>

    <!-- W297 — FAQ visuelle : schema={false}, /faq garde le seul FAQPage du site -->
    <Faq items={faq} heading="Prix des panneaux solaires — questions fréquentes" schema={false} />

    <CtaBand title="Le seul chiffre qui compte est le vôtre. Lancez l'étude gratuite." href="/devis/mon-toit/" />

    <StickyCta />
  </div>
</Layout>
