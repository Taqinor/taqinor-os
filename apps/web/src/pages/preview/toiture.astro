---
/**
 * PAGE PRIVÉE DE PRÉVISUALISATION — /preview/toiture (noindex, hors nav,
 * exclue du sitemap, non liée). Réservée à la revue mobile du fondateur AVANT
 * toute promotion.
 *
 * « Dessinez votre toit » : le visiteur cherche son adresse, trace le contour
 * de sa toiture sur une carte satellite, voit un calepinage de panneaux à
 * l'échelle, une puissance (kWc), une production annuelle (PVGIS, côté serveur)
 * et une fourchette d'économies — puis bascule vers le MÊME diagnostic/lead que
 * la production (DiagnosticFormEnriched → /api/preview-lead), pré-rempli.
 *
 * La carte (MapLibre) est LOURDE : elle est chargée PARESSEUSEMENT
 * (import() dynamique de src/scripts/roof-tool.ts) — aucune autre page ne la
 * télécharge. Sans clé MapTiler ou sans JS : repli gracieux, jamais de carte
 * cassée. Construite sur le design de production (.v2 + V2Enhance).
 */
import Layout from '../../layouts/Layout.astro';
import V2Enhance from '../../components/V2Enhance.astro';
import DiagnosticFormEnriched from '../../components/DiagnosticFormEnriched.astro';
import RoofPreviewShell from '../../components/RoofPreviewShell.astro';
import '../../styles/preview-toiture-map.css';
---

<Layout
  title="Prévisualisation privée — estimateur de toiture | Taqinor"
  description="Page de travail privée, non indexée."
  noindex={true}
>
  <div class="v2">
    <V2Enhance />

    <RoofPreviewShell
      p="rt"
      label="Prévisualisation privée · non publiée"
      h1Width="max-w-[18ch]"
      h1="Dessinez votre toit, voyez vos panneaux"
      mapLabel="Carte satellite pour tracer votre toiture"
      step2="Cliquez les coins ; double-cliquez (ou « Terminer ») pour fermer."
      step3Title="Votre potentiel"
      step3Text="Puissance, production et économies — puis l'étude sur WhatsApp."
      fallbackTitle="Outil momentanément indisponible"
    >
      <Fragment slot="lead">Cherchez votre adresse, tracez le contour de votre toiture sur la vue satellite, et
          l'outil y dépose des panneaux à l'échelle réelle : puissance, production annuelle et
          économies estimées — en quelques secondes. Le site et le formulaire en production restent
          inchangés.</Fragment>
      <Fragment slot="links">Estimation indicative, jamais un devis. <a href="#simulateur" class="text-brass-300 underline underline-offset-2 hover:text-brass-400">Vous préférez le diagnostic classique ?</a></Fragment>
      <Fragment slot="fallback">La carte interactive n'est pas accessible pour l'instant. Vous pouvez quand même obtenir
            votre étude — <a href="#simulateur" class="text-brass-300 underline underline-offset-2">passez par le diagnostic en 60 secondes</a>, on regarde votre toit ensemble sur WhatsApp.</Fragment>
      <Fragment slot="noscript">Cet outil nécessite JavaScript. <a href="#simulateur" class="text-brass-300 underline">Utilisez le diagnostic classique →</a></Fragment>
    </RoofPreviewShell>

    <DiagnosticFormEnriched heading="Recevez votre étude détaillée" />
  </div>
</Layout>

<script>
  import { startRoofPreview } from '../../lib/roofPreviewBoot';

  startRoofPreview('rt', () => import('../../scripts/roof-tool.ts'), 'initRoofTool');
</script>
