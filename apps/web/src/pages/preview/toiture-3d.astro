---
/**
 * PAGE PRIVÉE DE PRÉVISUALISATION — /preview/toiture-3d (noindex, hors nav,
 * exclue du sitemap, non liée). VARIANTE 3D de /preview/toiture, à comparer
 * côte à côte avec la version 2D : le fondateur garde celle qu'il préfère.
 *
 * Même parcours que la 2D — adresse → tracé satellite → MÊME estimation (kWc,
 * production PVGIS, économies) → MÊME diagnostic/lead pré-rempli
 * (DiagnosticFormEnriched → /api/preview-lead). SEULE différence : une fois le
 * toit fermé, la carte bascule en 3D et extrude le bâtiment + le toit + les
 * panneaux avec les couches `fill-extrusion` NATIVES de MapLibre (aucune
 * dépendance ajoutée, pas de Three.js) ; le visiteur peut faire pivoter/incliner.
 *
 * La carte (MapLibre) est LOURDE : chargée PARESSEUSEMENT (import() dynamique de
 * src/scripts/roof-tool-3d.ts) — aucune autre page ne la télécharge. Sans clé
 * MapTiler, sans WebGL ou sans JS : repli gracieux vers la 2D / le diagnostic,
 * jamais de carte cassée. Construite sur le design de production (.v2 + V2Enhance).
 */
import Layout from '../../layouts/Layout.astro';
import V2Enhance from '../../components/V2Enhance.astro';
import DiagnosticFormEnriched from '../../components/DiagnosticFormEnriched.astro';
import RoofPreviewShell from '../../components/RoofPreviewShell.astro';
import '../../styles/preview-toiture-map.css';
---

<Layout
  title="Prévisualisation privée — estimateur de toiture 3D | Taqinor"
  description="Page de travail privée, non indexée."
  noindex={true}
>
  <div class="v2">
    <V2Enhance />

    <RoofPreviewShell
      p="r3"
      label="Prévisualisation privée · version 3D · non publiée"
      h1Width="max-w-[20ch]"
      h1="Dessinez votre toit, voyez votre maison en 3D"
      mapLabel="Carte satellite 3D pour tracer votre toiture"
      step2="Cliquez les coins ; double-cliquez (ou « Terminer ») pour passer en 3D."
      step3Title="Faites-la pivoter"
      step3Text="Glissez pour tourner et incliner, voyez les panneaux sur votre toit."
      fallbackTitle="Vue 3D momentanément indisponible"
      pitchLabel="Toit en pente (villa)"
    >
      <Fragment slot="lead">Cherchez votre adresse, tracez le contour de votre toiture sur la vue satellite : l'outil
          relève alors votre bâtiment en 3D et y pose vos panneaux — vous le faites pivoter et
          l'inclinez du doigt. Puissance, production annuelle et économies estimées, comme la version
          classique. Le site et le formulaire en production restent inchangés.</Fragment>
      <Fragment slot="links">Estimation indicative, jamais un devis. <a href="/preview/toiture" class="text-brass-300 underline underline-offset-2 hover:text-brass-400">Comparer avec la version 2D</a> ·<a href="#simulateur" class="text-brass-300 underline underline-offset-2 hover:text-brass-400">le diagnostic classique</a>.</Fragment>
      <Fragment slot="fallback">La carte 3D n'est pas accessible sur cet appareil (carte graphique, clé ou JavaScript).
            Vous pouvez utiliser <a href="/preview/toiture" class="text-brass-300 underline underline-offset-2">la version 2D</a>,
            ou obtenir votre étude directement — <a href="#simulateur" class="text-brass-300 underline underline-offset-2">le diagnostic en 60 secondes</a>.</Fragment>
      <Fragment slot="noscript">Cet outil nécessite JavaScript. <a href="/preview/toiture" class="text-brass-300 underline">Version 2D</a> ·<a href="#simulateur" class="text-brass-300 underline">diagnostic classique →</a></Fragment>
      <Fragment slot="note">Vue 3D : volume approximatif (contour tracé + nombre d'étages + type de toit), pas un
              relevé exact de la maison. Les chiffres sont identiques à la version 2D.</Fragment>
    </RoofPreviewShell>

    <DiagnosticFormEnriched heading="Recevez votre étude détaillée" />
  </div>
</Layout>

<script>
  import { startRoofPreview } from '../../lib/roofPreviewBoot';

  startRoofPreview('r3', () => import('../../scripts/roof-tool-3d.ts'), 'initRoofTool3D');
</script>
