---
/**
 * Page publique — élévation « élégance retenue » : typographie éditoriale,
 * révélations au défilement, chiffres count-up, parallaxe d'en-tête (desktop)
 * + mouvement photo (Ken Burns d'en-tête, montée d'échelle au défilement).
 * Tout le mouvement est désactivé sous prefers-reduced-motion. Le diagnostic
 * et son flux de données restent inchangés (composant partagé DiagnosticForm).
 * Voir apps/web/DESIGN_RATIONALE.md.
 *
 * ÉLÉVATION (2026-06-22) — « bleu Majorelle élevé + âme marocaine, avec
 * discipline », sans rien remplacer : nuit profonde (#070b1d) + laiton, aucun
 * noir. CONTENU et chiffres VERBATIM (texte de loi, sanctions, dates). Rythme
 * via les tokens .section / .section-tight ; un seul langage de mouvement
 * (.cine-in / .v2-rise), tous gated prefers-reduced-motion, zéro CLS.
 * Discipline laiton : l'or ne reste que sur les CHIFFRES clés (« 18 mois » en
 * .lum, les numéros d'étapes en .lum) et le CTA principal « Démarrer sur
 * WhatsApp » ; les eyebrows brass sont rétrogradés en lune, et les disques
 * laiton pleins des étapes deviennent des numéros .lum dans un anneau azur.
 * Pas de photo de contenu → pas de .v3-grade. Le ZelligeDivider de l'acte final
 * reste l'unique marqueur zellige (aucune ZelligeSignature ajoutée). Le lien
 * WhatsApp pré-rempli (waFallback + script) est INCHANGÉ byte-for-byte : le
 * client n'édite jamais le message.
 */
import Layout from '../layouts/Layout.astro';
import V2Enhance from '../components/V2Enhance.astro';
import Article33Ribbon from '../components/Article33Ribbon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StickyCta from '../components/StickyCta.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { WHATSAPP_LEADS, NAP } from '../lib/nap';
import { whatsappLink, regularizationWhatsappText } from '../lib/whatsapp';

const waFallback = whatsappLink(WHATSAPP_LEADS, regularizationWhatsappText());

const steps = [
  { title: 'Inventaire technique', body: 'Relevé de l’installation existante : puissance installée, mode de raccordement, niveau de tension, équipements de protection et de comptage.' },
  { title: 'Détermination du régime', body: 'Selon la puissance et le raccordement, l’installation relève de la déclaration, de l’accord de raccordement ou de l’autorisation (décret 2-25-100).' },
  { title: 'Constitution du dossier', body: 'Fiches techniques, schéma unifilaire, attestations de conformité et formulaires du régime applicable — préparés par nos soins.' },
  { title: 'Dépôt de la demande de régularisation', body: 'Dépôt auprès du gestionnaire de réseau ou de l’autorité compétente, dans le délai prévu par l’Article 33.' },
  { title: 'Suivi jusqu’à la mise en conformité', body: 'Suivi de l’instruction, réponses aux compléments demandés, et le cas échéant mise à niveau technique de l’installation.' },
];

const sanctions = [
  { title: 'Situation irrégulière', body: 'Une installation existante non régularisée est en situation irrégulière au regard de la loi 82-21, désormais en vigueur.' },
];

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Régularisation Article 33 — installations solaires existantes',
  description: 'Le décret d’application 2-25-100 est en vigueur depuis le 9 juin 2026. L’Article 33 de la loi 82-21 prévoit un délai de 18 mois pour régulariser les installations solaires existantes ; à déposer sans attendre.',
  about: { '@type': 'Thing', name: 'Régularisation loi 82-21 — Article 33' },
  author: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  publisher: { '@type': 'Organization', name: NAP.name, url: NAP.url },
  mainEntityOfPage: url,
  dateModified: '2026-10-05',
};

// W290 — HowTo schema, en plus de l'Article ci-dessus : les 5 étapes déjà publiées dans `steps`.
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'La régularisation en 5 étapes — Article 33 de la loi 82-21',
  description: 'La procédure pas à pas pour régulariser une installation solaire existante au titre de l’Article 33 de la loi 82-21.',
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.body,
  })),
};
import RegularizationArticle33Ol7511 from '../components/blocs/RegularizationArticle33Ol7511.astro';
import RegularizationArticle33DivC937 from '../components/blocs/RegularizationArticle33DivC937.astro';
import Loi8221OuEnEstLaLoi from '..//components/blocs/Loi8221OuEnEstLaLoi.astro';
import RegularisationDossier from '../components/blocs/RegularisationDossier.astro';
---

<Layout
  title="Régularisation Article 33 — installations solaires existantes | Taqinor"
  description="Le décret d'application 2-25-100 est en vigueur depuis le 9 juin 2026. L'Article 33 de la loi 82-21 prévoit un délai de 18 mois pour régulariser les installations solaires existantes : procédure en 5 étapes et prise en charge complète du dossier."
  ogSlug="article-33"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToLd)} />
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Régularisation Article 33' }]} />

    <section class="section px-4 text-white">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">Loi 82-21 — Article 33</p>
        <h1 class="display v2-page-title cine-in cine-in-1 mt-5 max-w-3xl">Votre installation solaire existe déjà ? Régularisez-la maintenant.</h1>
        <p class="v2-lead cine-in cine-in-2 mt-6 max-w-xl text-white/85">
          Le décret d'application 2-25-100, publié au Bulletin Officiel le 9 mars 2026, est entré en
          vigueur le 9 juin 2026. La décision 04/26 de l'ANRE fixe le tarif d'excédent pour les
          installations raccordées en MT/HT/THT ; en basse tension, la revente du surplus n'est pas
          ouverte, même à 11 kW ou plus sous accord de raccordement. Le régime de la loi 82-21 vaut
          pour toutes les installations
                    d'autoproduction, jusqu'à celles montées bien avant le texte.
        </p>
      </div>
    </section>

    <!-- W259 — « Où en est la loi ? » : distingue LIVE (MT/HT) de PENDING (BT résidentiel). -->
    <div class="seam-soft" aria-hidden="true"></div>
    <section class="section mx-auto max-w-3xl px-4">
      <div class="v2-rise border-2 border-brass-400/50 bg-nuit-800/60 p-6 sm:p-8">
        <p class="tech-label v2-kicker text-brass-300">Où en est la loi ? · vérifié le 5 octobre 2026</p>
        {/* CIW413 — mêmes phrases tarifaires que CIW412 (décision ANRE 04/26 art. 6-7 ; décret
            2.25.100 art. 12 ; D-CIQ-4) : le tarif vise la TENSION, la basse tension n'est pas ouverte. */}
        <Loi8221OuEnEstLaLoi>
          <Fragment slot="vigueur">Le décret d'application <strong class="text-white">2-25-100</strong> (BO du 9 mars 2026, en
              vigueur depuis le 9 juin 2026) et la décision ANRE <strong class="text-white">04/26</strong>.
              Tarif d'excédent ANRE (décision 04/26) : <strong class="text-white">0,18 DH/kWh hors pointe,
              0,21 DH/kWh en pointe, hors taxes</strong>, pour les installations raccordées en
              <strong class="text-white"> moyenne, haute ou très haute tension (MT/HT/THT)</strong>,
              quel que soit leur régime.</Fragment>
          <Fragment slot="bt">En <strong class="text-white">basse tension (BT)</strong>, quel que soit le régime — y compris
              un commerce de 11 kW ou plus sous accord de raccordement — la revente du surplus n'est
              pas ouverte à ce jour. L'Article 33 se dépose sans attendre, indépendamment de ce tarif.</Fragment>
        </Loi8221OuEnEstLaLoi>
      </div>
    </section>

    <section class="section mx-auto max-w-3xl px-4">
      <div class="v2-rise">
        <p class="tech-label v2-kicker rule-brass text-lune">Le texte</p>
        <h2 class="display v2-section-title mt-4 text-white">Ce que dit l'Article 33</h2>
        <p class="v2-lead mt-5 text-lune-soft">
          L'Article 33 de la loi 82-21 dispose que les installations existantes doivent être
          régularisées « dans un délai de dix-huit (18) mois à compter de la date d'entrée en vigueur
          de la présente loi » (loi 82-21, art. 33), soit <strong class="fig lum text-xl">18 mois</strong>.
          Le point de départ de ce délai est à confirmer auprès des services de l'énergie : déposez
          sans attendre. Une fois le dossier régularisé, l'installation est en règle au regard de la
          loi ; sans cette démarche, elle reste en situation irrégulière.
        </p>
      </div>

      <h2 class="display v2-section-title v2-rise mt-14 text-white">Qui est concerné ?</h2>
      {/* Losanges au trait rétrogradés en azur (l'or reste aux chiffres/CTA) */}
      <ul class="v2-rise mt-5 space-y-2.5 text-sm leading-relaxed text-lune-soft">
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>Toute installation solaire d'autoproduction mise en service avant l'entrée en vigueur du régime — villa, hangar, hôtel, exploitation agricole.</span></li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>Raccordée au réseau ou en site isolé, quelle que soit la puissance.</span></li>
        <li class="flex gap-2.5"><span class="mt-1.5 inline-block h-1.5 w-1.5 flex-none rotate-45 border border-azur-200/70" aria-hidden="true"></span><span>Sans déclaration, sans accord de raccordement ou sans autorisation au regard du régime applicable.</span></li>
      </ul>

      <h2 class="display v2-section-title v2-rise mt-14 text-white">La régularisation en 5 étapes</h2>
      {/* Rail de timeline rétrogradé en filet blanc ; numéros d'étape en .lum
          (l'or reste sur les chiffres clés) dans un anneau azur, plus de disque
          laiton plein répété. */}
      <RegularizationArticle33Ol7511 steps={steps} />

      <h2 class="display v2-section-title v2-rise mt-14 text-white">Le statut d’une installation non régularisée</h2>
      <p class="v2-rise mt-2 text-sm text-lune-soft">Au regard de la loi 82-21 :</p>
      <RegularizationArticle33DivC937 sanctions={sanctions} />

      <RelatedLinks mt="mt-8" links={[
        { href: '/loi-82-21/', label: 'Les 3 régimes de la loi 82-21' },
        { href: '/guides/loi-82-21-expliquee/', label: 'Loi 82-21 expliquée simplement' },
        { href: '/résidentiel/', label: "Régularisation d'une villa ou d'un appartement" },
        { href: '/professionnel/', label: "Régularisation d'un site professionnel" },
      ]} />
    </section>

    <!-- ACTE FINAL — le dossier se confie en pleine lumière -->
    <RegularisationDossier kicker="Prise en charge complète" titre="Confiez-nous le dossier" intro="Deux questions, et votre message WhatsApp part déjà complet — nous identifions le régime applicable et constituons le dossier." kwcLabel="Puissance approximative (kWc)" kwcPlaceholder="ex. 5" inconnu="Je ne connais pas la puissance" villeLabel="Ville de l'installation" villePlaceholder="ex. Casablanca" cta="Démarrer sur WhatsApp" waFallback={waFallback} />

    <StickyCta />
  </div>
</Layout>
