---
/**
 * WAUD25 — page 404 de la marque, dans la langue de l'URL demandée (préfixe /en, /ar).
 * SSR : la langue se lit sur l'URL réellement demandée, et le statut reste 404.
 * Trois sorties : le tunnel, WhatsApp, et l'accueil (le menu complet vit dans Layout).
 */
import Layout from '../layouts/Layout.astro';
import { getLocaleFromPath, useTranslations } from '../i18n/utils';
import { localizeNavHref, quoteJourneyHref } from '../i18n/pages';
import type { Locale } from '../i18n/config';
import { WHATSAPP_LEADS } from '../lib/nap';
import { whatsappLink } from '../lib/whatsapp';

export const prerender = false;

Astro.response.status = 404;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const TEXTES: Record<Locale, { title: string; h1: string; lead: string; home: string; wa: string; proof: string }> = {
  fr: {
    title: 'Page introuvable | Taqinor',
    h1: 'Cette page n’existe pas ou a changé d’adresse.',
    lead: 'Le plus simple : demandez votre étude gratuite, ou écrivez-nous sur WhatsApp.',
    home: 'Retour à l’accueil',
    wa: 'Nous écrire sur WhatsApp',
    proof: 'Voir nos réalisations',
  },
  en: {
    title: 'Page not found | Taqinor',
    h1: 'This page does not exist or has moved.',
    lead: 'The simplest way forward: request your free study, or message us on WhatsApp.',
    home: 'Back to the home page',
    wa: 'Message us on WhatsApp',
    proof: 'See our installations',
  },
  ar: {
    title: 'الصفحة غير موجودة | Taqinor',
    h1: 'هذه الصفحة غير موجودة أو تغيّر عنوانها.',
    lead: 'الأبسط: اطلبوا دراستكم المجانية، أو راسلونا عبر واتساب.',
    home: 'العودة إلى الصفحة الرئيسية',
    wa: 'راسلونا عبر واتساب',
    proof: 'شاهدوا إنجازاتنا',
  },
};
const s = TEXTES[locale] ?? TEXTES.fr;
const wa = whatsappLink(WHATSAPP_LEADS, 'Bonjour, je n’ai pas trouvé une page sur taqinor.ma et je souhaite une étude.');
---

<Layout title={s.title} description={s.lead} noindex locales={[locale]}>
  <section class="mx-auto max-w-3xl bg-blanc-azur px-5 py-20 text-encre">
    <p class="tech-label text-encre-soft">404</p>
    <h1 class="mt-3 text-3xl font-semibold text-encre">{s.h1}</h1>
    <p class="mt-4 text-encre-soft">{s.lead}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a data-sortie-404 href={quoteJourneyHref(locale)} class="inline-flex items-center bg-brass-400 px-5 py-3 font-bold text-azur-950 hover:bg-brass-300">{t('cta.primary')}</a>
      <a data-sortie-404 href={wa} class="inline-flex items-center border border-azur-900/25 px-5 py-3 font-semibold text-encre hover:border-brass-400">{s.wa}</a>
      <a data-sortie-404 href={localizeNavHref('/realisations', locale)} class="inline-flex items-center border border-azur-900/25 px-5 py-3 font-semibold text-encre hover:border-brass-400">{s.proof}</a>
      <a data-sortie-404 href={localizeNavHref('/', locale)} class="inline-flex items-center border border-azur-900/25 px-5 py-3 font-semibold text-encre hover:border-brass-400">{s.home}</a>
    </div>
  </section>
</Layout>
