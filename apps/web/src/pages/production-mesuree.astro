---
/**
 * Production mesurée (W354) — page publique INDEXÉE de transparence continue.
 *
 * INTÉGRITÉ (règle du WEB_PLAN) : chaque chiffre est DÉRIVÉ, en direct dans ce
 * fichier, de `realisations.ts` (lecture seule — jamais modifié ici). Aucune
 * valeur n'est saisie à la main :
 *  - production cumulée = `MEASURED_FLEET_LIFETIME_MWH`, le cumul mesuré de la
 *    flotte réellement suivie en production (jamais estimé, jamais compté
 *    comme zéro) ;
 *  - la date affichée est `FACTS_GENERATED_AT` (facts.ts, W380) — le même
 *    horodatage que l'agrégat de faits canoniques, pour que "mesuré au [date]"
 *    reste cohérent d'une page à l'autre.
 *
 * (2026-07-05, founder) : le kWc cumulé installé n'est plus mis en avant nulle
 * part sur le site — la page mène désormais par la production MESURÉE.
 *
 * Différence avec `/impact-taqinor` (W279, déjà en ligne) : cette page-ci est
 * un compteur roulant à vocation de suivi (production + nombre de chantiers
 * suivis, cadence de rafraîchissement WG7), pas un bilan CO2/arbres — les deux
 * pages coexistent sans se dupliquer.
 *
 * NOTE (hors périmètre de cette tâche) : cette page n'est PAS encore liée
 * depuis d'autres pages ni enregistrée dans `src/i18n/pages.ts` — l'orchestrateur
 * fera ce câblage dans une passe séparée.
 */
import PourAllerPlusLoin from '../components/blocs/PourAllerPlusLoin.astro';
import LienRealisationsBilan from '../components/blocs/LienRealisationsBilan.astro';
import LigneMateriel from '../components/blocs/LigneMateriel.astro';
import Layout from '../layouts/Layout.astro';
import { impactFigures } from '../lib/impactFigures';
import V2Enhance from '../components/V2Enhance.astro';
import Article33Ribbon from '../components/Article33Ribbon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import KeyFigure from '../components/KeyFigure.astro';
import Callout from '../components/Callout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CtaBand from '../components/CtaBand.astro';
import StickyCta from '../components/StickyCta.astro';
import { REALISATIONS } from '../lib/realisations';
import { MEASURED_FLEET_READ_AT } from '../lib/realisations';

// ── Chiffres dérivés — AUCUNE valeur saisie à la main ────────────────────────
// RULE B (2026-07-04) : le nombre brut d'installations n'est plus mis en
// avant en copie utilisateur (h2, dénominateurs) — la page mène par le kWh
// mesuré (partiellement supersède W354).
// (2026-07-05, founder) : le kWc cumulé installé est retiré (plus affiché
// nulle part sur le site) — la page mène désormais par la production MESURÉE.

// WB1 (2026-07-04) : la production ANNUELLE par installation a été retirée
// (fabriquée — même facteur impossible sur plusieurs sites). Le seul chiffre
// de production réel est le CUMUL mesuré de la flotte suivie
// (MEASURED_FLEET, realisations.ts) — cumul « depuis la mise en service »,
// JAMAIS annualisé.
const { productionTotal, productionTotalLabel, generatedDateLabel } = impactFigures('fr-FR');


const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Production solaire suivie — parc Taqinor',
  description: `Cumul de production mesuré sur la flotte suivie, arrêté au ${generatedDateLabel} : ${productionTotalLabel} kWh cumulés.`,
  temporalCoverage: MEASURED_FLEET_READ_AT ?? undefined,
  creator: { '@type': 'Organization', name: 'Taqinor', url: 'https://taqinor.ma' },
};
---

<Layout
  title="Production solaire suivie — le cumul réel de notre parc | Taqinor"
  description={`${productionTotalLabel} kWh cumulés sur la flotte suivie, cumul arrêté au ${generatedDateLabel} — rien d'arrondi, rien de gonflé.`}
  ogSlug="equipement"
>
  <div class="v2">
    <V2Enhance />
    <Article33Ribbon />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Production mesurée' }]} />

    <section class="section-lg px-4 pb-10 text-white">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass cine-in text-lune">Transparence continue</p>
        <h1 class="display v2-page-title cine-in cine-in-1 mt-6">Production suivie</h1>
        <p class="v2-lead cine-in cine-in-2 mt-6 max-w-xl text-white/85">
          Pas une brochure : un compteur qui roule. Ce que la flotte suivie a
          réellement produit depuis sa mise en service, en cumul — arrêté au{' '}
          <strong class="text-white">{generatedDateLabel}</strong>.
        </p>
      </div>
    </section>

    <!-- Chiffres clés — dérivés en direct de realisations.ts -->
    <section class="section px-4">
      <div class="mx-auto max-w-6xl">
        <p class="tech-label v2-kicker rule-brass text-lune">Cumul mesuré au {generatedDateLabel}</p>
        <h2 class="display v2-section-title mt-5 text-white">{productionTotalLabel} kWh, un seul compteur</h2>
        <div class="mt-10 grid gap-6" data-stagger>
          <KeyFigure value={productionTotalLabel} unit="kWh cumulés" label="Production suivie">
            Cumul relevé sur la flotte suivie depuis la mise en service — jamais
            annualisé.
          </KeyFigure>
        </div>
        <Callout type="info" title="Comment ce chiffre est mis à jour">
          <p>
            Ce cumul est recalculé à chaque export de suivi republié (cadence indicative : à
            chaque nouveau chantier suivi ajouté à la flotte). La date ci-dessus est celle du
            dernier arrêté — jamais une moyenne glissante, jamais une projection. Le cumul mesuré
            est relevé par notre supervision de production, recalculé à chaque nouveau
            chantier documenté.
          </p>
        </Callout>
      </div>
    </section>

    <!-- Le détail, chantier par chantier -->
    <div class="v2-seam" aria-hidden="true"></div>
    <section class="section bg-blanc-azur px-4 text-encre">
      <div class="mx-auto max-w-3xl">
        <p class="tech-label v2-kicker rule-brass text-azur-600">Le détail</p>
        <h2 class="display v2-section-title mt-5">Chantier par chantier</h2>
        <p class="v2-lead mt-4 text-encre-soft">
          Chaque ligne correspond à une installation réelle, documentée sur notre page
          réalisations.
        </p>
        <div class="mt-10 border-t-2 border-azur-900 bg-blanc" data-stagger>
          {REALISATIONS.map((r, i) => (
            <LigneMateriel r={r} i={i} titre={[r.ville, r.kwc, `réf. ${r.ref}`, r.date].filter(Boolean).join(' · ')} />
          ))}
        </div>
        <LienRealisationsBilan />
      </div>
    </section>

    <PourAllerPlusLoin links={[
          { href: '/realisations/', label: 'Nos réalisations' },
          { href: '/impact-taqinor/', label: 'Impact Taqinor (CO2 évité)' },
          { href: '/ensoleillement-maroc/', label: 'Productible solaire par ville' },
          { href: '/maintenance-monitoring/', label: 'Maintenance & monitoring' },
        ]} />

    <CtaBand title="Un projet qui pourrait s'ajouter à ce compteur ? Lancez le diagnostic gratuit." href="/devis/mon-toit/" />

    <StickyCta />
  </div>
</Layout>
