---
/**
 * ENF19 — coque commune des pages privées /preview/toiture, /preview/toiture-3d et
 * /preview/toiture-3d-pro : bandeau de revue, mode d'emploi, repli, formulaire d'adresse,
 * carte, barre de tracé, résultats. Les ids/classes dérivent du préfixe `p`
 * (rt / r3 / rp) ; tout le texte propre à une variante arrive en props ou en slots.
 * Le diagnostic/lead (DiagnosticFormEnriched) reste dans chaque page, hors coque.
 */
import Toiture3dProOption4857 from './blocs/Toiture3dProOption4857.astro';
import Toiture3dProButtonC44A from './blocs/Toiture3dProButtonC44A.astro';
import Toiture3dProOption3967 from './blocs/Toiture3dProOption3967.astro';

const {
  p,
  label,
  h1,
  h1Width,
  mapLabel,
  step2,
  step3Title,
  step3Text,
  fallbackTitle,
  pitchLabel,
} = Astro.props as Record<string, any>;

const inputClass =
  'w-full border border-white/15 bg-white/5 px-3 py-3 text-base text-white placeholder:text-lune-faint outline-none transition-colors focus:border-brass-400 focus:ring-2 focus:ring-brass-400/30';
---

<section class="border-b border-white/10 bg-nuit-800 px-4 py-14 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="tech-label rule-brass text-brass-300">{label}</p>
    <h1 class={`display v2-page-title mt-5 ${h1Width} text-white`}>
      {h1}
    </h1>
    <p class="v2-lead mt-6 max-w-2xl text-lune-soft">
      <slot name="lead" />
    </p>
    <p class="mt-4 text-sm text-lune-faint">
      <slot name="links" />
    </p>
  </div>
</section>

<section class="bg-nuit px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <ol class="mb-10 grid gap-4 sm:grid-cols-3">
      <li class="border-l-2 border-brass-400/60 pl-4 text-sm text-lune-soft">
        <span class="tech-label block text-brass-300">Étape 1</span>
        <strong class="mt-1 block text-white">Votre adresse</strong>
        La carte zoome sur votre maison en vue satellite.
      </li>
      <li class="border-l-2 border-brass-400/60 pl-4 text-sm text-lune-soft">
        <span class="tech-label block text-brass-300">Étape 2</span>
        <strong class="mt-1 block text-white">Tracez le toit</strong>
        {step2}
      </li>
      <li class="border-l-2 border-brass-400/60 pl-4 text-sm text-lune-soft">
        <span class="tech-label block text-brass-300">Étape 3</span>
        <strong class="mt-1 block text-white">{step3Title}</strong>
        {step3Text}
      </li>
    </ol>

    <div id={`${p}-fallback`} hidden class="cine-card mb-8 border-l-4 border-alert-300 p-6">
      <p class="font-semibold text-white">{fallbackTitle}</p>
      <p class="mt-2 text-sm text-lune-soft">
        <slot name="fallback" />
      </p>
    </div>

    <div id={`${p}-stage`} class="grid gap-6 lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div class="cine-card overflow-hidden">
        <form id={`${p}-search`} class="flex flex-col gap-3 border-b border-white/10 p-4 sm:flex-row">
          <label for={`${p}-address`} class="sr-only">Votre adresse</label>
          <input id={`${p}-address`} name="address" type="text" autocomplete="street-address"
            placeholder="Adresse, quartier ou ville (ex. Casablanca, Maârif)" class={inputClass} />
          <Toiture3dProButtonC44A />
        </form>

        <div id={`${p}-map`} class={`${p}-map`} role="application" aria-label={mapLabel}>
          <div id={`${p}-map-placeholder`} class={`${p}-map-placeholder`}>
            <p class="text-sm text-lune-soft">
              Saisissez votre adresse ci-dessus pour afficher la vue satellite, ou
            </p>
            <button type="button" id={`${p}-open`}
              class="mt-3 border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
              ouvrir la carte sans adresse
            </button>
            <noscript>
              <p class="mt-3 text-sm text-lune-faint">
                <slot name="noscript" />
              </p>
            </noscript>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-white/10 p-4">
          <button type="button" id={`${p}-finish`} disabled
            class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brass-400 hover:text-brass-300 disabled:cursor-not-allowed disabled:opacity-40">
            Terminer le tracé
          </button>
          <button type="button" id={`${p}-clear`}
            class="border border-white/25 px-4 py-2.5 text-sm font-semibold text-lune-soft transition-colors hover:border-white/50 hover:text-white">
            Effacer
          </button>
          <div class="ml-auto flex items-center gap-2">
            <label for={`${p}-orient`} class="text-sm text-lune-soft">Orientation</label>
            <select id={`${p}-orient`} class="border border-white/15 bg-nuit-700 px-3 py-2 text-sm text-white outline-none focus:border-brass-400">
              <Toiture3dProOption4857 />
            </select>
          </div>
        </div>

        {pitchLabel && (
          <div id={`${p}-build-controls`} hidden class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 bg-nuit-800 p-4">
            <div class="flex items-center gap-2">
              <label for={`${p}-floors`} class="text-sm text-lune-soft">Étages</label>
              <select id={`${p}-floors`} class="border border-white/15 bg-nuit-700 px-3 py-2 text-sm text-white outline-none focus:border-brass-400">
                <Toiture3dProOption3967 />
              </select>
            </div>
            <label class="flex items-center gap-2 text-sm text-lune-soft">
              <input type="checkbox" id={`${p}-pitch`} class="accent-brass-400" />
              {pitchLabel}
            </label>
            <span class="ml-auto text-xs text-lune-faint">Glissez pour pivoter · molette/pincez pour zoomer</span>
          </div>
        )}

        <p id={`${p}-status`} class="border-t border-white/10 px-4 py-3 text-sm text-lune-faint" aria-live="polite">
          Cherchez votre adresse pour commencer.
        </p>
      </div>

      <div id={`${p}-results`} class={`${p}-results cine-card p-6`}>
        <p class="tech-label rule-brass text-brass-300">Votre potentiel solaire</p>
        <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-7">
          <div>
            <dd id={`${p}-res-kwc`} class="fig text-3xl text-brass-300 sm:text-4xl">—</dd>
            <dt class="tech-label mt-2 text-lune-faint">Puissance</dt>
          </div>
          <div>
            <dd id={`${p}-res-panels`} class="fig text-3xl text-white sm:text-4xl">—</dd>
            <dt class="tech-label mt-2 text-lune-faint">Panneaux</dt>
          </div>
          <div>
            <dd id={`${p}-res-area`} class="fig text-3xl text-white sm:text-4xl">—</dd>
            <dt class="tech-label mt-2 text-lune-faint">Surface tracée</dt>
          </div>
          <div>
            <dd id={`${p}-res-prod`} class="fig text-2xl text-white sm:text-3xl">—</dd>
            <dt class="tech-label mt-2 text-lune-faint">Production estimée</dt>
          </div>
        </dl>
        <div class="mt-7 border-t border-white/10 pt-6">
          <dd id={`${p}-res-savings`} class="fig text-2xl text-brass-300 sm:text-3xl">—</dd>
          <dt class="tech-label mt-2 text-lune-faint">Économies estimées</dt>
        </div>
        <p id={`${p}-res-note`} class="mt-6 text-xs leading-relaxed text-lune-faint">
          Tracez votre toit pour découvrir votre potentiel solaire.
        </p>
        {Astro.slots.has('note') && (
          <p class="mt-3 text-xs leading-relaxed text-lune-faint/80">
            <slot name="note" />
          </p>
        )}
        <button type="button" id={`${p}-cta`} hidden
          class="mt-6 inline-flex w-full items-center justify-center gap-2 bg-ok-600 px-6 py-4 text-base font-bold text-white transition-opacity hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.3 1.4Z"/></svg>
          Recevoir mon étude sur WhatsApp
        </button>
      </div>
    </div>
  </div>
</section>
