---
// Groupe de fiches (titre de catégorie + grille de cartes) partagé par /produits (FR) et
// FichesIndexLocale (EN/AR) : le balisage commun n'existe qu'ici (anti-duplicata littéral).
interface Props { titre: string }
const { titre } = Astro.props;
---
<section class="mx-auto max-w-6xl px-4 pb-4">
  <h2 class="tech-label mb-5 text-brass-300">{titre}</h2>
  <div class="grid gap-6 pb-10 md:grid-cols-2 lg:grid-cols-3" data-stagger>
    <slot />
  </div>
</section>
