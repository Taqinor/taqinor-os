---
/**
 * WB33 — Pixel Meta NAVIGATEUR (fbq), le pendant client du relais CAPI serveur.
 *
 * LE CONSTAT (audit Meta lecture seule du 2026-07-24, docs/engine/audit-2026-07.md §8) :
 * le dataset « leads » (845710231783646) existe depuis janvier et n'a JAMAIS émis
 * un seul événement — il n'était installé nulle part. Conséquence : Meta ne peut
 * ni optimiser une campagne « site » sur l'événement Lead, ni construire
 * d'audiences de visiteurs. Ce composant l'installe sitewide.
 *
 * CONSENTEMENT — WAUD12 (D-WAUD-1 = opt-in strict, CNDP D-939-2025 §6) : RIEN
 * avant « Accepter » (`tq_consent` = 'granted'), ni fbevents.js, ni cookie, ni
 * événement. L'amorce fbq n'est qu'une file locale : `consent revoke` puis `init`.
 * Au grant (au chargement si déjà accepté, ou `tq:consent-change` sur la page) :
 * `consent grant`, PageView, événements en attente (avec leur eventId), puis
 * fbevents.js injecté après l'affichage (load + requestIdleCallback). Un refus
 * vide la file d'attente et révoque. Le visiteur qui accepte a donc toujours son
 * pixel, y compris s'il accepte plus tard depuis « Gérer mes cookies ».
 * Effet connu (dit à Reda) : PageView part 1-3 s plus tard ; audiences de
 * reciblage réduites aux « Accepter ».
 *
 * DÉDUPLICATION — l'événement `Lead` navigateur est émis par les pages du tunnel
 * via `window.tqPixelTrack('Lead', {}, eventId)` avec le MÊME `eventId` (WJ92)
 * que le corps du lead envoyé au CRM et au relais CAPI : Meta fusionne les deux
 * signaux (browser + server) au lieu de compter double.
 *
 * L'ID du pixel n'est pas un secret (il est visible dans toute page qui
 * l'embarque) : constante avec surcharge d'env (PUBLIC_META_PIXEL_ID).
 */
const pixelId = ((import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined) ?? '845710231783646').trim();
---

{pixelId && (
  <script is:inline define:vars={{ tqPixelId: pixelId }}>
    (function () {
      var lireChoix = function () {
        try {
          return localStorage.getItem('tq_consent');
        } catch (e) {
          return null;
        }
      };
      /* Amorce fbq officielle Meta (file locale) ; le chargement de fbevents.js est séparé. */
      !(function (f, n) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
      })(window);
      var charge = false;
      var charger = function () {
        if (charge) return;
        charge = true;
        var t = document.createElement('script');
        t.async = true;
        t.src = 'https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(t);
      };
      /* Après l'affichage : événement load, puis temps libre du navigateur. */
      var apresAffichage = function () {
        var libre = function () {
          if (window.requestIdleCallback) window.requestIdleCallback(charger, { timeout: 3000 });
          else setTimeout(charger, 1500);
        };
        if (document.readyState === 'complete') libre();
        else window.addEventListener('load', libre, { once: true });
      };
      var accorde = false;
      var pageVueEnvoyee = false;
      var enAttente = [];
      var suivre = function (a) {
        window.fbq('track', a[0], a[1] || {}, a[2] ? { eventID: a[2] } : undefined);
      };
      var demarrer = function () {
        if (accorde) return;
        accorde = true;
        window.fbq('consent', 'grant');
        if (!pageVueEnvoyee) {
          pageVueEnvoyee = true;
          window.fbq('track', 'PageView');
        }
        enAttente.splice(0).forEach(suivre);
        apresAffichage();
      };
      /* Consentement révoqué AVANT init : aucun cookie jusqu'au grant. */
      window.fbq('consent', 'revoke');
      window.fbq('init', tqPixelId);
      if (lireChoix() === 'granted') demarrer();
      window.addEventListener('tq:consent-change', function (e) {
        var choix = e && e.detail && e.detail.value;
        if (choix === 'granted') demarrer();
        if (choix === 'denied') {
          accorde = false;
          enAttente = [];
          try { window.fbq('consent', 'revoke'); } catch (err) {}
        }
      });
      /* Pont pour les pages (tunnel /devis/mon-toit) : gardé jusqu'au choix, no-op si refusé. */
      window.tqPixelTrack = function (event, params, eventId) {
        try {
          if (lireChoix() === 'denied') return;
          if (accorde) suivre([event, params, eventId]);
          else enAttente.push([event, params, eventId]);
        } catch (err) {}
      };
    })();
  </script>
)}
