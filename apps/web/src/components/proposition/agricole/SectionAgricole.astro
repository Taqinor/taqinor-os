---
/**
 * CPRW (27/10/2026) — déplacement PUR depuis pages/proposition/[...token].astro : la section « Votre pompage solaire » (WJ126/AGW301-304), sa condition d'affichage reste dans la page.
 * Le balisage est recopié à l'identique (mêmes attributs, mêmes textes FR/EN/AR) ; la page ne garde
 * qu'un appel de composant. Les valeurs arrivent par props sous LEURS noms de la page.
 */
import { AGR_ARGENT_LBL, AGR_COMPOSANT_LBL, AGR_LBL, AGR_MOIS_LONG, MONTHS_SHORT, confirmationOption, etatActivationOption, formatMAD, formatMADCentimes, formatNumber, libelleEntree, phraseProvenance } from '../../../lib/proposition';
import { AGR_LBL_AGQ, valeurProvenance } from '../../../lib/propositionAgricole';
import type { SyntheseAgricole, SyntheseAgricoleArgent } from '../../../lib/proposition';

// Déplacement pur : les props gardent leurs noms de la page ; celles que le balisage parcourt
// (listes) sont typées comme dans la page, les autres restent ouvertes (`any`).
interface Props {
  aConfirmerLbl: any;
  agri: any;
  apercuInterne: any;
  argent: SyntheseAgricoleArgent | null;
  argentNotes: any;
  bvl: SyntheseAgricole['besoinVsLivre'] | null;
  bvlMax: any;
  courbeGeo: any;
  energieLbl: any;
  energiePhrase: any;
  heuresAgri: any;
  moisSousToleranceTexte: any;
  motifCourbe: any;
  nonInclusLbl: any;
  offerState: any;
  plaqueTexte: any;
  remplacement: any;
  synth: SyntheseAgricole | null;
  token: any;
}
const { aConfirmerLbl, agri, apercuInterne, argent, argentNotes, bvl, bvlMax, courbeGeo, energieLbl, energiePhrase, heuresAgri, moisSousToleranceTexte, motifCourbe, nonInclusLbl, offerState, plaqueTexte, remplacement, synth, token } = Astro.props;
---
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="mode-agricole">
          <h2 class="tech-label rule-brass text-brass-300" data-i18n data-fr="Votre pompage solaire" data-en="Your solar pumping" data-ar="ضخّكم الشمسي">Votre pompage solaire</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {(agri.pompe_cv || agri.pompe_kw) ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Pompe" data-en="Pump" data-ar="المضخة">Pompe</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">
                  {agri.pompe_cv ? <>{formatNumber(agri.pompe_cv, 1)} <span class="text-base text-lune-soft">CV</span></> : null}
                  {agri.pompe_cv && agri.pompe_kw ? <span class="text-lune-faint"> · </span> : null}
                  {agri.pompe_kw ? <>{formatNumber(agri.pompe_kw, 1)} <span class="text-base text-lune-soft">kW</span></> : null}
                </p>
              </div>
            ) : null}
            {agri.m3_jour ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Eau / jour" data-en="Water / day" data-ar="الماء / يوم">Eau / jour</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(agri.m3_jour)} <span class="text-base text-lune-soft">m³</span></p>
                {agri.hmt_m ? (
                  <p class="mt-1 text-sm text-lune-faint" dir="ltr" data-i18n
                    data-fr={`à ${formatNumber(agri.hmt_m)} m HMT`}
                    data-en={`at ${formatNumber(agri.hmt_m)} m head`}
                    data-ar={`عند ${formatNumber(agri.hmt_m)} m (ع.ر.)`}>à {formatNumber(agri.hmt_m)} m HMT</p>
                ) : null}
                {heuresAgri ? (
                  <p class="mt-1 text-xs text-lune-faint" dir="ltr" data-i18n data-agri-heures-pompage
                    data-fr={heuresAgri.fr}
                    data-en={heuresAgri.en}
                    data-ar={heuresAgri.ar}>{heuresAgri.fr}</p>
                ) : null}
              </div>
            ) : null}
            {agri.champ_kwc ? (
              <div class="cine-card rounded-xl p-5">
                <p class="tech-label text-lune-faint" data-i18n data-fr="Champ solaire" data-en="Solar array" data-ar="الحقل الشمسي">Champ solaire</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(agri.champ_kwc, 2)} <span class="text-base text-lune-soft">kWc</span></p>
              </div>
            ) : null}
            {bvl && bvl.hectaresIrrigables !== null ? (
              <div class="cine-card rounded-xl p-5" data-agri-hectares>
                <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.surfaceIrrigable.fr} data-en={AGR_LBL.surfaceIrrigable.en} data-ar={AGR_LBL.surfaceIrrigable.ar}>{AGR_LBL.surfaceIrrigable.fr}</p>
                <p class="fig mt-2 text-2xl text-lune" dir="ltr">{formatNumber(bvl.hectaresIrrigables, 1)} <span class="text-base text-lune-soft">ha</span></p>
              </div>
            ) : null}
          </div>
          {/* Honnêteté : aucun KPI pompe exploitable → message d'omission clair. */}
          {(!agri.pompe_cv && !agri.pompe_kw && !agri.m3_jour && !agri.champ_kwc) ? (
            <p class="mt-4 text-sm text-lune-faint" data-i18n
              data-fr="Le dimensionnement précis de votre pompe est confirmé avec votre conseiller."
              data-en="The precise sizing of your pump is confirmed with your advisor."
              data-ar="يُحدَّد تحجيم مضختكم الدقيق مع مستشاركم.">Le dimensionnement précis de votre pompe est confirmé avec votre conseiller.</p>
          ) : null}
          {agri.debit_hmt_m3h ? (
            <p class="mt-4 text-sm text-lune-soft" data-i18n
              data-fr={`Débit estimé ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h à la hauteur de refoulement retenue.`}
              data-en={`Estimated flow ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h at the selected head.`}
              data-ar={`التدفق المقدّر ≈ ${formatNumber(agri.debit_hmt_m3h)} m³/h عند ارتفاع الرفع المعتمد.`}>Débit estimé ≈ {formatNumber(agri.debit_hmt_m3h)} m³/h à la hauteur de refoulement retenue.</p>
          ) : null}

          {/* ── AGW303 — la synthèse agricole SERVIE (`synthese_agricole`, la MÊME fonction
              que le PDF — AGR304/AGR308) : la page LIT, elle ne calcule rien. Chaque bloc
              est OMIS quand le serveur ne le sert pas (jamais un zéro, jamais un graphe
              vide). ─────────────────────────────────────────────────────────────── */}

          {/* Besoin vs eau livrée, mois par mois (12 barres doubles) + mois le plus serré. */}
          {bvl && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-besoin-livre>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.titreBesoinLivre.fr} data-en={AGR_LBL.titreBesoinLivre.en} data-ar={AGR_LBL.titreBesoinLivre.ar}>{AGR_LBL.titreBesoinLivre.fr}</p>
              <div class="mt-4 flex items-end gap-1.5" dir="ltr" role="img"
                aria-label="Besoin et eau livrée par jour, mois par mois" data-aria-label-fr="Besoin et eau livrée par jour, mois par mois" data-aria-label-en="Water need and water delivered per day, month by month" data-aria-label-ar="الحاجة والماء المُوفَّر يومياً، شهراً بشهر">
                {bvl.mois.map((m, i) => (
                  <div class="flex flex-1 flex-col items-center gap-1">
                    <div class="flex w-full items-end gap-px">
                      <span class="w-1/2 rounded-t" data-barre="besoin" style={`height:${Math.max(3, Math.round((m.besoin / bvlMax) * 72))}px; background: var(--color-lune-faint, #9ca3af)`}></span>
                      <span class="w-1/2 rounded-t" data-barre="livre" style={`height:${Math.max(3, Math.round((m.livre / bvlMax) * 72))}px; background: var(--color-azur-300, #7fb4e8)`}></span>
                    </div>
                    <span class="text-[10px] text-lune-faint" data-i18n data-fr={MONTHS_SHORT.fr[i]} data-en={MONTHS_SHORT.en[i]} data-ar={MONTHS_SHORT.ar[i]}>{MONTHS_SHORT.fr[i]}</span>
                  </div>
                ))}
              </div>
              <p class="mt-3 text-xs text-lune-faint" data-i18n data-fr={AGR_LBL.legendeBarres.fr} data-en={AGR_LBL.legendeBarres.en} data-ar={AGR_LBL.legendeBarres.ar}>{AGR_LBL.legendeBarres.fr}</p>
              {bvl.moisLePlusSerre !== null && (
                <p class="mt-1 text-sm text-lune-soft" data-agri-mois-serre data-i18n
                  data-fr={`${AGR_LBL.moisSerre.fr} ${AGR_MOIS_LONG.fr[bvl.moisLePlusSerre - 1]}.`}
                  data-en={`${AGR_LBL.moisSerre.en} ${AGR_MOIS_LONG.en[bvl.moisLePlusSerre - 1]}.`}
                  data-ar={`${AGR_LBL.moisSerre.ar} ${AGR_MOIS_LONG.ar[bvl.moisLePlusSerre - 1]}.`}>{AGR_LBL.moisSerre.fr} {AGR_MOIS_LONG.fr[bvl.moisLePlusSerre - 1]}.</p>
              )}
              {bvl.baseBesoin === 'agronomique_plein' && (
                <p class="mt-1 text-xs text-lune-faint" data-i18n data-fr={AGR_LBL.agronomique.fr} data-en={AGR_LBL.agronomique.en} data-ar={AGR_LBL.agronomique.ar}>{AGR_LBL.agronomique.fr}</p>
              )}
              {/* AGQ3/AGQ33 — chaque mois sous la tolérance de conception, avec sa couverture servie (même phrase que le PDF). */}
              {bvl.moisSousTolerance.length > 0 && (
                <p class="mt-1 text-sm text-lune-soft" data-agri-mois-tolerance data-i18n
                  data-fr={`${AGR_LBL_AGQ.moisSousTolerance.fr} ${moisSousToleranceTexte.fr}.`}
                  data-en={`${AGR_LBL_AGQ.moisSousTolerance.en} ${moisSousToleranceTexte.en}.`}
                  data-ar={`${AGR_LBL_AGQ.moisSousTolerance.ar} ${moisSousToleranceTexte.ar}.`}>{AGR_LBL_AGQ.moisSousTolerance.fr} {moisSousToleranceTexte.fr}.</p>
              )}
            </div>
          )}

          {/* AGQ38/AGQ35 — notes client du noyau (ratio champ/pompe, variateur retenu, repli d'irradiation…), textes servis. */}
          {synth && synth.notes.length > 0 && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-notes>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL_AGQ.notesTitre.fr} data-en={AGR_LBL_AGQ.notesTitre.en} data-ar={AGR_LBL_AGQ.notesTitre.ar}>{AGR_LBL_AGQ.notesTitre.fr}</p>
              <ul class="mt-3 space-y-2 text-sm text-lune-soft">
                {synth.notes.map((n) => (
                  <li data-agri-note data-code={n.code ?? ''} data-i18n data-fr={n.textes.fr} data-en={n.textes.en} data-ar={n.textes.ar}>{n.textes.fr}</li>
                ))}
              </ul>
            </div>
          )}

          {/* Schéma forage → pompe → variateur → panneaux → bassin → irrigation : le SVG
              SERVI, inséré tel quel (déjà échappé côté serveur) — jamais un second dessin. */}
          {synth?.dessinSchema && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-schema>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.titreComment.fr} data-en={AGR_LBL.titreComment.en} data-ar={AGR_LBL.titreComment.ar}>{AGR_LBL.titreComment.fr}</p>
              <div class="mt-4 w-full overflow-x-auto" dir="ltr" set:html={synth.dessinSchema}></div>
            </div>
          )}

          {/* Courbe constructeur + point de fonctionnement ; sans courbe, la phrase d'omission. */}
          {synth && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-point>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.pointFonctionnement.fr} data-en={AGR_LBL.pointFonctionnement.en} data-ar={AGR_LBL.pointFonctionnement.ar}>{AGR_LBL.pointFonctionnement.fr}</p>
              {courbeGeo ? (
                <div class="mt-3" dir="ltr">
                  <svg viewBox={`0 0 ${courbeGeo.largeur} ${courbeGeo.hauteur}`} class="w-full max-w-lg" role="img" aria-label="Courbe de la pompe et point de fonctionnement" data-aria-label-fr="Courbe de la pompe et point de fonctionnement" data-aria-label-en="Pump curve and operating point" data-aria-label-ar="منحنى المضخة ونقطة التشغيل">
                    <line x1={courbeGeo.axe.x0} y1={courbeGeo.axe.y0} x2={courbeGeo.axe.x1} y2={courbeGeo.axe.y0} stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <line x1={courbeGeo.axe.x0} y1={courbeGeo.axe.y0} x2={courbeGeo.axe.x0} y2={courbeGeo.axe.y1} stroke="currentColor" stroke-width="1" opacity="0.5" />
                    <polyline points={courbeGeo.polyline} fill="none" stroke="#7fb4e8" stroke-width="2.5" />
                    <line x1={courbeGeo.point.x} y1={courbeGeo.axe.y0} x2={courbeGeo.point.x} y2={courbeGeo.point.y} stroke="#e8b54a" stroke-width="1" stroke-dasharray="4 3" />
                    <line x1={courbeGeo.axe.x0} y1={courbeGeo.point.y} x2={courbeGeo.point.x} y2={courbeGeo.point.y} stroke="#e8b54a" stroke-width="1" stroke-dasharray="4 3" />
                    <circle cx={courbeGeo.point.x} cy={courbeGeo.point.y} r="5" fill="#e8b54a" />
                    <text x={courbeGeo.axe.x1} y={courbeGeo.axe.y0 + 16} font-size="11" text-anchor="end" fill="currentColor" opacity="0.7">{formatNumber(courbeGeo.debitMax)}</text>
                    <text x={courbeGeo.axe.x0 - 6} y={courbeGeo.axe.y1 + 8} font-size="11" text-anchor="end" fill="currentColor" opacity="0.7">{formatNumber(courbeGeo.hmtMax)}</text>
                    <text x={courbeGeo.axe.x0 - 6} y={courbeGeo.axe.y0} font-size="11" text-anchor="end" fill="currentColor" opacity="0.7">0</text>
                  </svg>
                  <p class="mt-2 text-xs text-lune-faint">
                    <span data-i18n data-fr={AGR_LBL.axeDebit.fr} data-en={AGR_LBL.axeDebit.en} data-ar={AGR_LBL.axeDebit.ar}>{AGR_LBL.axeDebit.fr}</span> ·
                    <span data-i18n data-fr={AGR_LBL.axeHmt.fr} data-en={AGR_LBL.axeHmt.en} data-ar={AGR_LBL.axeHmt.ar}>{AGR_LBL.axeHmt.fr}</span>
                    — <span class="fig">{formatNumber(synth.pointFonctionnement!.point.debitM3h)} m³/h · {formatNumber(synth.pointFonctionnement!.point.hmtM)} m</span>
                  </p>
                </div>
              ) : (
                <p class="mt-3 text-sm text-lune-faint" data-agri-point-omis data-i18n
                  data-fr={`${motifCourbe && !motifCourbe.startsWith('courbe constructeur non disponible') ? motifCourbe : AGR_LBL.courbeAbsente.fr} ${AGR_LBL.pointOmis.fr}`}
                  data-en={`${AGR_LBL.courbeAbsente.en} ${AGR_LBL.pointOmis.en}`}
                  data-ar={`${AGR_LBL.courbeAbsente.ar} ${AGR_LBL.pointOmis.ar}`}>{motifCourbe && !motifCourbe.startsWith('courbe constructeur non disponible') ? motifCourbe : AGR_LBL.courbeAbsente.fr} {AGR_LBL.pointOmis.fr}</p>
              )}
            </div>
          )}

          {/* Pompe existante conservée : plaque relevée et compatibilité. */}
          {synth && synth.modePompe === 'existante' && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-plaque>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.pompeExistante.fr} data-en={AGR_LBL.pompeExistante.en} data-ar={AGR_LBL.pompeExistante.ar}>{AGR_LBL.pompeExistante.fr}</p>
              {plaqueTexte ? (
                <p class="mt-2 text-sm text-lune-soft" data-i18n data-fr={plaqueTexte.fr} data-en={plaqueTexte.en} data-ar={plaqueTexte.ar}>{plaqueTexte.fr}</p>
              ) : (
                <p class="mt-2 text-sm text-lune-faint" data-i18n data-fr={AGR_LBL.plaqueNonRelevee.fr} data-en={AGR_LBL.plaqueNonRelevee.en} data-ar={AGR_LBL.plaqueNonRelevee.ar}>{AGR_LBL.plaqueNonRelevee.fr}</p>
              )}
            </div>
          )}

          {/* D'où viennent ces chiffres : déclaré par vous le … / mesuré par TAQINOR le … /
              à confirmer par la visite — la provenance SERVIE, jamais une date inventée. */}
          {synth && (synth.provenance.length > 0 || synth.aConfirmerParVisite.length > 0) && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-provenance>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_LBL.titreProvenance.fr} data-en={AGR_LBL.titreProvenance.en} data-ar={AGR_LBL.titreProvenance.ar}>{AGR_LBL.titreProvenance.fr}</p>
              {synth.provenance.length > 0 && (
                <ul class="mt-3 space-y-1 text-sm text-lune-soft">
                  {synth.provenance.map((e) => {
                    const lib = libelleEntree(e.cle);
                    const ph = phraseProvenance(e);
                    // Rejeu AGQ41 — la valeur À CÔTÉ de sa provenance (parité PDF, AGQ28).
                    const val = valeurProvenance(e.cle, e.valeur, (n) => formatNumber(n, 1));
                    return (
                      <li>
                        <strong class="text-lune" data-i18n data-fr={lib.fr} data-en={lib.en} data-ar={lib.ar}>{lib.fr}</strong> :
                        {val && <span class="fig text-lune" dir="ltr" data-agri-provenance-valeur data-i18n data-fr={val.fr} data-en={val.en} data-ar={val.ar}>{' '}{val.fr} —</span>}
                        {' '}<span data-i18n data-fr={ph.fr} data-en={ph.en} data-ar={ph.ar}>{ph.fr}</span>
                      </li>
                    );
                  })}
                </ul>
              )}
              {synth.aConfirmerParVisite.length > 0 && (
                <p class="mt-3 text-sm text-lune-soft" data-agri-a-confirmer data-i18n
                  data-fr={`${AGR_LBL.aConfirmerVisite.fr} ${aConfirmerLbl.fr}.`}
                  data-en={`${AGR_LBL.aConfirmerVisite.en} ${aConfirmerLbl.en}.`}
                  data-ar={`${AGR_LBL.aConfirmerVisite.ar} ${aConfirmerLbl.ar}.`}><strong class="text-lune">{AGR_LBL.aConfirmerVisite.fr}</strong> {aConfirmerLbl.fr}.</p>
              )}
            </div>
          )}


          {/* ── AGW304 — L'ARGENT DÉCLARÉ, L'ÉNERGIE ACTUELLE, LA RÈGLE FDA, LES OPTIONS DU KIT ET LES
              FORMALITÉS, tels que SERVIS par `synthese_agricole` (la MÊME fonction que le PDF).
              Aucun calcul ici ; chaque bloc est OMIS quand le serveur ne le sert pas. Jamais un
              montant d'aide propre au client, jamais de pourcentage maximal promis, jamais « gratuit ». ──── */}
          {argent?.economies && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-argent>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.titreArgent.fr} data-en={AGR_ARGENT_LBL.titreArgent.en} data-ar={AGR_ARGENT_LBL.titreArgent.ar}>{AGR_ARGENT_LBL.titreArgent.fr}</p>
              <dl class="mt-3 divide-y divide-white/10 text-sm">
                {argent.economies.depenseActuelleMadAn !== null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="depense-actuelle">
                    <dt class="text-lune-soft" data-i18n
                      data-fr={`${AGR_ARGENT_LBL.depenseActuelle.fr}${energieLbl ? ` — ${energieLbl.fr}` : ''}`}
                      data-en={`${AGR_ARGENT_LBL.depenseActuelle.en}${energieLbl ? ` — ${energieLbl.en}` : ''}`}
                      data-ar={`${AGR_ARGENT_LBL.depenseActuelle.ar}${energieLbl ? ` — ${energieLbl.ar}` : ''}`}>{AGR_ARGENT_LBL.depenseActuelle.fr}{energieLbl ? ` — ${energieLbl.fr}` : ''}</dt>
                    <dd class="fig text-lune" dir="ltr">{formatMAD(argent.economies.depenseActuelleMadAn)}</dd>
                  </div>
                )}
                {argent.economies.chargesSolairesMadAn !== null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="charges-solaires">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_ARGENT_LBL.chargesSolaires.fr} data-en={AGR_ARGENT_LBL.chargesSolaires.en} data-ar={AGR_ARGENT_LBL.chargesSolaires.ar}>{AGR_ARGENT_LBL.chargesSolaires.fr}</dt>
                    <dd class="fig text-lune" dir="ltr">{formatMAD(argent.economies.chargesSolairesMadAn)}</dd>
                  </div>
                )}
                {argent.economies.economieNetteAn1 !== null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="economie-nette-an1">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_ARGENT_LBL.economieNetteAn1.fr} data-en={AGR_ARGENT_LBL.economieNetteAn1.en} data-ar={AGR_ARGENT_LBL.economieNetteAn1.ar}>{AGR_ARGENT_LBL.economieNetteAn1.fr}</dt>
                    <dd class="fig lum" dir="ltr">{formatMAD(argent.economies.economieNetteAn1)}</dd>
                  </div>
                )}
                {argent.economies.retourAns !== null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="retour-sans-aide">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_ARGENT_LBL.retourSansAide.fr} data-en={AGR_ARGENT_LBL.retourSansAide.en} data-ar={AGR_ARGENT_LBL.retourSansAide.ar}>{AGR_ARGENT_LBL.retourSansAide.fr}</dt>
                    <dd class="fig text-lune" dir="ltr" data-i18n
                      data-fr={`${formatNumber(argent.economies.retourAns, 1)} ans`} data-en={`${formatNumber(argent.economies.retourAns, 1)} years`} data-ar={`${formatNumber(argent.economies.retourAns, 1)} سنوات`}>{formatNumber(argent.economies.retourAns, 1)} ans</dd>
                  </div>
                )}
                {argent.economies.coutM3 && argent.economies.coutM3.actuel !== null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="cout-m3">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_ARGENT_LBL.coutM3.fr} data-en={AGR_ARGENT_LBL.coutM3.en} data-ar={AGR_ARGENT_LBL.coutM3.ar}>{AGR_ARGENT_LBL.coutM3.fr}</dt>
                    <dd class="fig text-lune" dir="ltr">{formatNumber(argent.economies.coutM3.actuel, 2)} / {formatNumber(argent.economies.coutM3.solaire, 2)} MAD</dd>
                  </div>
                )}
                {/* AGQ17/AGQ35 — nouveau forage : aucune dépense actuelle, le m³ solaire se dit seul (comme le PDF). */}
                {argent.economies.coutM3 && argent.economies.coutM3.actuel === null && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="cout-m3-solaire">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_LBL_AGQ.coutM3Solaire.fr} data-en={AGR_LBL_AGQ.coutM3Solaire.en} data-ar={AGR_LBL_AGQ.coutM3Solaire.ar}>{AGR_LBL_AGQ.coutM3Solaire.fr}</dt>
                    <dd class="fig text-lune" dir="ltr">{formatNumber(argent.economies.coutM3.solaire, 2)} MAD</dd>
                  </div>
                )}
                {/* AGQ20/AGQ35 — retour non publié : le motif SERVI (au-delà de l'horizon…), jamais un chiffre. */}
                {argent.economies.retourAns === null && argent.economies.retourMotif && (
                  <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="retour-motif">
                    <dt class="text-lune-soft" data-i18n data-fr={AGR_ARGENT_LBL.retourSansAide.fr} data-en={AGR_ARGENT_LBL.retourSansAide.en} data-ar={AGR_ARGENT_LBL.retourSansAide.ar}>{AGR_ARGENT_LBL.retourSansAide.fr}</dt>
                    <dd class="text-sm text-lune-soft">{argent.economies.retourMotif}</dd>
                  </div>
                )}
                {argent.economies.remplacements.map((r) => {
                  const comp = AGR_COMPOSANT_LBL[r.composant] ?? { fr: r.composant, en: r.composant, ar: r.composant };
                  const lbl = {
                    fr: AGR_ARGENT_LBL.remplacement.fr.replace('{composant}', comp.fr).replace('{annee}', String(r.annee)),
                    en: AGR_ARGENT_LBL.remplacement.en.replace('{composant}', comp.en).replace('{annee}', String(r.annee)),
                    ar: AGR_ARGENT_LBL.remplacement.ar.replace('{composant}', comp.ar).replace('{annee}', String(r.annee)),
                  };
                  return (
                    <div class="flex items-baseline justify-between gap-4 py-2" data-agri-ligne="remplacement">
                      <dt class="text-lune-soft" data-i18n data-fr={lbl.fr} data-en={lbl.en} data-ar={lbl.ar}>{lbl.fr}</dt>
                      <dd class="fig text-lune" dir="ltr">{formatMAD(r.montantTtc)} TTC</dd>
                    </div>
                  );
                })}
              </dl>
                {/* Validation R3 — la formule omet les remplacements : seulement pour un NOUVEAU forage, comme le PDF. */}
                {argent.economies.cas === 'nouveau_forage' && argent.economies.coutM3 && argent.economies.horizonAns !== null && (
                  <p class="mt-2 text-xs text-lune-faint" data-agri-formule-m3 data-i18n
                    data-fr={AGR_LBL_AGQ.formuleM3.fr.replaceAll('{horizon}', String(argent.economies.horizonAns))}
                    data-en={AGR_LBL_AGQ.formuleM3.en.replaceAll('{horizon}', String(argent.economies.horizonAns))}
                    data-ar={AGR_LBL_AGQ.formuleM3.ar.replaceAll('{horizon}', String(argent.economies.horizonAns))}>{AGR_LBL_AGQ.formuleM3.fr.replaceAll('{horizon}', String(argent.economies.horizonAns))}</p>
                )}
              <p class="mt-3 text-xs text-lune-faint" data-agri-argent-notes data-i18n
                data-fr={argentNotes.fr} data-en={argentNotes.en} data-ar={argentNotes.ar}>{argentNotes.fr}</p>
            </div>
          )}
          {/* AGC17 (parité PDF AGC11) — argent non publiable mais dépense DÉCLARÉE : la seule somme déclarée, jamais une économie. */}
          {!argent?.economies && argent?.depenseDeclareeMadAn != null && (
            <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-agri-depense-declaree>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.titreArgent.fr} data-en={AGR_ARGENT_LBL.titreArgent.en} data-ar={AGR_ARGENT_LBL.titreArgent.ar}>{AGR_ARGENT_LBL.titreArgent.fr}</p>
              <p class="mt-3 text-sm text-lune-soft" data-i18n
                data-fr={AGR_LBL_AGQ.depenseDeclaree.fr.replace('{mad}', formatMADCentimes(argent.depenseDeclareeMadAn))}
                data-en={AGR_LBL_AGQ.depenseDeclaree.en.replace('{mad}', formatMADCentimes(argent.depenseDeclareeMadAn))}
                data-ar={AGR_LBL_AGQ.depenseDeclaree.ar.replace('{mad}', formatMADCentimes(argent.depenseDeclareeMadAn))}>{AGR_LBL_AGQ.depenseDeclaree.fr.replace('{mad}', formatMADCentimes(argent.depenseDeclareeMadAn))}</p>
            </div>
          )}

          {/* Énergie actuelle — seulement si DÉCLARÉE (jamais le défaut de l'écran). */}
          {argent?.energieActuelle && energieLbl && (
            <div class="cine-card mt-5 rounded-xl p-5" data-agri-energie>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.energieActuelle.fr} data-en={AGR_ARGENT_LBL.energieActuelle.en} data-ar={AGR_ARGENT_LBL.energieActuelle.ar}>{AGR_ARGENT_LBL.energieActuelle.fr}</p>
              <p class="mt-2 text-sm text-lune-soft">
                <strong class="text-lune" data-i18n data-fr={energieLbl.fr} data-en={energieLbl.en} data-ar={energieLbl.ar}>{energieLbl.fr}</strong> —
                <span data-i18n data-fr={energiePhrase!.fr} data-en={energiePhrase!.en} data-ar={energiePhrase!.ar}>{energiePhrase!.fr}</span>
              </p>
            </div>
          )}

          {/* La RÈGLE de l'aide FDA (D-AGR-6) : conditions, plafonds, accord AVANT travaux,
              versement après réalisation, source — JAMAIS un montant propre au client. */}
          {argent?.aideFda?.textes && (
            <div class="cine-card mt-5 rounded-xl p-5" data-agri-fda>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.aideTitre.fr} data-en={AGR_ARGENT_LBL.aideTitre.en} data-ar={AGR_ARGENT_LBL.aideTitre.ar}>{AGR_ARGENT_LBL.aideTitre.fr}</p>
              <p class="mt-2 text-sm leading-relaxed text-lune-soft" data-i18n
                data-fr={argent.aideFda.textes.fr} data-en={argent.aideFda.textes.en} data-ar={argent.aideFda.textes.ar}>{argent.aideFda.textes.fr}</p>
            </div>
          )}

          {/* AGW308 — options du kit À COCHER : chaque option nommée porte « Ajouter au devis » (si le devis
              n'est pas figé ; INACTIF en aperçu interne, R4) → confirmation → /api/proposition-option →
              rechargement des totaux servis. Aucun retrait en ligne (le backend n'a pas d'endpoint). */}
          {argent && argent.optionsKit.length > 0 && (
            <div class="cine-card mt-5 rounded-xl p-5" id="agri-options-kit" data-agri-options-kit data-token={token}>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.optionsKit.fr} data-en={AGR_ARGENT_LBL.optionsKit.en} data-ar={AGR_ARGENT_LBL.optionsKit.ar}>{AGR_ARGENT_LBL.optionsKit.fr}</p>
              <ul class="mt-3 space-y-2 text-sm text-lune-soft">
                {argent.optionsKit.map((o) => {
                  const etat = etatActivationOption({ ligneId: o.ligneId, apercuInterne, offreVivante: offerState === 'live' });
                  const conf = confirmationOption(o.designation, o.totalTtc !== null ? formatMAD(o.totalTtc) : null);
                  return (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2" data-agri-option-kit data-ligne-id={o.ligneId ?? ''}>
                      <span class="text-lune">{o.designation}</span>
                      <span class="flex flex-wrap items-baseline gap-3">
                        {o.prixConnu && o.totalTtc !== null
                          ? <span class="fig text-lune" dir="ltr">+ {formatMAD(o.totalTtc)} TTC</span>
                          : <span class="text-xs text-lune-faint" data-agri-prix-sur-devis data-i18n data-fr={AGR_LBL_AGQ.prixSurDevis.fr} data-en={AGR_LBL_AGQ.prixSurDevis.en} data-ar={AGR_LBL_AGQ.prixSurDevis.ar}>{AGR_LBL_AGQ.prixSurDevis.fr}</span>}
                        {o.mention && <span class="basis-full text-xs text-lune-faint" data-agri-option-mention>{o.mention}</span>}
                        {etat !== 'masque' && o.prixConnu && (
                          <button type="button" data-option-ajouter data-ligne-id={o.ligneId ?? ''}
                            data-confirm-fr={conf.fr} data-confirm-en={conf.en} data-confirm-ar={conf.ar}
                            disabled={etat === 'apercu'} aria-disabled={etat === 'apercu' ? 'true' : undefined}
                            class="border border-brass-400/60 px-3 py-1.5 text-xs font-semibold text-brass-300 transition-colors hover:bg-brass-400/10 disabled:cursor-not-allowed disabled:opacity-50"
                            data-i18n data-fr="Ajouter au devis" data-en="Add to quote" data-ar="إضافة إلى العرض">Ajouter au devis</button>
                        )}
                      </span>
                    </li>
                  );
                })}
              </ul>
              <div id="agri-option-confirm" hidden role="dialog" aria-modal="true" aria-labelledby="agri-option-confirm-texte"
                class="mt-4 border border-brass-400/50 bg-black/20 p-4">
                <p id="agri-option-confirm-texte" class="text-sm text-lune"></p>
                <div class="mt-3 flex flex-wrap gap-3">
                  <button type="button" id="agri-option-confirm-ok" class="bg-brass-400 px-4 py-2 text-sm font-bold text-azur-950 disabled:opacity-60"
                    data-i18n data-fr="Confirmer l’ajout" data-en="Confirm" data-ar="تأكيد الإضافة">Confirmer l’ajout</button>
                  <button type="button" id="agri-option-confirm-annuler" class="border border-white/30 px-4 py-2 text-sm text-lune-soft"
                    data-i18n data-fr="Annuler" data-en="Cancel" data-ar="إلغاء">Annuler</button>
                </div>
              </div>
              <p id="agri-option-msg" hidden role="alert" class="mt-3 text-sm text-brass-300"></p>
            </div>
          )}
          {argent && argent.nonInclus.length > 0 && (
            <p class="mt-3 text-sm text-lune-soft" data-agri-non-inclus data-i18n
              data-fr={nonInclusLbl.fr} data-en={nonInclusLbl.en} data-ar={nonInclusLbl.ar}>{nonInclusLbl.fr}</p>
          )}

          {/* Formalités du client (loi 82-21 art. 3 hors réseau, loi 36-15 eau), telles que servies. */}
          {argent && argent.formalites.length > 0 && (
            <div class="cine-card mt-5 rounded-xl p-5" data-agri-formalites>
              <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.formalites.fr} data-en={AGR_ARGENT_LBL.formalites.en} data-ar={AGR_ARGENT_LBL.formalites.ar}>{AGR_ARGENT_LBL.formalites.fr}</p>
              <ul class="mt-3 space-y-2 text-sm text-lune-soft">
                {argent.formalites.map((f) => (
                  <li data-formalite={f.cle ?? ''} data-i18n data-fr={f.textes.fr} data-en={f.textes.en} data-ar={f.textes.ar}>{f.textes.fr}</li>
                ))}
              </ul>
            </div>
          )}

          {/* AGW301 — « Bassin recommandé ≈ 2 jours », « Subvention FDA … 30 % » et « Fini le
              carburant » RETIRÉS (zéro chiffre inventé ; D-AGR-6 : aucune promesse d'aide ;
              le gasoil n'est pas le cas de tout agriculteur). La règle FDA sans montant et la
              carte d'énergie DÉCLARÉE reviennent par `synthese_agricole` (AGW304). */}
        </section>
