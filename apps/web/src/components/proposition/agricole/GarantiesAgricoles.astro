---
/**
 * CPRW (27/10/2026) — déplacement PUR depuis pages/proposition/[...token].astro : la carte des garanties par composant du pompage (AGW304), sa condition d'affichage reste dans la page.
 * Le balisage est recopié à l'identique (mêmes attributs, mêmes textes FR/EN/AR) ; la page ne garde
 * qu'un appel de composant. Les valeurs arrivent par props sous LEURS noms de la page.
 */
import { AGR_ARGENT_LBL, libelleGarantie } from '../../../lib/proposition';
import type { SyntheseAgricoleArgent } from '../../../lib/proposition';

// Déplacement pur : les props gardent leurs noms de la page ; celles que le balisage parcourt
// (listes) sont typées comme dans la page, les autres restent ouvertes (`any`).
interface Props {
  argent: SyntheseAgricoleArgent;
}
const { argent } = Astro.props;
---
          <div class="cine-card mt-5 rounded-xl p-5" data-agri-garanties>
            <p class="tech-label text-lune-faint" data-i18n data-fr={AGR_ARGENT_LBL.garanties.fr} data-en={AGR_ARGENT_LBL.garanties.en} data-ar={AGR_ARGENT_LBL.garanties.ar}>{AGR_ARGENT_LBL.garanties.fr}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-lune-soft">
              {argent.garanties.map((g) => {
                const { lbl } = libelleGarantie(g);
                return <li data-garantie-composant={g.composant} data-i18n data-fr={lbl.fr} data-en={lbl.en} data-ar={lbl.ar}>{lbl.fr}</li>;
              })}
            </ul>
          </div>
