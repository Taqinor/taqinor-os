---
/**
 * CPRW15 (27/10/2026) — les garanties d'un devis commercial / industriel : les durées SERVIES par
 * le serveur (`synthese_ci.services.garanties`, la même bande que le PDF), jamais un défaut codé en
 * dur ; la pose garde sa durée adjugée (`INSTALL_WARRANTY_YEARS`, comme le PDF). Mots du PDF
 * (`i18n_labels.py` `ci_garantie_*`, `ci_legende_garanties`) en FR/EN/AR. Condition dans la page.
 */
import type { SyntheseCi } from '../../../lib/proposition';
import { INSTALL_WARRANTY_YEARS } from '../../../lib/warranty';
import { ANS_CI, LBL_GARANTIES_CI, LEGENDE_GARANTIES_CI, TITRE_GARANTIES_CI, garantiesCi } from './blocsCi';

interface Props {
  ci: SyntheseCi;
}
const { ci } = Astro.props;
const lignes = [
  ...garantiesCi(ci),
  { composant: 'installation', libelle: LBL_GARANTIES_CI.installation!, annees: INSTALL_WARRANTY_YEARS },
];
---
<div class="cine-card mt-5 rounded-xl p-5" data-ci-garanties>
  <h3 class="tech-label text-lune-faint" data-i18n data-fr={TITRE_GARANTIES_CI.fr} data-en={TITRE_GARANTIES_CI.en} data-ar={TITRE_GARANTIES_CI.ar}>{TITRE_GARANTIES_CI.fr}</h3>
  <ul class="mt-3 space-y-1.5 text-sm text-lune-soft">
    {lignes.map((g) => (
      <li data-garantie-composant={g.composant} data-i18n data-fr={`${g.libelle.fr} : ${g.annees} ${ANS_CI.fr}`} data-en={`${g.libelle.en}: ${g.annees} ${ANS_CI.en}`} data-ar={`${g.libelle.ar}: ${g.annees} ${ANS_CI.ar}`}>{g.libelle.fr} : {g.annees} {ANS_CI.fr}</li>
    ))}
  </ul>
  <p class="mt-3 text-xs text-lune-faint" data-i18n data-fr={LEGENDE_GARANTIES_CI.fr} data-en={LEGENDE_GARANTIES_CI.en} data-ar={LEGENDE_GARANTIES_CI.ar}>{LEGENDE_GARANTIES_CI.fr}</p>
</div>
