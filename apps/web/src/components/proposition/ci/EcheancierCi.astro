---
/**
 * CPRW16 (27/10/2026) — l'échéancier de paiement d'un devis commercial / industriel : les jalons, pourcentages
 * et montants TTC SERVIS (`synthese_ci.echeancier`, le même que le PDF), jamais recalculés ; mots du PDF
 * (`i18n_labels.py` `ci_jalon_*`) en FR/EN/AR. Un montant non servi (ou nul) est omis. Condition dans la page.
 */
import { formatMADCentimes } from '../../../lib/proposition';
import type { SyntheseCi } from '../../../lib/proposition';
import { TITRE_ECHEANCIER_CI, TTC_CI, echeancierCi } from './blocsCi';

interface Props {
  ci: SyntheseCi;
}
const { ci } = Astro.props;
const jalons = echeancierCi(ci);
---
<section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="echeancier" data-ci-echeancier>
  <h2 class="tech-label rule-brass text-brass-300" data-i18n data-fr={TITRE_ECHEANCIER_CI.fr} data-en={TITRE_ECHEANCIER_CI.en} data-ar={TITRE_ECHEANCIER_CI.ar}>{TITRE_ECHEANCIER_CI.fr}</h2>
  <ul class:list={['mt-5 grid grid-cols-1 gap-4', jalons.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3']}>
    {jalons.map((j) => (
      <li class="cine-card rounded-2xl p-5" data-ci-jalon={j.jalon ?? undefined}>
        <p class="fig text-3xl text-lune" dir="ltr">{String(j.pct).replace('.', ',')} %</p>
        <p class="mt-2 text-sm text-lune-soft" data-i18n data-fr={j.libelle.fr} data-en={j.libelle.en} data-ar={j.libelle.ar}>{j.libelle.fr}</p>
        {j.montantTtc !== null ? (
          <p class="mt-1 text-sm text-lune" dir="ltr">{formatMADCentimes(j.montantTtc)} <span data-i18n data-fr={TTC_CI.fr} data-en={TTC_CI.en} data-ar={TTC_CI.ar}>{TTC_CI.fr}</span></p>
        ) : null}
      </li>
    ))}
  </ul>
</section>
