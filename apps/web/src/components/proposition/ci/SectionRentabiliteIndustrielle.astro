---
/**
 * CPRW (27/10/2026) — déplacement PUR depuis pages/proposition/[...token].astro : la section « Rentabilité de votre projet » d'un devis industriel (CIW308), sa condition d'affichage reste dans la page.
 * Le balisage est recopié à l'identique (mêmes attributs, mêmes textes FR/EN/AR) ; la page ne garde
 * qu'un appel de composant. Les valeurs arrivent par props sous LEURS noms de la page.
 */
import { formatMAD, formatNumber } from '../../../lib/proposition';
import type { RentabiliteCi } from '../../../lib/proposition';

// Déplacement pur : les props gardent leurs noms de la page ; celles que le balisage parcourt
// (listes) sont typées comme dans la page, les autres restent ouvertes (`any`).
interface Props {
  ciRent: RentabiliteCi | null;
  ciRentBaseTexte: any;
}
const { ciRent, ciRentBaseTexte } = Astro.props;

// CPRW6 — libellés CLIENT des sensibilités servies ; une clé inconnue n'imprime aucune ligne.
const LIBELLES_SENSIBILITE: Record<string, { fr: string; en: string; ar: string }> = {
  indexation_tarif: { fr: 'Indexation du tarif', en: 'Tariff indexation', ar: 'فهرسة التعريفة' },
  degradation: { fr: 'Dégradation', en: 'Degradation', ar: 'التدهور' },
  tarif_kwh: { fr: 'Prix du kWh', en: 'kWh price', ar: 'ثمن الكيلوواط ساعة' },
  production: { fr: 'Production', en: 'Production', ar: 'الإنتاج' },
};
const sensibilites = (ciRent?.sensibilites ?? []).filter((sn) => LIBELLES_SENSIBILITE[sn.cle]);
---
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="direction" data-ci-lecteurs>
          {ciRent && (
            <>
          <nav class="flex flex-wrap gap-2 text-xs" aria-label="Sections" data-aria-label-fr="Sections" data-aria-label-en="Sections" data-aria-label-ar="الأقسام">
            <a href="#direction" class="btn-pill px-3 py-1" data-i18n data-fr="Direction" data-en="Management" data-ar="الإدارة">Direction</a>
            <a href="#achats" class="btn-pill px-3 py-1" data-i18n data-fr="Achats" data-en="Procurement" data-ar="المشتريات">Achats</a>
            <a href="#exploitation" class="btn-pill px-3 py-1" data-i18n data-fr="Exploitation" data-en="Operations" data-ar="الاستغلال">Exploitation</a>
          </nav>
            <div class="mt-5" id="rentabilite" data-ci-rentabilite>
              <h2 class="tech-label rule-brass text-brass-300" data-i18n data-fr="Rentabilité de votre projet" data-en="Your project's profitability" data-ar="مردودية مشروعكم">Rentabilité de votre projet</h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {ciRent.triPct !== null ? (
                  <div class="cine-card rounded-xl p-5">
                    <p class="tech-label text-lune-faint" data-i18n
                      data-fr={ciRent.triHorizonAns !== null ? `TRI sur ${formatNumber(ciRent.triHorizonAns, 0)} ans` : 'TRI'}
                      data-en={ciRent.triHorizonAns !== null ? `IRR over ${formatNumber(ciRent.triHorizonAns, 0)} years` : 'IRR'}
                      data-ar={ciRent.triHorizonAns !== null ? `معدل العائد الداخلي على ${formatNumber(ciRent.triHorizonAns, 0)} سنة` : 'معدل العائد الداخلي'}>{ciRent.triHorizonAns !== null ? `TRI sur ${formatNumber(ciRent.triHorizonAns, 0)} ans` : 'TRI'}</p>
                    <p class="fig fig-md lum mt-2" dir="ltr" data-figure="tri_pct">{formatNumber(ciRent.triPct, 1)} %</p>
                  </div>
                ) : null}
                {ciRent.lcoeMadKwh !== null ? (
                  <div class="cine-card rounded-xl p-5 sm:col-span-2">
                    <p class="text-sm text-lune">
                      <span data-i18n data-fr="Coût du kWh solaire" data-en="Cost of your solar kWh" data-ar="كلفة الكيلوواط ساعة الشمسي">Coût du kWh solaire</span>{' '}
                      <span class="fig" dir="ltr" data-figure="lcoe_mad_kwh">{formatNumber(ciRent.lcoeMadKwh, 4)}</span> MAD
                      {ciRent.tarifKwhEvite !== null ? (
                        <>
                          {' — '}<span data-i18n data-fr="votre kWh évité" data-en="your avoided kWh" data-ar="الكيلوواط ساعة الذي توفرونه">votre kWh évité</span>{' '}
                          <span class="fig" dir="ltr">{formatNumber(ciRent.tarifKwhEvite, 2)}</span> MAD
                        </>
                      ) : null}
                    </p>
                  </div>
                ) : null}
                {ciRent.vanMad !== null ? (
                  <div class="cine-card rounded-xl p-5" data-ci-van>
                    <p class="tech-label text-lune-faint" data-i18n
                      data-fr={ciRent.tauxActualisationPct !== null ? `VAN au taux déclaré de ${formatNumber(ciRent.tauxActualisationPct, 1)} %` : 'VAN'}
                      data-en={ciRent.tauxActualisationPct !== null ? `NPV at your declared rate of ${formatNumber(ciRent.tauxActualisationPct, 1)} %` : 'NPV'}
                      data-ar={ciRent.tauxActualisationPct !== null ? `القيمة الحالية الصافية بالمعدل المصرح به ${formatNumber(ciRent.tauxActualisationPct, 1)} %` : 'القيمة الحالية الصافية'}>{ciRent.tauxActualisationPct !== null ? `VAN au taux déclaré de ${formatNumber(ciRent.tauxActualisationPct, 1)} %` : 'VAN'}</p>
                    <p class="fig fig-md lum mt-2" dir="ltr">{formatMAD(ciRent.vanMad)}</p>
                  </div>
                ) : null}
              </div>
              {ciRent.jalons.length > 0 ? (
                <div class="cine-card mt-5 rounded-2xl p-5 sm:p-6" data-ci-jalons>
                  <p class="tech-label text-lune-faint" data-i18n
                    data-fr={`Cumul net (${ciRentBaseTexte}) aux jalons`} data-en={`Net cumulative (${ciRentBaseTexte}) at milestones`} data-ar={`الصافي التراكمي (${ciRentBaseTexte}) عند المحطات`}>{`Cumul net (${ciRentBaseTexte}) aux jalons`}</p>
                  <div class="overflow-x-auto">
                  <table class="mt-3 w-full text-sm" dir="ltr">
                    <caption class="sr-only" data-i18n
                      data-fr={`Cumul net (${ciRentBaseTexte}) aux jalons`} data-en={`Net cumulative (${ciRentBaseTexte}) at milestones`} data-ar={`الصافي التراكمي (${ciRentBaseTexte}) عند المحطات`}>{`Cumul net (${ciRentBaseTexte}) aux jalons`}</caption>
                    <thead>
                      <tr>
                        <th scope="col" class="sr-only" data-i18n data-fr="Année" data-en="Year" data-ar="السنة">Année</th>
                        <th scope="col" class="sr-only" data-i18n
                          data-fr={`Cumul net (${ciRent.base === 'ttc' ? 'TTC' : 'HT'})`} data-en={`Net cumulative (${ciRent.base === 'ttc' ? 'incl. VAT' : 'excl. VAT'})`} data-ar={`الرصيد الصافي (${ciRent.base === 'ttc' ? 'شامل الضريبة' : 'دون احتساب الضريبة'})`}>{`Cumul net (${ciRent.base === 'ttc' ? 'TTC' : 'HT'})`}</th>
                        {ciRent.jalonsTtc.length > 0 ? (
                          <th scope="col" class="sr-only" data-i18n data-fr="Cumul net (TTC)" data-en="Net cumulative (incl. VAT)" data-ar="الرصيد الصافي (شامل الضريبة)">Cumul net (TTC)</th>
                        ) : null}
                      </tr>
                    </thead>
                    <tbody>
                      {ciRent.jalons.map((j) => (
                        <tr>
                          <th scope="row" class="py-1 text-left font-normal text-lune-soft">{j.annee}<span data-i18n data-fr=" ans" data-en=" years" data-ar=" سنة"> ans</span></th>
                          <td class="py-1 text-right text-lune" data-figure={j.annee === 25 ? 'cumul_net_25_ans_mad' : undefined}>{formatMAD(j.cumul)}</td>
                          {ciRent.jalonsTtc.length > 0 ? (
                            <td class="py-1 text-right text-lune-faint">{ciRent.jalonsTtc.find((x) => x.annee === j.annee) ? `${formatMAD(ciRent.jalonsTtc.find((x) => x.annee === j.annee)!.cumul)} TTC` : ''}</td>
                          ) : null}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                  </div>
                </div>
              ) : null}
              {sensibilites.length > 0 ? (
                <div class="cine-card mt-5 rounded-xl p-5" data-ci-sensibilites>
                  <p class="tech-label text-lune-faint" data-i18n data-fr="Sensibilités" data-en="Sensitivities" data-ar="تحليل الحساسية">Sensibilités</p>
                  <ul class="mt-2 space-y-1 text-sm text-lune-soft">
                    {sensibilites.map((sn) => (
                      <li><span data-i18n data-fr={LIBELLES_SENSIBILITE[sn.cle].fr} data-en={LIBELLES_SENSIBILITE[sn.cle].en} data-ar={LIBELLES_SENSIBILITE[sn.cle].ar}>{LIBELLES_SENSIBILITE[sn.cle].fr}</span><span dir="ltr">{sn.variationPct !== null ? ` ${sn.variationPct > 0 ? '+' : ''}${formatNumber(sn.variationPct, 1)} %` : ''}{sn.retourAns !== null ? ` — ${formatNumber(sn.retourAns, 1)} ` : ''}</span>{sn.retourAns !== null ? <span data-i18n data-fr="ans" data-en="years" data-ar="سنة">ans</span> : null}{sn.triPct !== null ? <><span>, </span><span data-i18n data-fr="TRI" data-en="IRR" data-ar="معدل العائد">TRI</span><span dir="ltr">{` ${formatNumber(sn.triPct, 1)} %`}</span></> : null}</li>
                    ))}
                  </ul>
                </div>
              ) : null}
                    {ciRent.financement.economieMensuelleMoyenneMad !== null ? (
                      <li data-i18n
                        data-fr={`Économie moyenne : ${formatMAD(ciRent.financement.economieMensuelleMoyenneMad)} par mois`}
                        data-en={`Average savings: ${formatMAD(ciRent.financement.economieMensuelleMoyenneMad)} per month`}
                        data-ar={`متوسط التوفير: ${formatMAD(ciRent.financement.economieMensuelleMoyenneMad)} شهريًا`}>{`Économie moyenne : ${formatMAD(ciRent.financement.economieMensuelleMoyenneMad)} par mois`}</li>
                    ) : null}
                    {ciRent.financement.ecartMensuelMad !== null ? (
                      <li data-i18n
                        data-fr={`${formatMAD(ciRent.financement.ecartMensuelMad)} par mois : différence entre l'échéance et l'économie moyenne`}
                        data-en={`${formatMAD(ciRent.financement.ecartMensuelMad)} per month: difference between the instalment and the average savings`}
                        data-ar={`${formatMAD(ciRent.financement.ecartMensuelMad)} شهريًا: الفرق بين القسط ومتوسط التوفير`}>{`${formatMAD(ciRent.financement.ecartMensuelMad)} par mois : différence entre l'échéance et l'économie moyenne`}</li>
                    ) : null}
                  </ul>
                </div>
              ) : null}
            </div>
            </>
          )}
        </section>
