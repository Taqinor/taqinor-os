---
/**
 * CPRW18 (27/10/2026) — comparaison sans / avec batterie d'un devis commercial / industriel à deux options :
 * UNIQUEMENT des valeurs servies (Total TTC par option, phrase du moteur sur la capacité et l'énergie restituée,
 * économie annuelle HT et retour de l'option) avec les mots du PDF (`ci/blocs.py::LIBELLES_OPTION_AVEC`).
 * Mobile d'abord : une colonne, deux dès `sm`. Aucune autoconsommation/couverture par option. Condition dans la page.
 */
import type { SyntheseCi } from '../../../lib/proposition';
import { LBL_COMPARAISON_CI, comparaisonBatterieCi } from './blocsCi';

interface Props {
  ci: SyntheseCi;
  sansTtc: number | null;
  avecTtc: number | null;
}
const { ci, sansTtc, avecTtc } = Astro.props;
const comparaison = comparaisonBatterieCi(ci, sansTtc, avecTtc);
---
<div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2" data-ci-comparaison-batterie>
  {(comparaison?.colonnes ?? []).map((col) => (
    <div class="cine-card rounded-2xl p-5" data-ci-colonne={col.cle}>
      <p class="tech-label text-lune-faint" data-i18n data-fr={col.titre.fr} data-en={col.titre.en} data-ar={col.titre.ar}>{col.titre.fr}</p>
      <div class="mt-3 space-y-2 text-sm text-lune-soft">
        {col.lignes.map((l) => (
          l.textes ? (
            <p data-ci-ligne={l.cle} data-i18n data-fr={l.textes.fr} data-en={l.textes.en} data-ar={l.textes.ar}>{l.textes.fr}</p>
          ) : (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3" data-ci-ligne={l.cle}>
              <span data-i18n data-fr={l.libelle?.fr} data-en={l.libelle?.en} data-ar={l.libelle?.ar}>{l.libelle?.fr}</span>
              <span class="fig text-lune" dir="ltr">{l.valeur}{l.cle === 'retour' ? ' ' : ''}{l.cle === 'retour' ? <span data-i18n data-fr={LBL_COMPARAISON_CI.ans.fr} data-en={LBL_COMPARAISON_CI.ans.en} data-ar={LBL_COMPARAISON_CI.ans.ar}>{LBL_COMPARAISON_CI.ans.fr}</span> : null}</span>
            </div>
          )
        ))}
      </div>
    </div>
  ))}
</div>
