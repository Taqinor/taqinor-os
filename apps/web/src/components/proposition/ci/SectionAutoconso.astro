---
/**
 * CPRW (27/10/2026) — déplacement PUR depuis pages/proposition/[...token].astro : la section « Votre autoconsommation » d'un devis commercial ou industriel (CIW300/307), sa condition d'affichage reste dans la page.
 * Le balisage est recopié à l'identique (mêmes attributs, mêmes textes FR/EN/AR) ; la page ne garde
 * qu'un appel de composant. Les valeurs arrivent par props sous LEURS noms de la page.
 */
import { formatMAD, formatNumber } from '../../../lib/proposition';
import type { SyntheseCi, carteIndustrielleCi } from '../../../lib/proposition';

// Déplacement pur : les props gardent leurs noms de la page ; celles que le balisage parcourt
// (listes) sont typées comme dans la page, les autres restent ouvertes (`any`).
interface Props {
  ci: SyntheseCi | null;
  ciArgent: any;
  ciCarteInd: ReturnType<typeof carteIndustrielleCi> | null;
  ciEco: any;
  ciInjection: any;
  // CPRW3/4 : la page passe encore trois props que ce composant ne lit plus (estimation, motifs
  // manquants, réserve) — à retirer côté page par la session RWEB.
  couverture: any;
  isCommercial: any;
}
// CPRW2 — la phrase « tarif » est le texte CLIENT servi (hypothèse `tarif`), jamais la note interne
// de l'argent (ni sa mention, ni sa source) ; non servie → rien.
const { ci, ciArgent, ciCarteInd, ciEco, ciInjection, couverture, isCommercial } = Astro.props;
// CPRW3 — bandeau « devis préliminaire » : le texte servi (hypothèse `visite`), à chaque fois qu'il l'est.
const preliminaire = ci?.hypotheses.find((h) => h.cle === 'visite')?.textes ?? null;
const tarifServi = ci?.hypotheses.find((h) => h.cle === 'tarif')?.textes ?? null;
---
        <section class="mx-auto max-w-4xl px-5 pt-12 sm:px-8" id="mode-autoconso">
          <h2 class="tech-label rule-brass text-brass-300" data-i18n
            data-fr={isCommercial ? 'Votre autoconsommation' : 'Votre autoconsommation industrielle'}
            data-en={isCommercial ? 'Your self-consumption' : 'Your industrial self-consumption'}
            data-ar={isCommercial ? 'استهلاككم الذاتي' : 'استهلاككم الذاتي الصناعي'}>{isCommercial ? 'Votre autoconsommation' : 'Votre autoconsommation industrielle'}</h2>
          <span id="economies" aria-hidden="true"></span>
          {/* CIW300 — TOUT est LU dans `synthese_ci` (la MÊME fonction que le PDF) : kWc, production,
              autoconsommation, couverture (définitions servies), économie de l'année 1, retour.
              Une clé non servie n'imprime rien (jamais un 0 fabriqué). */}
          {ci ? (
            <div data-ci-synthese>
              {preliminaire ? (
                <div class="mt-4 rounded-xl border border-brass-400/40 bg-brass-400/10 p-4 text-sm text-lune-soft" data-ci-preliminaire>
                  <p class="font-semibold text-lune" data-i18n
                    data-fr={preliminaire.fr} data-en={preliminaire.en} data-ar={preliminaire.ar}>{preliminaire.fr}</p>
                </div>
              ) : null}
              <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {ci.systeme?.kwc != null ? (
                  <div class="cine-card rounded-xl p-5">
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Puissance installée" data-en="Installed capacity" data-ar="القدرة المركبة">Puissance installée</p>
                    <p class="fig fig-md lum mt-2" dir="ltr" data-figure="puissance_kwc">{formatNumber(ci.systeme.kwc, 2)} kWc</p>
                  </div>
                ) : null}
                {ci.systeme?.productionKwhAn != null ? (
                  <div class="cine-card rounded-xl p-5">
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Production solaire / an" data-en="Solar production / year" data-ar="الإنتاج الشمسي / سنة">Production solaire / an</p>
                    <p class="fig fig-md mt-2 text-lune" dir="ltr" data-figure="production_annuelle_kwh">{formatNumber(ci.systeme.productionKwhAn)} kWh</p>
                  </div>
                ) : null}
                {ci.energie?.autoconsoPct != null ? (
                  <div class="cine-card rounded-xl p-5">
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Taux d'autoconsommation" data-en="Self-consumption rate" data-ar="نسبة الاستهلاك الذاتي">Taux d'autoconsommation</p>
                    <p class="fig fig-md lum mt-2" dir="ltr" data-figure="autoconsommation_pct">{formatNumber(ci.energie.autoconsoPct, 1)} %</p>
                    {ci.energie.definitions.autoconso ? <p class="mt-1 text-xs text-lune-faint">{ci.energie.definitions.autoconso}</p> : null}
                  </div>
                ) : null}
                {ci.energie?.couverturePct != null ? (
                  <div class="cine-card rounded-xl p-5">
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Taux de couverture" data-en="Coverage rate" data-ar="نسبة التغطية">Taux de couverture</p>
                    <p class="fig fig-md mt-2 text-lune" dir="ltr" data-figure="couverture_pct">{formatNumber(ci.energie.couverturePct, 1)} %</p>
                    {ci.energie.definitions.couverture ? <p class="mt-1 text-xs text-lune-faint">{ci.energie.definitions.couverture}</p> : null}
                  </div>
                ) : null}
                {ciArgent && ciEco !== null ? (
                  <div class="cine-card rounded-xl p-5" data-ci-economie>
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Économie de l'année 1" data-en="Year-1 savings" data-ar="توفير السنة الأولى">Économie de l'année 1</p>
                    <p class="fig fig-md lum mt-2" dir="ltr" data-figure="economie_annuelle">{formatMAD(ciEco)}{' '}<span class="text-base text-lune-soft" data-i18n
                      data-fr={ciArgent.base === 'ttc' ? 'TTC' : 'HT'}
                      data-en={ciArgent.base === 'ttc' ? 'incl. VAT' : 'excl. VAT'}
                      data-ar={ciArgent.base === 'ttc' ? 'شامل الضريبة' : 'دون احتساب الضريبة'}>{ciArgent.base === 'ttc' ? 'TTC' : 'HT'}</span></p>
                    {ciArgent.base === 'deux' && ciArgent.economieAnnee1?.ttc != null ? (
                      <p class="mt-1 text-xs text-lune-faint" dir="ltr">{formatMAD(ciArgent.economieAnnee1.ttc)}{' '}<span data-i18n data-fr="TTC" data-en="incl. VAT" data-ar="شامل الضريبة">TTC</span></p>
                    ) : null}
                  </div>
                ) : null}
                {ciArgent && ciArgent.retourAns !== null ? (
                  <div class="cine-card rounded-xl p-5" data-ci-retour>
                    <p class="tech-label text-lune-faint" data-i18n data-fr="Rentabilisé en" data-en="Paid back in" data-ar="يُسترد خلال">Rentabilisé en</p>
                    <p class="fig fig-md mt-2 text-lune" dir="ltr" data-figure="payback_ans">{formatNumber(ciArgent.retourAns, 1)} <span class="text-base text-lune-soft" data-i18n data-fr="ans" data-en="years" data-ar="سنة">ans</span></p>
                  </div>
                ) : null}
              </div>
              {ciArgent?.motifBase ? (
                <p class="mt-3 text-xs text-lune-faint" data-ci-motif-base>{ciArgent.motifBase}</p>
              ) : null}
              {tarifServi ? (
                <p class="mt-4 text-xs text-lune-faint" data-ci-tarif data-i18n
                  data-fr={tarifServi.fr} data-en={tarifServi.en} data-ar={tarifServi.ar}>{tarifServi.fr}</p>
              ) : null}
            </div>
          ) : (
            <p class="mt-4 text-sm text-lune-faint" data-i18n
              data-fr="Les indicateurs détaillés de votre étude sont confirmés avec votre conseiller."
              data-en="The detailed indicators of your study are confirmed with your advisor."
              data-ar="تُؤكَّد المؤشرات التفصيلية لدراستكم مع مستشاركم.">Les indicateurs détaillés de votre étude sont confirmés avec votre conseiller.</p>
          )}

          {/* Injection 82-21 — UNIQUEMENT si le serveur SERT la revente (`synthese_ci.argent.revente`
              calculée, MT seulement). La mention est le texte servi (`synthese_ci.hypotheses`,
              MENTION_82_21) : AUCUNE mention réglementaire n'est écrite dans la page. */}
          {ciInjection && (
            <div class="cine-card mt-5 rounded-xl p-5" data-ci-injection>
              <p class="tech-label text-brass-300" data-i18n data-fr="Injection du surplus (loi 82-21)" data-en="Surplus injection (law 82-21)" data-ar="حقن الفائض (القانون 82-21)">Injection du surplus (loi 82-21)</p>
              {ciInjection.kwhAn !== null ? (
                <p class="mt-2 text-sm text-lune-soft" data-i18n
                  data-fr={`≈ ${formatNumber(ciInjection.kwhAn)} kWh/an de surplus injectables${ciInjection.valeurMadAn !== null ? `, soit ≈ ${formatMAD(ciInjection.valeurMadAn)}/an` : ''}.`}
                  data-en={`≈ ${formatNumber(ciInjection.kwhAn)} kWh/year of injectable surplus${ciInjection.valeurMadAn !== null ? `, i.e. ≈ ${formatMAD(ciInjection.valeurMadAn)}/year` : ''}.`}
                  data-ar={`≈ ${formatNumber(ciInjection.kwhAn)} kWh/سنة من الفائض القابل للحقن${ciInjection.valeurMadAn !== null ? `، أي ≈ ${formatMAD(ciInjection.valeurMadAn)}/سنة` : ''}.`}>≈ {formatNumber(ciInjection.kwhAn)} kWh/an de surplus injectables{ciInjection.valeurMadAn !== null ? `, soit ≈ ${formatMAD(ciInjection.valeurMadAn)}/an` : ''}.</p>
              ) : null}
              <p class="mt-2 text-xs text-lune-faint" data-i18n
                data-fr={ciInjection.mention.fr} data-en={ciInjection.mention.en} data-ar={ciInjection.mention.ar}>{ciInjection.mention.fr}</p>
            </div>
          )}

          {/* CIW307 — Industriel : la carte lit `synthese_ci` (CIQ305/CIQ344), les MÊMES textes que le
              PDF. Aucune promesse de prix horaire ni de lissage de la puissance : la redevance de
              puissance se paie sur la puissance SOUSCRITE, que la centrale ne change pas ;
              CBAM seulement sur drapeau servi, aucun CO₂ chiffré. */}
          {ciCarteInd && (ciCarteInd.hypotheses.length > 0 || ciCarteInd.decarbonation) && (
            <div class="mt-5 grid gap-4 sm:grid-cols-2" data-ci-carte-industrielle>
              {ciCarteInd.hypotheses.length > 0 && (
                <div class="cine-card rounded-xl p-5">
                  <p class="tech-label text-brass-300" data-i18n data-fr="Ce que le solaire change à votre facture" data-en="What solar changes on your bill" data-ar="ما تغيّره الطاقة الشمسية في فاتورتكم">Ce que le solaire change à votre facture</p>
                  <ul class="mt-2 space-y-2 text-sm text-lune-soft">
                    {ciCarteInd.hypotheses.map((h) => (
                      <li data-i18n data-fr={h.textes.fr} data-en={h.textes.en} data-ar={h.textes.ar} data-ci-hypothese={h.cle}>{h.textes.fr}</li>
                    ))}
                  </ul>
                </div>
              )}
              {ciCarteInd.decarbonation && (
                <div class="cine-card rounded-xl p-5">
                  <p class="tech-label text-brass-300" data-i18n
                    data-fr={ciCarteInd.decarbonation.cbam ? 'Décarbonation et CBAM' : 'Décarbonation'}
                    data-en={ciCarteInd.decarbonation.cbam ? 'Decarbonation and CBAM' : 'Decarbonation'}
                    data-ar={ciCarteInd.decarbonation.cbam ? 'إزالة الكربون وآلية CBAM' : 'إزالة الكربون'}>{ciCarteInd.decarbonation.cbam ? 'Décarbonation et CBAM' : 'Décarbonation'}</p>
                  <p class="mt-2 text-sm text-lune-soft" data-i18n data-ci-decarbonation={ciCarteInd.decarbonation.cbam ? 'cbam' : 'generique'}
                    data-fr={ciCarteInd.decarbonation.textes.fr} data-en={ciCarteInd.decarbonation.textes.en} data-ar={ciCarteInd.decarbonation.textes.ar}>{ciCarteInd.decarbonation.textes.fr}</p>
                </div>
              )}
            </div>
          )}
        </section>
