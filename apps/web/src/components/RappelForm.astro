---
/**
 * WAUD81 — formulaire « On vous rappelle » PARTAGÉ FR/EN/AR (WJ97 pour le FR) :
 * même endpoint (/api/capture-lead), mêmes champs, même corps — seule la langue
 * affichée change, et part en `langue_preferee` pour EN/AR (le FR n'en envoie
 * pas, comme avant). Tracking + eventId + adsConsent : voir `corpsRappel`.
 */
import LigneInfoConsentement from './LigneInfoConsentement.astro';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  /** Lien WhatsApp de repli (canal distinct du rappel). */
  waRappel: string;
}
const { locale, waRappel } = Astro.props;
const STR: Record<Locale, Record<string, string>> = {
  fr: {
    label: 'Par téléphone', titre: 'On vous rappelle',
    intro: 'Laissez votre nom et votre numéro : un conseiller Taqinor vous rappelle directement, aucune saisie supplémentaire.',
    hp: 'Ne pas remplir', nom: 'Nom complet', tel: 'Téléphone',
    consent: "J'accepte d'être recontacté(e) par Taqinor au sujet de mon projet solaire.",
    bouton: 'Demander à être rappelé(e)', pref: 'Vous préférez écrire ?', wa: 'Contactez-nous plutôt sur WhatsApp',
    ok: 'Merci — un conseiller Taqinor vous rappelle très vite.',
    ko: 'Service momentanément indisponible — contactez-nous plutôt sur WhatsApp, nous répondons vite.',
  },
  en: {
    label: 'By phone', titre: 'We call you back',
    intro: 'Leave your name and number: a Taqinor advisor will call you back directly, nothing else to fill in.',
    hp: 'Do not fill in', nom: 'Full name', tel: 'Phone',
    consent: 'I agree to be contacted by Taqinor about my solar project.',
    bouton: 'Request a callback', pref: 'Prefer to write?', wa: 'Message us on WhatsApp instead',
    ok: 'Thank you — a Taqinor advisor will call you back very soon.',
    ko: 'Service temporarily unavailable — please message us on WhatsApp instead, we reply fast.',
  },
  ar: {
    label: 'عبر الهاتف', titre: 'نتصل بك',
    intro: 'اترك اسمك ورقمك: سيتصل بك مستشار من Taqinor مباشرة، دون أي معلومات إضافية.',
    hp: 'لا تملأ هذا الحقل', nom: 'الاسم الكامل', tel: 'الهاتف',
    consent: 'أوافق على أن تتواصل معي Taqinor بخصوص مشروعي الشمسي.',
    bouton: 'اطلب معاودة الاتصال', pref: 'تفضّل الكتابة؟', wa: 'راسلنا عبر واتساب',
    ok: 'شكراً — سيتصل بك مستشار من Taqinor قريباً جداً.',
    ko: 'الخدمة غير متاحة مؤقتاً — راسلنا عبر واتساب، نردّ بسرعة.',
  },
};
const s = STR[locale] ?? STR.fr;
---

<div id="rappel-form" class="v2-rise mt-8 border-2 border-azur-600/40 bg-blanc p-7 text-sm" hidden>
  <p class="tech-label text-azur-600">{s.label}</p>
  <h2 class="display mt-1 text-xl font-bold">{s.titre}</h2>
  <p class="mt-2 text-encre-soft">{s.intro}</p>
  <form id="rappel-form-el" novalidate class="mt-5 space-y-3"
    data-langue={locale === 'fr' ? '' : locale} data-ok={s.ok} data-ko={s.ko}>
    <div aria-hidden="true" style="position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden;">
      <label>{s.hp}<input id="rappel-hp" name="website_url" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div>
      <label for="rappel-nom" class="block text-xs font-semibold text-encre-soft">{s.nom}</label>
      <input id="rappel-nom" name="fullName" type="text" required autocomplete="name"
        class="mt-1 w-full border border-azur-900/20 bg-blanc-azur px-4 py-2.5 text-encre focus:border-azur-600 focus:outline-none" />
    </div>
    <div>
      <label for="rappel-tel" class="block text-xs font-semibold text-encre-soft">{s.tel}</label>
      <input id="rappel-tel" name="phone" type="tel" required autocomplete="tel" placeholder="06 12 34 56 78" dir="ltr"
        class="mt-1 w-full border border-azur-900/20 bg-blanc-azur px-4 py-2.5 text-encre focus:border-azur-600 focus:outline-none" />
    </div>
    <label class="flex items-start gap-2 text-xs text-encre-soft">
      <input id="rappel-consent" name="consent" type="checkbox" required class="mt-0.5" />
      <span>{s.consent}</span>
    </label>
    <LigneInfoConsentement sombre={false} />
    <button type="submit" id="rappel-submit"
      class="inline-flex w-full items-center justify-center gap-2 bg-brass-400 px-6 py-3 text-sm font-bold text-azur-950 transition-colors hover:bg-brass-300 sm:w-auto">
      {s.bouton}
    </button>
    <p id="rappel-status" role="status" class="text-sm" hidden></p>
  </form>
  <p class="mt-4 border-t border-azur-900/10 pt-4 text-encre-soft">
    {s.pref} <a href={waRappel} rel="noopener" class="font-semibold underline decoration-azur-600 decoration-2 underline-offset-4">{s.wa}</a>.
  </p>
</div>

<script>
  import { corpsRappel, lireTrackingCapte, readAdsConsent } from '../lib/diagnosticFormShared';

  // WJ97 — révèle #rappel-form au clic sur la carte « Demander un rappel »
  // (jamais affiché par défaut : la grille reste dense pour qui ne veut que
  // WhatsApp) puis poste un lead RÉEL via /api/capture-lead, DISTINCT du canal
  // WhatsApp (contactPreference: 'phone_ok', quickCallback: true — lib/lead.ts
  // relâche city/roofType/billRange pour ce chemin, jamais une valeur inventée).
  const openLinks = document.querySelectorAll<HTMLAnchorElement>('[data-rappel-open]');
  const formWrap = document.getElementById('rappel-form');
  openLinks.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (formWrap) {
        formWrap.hidden = false;
        formWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('rappel-nom')?.focus();
      }
    });
  });

  const form = document.getElementById('rappel-form-el') as HTMLFormElement | null;
  const statusEl = document.getElementById('rappel-status');
  const submitBtn = document.getElementById('rappel-submit') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !submitBtn) return;
    const fullName = (document.getElementById('rappel-nom') as HTMLInputElement | null)?.value ?? '';
    const phone = (document.getElementById('rappel-tel') as HTMLInputElement | null)?.value ?? '';
    const consent = (document.getElementById('rappel-consent') as HTMLInputElement | null)?.checked === true;
    const websiteUrl = (document.getElementById('rappel-hp') as HTMLInputElement | null)?.value ?? '';

    const adsConsent = readAdsConsent();
    // WAUD30 — même identifiant pour l'événement Lead du navigateur et le relais CAPI.
    const eventId = (crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2, 12)}`).replace(/[^A-Za-z0-9_-]/g, '');
    statusEl.hidden = true;
    submitBtn.disabled = true;
    try {
      const res = await fetch('/api/capture-lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        // WJ97 — chemin rappel rapide : nom + téléphone seulement (jamais de
        // ville/toiture/facture inventées). WAUD30 : + tracking + eventId ; le
        // beacon Meta n'est ouvert que par un `granted` (décision fondateur 04/11/2026).
        body: JSON.stringify(corpsRappel(
          { fullName, phone, consent, websiteUrl }, adsConsent, lireTrackingCapte(), eventId, form?.dataset.langue || undefined)),
      });
      const data = (await res.json().catch(() => null)) as { ok?: boolean; errors?: Record<string, string> } | null;
      if (res.ok && data?.ok) {
        (window as unknown as { tqPixelTrack?: (e: string, p?: object, id?: string) => void })
          .tqPixelTrack?.('Lead', {}, eventId);
        statusEl.textContent = form?.dataset.ok ?? '';
        statusEl.className = 'text-sm text-azur-700';
        statusEl.hidden = false;
        form.reset();
        form.hidden = true;
      } else {
        statusEl.textContent = form?.dataset.ko ?? '';
        statusEl.className = 'text-sm text-red-700';
        statusEl.hidden = false;
      }
    } catch {
      statusEl.textContent = form?.dataset.ko ?? '';
      statusEl.className = 'text-sm text-red-700';
      statusEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
