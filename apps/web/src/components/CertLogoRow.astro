---
/**
 * WJ35 — CertLogoRow : bandeau de certifications/normes RÉELLES et vérifiables.
 *
 * Pas de logos-images : nous n'avons AUCUN fichier de logo officiel (IEC,
 * AMEE, IRESEN…) sous licence pour cet usage — en fabriquer un serait un faux
 * badge. On affiche donc les mêmes FAITS techniques déjà publiés ailleurs sur
 * le site (garanties.astro, la section « Pourquoi nous faire confiance » de
 * la proposition) sous forme de bandeau typographique sobre, laiton réservé
 * aux libellés clés — cohérent avec la discipline v3 (pas de zellige plein,
 * pas d'icône fabriquée). pending real content from Reda : remplacer par les
 * vrais logos une fois les autorisations d'usage obtenues.
 *
 * (fondateur 2026-08-17) DEUX PROPRIÉTÉS OPTIONNELLES, sans changer le rendu
 * par défaut : `keys` (quels badges rendre) et `hrefs` (vers quelle page chaque
 * badge pointe). La règle fondateur — « un badge n'existe que s'il est
 * cliquable vers une page réelle et bien remplie » — est appliquée par la page
 * hôte, qui SEULE connaît les cibles pertinentes de son contexte (la
 * proposition client lie garanties → /garanties et IEC → la fiche du panneau
 * réellement devisé, et ne rend pas « Loi 82-21 », faute de page dédiée digne).
 */
import {
  PANEL_PERFORMANCE_WARRANTY_YEARS,
  INVERTER_WARRANTY_YEARS,
} from '../lib/warranty';

/** Identifiant stable d'un badge (une page hôte choisit lesquels elle rend). */
type CertKey = 'iec' | 'loi8221' | 'panneaux' | 'onduleur';

interface CertItem {
  key: CertKey;
  label: string;
  labelAr: string;
  detail: string;
  detailEn: string;
  detailAr: string;
}

// WJ99 — `detailEn` ajouté : ce composant est monté sur /proposition/[token]
// (EN disponible) ; sans variante anglaise, un visiteur EN voyait
// silencieusement le libellé FR (repli implicite du mécanisme dual-node).
// (fondateur 2026-08-17) les DURÉES viennent de `lib/warranty.ts`, source
// unique des garanties publiées — plus aucun « 30 » / « 10 » codé en dur ici.
const CERTS: CertItem[] = [
  { key: 'iec', label: 'IEC 61215 / 61730', labelAr: 'IEC 61215 / 61730', detail: 'Modules certifiés', detailEn: 'Certified modules', detailAr: 'ألواح معتمدة' },
  { key: 'loi8221', label: 'Loi 82-21', labelAr: 'القانون 82-21', detail: 'Autoconsommation BT', detailEn: 'Low-voltage self-consumption', detailAr: 'الاستهلاك الذاتي' },
  { key: 'panneaux', label: `${PANEL_PERFORMANCE_WARRANTY_YEARS} ans`, labelAr: `${PANEL_PERFORMANCE_WARRANTY_YEARS} سنة`, detail: 'Garantie performance panneaux', detailEn: 'Panel performance warranty', detailAr: 'ضمان أداء الألواح' },
  { key: 'onduleur', label: `${INVERTER_WARRANTY_YEARS} ans`, labelAr: `${INVERTER_WARRANTY_YEARS} سنوات`, detail: 'Garantie onduleur', detailEn: 'Inverter warranty', detailAr: 'ضمان العاكس' },
];

interface Props {
  /**
   * (fondateur 2026-08-17) badges à rendre, dans cet ordre. Défaut : les
   * quatre — le rendu des pages qui montent `<CertLogoRow />` sans propriété
   * est strictement inchangé.
   */
  keys?: CertKey[];
  /**
   * Lien par badge. RÈGLE FONDATEUR (2026-08-17) : un badge ne vaut que s'il
   * est cliquable vers une page réelle et bien remplie — une page hôte qui
   * connaît ces cibles les passe ici, et le badge devient un lien. Sans lien,
   * le badge reste le bloc typographique historique.
   */
  hrefs?: Partial<Record<CertKey, string>>;
}

const { keys, hrefs = {} } = Astro.props as Props;
const items = (keys && keys.length ? keys : CERTS.map((c) => c.key))
  .map((k) => CERTS.find((c) => c.key === k))
  .filter((c): c is CertItem => !!c);
---

<!-- WJ99 — `aria-label` racine porte les 3 traductions en `data-*` (jamais un
     texte statique figé en FR) : /proposition/[token] bascule sa langue
     ENTIÈREMENT côté client (applyLang('fr'|'en'|'ar'), pas de route /en//ar/
     dédiée pour cette page dynamique) — un `Astro.currentLocale` résolu au
     build serait toujours 'fr' ici, jamais la langue réellement affichée. Le
     script du composant hôte (proposition/[token].astro applyLang) doit lire
     ces data-attrs et réécrire aria-label à chaque bascule ; sans hôte
     compatible (ex. mon-toit.astro, FR-only), l'attribut reste simplement le
     FR ci-dessous — comportement identique à avant. -->
<div class="cert-row" role="list" aria-label="Certifications et garanties"
  data-aria-label-fr="Certifications et garanties"
  data-aria-label-en="Certifications and warranties"
  data-aria-label-ar="الشهادات والضمانات"
  data-n={items.length}
  data-choreo>
  {/* W377 — data-choreo cascades each cert in as the row scrolls into view
      (see v2.css); --i orders the four items left→right. */}
  {items.map((c, i) => (
    hrefs[c.key] ? (
      <a class="cert-row__item cert-row__item--link" role="listitem" style={`--i:${i}`} href={hrefs[c.key]}>
        <p class="cert-row__label">{c.label}</p>
        <p class="cert-row__detail" data-i18n data-fr={c.detail} data-en={c.detailEn} data-ar={c.detailAr}>{c.detail}</p>
      </a>
    ) : (
      <div class="cert-row__item" role="listitem" style={`--i:${i}`}>
        <p class="cert-row__label">{c.label}</p>
        <p class="cert-row__detail" data-i18n data-fr={c.detail} data-en={c.detailEn} data-ar={c.detailAr}>{c.detail}</p>
      </div>
    )
  ))}
</div>

<style>
  .cert-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    /* Quatre badges = rendu historique ; une page hôte qui n'en rend que 2 ou 3
       occupe la largeur au lieu de laisser une colonne vide. */
    .cert-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cert-row[data-n='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cert-row[data-n='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cert-row[data-n='1'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cert-row__item {
    border: 1px solid rgb(255 255 255 / 0.1);
    border-top: 2px solid var(--color-brass-400, #e8b54a);
    padding: 0.9rem 1rem;
    text-align: center;
  }
  /* Badge CLIQUABLE (fondateur 2026-08-17) : même bloc, plus un état de survol
     et un focus visible au clavier — jamais une couleur de lien par défaut. */
  a.cert-row__item--link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  a.cert-row__item--link:hover,
  a.cert-row__item--link:focus-visible {
    border-color: var(--color-brass-400, #e8b54a);
    background: rgb(255 255 255 / 0.04);
  }
  .cert-row__label {
    font-weight: 700;
    font-size: 0.9375rem;
    color: white;
  }
  .cert-row__detail {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-lune-faint, #8d96b4);
  }
</style>
