---
/**
 * WB31 — Bandeau minimal de consentement analytics/tracking.
 *
 * Aucun bandeau n'existait sitewide alors que la capture fbclid/UTM
 * (Layout.astro) et le beacon de funnel (funnelBeacon.ts) tournent déjà
 * avant tout consentement (WB29/WB30). Ce composant fournit le SIGNAL de
 * consentement lu par ces deux gates : un simple flag en localStorage,
 * `tq_consent` ∈ {'granted','denied'} — absent tant que le visiteur n'a pas
 * répondu. Additif uniquement : ne change ni le webhook de lead, ni les
 * champs fbclid/UTM eux-mêmes, ni le seuil 1000 MAD.
 *
 * QJW14 — CE QUE « REFUSER » BLOQUE EXACTEMENT (décision tranchée, documentée
 * ici pour que le fondateur puisse l'inverser d'un mot) :
 *  - « Refuser » (`denied`) bloque, EN PLUS des deux gates historiques, le
 *    beacon Meta CAPI : jusqu'ici téléphone, ville et e-mail HACHÉS partaient
 *    chez Meta même après un refus explicite (cf. `fireCapi` / le bloc QJW14
 *    de src/lib/lead.ts). Les formulaires transmettent désormais ce signal au
 *    serveur sous le champ `adsConsent`.
 *  - PAS ENCORE RÉPONDU (flag absent) : le beacon CAPI ne part pas non plus
 *    (décision fondateur 04/11/2026) : seul « Accepter » l'ouvre.
 *  - La capture du lead et son envoi au CRM ne sont jamais gatés.
 *
 * Léger, discutable (Accepter/Refuser), trilingue (même mécanisme de repli
 * FR que le reste du site : petite table `STR` locale, `getLocaleFromPath`).
 * Disparaît dès qu'un choix est fait — pas de recueil de préférences
 * granulaires, pas de dépendance à un CMP tiers.
 *
 * WAUD66 (D-WAUD-1) — le choix vaut 180 jours : `tq_consent_at` date le choix,
 * ConsentExpiry.astro l'efface en tête de page une fois échu (ou s'il n'a pas de
 * date : donné sous l'ancien texte « mesures anonymes », il est redemandé une
 * fois). Le pied de page (`data-consent-manage`) rouvre le bandeau.
 */
import { getLocaleFromPath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import { localizeNavHref } from '../i18n/pages';

interface Props {
  /**
   * PREVIEW DENSITE (2026-09-15) - rend le bandeau DANS LE FLUX, en fin de
   * page, au lieu de `position: fixed` en bas d'ecran. Motif : sur la page
   * proposition, ce bandeau (z-60) recouvrait en permanence le CTA collant
   * de signature (z-40) tant que le visiteur n'avait pas repondu - le seul
   * appel a l'action permanent de la page etait donc invisible. La SEMANTIQUE
   * de consentement est strictement inchangee : meme id, meme cle
   * localStorage `tq_consent`, memes boutons, meme evenement
   * `tq:consent-change`, meme gating des beacons. Seule la position change.
   * Defaut `false` : toutes les autres pages gardent le bandeau fixe.
   */
  inline?: boolean;
}

const { inline = false } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// WAUD66 (D-WAUD-1 = opt-in strict) : court pour tenir à côté des 2 boutons sur
// téléphone (WAUD3), jamais « anonyme » (un pixel publicitaire ne l'est pas).
const STR: Record<Locale, { text: string; more: string; label: string; accept: string; decline: string }> = {
  fr: {
    text: 'Cookies Meta et Google, seulement si vous acceptez.',
    more: 'Détails',
    label: 'Choix des cookies',
    accept: 'Accepter',
    decline: 'Refuser',
  },
  en: {
    text: 'Meta and Google cookies, only if you accept.',
    more: 'Details',
    label: 'Cookie choice',
    accept: 'Accept',
    decline: 'Decline',
  },
  ar: {
    text: 'ملفات تعريف Meta وGoogle، فقط إذا وافقتم.',
    more: 'التفاصيل',
    label: 'اختيار ملفات التعريف',
    accept: 'قبول',
    decline: 'رفض',
  },
};
const s = STR[locale] ?? STR.fr;
const politiqueHref = localizeNavHref('/politique-de-confidentialite', locale);
---

<div
  id="tq-consent-banner"
  class={inline
    ? 'hidden border-t border-white/10 bg-nuit/95 px-4 pt-3 pb-28 sm:px-6'
    : 'fixed inset-x-0 bottom-0 z-[60] hidden border-t border-white/10 bg-nuit/95 px-3 py-1.5 backdrop-blur sm:px-6'}
  style={inline ? undefined : 'padding-bottom: max(0.375rem, env(safe-area-inset-bottom));'}
  role="region"
  aria-label={s.label}
  data-consent-banner
  data-consent-inline={inline ? 'true' : undefined}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2">
    <p class="min-w-0 text-[0.6875rem] leading-tight text-lune-soft sm:text-xs">
      {s.text} <a href={politiqueHref} class="whitespace-nowrap underline underline-offset-2 hover:text-white">{s.more}</a>
    </p>
    <div class="flex shrink-0 gap-1.5">
      <button
        type="button"
        data-consent-decline
        class="min-h-11 border border-white/20 px-2.5 text-xs font-semibold text-lune-soft transition-colors hover:text-white sm:px-4 sm:text-sm"
      >{s.decline}</button>
      <button
        type="button"
        data-consent-accept
        class="glow min-h-11 bg-brass-400 px-2.5 text-xs font-bold text-azur-950 transition-colors hover:bg-brass-300 sm:px-4 sm:text-sm"
      >{s.accept}</button>
    </div>
  </div>
</div>

<script>
  // WB31 — Signal de consentement : `tq_consent` en localStorage, lu par
  // WB29 (capture fbclid/UTM) et WB30 (funnel beacon). Absent = pas encore
  // répondu → le bandeau s'affiche ; une fois répondu, il ne réapparaît
  // plus (peu importe la valeur), et un événement custom `tq:consent-change`
  // est émis pour toute logique déjà montée sur la page.
  (function () {
    try {
      var KEY = 'tq_consent';
      var existing = localStorage.getItem(KEY);
      var banner = document.getElementById('tq-consent-banner');
      if (!banner) return;

      if (!existing) {
        banner.classList.remove('hidden');
      }

      function setConsent(value: string) {
        try {
          localStorage.setItem(KEY, value);
          localStorage.setItem('tq_consent_at', String(Date.now()));
        } catch (e) {}
        banner?.classList.add('hidden');
        window.dispatchEvent(new CustomEvent('tq:consent-change', { detail: { value: value } }));
      }

      // WAUD66 — « Gérer mes cookies » (pied de page) : rouvre le bandeau.
      document.addEventListener('click', function (e) {
        var cible = e.target as Element | null;
        if (cible && cible.closest && cible.closest('[data-consent-manage]')) {
          banner?.classList.remove('hidden');
        }
      });

      banner.querySelector('[data-consent-accept]')?.addEventListener('click', function () {
        setConsent('granted');
      });
      banner.querySelector('[data-consent-decline]')?.addEventListener('click', function () {
        setConsent('denied');
      });
    } catch (e) {}
  })();
</script>
