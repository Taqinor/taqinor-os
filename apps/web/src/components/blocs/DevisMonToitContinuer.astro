---
// WAUD43 : « Continuer » sous les profils, partagé FR/EN/AR (garde ACAL345).
// Le même bouton est repris SOUS la carte (`id="mt-next-0-bas"`) : un visiteur qui
// vient de localiser son adresse ou de confirmer son repère ne voyait plus aucun
// bouton (celui du haut était sorti de l'écran).
interface Props { id?: string; cadre?: string }
const { id = 'mt-next-0', cadre = 'mt-5 flex justify-end' } = Astro.props;
---
<div class={cadre}>
          <button type="button" id={id}
            class="inline-flex items-center justify-center gap-2 bg-brass-400 px-6 py-3 text-base font-bold text-azur-950 transition-colors hover:bg-brass-300">
<slot />
</button>
</div>
