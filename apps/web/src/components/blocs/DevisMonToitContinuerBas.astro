---
// « Continuer » repris SOUS la carte, partagé FR/EN/AR (garde ACAL345). Après
// « Localiser » ou le repère confirmé, le bouton du haut (WAUD43) est hors écran :
// sans cette reprise le visiteur ne voyait plus aucun bouton (constat du 11/11/2026).
// Libellé par défaut : FR/AR basculable ; la page EN passe le sien par le slot.
import DevisMonToitContinuer from './DevisMonToitContinuer.astro';
---
<DevisMonToitContinuer id="mt-next-0-bas" cadre="flex justify-end border-t border-white/10 p-4">
  <slot>
    <span data-i18n data-fr="Continuer" data-ar="متابعة">Continuer</span>
    <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="3,1 7,5 3,9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </slot>
</DevisMonToitContinuer>
