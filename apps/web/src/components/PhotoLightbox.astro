---
/**
 * Lightbox photo accessible partagée (ENF19) — était recopiée dans les trois
 * `realisations/index.astro` et les trois `realisations/[slug].astro` (fr/en/ar) :
 * même coquille, même script (focus-trap, Échap, flèches), mêmes styles. Seuls
 * changent les libellés (`locale`) et le sélecteur des déclencheurs (`trigger`),
 * lu par le script dans `data-trigger`. Les déclencheurs portent
 * `data-lightbox-src/alt/label` ; sans JS ils restent de simples boutons.
 */
interface Props {
  locale: 'fr' | 'en' | 'ar';
  trigger: string;
}
const { locale, trigger } = Astro.props;
const LABELS = {
  fr: { dialog: 'Photo agrandie', close: 'Fermer (Échap)', prev: 'Photo précédente (←)', next: 'Photo suivante (→)' },
  en: { dialog: 'Enlarged photo', close: 'Close (Esc)', prev: 'Previous photo (←)', next: 'Next photo (→)' },
  ar: { dialog: 'صورة مكبّرة', close: 'إغلاق (Échap)', prev: 'الصورة السابقة (←)', next: 'الصورة التالية (→)' },
}[locale];
---

<div
  data-photo-lightbox
  data-trigger={trigger}
  data-variant={locale}
  role="dialog"
  aria-modal="true"
  aria-label={LABELS.dialog}
  class="lightbox-overlay"
  hidden
>
  <button type="button" data-lb="close" class="lightbox-close" aria-label={LABELS.close}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>
  <button type="button" data-lb="prev" class="lightbox-arrow lightbox-arrow--prev" aria-label={LABELS.prev}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="m15 18-6-6 6-6"/>
    </svg>
  </button>
  <div class="lightbox-img-wrap">
    <img data-lb="img" src="" alt="" class="lightbox-img" />
    <p data-lb="label" class="lightbox-label"></p>
  </div>
  <button type="button" data-lb="next" class="lightbox-arrow lightbox-arrow--next" aria-label={LABELS.next}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </button>
</div>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(7 11 29 / 0.94);
    padding: 1rem;
  }
  .lightbox-overlay[hidden] {
    display: none;
  }
  .lightbox-img-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: min(90vw, 1200px);
    gap: 0.75rem;
  }
  .lightbox-img {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 32px 80px -20px rgb(0 0 0 / 0.8);
  }
  .lightbox-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-lune-soft);
    text-align: center;
  }
  .lightbox-close,
  .lightbox-arrow {
    position: fixed;
    z-index: 9001;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(7 11 29 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.2);
    color: var(--color-lune);
    cursor: pointer;
    transition: color 200ms, border-color 200ms;
  }
  .lightbox-arrow {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-close:hover,
  .lightbox-close:focus-visible,
  .lightbox-arrow:hover,
  .lightbox-arrow:focus-visible {
    color: var(--color-brass-300);
    border-color: var(--color-brass-400);
    outline: none;
  }

  /* FR et AR : propriétés logiques (marges de sécurité des encoches). */
  .lightbox-overlay[data-variant='fr'] .lightbox-close,
  .lightbox-overlay[data-variant='ar'] .lightbox-close {
    top: max(1.25rem, env(safe-area-inset-top));
    inset-inline-end: max(1.25rem, env(safe-area-inset-right));
  }
  .lightbox-overlay[data-variant='fr'] .lightbox-arrow--prev { inset-inline-start: max(1rem, env(safe-area-inset-left)); }
  .lightbox-overlay[data-variant='fr'] .lightbox-arrow--next { inset-inline-end: max(1rem, env(safe-area-inset-right)); }

  /* EN : positions physiques + miroir RTL défensif (WC3). */
  .lightbox-overlay[data-variant='en'] .lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
  }
  .lightbox-overlay[data-variant='en'] .lightbox-arrow--prev { left: 1rem; }
  .lightbox-overlay[data-variant='en'] .lightbox-arrow--next { right: 1rem; }
  [dir="rtl"] .lightbox-overlay[data-variant='en'] .lightbox-arrow--prev { left: auto; right: 1rem; }
  [dir="rtl"] .lightbox-overlay[data-variant='en'] .lightbox-arrow--next { right: auto; left: 1rem; }

  /* AR (WA23) : « précédent » reste à droite visuellement, « suivant » à gauche ;
     propriétés logiques + chevrons SVG retournés. */
  .lightbox-overlay[data-variant='ar'] .lightbox-arrow--prev {
    inset-inline-start: max(1rem, env(safe-area-inset-left));
    transform: translateY(-50%) scaleX(-1);
  }
  .lightbox-overlay[data-variant='ar'] .lightbox-arrow--next {
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    transform: translateY(-50%) scaleX(-1);
  }
</style>

<script>
  // Lightbox accessible, vanilla JS, focus-trap, clavier Échap/flèches.
  interface LbItem {
    src: string;
    alt: string;
    label: string;
  }

  const overlay = document.querySelector<HTMLElement>('[data-photo-lightbox]');
  const imgEl = overlay?.querySelector<HTMLImageElement>('[data-lb="img"]') ?? null;
  const labelEl = overlay?.querySelector<HTMLElement>('[data-lb="label"]') ?? null;
  const closeBtn = overlay?.querySelector<HTMLButtonElement>('[data-lb="close"]') ?? null;
  const prevBtn = overlay?.querySelector<HTMLButtonElement>('[data-lb="prev"]') ?? null;
  const nextBtn = overlay?.querySelector<HTMLButtonElement>('[data-lb="next"]') ?? null;

  if (overlay && imgEl && labelEl && closeBtn && prevBtn && nextBtn) {
    let items: LbItem[] = [];
    let current = 0;
    let lastFocus: HTMLElement | null = null;

    function show(idx: number) {
      if (!items.length) return;
      current = ((idx % items.length) + items.length) % items.length;
      imgEl!.src = items[current].src;
      imgEl!.alt = items[current].alt;
      labelEl!.textContent = items[current].label;
      overlay!.hidden = false;
      overlay!.removeAttribute('hidden');
      // Flèches visibles seulement s'il y a plusieurs photos
      const multi = items.length > 1;
      prevBtn!.style.display = multi ? '' : 'none';
      nextBtn!.style.display = multi ? '' : 'none';
      closeBtn!.focus();
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    // Déclencheurs : le sélecteur vient de la page (galerie + phases réunies)
    const triggers = document.querySelectorAll<HTMLElement>(overlay.dataset.trigger ?? '');
    items = Array.from(triggers).map((t) => ({
      src: t.dataset.lightboxSrc ?? '',
      alt: t.dataset.lightboxAlt ?? '',
      label: t.dataset.lightboxLabel ?? '',
    }));

    triggers.forEach((t, idx) => {
      t.addEventListener('click', (e) => {
        e.preventDefault();
        lastFocus = t;
        show(idx);
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));

    overlay.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
      // Focus-trap : Tab reste dans la lightbox
      if (e.key === 'Tab') {
        const focusable = Array.from(
          overlay!.querySelectorAll<HTMLElement>('button, [href], input, [tabindex]:not([tabindex="-1"])')
        ).filter((el) => !el.hidden && el.offsetParent !== null);
        if (!focusable.length) return;
        const edge = e.shiftKey ? focusable[0] : focusable[focusable.length - 1];
        const wrapTo = e.shiftKey ? focusable[focusable.length - 1] : focusable[0];
        if (document.activeElement === edge) {
          e.preventDefault();
          wrapTo.focus();
        }
      }
    });

    // Clic sur le fond (hors image) : ferme
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
  }
</script>
