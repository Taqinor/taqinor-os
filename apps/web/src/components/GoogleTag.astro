---
/**
 * Google tag (gtag.js) — Google Ads + GA4, le pendant Google de MetaPixel.astro.
 *
 * CHARGEMENT — uniquement si PUBLIC_GOOGLE_TAG_ID porte au moins un ID valide
 * (`AW-…` et/ou `G-…`, séparés par des virgules ; lib/googleTag.ts). Sans ID,
 * le composant ne rend RIEN et `window.tqGoogleTrack` reste indéfini — les
 * appelants se gardent donc toujours (`window.tqGoogleTrack && …`).
 *
 * CONSENTEMENT — WAUD12 (D-WAUD-1 = opt-in strict), mêmes règles que le pixel :
 * Consent Mode « denied » par défaut sur les 4 signaux AVANT tout `config` ;
 * gtag.js n'est pas chargé tant que `tq_consent` n'est pas 'granted'. Au grant
 * (au chargement ou sur la page) : `consent update`, `js`, `config`, conversions
 * en attente, puis gtag.js injecté après l'affichage. Refus : update « denied ».
 *
 * CONVERSION — `window.tqGoogleTrack(eventId)` est appelé par les pages du
 * tunnel AU MÊME ENDROIT que `tqPixelTrack('Lead', …)` (lead qualifié) avec le
 * MÊME eventId (WJ92), passé en `transaction_id` pour que Google dédoublonne :
 *  (a) conversion Google Ads si PUBLIC_GOOGLE_ADS_LEAD_SEND_TO est posé ;
 *  (b) événement GA4 `generate_lead`.
 */
import { parseGoogleTagIds, parseLeadSendTo } from '../lib/googleTag';

const tagIds = parseGoogleTagIds(import.meta.env.PUBLIC_GOOGLE_TAG_ID as string | undefined);
const leadSendTo = parseLeadSendTo(import.meta.env.PUBLIC_GOOGLE_ADS_LEAD_SEND_TO as string | undefined);
---

{tagIds.length > 0 && (
  <script is:inline define:vars={{ tqGoogleTagIds: tagIds, tqGoogleLeadSendTo: leadSendTo }}>
    (function () {
      var lireChoix = function () {
        try {
          return localStorage.getItem('tq_consent');
        } catch (e) {
          return null;
        }
      };
      var signaux = function (valeur) {
        return { ad_storage: valeur, analytics_storage: valeur, ad_user_data: valeur, ad_personalization: valeur };
      };
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      /* Refus par défaut, avant tout config. */
      window.gtag('consent', 'default', signaux('denied'));
      var charge = false;
      var charger = function () {
        if (charge) return;
        charge = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(tqGoogleTagIds[0]);
        document.head.appendChild(s);
      };
      var apresAffichage = function () {
        var libre = function () {
          if (window.requestIdleCallback) window.requestIdleCallback(charger, { timeout: 3000 });
          else setTimeout(charger, 1500);
        };
        if (document.readyState === 'complete') libre();
        else window.addEventListener('load', libre, { once: true });
      };
      var envoyerLead = function (eventId) {
        var extra = eventId ? { transaction_id: String(eventId) } : {};
        if (tqGoogleLeadSendTo) {
          window.gtag('event', 'conversion', Object.assign({ send_to: tqGoogleLeadSendTo }, extra));
        }
        window.gtag('event', 'generate_lead', extra);
      };
      var accorde = false;
      var configure = false;
      var enAttente = [];
      var demarrer = function () {
        if (accorde) return;
        accorde = true;
        window.gtag('consent', 'update', signaux('granted'));
        if (!configure) {
          configure = true;
          window.gtag('js', new Date());
          for (var i = 0; i < tqGoogleTagIds.length; i++) window.gtag('config', tqGoogleTagIds[i]);
        }
        enAttente.splice(0).forEach(envoyerLead);
        apresAffichage();
      };
      if (lireChoix() === 'granted') demarrer();
      window.addEventListener('tq:consent-change', function (e) {
        var choix = e && e.detail && e.detail.value;
        if (choix === 'granted') demarrer();
        if (choix === 'denied') {
          accorde = false;
          enAttente = [];
          try { window.gtag('consent', 'update', signaux('denied')); } catch (err) {}
        }
      });
      /* Pont pour les pages (tunnel /devis/mon-toit) : gardé jusqu'au choix, no-op si refusé. */
      window.tqGoogleTrack = function (eventId) {
        try {
          if (lireChoix() === 'denied') return;
          if (accorde) envoyerLead(eventId);
          else enAttente.push(eventId);
        } catch (err) {}
      };
    })();
  </script>
)}
