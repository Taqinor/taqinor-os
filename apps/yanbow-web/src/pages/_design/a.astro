---
// Tour design (YBW42) — candidat A « Encre et papier » (studio éditorial).
// Route PRIVÉE injectée par astro.config.mjs : `/_design/a/` (FR) et
// `/_design/a/en/` (EN) — noindex, hors sitemap, liée nulle part. Texte =
// dictionnaire NEUTRE commun aux trois candidats. Supprimée par YBW44.
import '../../styles/global.css';
import '../../styles/candidates/a.css';
import Logo from '../../components/Logo.astro';
import TraitFleche from '../../components/motif/TraitFleche.astro';
import { LANG_HTML, type Locale } from '../../i18n/config';
import { PRODUITS } from '../../lib/brand';
import Capture from '../../styles/candidates/Capture.astro';
import Entete from '../../styles/candidates/Entete.astro';
import Pied from '../../styles/candidates/Pied.astro';
import Tete from '../../styles/candidates/Tete.astro';
import { cheminsStatiques, textes } from '../../styles/candidates/candidats';

export function getStaticPaths() {
  return cheminsStatiques();
}

const { locale } = Astro.props as { locale: Locale };
const tx = textes(locale);
// Une carte par produit de brand.ts, dans son ordre (ancre = sa clé), chacune avec un écran du kit YBW41.
const ECRANS = ['calepinage-3d', 'approbations'];
const produits = (Object.keys(PRODUITS) as (keyof typeof PRODUITS)[]).map((cle, i) => ({
  id: cle,
  nom: PRODUITS[cle].nom,
  ecran: ECRANS[i],
}));
const etapes = ['etape1', 'etape2', 'etape3', 'etape4'];
---
<!doctype html>
<html lang={LANG_HTML[locale]} data-candidat="a">
  <head>
    <Tete candidat="a" locale={locale} />
  </head>
  <body>
    <Entete candidat="a" locale={locale} />
    <main>
      <section class="hero" aria-labelledby="hero-titre">
        <div class="conteneur">
          <p class="surtitre">{tx('hero.surtitre')}</p>
          <h1 id="hero-titre" class="hero-titre">{tx('hero.titre')}</h1>
          <div class="hero-trajectoire">
            <TraitFleche longueur={46} class="hero-fleche fleche-courte" anime />
            <TraitFleche longueur={92} class="hero-fleche fleche-moyenne" anime />
            <TraitFleche longueur={240} class="hero-fleche fleche-longue" anime />
            <a class="bouton" href="#rendez-vous">{tx('hero.cta')}</a>
          </div>
          <div class="hero-bas">
            <p class="hero-intro">{tx('hero.intro')}</p>
            <a class="lien-fleche" href="#produits">{tx('hero.secondaire')}</a>
          </div>
        </div>
      </section>

      <div class="conteneur">
        <Capture ecran="crm-pipeline" locale={locale} class="capture-hero" prioritaire />
      </div>

      <section id="produits" class="section" aria-labelledby="produits-titre">
        <div class="conteneur">
          <header class="section-tete">
            <p class="surtitre">{tx('produits.surtitre')}</p>
            <h2 id="produits-titre">{tx('produits.titre')}</h2>
            <p>{tx('produits.intro')}</p>
          </header>
          <div class="produits-grille">
            {produits.map((p) => (
              <article id={p.id} class="produit" aria-labelledby={`${p.id}-titre`}>
                <p class="produit-surtitre">{tx('produit.surtitre')}</p>
                <h3 id={`${p.id}-titre`}>{p.nom}</h3>
                <p class="produit-description">{tx('produit.description')}</p>
                <ul class="points">
                  <li>{tx('produit.point1')}</li>
                  <li>{tx('produit.point2')}</li>
                  <li>{tx('produit.point3')}</li>
                </ul>
                <Capture ecran={p.ecran} locale={locale} />
                <a class="lien-fleche" href="#rendez-vous">{tx('produit.lien')}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="sur-mesure" class="section" aria-labelledby="sur-mesure-titre">
        <div class="conteneur sur-mesure-grille">
          <div class="sur-mesure-texte">
            <p class="surtitre">{tx('surMesure.surtitre')}</p>
            <h2 id="sur-mesure-titre">{tx('surMesure.titre')}</h2>
            <p>{tx('surMesure.texte')}</p>
          </div>
          <ol class="etapes">
            {etapes.map((e) => (
              <li>
                <span class="etape-titre">{tx(`surMesure.${e}`)}</span>
                <span class="etape-detail">{tx('surMesure.detail')}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="societe" class="section societe" aria-labelledby="societe-titre">
        <div class="conteneur societe-int">
          <Logo variante="symbole" taille={88} locale={locale} />
          <div>
            <p class="surtitre">{tx('societe.surtitre')}</p>
            <h2 id="societe-titre">{tx('societe.titre')}</h2>
            <p>{tx('societe.texte')}</p>
          </div>
        </div>
      </section>

      <section id="rendez-vous" class="bande" aria-labelledby="rdv-titre">
        <div class="conteneur">
          <h2 id="rdv-titre">{tx('rdv.titre')}</h2>
          <p>{tx('rdv.texte')}</p>
          <div class="hero-trajectoire">
            <TraitFleche longueur={46} class="hero-fleche fleche-courte" />
            <TraitFleche longueur={92} class="hero-fleche fleche-moyenne" />
            <TraitFleche longueur={240} class="hero-fleche fleche-longue" />
            <a class="bouton" href="#rendez-vous">{tx('rdv.bouton')}</a>
          </div>
        </div>
      </section>
    </main>
    <Pied locale={locale} />
  </body>
</html>
