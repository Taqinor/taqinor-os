---
// En-tête de document commun aux candidats (YBW42) : page PRIVÉE (noindex,
// nofollow), polices critiques DU candidat préchargées, icônes YBW37.
import type { Locale } from '../../i18n/config';
import { FICHES, textes, type Candidat } from './candidats';

interface Props {
  candidat: Candidat;
  locale: Locale;
}
const { candidat, locale } = Astro.props;
const tx = textes(locale);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>{`${tx(`candidats.${candidat}`)} · ${tx('meta.titre')}`}</title>
<meta name="description" content={tx('meta.description')} />
{FICHES[candidat].polices.map((p) => <link rel="preload" href={p} as="font" type="font/woff2" crossorigin />)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
<link rel="manifest" href="/site.webmanifest" />
