---
// Ruban « page privée » + en-tête commun aux candidats (YBW42). Le BALISAGE
// est partagé ; chaque candidat le met en page avec SA feuille (`<id>.css`).
// Logo (YBW36) : le nom à 180 px, minimum de la charte — jamais le slogan ici.
// Navigation : 4 entrées + UN appel « Prendre rendez-vous » (plan de YBW60) ;
// ancres internes seulement (les pages n'existent pas encore : aucun lien mort).
// Mobile : un <details> natif, sans script (CSP `script-src 'self'`).
import Logo from '../../components/Logo.astro';
import { LANG_HTML, type Locale } from '../../i18n/config';
import { PRODUITS } from '../../lib/brand';
import { cheminCandidat, textes, type Candidat } from './candidats';

interface Props {
  candidat: Candidat;
  locale: Locale;
}
const { candidat, locale } = Astro.props;
const tx = textes(locale);
const autre: Locale = locale === 'en' ? 'fr' : 'en';
const entrees = [
  ...(Object.keys(PRODUITS) as (keyof typeof PRODUITS)[]).map((cle) => ({ href: `#${cle}`, texte: PRODUITS[cle].nom })),
  { href: '#sur-mesure', texte: tx('nav.surMesure') },
  { href: '#societe', texte: tx('nav.societe') },
];
---
<div class="ruban" data-ruban>
  <div class="conteneur ruban-int">
    <strong class="ruban-nom">{tx(`candidats.${candidat}`)}</strong>
    <span class="ruban-note">{tx('ruban')}</span>
  </div>
</div>
<header class="entete">
  <div class="conteneur entete-int">
    <a class="entete-logo" href={cheminCandidat(candidat, locale)}>
      <Logo variante="nom" taille={180} locale={locale} />
    </a>
    <nav class="nav-bureau" aria-label={tx('nav.aria')}>
      <ul>
        {entrees.map((e) => <li><a href={e.href}>{e.texte}</a></li>)}
      </ul>
    </nav>
    <div class="entete-actions">
      <a class="lien-langue" href={cheminCandidat(candidat, autre)} hreflang={autre} lang={LANG_HTML[autre]}>
        {tx('nav.langue')}
      </a>
      <a class="bouton bouton-entete" href="#rendez-vous">{tx('nav.rdv')}</a>
    </div>
    <details class="nav-mobile">
      <summary><span class="nav-mobile-icone" aria-hidden="true"></span>{tx('nav.menu')}</summary>
      <nav aria-label={tx('nav.ariaMobile')}>
        <ul>
          {entrees.map((e) => <li><a href={e.href}>{e.texte}</a></li>)}
          <li>
            <a href={cheminCandidat(candidat, autre)} hreflang={autre} lang={LANG_HTML[autre]}>
              {tx('nav.langue')}
            </a>
          </li>
          <li><a class="bouton" href="#rendez-vous">{tx('nav.rdv')}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
