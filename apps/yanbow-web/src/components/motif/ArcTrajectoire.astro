---
// Fragment d'arc de trajectoire (YBW40) — rayon et trait aux PROPORTIONS de la
// panse du B et du fût de la flèche (mesures.ts). Décoratif : aria-hidden,
// couleur = jeton, statique par défaut ; `anime` jamais sur l'élément LCP.
import './motif.css';
import { MESURES, RAPPORTS } from './mesures';

interface Props {
  /** Ouverture de l'arc en degrés (0 < angle <= 180). */
  angle?: number;
  largeur?: string;
  anime?: boolean;
  class?: string;
}
const { angle = 90, largeur = '100%', anime = false, class: classe } = Astro.props;
if (!(angle > 0 && angle <= 180)) throw new Error(`ArcTrajectoire : angle hors de ]0, 180] (${angle})`);
const e = MESURES.fut.epaisseur;
const R = RAPPORTS.panseSurFut * e;
const a = (angle * Math.PI) / 180;
const r = (v: number) => Math.round(v * 100) / 100;
// Arc centré en (0, 0), de l'angle -a/2 à +a/2 autour de l'axe horizontal.
const x0 = R * Math.cos(-a / 2);
const y0 = R * Math.sin(-a / 2);
const x1 = R * Math.cos(a / 2);
const y1 = R * Math.sin(a / 2);
const m = e / 2;
const minX = Math.min(x0, x1) - m;
const vb = `${r(minX)} ${r(y0 - m)} ${r(R + m - minX)} ${r(y1 - y0 + 2 * m)}`;
---
<svg
  class:list={['motif', 'motif-arc-fragment', { 'motif-anime': anime }, classe]}
  viewBox={vb}
  style={`inline-size:${largeur}`}
  aria-hidden="true"
  focusable="false"
  data-motif="arc"
>
  <path class="motif-arc" d={`M${r(x0)} ${r(y0)}A${r(R)} ${r(R)} 0 0 1 ${r(x1)} ${r(y1)}`} stroke-width={e} pathLength="1" />
</svg>
