---
// Une affirmation publique du registre (YBW61-66), rendue telle quelle et
// marquée `data-affirmation` (fiche de relecture YBW67, tests/pages.test.ts).
import type { Locale } from '../i18n/config';
import { texteAffirmation } from '../lib/affirmer';

interface Props {
  id: string;
  locale: Locale;
  /** Balise rendue (paragraphe par défaut). */
  balise?: 'p' | 'li' | 'h1' | 'h2' | 'h3' | 'span';
  class?: string;
}
const { id, locale, balise: Balise = 'p', class: classe } = Astro.props;
---
<Balise class={classe} data-affirmation={id}>{texteAffirmation(id, locale)}</Balise>
