---
// Capture produit (D-YBW-10), reprise du tour design (YBW42) pour le site.
// Une capture REVUE du kit YBW41 (`capturesPubliables`) est rendue en
// AVIF/WebP avec largeur/hauteur et sa légende « Données fictives ». Tant
// qu'aucune capture revue n'existe (registre vide), un CADRE NEUTRE la
// remplace — jamais une photo d'illustration, jamais une personne, jamais un
// faux écran dessiné. La légende est rendue dans les deux cas.
import type { Locale } from '../i18n/config';
import { lecteur } from '../i18n/utils';
import { fr } from '../i18n/components/chrome.fr';
import { en } from '../i18n/components/chrome.en';
import { capturesPubliables, ECRANS_PRODUIT, LEGENDE } from '../data/productScreens';

interface Props {
  /** Identifiant d'écran du kit (`ECRANS_PRODUIT`). */
  ecran: string;
  locale: Locale;
  class?: string;
  /** Image prioritaire (au-dessus de la ligne de flottaison) : jamais animée. */
  prioritaire?: boolean;
}
const { ecran, locale, class: classe, prioritaire = false } = Astro.props;
const tx = lecteur(fr, en, locale);
const fiche = ECRANS_PRODUIT.find((e) => e.id === ecran);
if (!fiche) throw new Error(`Capture : écran inconnu « ${ecran} »`);

const fichiers = import.meta.glob('../assets/product/*.{avif,webp}', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const url = (nom: string) => Object.entries(fichiers).find(([k]) => k.endsWith(`/${nom}`))?.[1];
const alt = fiche.alt[locale];
const capture = alt ? capturesPubliables(ecran).find((c) => url(c.avif) && url(c.webp)) : undefined;
---
<figure class:list={['capture', classe]} data-capture={ecran} data-capture-etat={capture ? 'image' : 'emplacement'}>
  <div class="capture-cadre">
    {capture ? (
      <picture>
        <source srcset={url(capture.avif)} type="image/avif" />
        <img
          src={url(capture.webp)}
          width={capture.width}
          height={capture.height}
          alt={alt}
          loading={prioritaire ? 'eager' : 'lazy'}
          fetchpriority={prioritaire ? 'high' : undefined}
          decoding="async"
        />
      </picture>
    ) : (
      <div class="capture-emplacement">
        <span class="capture-emplacement-titre">{tx('capture.attente')}</span>
        <span class="capture-emplacement-note">{tx('capture.note')}</span>
      </div>
    )}
  </div>
  <figcaption class="capture-legende">{LEGENDE[locale]}</figcaption>
</figure>
