---
// Gabarit UNIQUE des pages (YBW60). En-tête de document : titre et
// description de la page, canonique (seulement quand le domaine final est
// posé, src/lib/site.ts — porte YBW12 : aucun lien vers un domaine non choisi),
// hreflang + x-default depuis le registre `pages.ts` (langues ACTIVES
// seulement), Open Graph / Twitter avec l'image YBW45 de la page, JSON-LD
// `Organization` SANS aucun champ inventé (ni date de création, ni adresse,
// ni numéro : `legal.ts` est vide), préchargement des 2 polices critiques,
// icônes YBW37. AUCUN script de capture UTM/fbclid, AUCUN service worker,
// AUCUN analytics : le seul script est le rapport d'erreurs client (YBW20).
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANG_HTML, LOCALES_ACTIVES, type Locale } from '../i18n/config';
import { PAGES, type PageId } from '../i18n/pages';
import { alternates } from '../i18n/utils';
import { MARQUE } from '../lib/brand';
import { ORIGINE_CANONIQUE } from '../lib/site';
import { POLICES_PRECHARGEES } from '../lib/typo';
import registreOg from '../data/og.json';

interface Props {
  page: PageId;
  locale: Locale;
  titre: string;
  description: string;
  /** Surcharge des langues actives — réservée aux tests (fixture). */
  locales?: readonly Locale[];
  /** Surcharge de l'origine canonique — réservée aux tests (fixture). */
  origine?: string | null;
}
const { page, locale, titre, description, locales = LOCALES_ACTIVES, origine = ORIGINE_CANONIQUE } = Astro.props;
const chemins = PAGES[page];
const absolue = (chemin: string) => (origine ? new URL(chemin, origine).href : chemin);
const liens = alternates(chemins, locales).map((a) => ({ ...a, href: absolue(a.href) }));
const canonique = origine ? absolue(chemins[locale]) : null;
const images = (registreOg as { images: Record<string, { fichier: string } | undefined> }).images;
const og = images[`${page}.${locale}`];
const ogImage = og ? absolue(`/og/${og.fichier}`) : null;
const OG_LOCALE: Record<Locale, string> = { fr: 'fr_FR', en: 'en_GB' };
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: MARQUE, ...(origine ? { url: origine } : {}) };
---
<!doctype html>
<html lang={LANG_HTML[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {canonique && <link rel="canonical" href={canonique} />}
    {liens.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {POLICES_PRECHARGEES.map((p) => <link rel="preload" href={p} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={MARQUE} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {canonique && <meta property="og:url" content={canonique} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header page={page} locale={locale} locales={locales} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/client-error';
    </script>
  </body>
</html>
