# ── Base de données PostgreSQL ────────────────────────────────
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=change_me_in_production
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MinIO (stockage fichiers PDF / uploads) ───────────────────
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_PDF=erp-pdf
MINIO_BUCKET_UPLOADS=erp-uploads
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me_in_production

# ── SCA13 : sauvegarde hors-boite (OFF par defaut) ─────────────
# Cible S3-compatible EXTERNE pour la copie hors-boite des dumps Postgres
# (core/backup.py, dump_database). OFF sans les 4 variables ci-dessous
# TOUTES posees : aucun appel reseau supplementaire, comportement identique
# a avant SCA13. Choix du fournisseur (Hetzner Storage Box, Backblaze B2,
# AWS S3, autre — tout endpoint compatible S3 fonctionne) = decision
# fondateur. Voir docs/scale-runway.md section SCA13 pour l'activation.
# BACKUP_OFFSITE_ENDPOINT=https://<endpoint-s3-compatible>
# BACKUP_OFFSITE_BUCKET=<nom-bucket>
# BACKUP_OFFSITE_ACCESS_KEY=<cle>
# BACKUP_OFFSITE_SECRET_KEY=<secret>
# BACKUP_OFFSITE_RETAIN_LAST=7

# ── Django ────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=erp_agentique.settings.dev
DJANGO_SECRET_KEY=change_me_generate_with_python_secrets
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# YHARD1 — chiffrement au repos des champs sensibles (TOTP, RIB, N° CNSS/AMO/CIMR,
# CIN, secrets webhook, clé privée VAPID). VIDE = aucun chiffrement (comportement
# identique à l'existant). Renseigner une (ou plusieurs, séparées par des virgules
# pour la rotation) clé Fernet : python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# ASEC52 — attribut Secure des cookies JWT / device_trust_id. ABSENT (défaut,
# recommandé) = décidé par requête : HTTPS vu au bord (X-Forwarded-Proto relayé
# par nginx depuis Caddy) => Secure ; sinon Secure seulement si DEBUG=False.
# 1 = toujours Secure ; 0 = jamais (secours pour un accès en HTTP pur).
# AUTH_COOKIE_SECURE=
# AFAC22 — origine publique de l'ERP pour les liens client ABSOLUS (paiement,
# QR facture, partages WhatsApp, signature GED). Vide = liens relatifs / repli
# sur la requête (comportement historique). Exemple production :
# PUBLIC_BASE_URL=https://api.taqinor.ma
# ASEC48 — réglages de la PRODUCTION (settings.prod). Liste complète, valeurs
# et procédure de bascule / retour arrière : docs/production.md, section
# « Bascule vers settings.prod ». En développement, laisser commenté.
# Origines cross-origin autorisées (csv, schéma inclus). Absent = taqinor.ma +
# www.taqinor.ma (settings.prod) ; en dev, la liste localhost de settings.dev.
# CORS_ALLOWED_ORIGINS=https://taqinor.ma,https://www.taqinor.ma
# Origines de confiance CSRF (csv, schéma inclus) — en prod, complétées
# automatiquement des origines CORS.
# CSRF_TRUSTED_ORIGINS=https://api.taqinor.ma,https://178-105-192-116.sslip.io
# Nombre de proxies À NOUS qui ajoutent un saut à X-Forwarded-For (CRX30,
# ASEC15). Absent = 1 hors tests (Caddy → nginx → Django) ; 0 refusé en prod.
# NUM_PROXIES=1
# Chemin de l'admin Django (lu par erp_agentique/urls.py), défaut
# api/django/admin/. Recommandé en prod : un chemin non devinable SOUS
# api/django/ (nginx ne relaie que ce préfixe), terminé par « / ».
# DJANGO_ADMIN_URL=api/django/admin/
# Inscription publique de nouvelles sociétés (D-ASEC-2) : 0 = éteinte (défaut).
# TENANT_SIGNUP_ENABLED=0

# ── SCA16 : dimensionnement gunicorn/celery (optionnel) ────────
# Surcharge les workers/threads gunicorn et la concurrency Celery sans
# éditer docker-compose*.yml. Défauts = comportement ACTUEL (commentés
# ci-dessous) : gunicorn_workers=3/threads=4 en prod (4/pas de --threads en
# dev), CELERY_CONCURRENCY vide = défaut natif Celery (cpu_count()).
# Formule de dimensionnement : docs/scale-runway.md section SCA16.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# CELERY_CONCURRENCY=
# CELERY_INTERACTIVE_CONCURRENCY=2

# ── FastAPI ───────────────────────────────────────────────────
FASTAPI_SECRET_KEY=change_me_generate_with_python_secrets

# ── API IA / OCR (ZhipuAI GLM) ───────────────────────────────
# Obtenir la clé sur : https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ── Agent SQL (LangChain + Groq) ─────────────────────────────
# Obtenir la clé sur : https://console.groq.com/
GROQ_API_KEY=your_groq_api_key
SQL_AGENT_PROVIDER=groq
SQL_AGENT_MODEL=llama-3.3-70b-versatile
# AANA30 — Rôle Postgres DÉDIÉ de l'agent SQL (LOGIN NOSUPERUSER NOBYPASSRLS,
# SELECT sur les seules tables de la liste blanche). À provisionner UNE fois
# (section 4 de backend/db/rls_roles.sql, mot de passe à choisir), puis
# décommenter et renseigner. Sans SQL_AGENT_DB_USER : agent DÉSACTIVÉ en
# production, repli propriétaire en développement seulement. Jamais de secret
# réel dans ce fichier.
# SQL_AGENT_DB_USER=sql_agent_ro
# SQL_AGENT_DB_PASSWORD=change_me_robuste
# Secret HMAC (≥ 32 caractères, `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# qui signe la CONFIRMATION des actions de l'agent (apps/agent/services.py) ;
# absent = confirmation refusée (fail-closed).
# AGENT_HMAC_SECRET=change_me_generate_with_python_secrets

# ── Autres clés API (optionnel) ───────────────────────────────
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key

# ── ENG17 : fabrique créative (OFF par défaut, key-gated) ──────
# Chaque adaptateur de apps/adsengine/creative_factory.py est ACTIVÉ uniquement
# si sa clé est posée ; sans clé il no-ope proprement (aucun appel réseau, aucun
# asset créé). Aucune dépendance pip nouvelle (httpx). Décommentez + renseignez
# pour activer un fournisseur.
# ZAPCAP_API_KEY=          # sous-titrage de reels
# FAL_API_KEY=             # B-roll / statiques génératifs
# TEMPLATED_API_KEY=       # stamps de marque
# ELEVENLABS_API_KEY=      # voix FR / darija
# JSON2VIDEO_API_KEY=      # assemblage d'explainers

# ── ADSENG-ODOO : connecteur Odoo LECTURE SEULE (OFF par défaut) ──
# Le coût-par-signature du moteur pub se calcule aussi contre les VRAIES
# signatures du fondateur (crm.lead gagnés + sale.order confirmés) qui vivent
# dans Odoo Online. Connecteur JSON-RPC STRICTEMENT lecture-seule (jamais
# create/write/unlink, jamais SQL — règle #1). Sans ces 4 variables, tout
# no-ope (aucun appel réseau). Diagnostic : manage.py odoo_pull.
# ODOO_URL=https://taqinor-solutions.odoo.com   # URL de l'instance Odoo Online
# ODOO_DB=taqinor-solutions                      # nom de la base Odoo
# ODOO_USERNAME=                                 # login utilisateur Odoo
# ODOO_API_KEY=                                  # clé d'API Odoo (= mot de passe RPC)
# ASEC40 — id (numérique) de la société ERP PROPRIÉTAIRE du connecteur Odoo.
# Sans lui, le connecteur reste INACTIF pour toutes les sociétés (fail-closed),
# même si les 4 variables ci-dessus sont posées. Les commandes odoo_pull et
# odoo_import_notes exigent en plus --company <slug|id> (la même société).
# ODOO_COMPANY_ID=

# ── Email (Brevo / SendGrid) ──────────────────────────────────
# ADEP8 — par défaut, une pile copiée de ce fichier garde le backend CONSOLE :
# les e-mails sont imprimés dans les logs, AUCUN appel réseau, aucun envoi à un
# vrai client depuis une pile locale. Recette PRODUCTION (à décommenter dans le
# .env du serveur seulement, avec une vraie clé) :
#   Brevo    : EMAIL_BACKEND=anymail.backends.sendinblue.EmailBackend
#              BREVO_API_KEY=<clé Brevo>
#   SendGrid : EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
#              SENDGRID_API_KEY=<clé SendGrid>
#              (clé : https://app.sendgrid.com/settings/api_keys ;
#               expéditeur : https://app.sendgrid.com/settings/sender_auth)
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
DEFAULT_FROM_EMAIL=contact@votre-domaine.com
CONTACT_EMAIL=contact@votre-domaine.com

# ── Sync leads Odoo sans IA (sync_odoo_leads / push_odoo_stages) ──
# Clé API à créer dans Odoo : Préférences ▸ Sécurité du compte ▸ Nouvelle
# clé API (durée max 3 mois, valeur affichée UNE seule fois — jamais commitée).
# Sans ces variables, les deux commandes ne font RIEN (sortie propre).
#
# CRX11 — LAISSÉES COMMENTÉES À DESSEIN. Renseignées d'office, un simple
# `cp .env.example .env` rendait `OdooConfig.incomplete` faux : les commandes
# se croyaient configurées et partaient appeler une base d'exemple
# (https://votre-base.odoo.com) au lieu de s'arrêter proprement. Décommenter
# et renseigner UNIQUEMENT sur une machine qui doit vraiment parler à Odoo.
# ODOO_SYNC_URL=https://votre-base.odoo.com
# ODOO_SYNC_API_KEY=your_odoo_api_key
# ODOO_SYNC_DB=                                  # optionnel (X-Odoo-Database)

# ── Contact form (PARKED by default) ──────────────────────────
# Public landing-page contact form is OFF by default: the endpoint returns 404
# and no email is sent. To re-enable, set BOTH flags to 1 and rebuild the
# frontend (docker compose up -d --build). See CLAUDE.md.
CONTACT_FORM_ENABLED=0
VITE_CONTACT_FORM_ENABLED=0

# ── Veille appels d'offres — collecte DÉSARMÉE par défaut ──────
# Règle #5 volet (b) : la première exécution réelle de la collecte automatique
# exige l'accord explicite et DATÉ du fondateur (tâche VAO4), consigné dans
# tos_risk/marchespublics_gov_ma.md. À 0 (défaut), la tâche planifiée de 06:00
# ET le bouton « Rafraîchir maintenant » sortent sans aucun appel réseau.
# Passer à 1 EST l'acte d'armement — jamais la décision d'un agent.
VEILLE_AO_COLLECTE_ACTIVE=0
# Rétention du sas (mois) : les avis nouveaux/ignorés dont la date limite est
# dépassée depuis ce délai sont purgés. Les avis retenus/convertis, jamais.
VEILLE_AO_RETENTION_MOIS=12

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost/api/django
VITE_IA_API_URL=http://localhost/api/fastapi
# SCA24 — marque produit neutre affichée sur l'écran de login (pré-auth, avant
# de connaître la société de l'utilisateur donc avant tout TenantTheme). Vide
# = repli sobre "ERP". Le thème par société (logo/couleur) s'applique APRÈS
# connexion, dans le shell, via l'endpoint core TenantTheme existant.
VITE_PRODUCT_NAME=


# ── QAH8 — Sentry frontend (monitoring d'erreurs), gardé par DSN ──────
# Pendant React de `SENTRY_DSN` côté Django (core/monitoring.py — variable
# d'environnement backend, pas ci-dessus dans ce fichier). Vide (défaut) =
# monitoring frontend désactivé : `@sentry/react` n'est même pas chargé,
# aucun octet envoyé (voir frontend/src/lib/monitoring.js). Flag BUILD-TIME
# (Vite l'inline au bundle, transmis par docker-compose.yml en build arg) :
# le poser exige un rebuild d'image frontend (docker compose up -d --build
# frontend), jamais un simple redémarrage. Session replay (10 % des sessions,
# 100 % sur erreur) masque tout texte/toute saisie par défaut — jamais de
# donnée client dans une capture.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# Recepteur leads site web (apps/crm/webhooks.py) ? secret statique obligatoire
WEBSITE_LEAD_WEBHOOK_SECRET=
# Tenant cible des leads web (vide = premiere Company)
WEBSITE_LEADS_COMPANY_ID=

# YBW51 - demandes de rendez-vous du site YanBow (apps/crm/webhooks.py,
# POST /api/django/crm/webhooks/demande-rdv/). Format :
#   SITE_RDV_CLES=<id_cle>:<slug de la societe YanBow>:<secret hex>
# (plusieurs cles separees par des virgules ; secret = python -c "import secrets;print(secrets.token_hex(32))").
# La societe est CELLE du slug lie a la cle, jamais un repli. Vide = tout refuse (401).
# Cote Worker (tableau de bord Cloudflare) : YANBOW_RDV_URL=https://api.taqinor.ma/api/django/crm/webhooks/demande-rdv/,
# YANBOW_RDV_CLE_ID=<id_cle>, YANBOW_RDV_SECRET=<secret hex> (le meme).
# SITE_RDV_CLES=
# SITE_RDV_LIMITE_PAR_MINUTE=30

# QJR414 (decision fondateur DR3) ? les DEUX webhooks entrants ci-dessous sont
# FAIL-CLOSED : sans leur secret d'application, tout POST est REFUSE (403) et
# aucun payload n'est traite. Tant qu'ils sont vides, la synchronisation
# entrante reste EN PAUSE ? c'est VOULU, ce n'est pas une panne. Un
# avertissement bruyant est emis au demarrage (crm.W010 / notifications.W010).
# Secret d'application Meta (webhook Lead Ads, apps/crm/webhooks.py)
META_LEAD_ADS_APP_SECRET=
# Secret d'application du BSP WhatsApp (apps/notifications/views_whatsapp_bsp.py)
WHATSAPP_BSP_APP_SECRET=
# ASEC36 — webhook WhatsApp SAV entrant (apps/sav/public_views.py), FAIL-CLOSED
# lui aussi : sans secret, tout message entrant est REFUSE (rien n'est cree).
# Secret d'application Meta qui signe le webhook (X-Hub-Signature-256).
SAV_WHATSAPP_APP_SECRET=
# Rattachement numero WhatsApp Business -> societe ERP, format
# <phone_number_id>=<company_id>,<phone_number_id>=<company_id>
# Un numero absent de la liste n'est rattache a AUCUNE societe (message ignore).
SAV_WHATSAPP_NUMEROS=

# Origine du SITE PUBLIC (apps/web) : base de TOUT lien envoye a un client
# (questionnaire /questionnaire/<token>/, reservation /rdv/<token>). Ces pages
# vivent sur le site Astro, jamais sur l'API : sans cette base, un lien
# construit sur l'hote de la requete (api.taqinor.ma) part mort chez le client.
# Vide = repli sur SITE_URL (https://taqinor.ma par defaut).
PUBLIC_SITE_URL=

# CRX29 — Purge automatique de la RETENTION (core.retention / tache planifiee
# core.run_retention). OFF PAR DEFAUT (0) : la tache tourne en SIMULATION et ne
# supprime RIEN tant que cette variable ne vaut pas 1 explicitement. Elle n'est
# donc PAS active en production aujourd'hui — les politiques de retention
# (CNDP/RGPD) sont calculees et rapportees, jamais appliquees. Mettre 1 est une
# decision FONDATEUR : la suppression est definitive.
RETENTION_AUTO_APPLY=0

# AUD730 — les deux balayages RH nouvellement PLANIFIES dont l'effet n'est pas
# neutre. Meme convention que RETENTION_AUTO_APPLY ci-dessus : OFF PAR DEFAUT
# (0), la tache COMPTE et journalise sans rien ecrire.
#   * rh.purger_candidatures (XRH24) anonymise IRREVERSIBLEMENT les
#     candidatures rejetees hors vivier au-dela de la retention CNDP.
#   * rh.planifier_appreciations (ZRH8) cree les evaluations des jalons
#     d'anciennete franchis — la CADENCE d'un cycle d'appreciation est une
#     decision FONDATEUR, pas un defaut technique.
# Les deux autres balayages du meme lot (rh.accruer_conges,
# rh.clore_pointages_ouverts) sont idempotents et non destructifs : ils
# s'appliquent directement, sans variable d'opt-in.
RH_PURGE_CANDIDATURES_AUTO_APPLY=0
RH_APPRECIATIONS_AUTO_APPLY=0

# N1 (CAD120 revu) — NOTIFICATIONS AUX HEURES DE TRAVAIL. DECISION FONDATEUR
# du 25/09/2026 : « les notifications ne doivent pas etre a minuit ni 23 h ;
# garde toutes les notifications importantes mais place-les aux heures de
# travail ». Une notification emise hors de la fenetre de MESSAGES de la
# societe (Parametres : ouverture des messages 08:30, fermeture du soir 20:00,
# jours ouvres, feries, fenetre du Ramadan — apps/crm/horaires.py) est creee
# tout de suite puis REPORTEE AU PROCHAIN CRENEAU OUVRE : la cloche in-app,
# l'e-mail, WhatsApp et le push la recoivent a l'ouverture (balayage
# notifications.livrer_differees, toutes les 5 min). Rien n'est jamais saute,
# et un evenement CRITIQUE attend lui aussi l'ouverture.
#
# 1 (DEFAUT, aussi quand la ligne est absente) = report au prochain creneau
#   ouvre.
# 0 = urgence / debogage : tout repart tout de suite, 24 h/24.
#
# Les alertes de SECURITE (nouvel appareil, break-glass, anomalie d'identite)
# partent toujours immediatement. Sous le test runner le report est toujours
# coupe (les tests l'allument eux-memes).
NOTIFICATIONS_QUIET_HOURS_ENABLED=1
#
# Cles d'evenement (EventType) qui partent immediatement meme la nuit et le
# week-end, separees par des virgules. Defaut (ligne absente) = les alertes de
# lead (decision fondateur du 04/10/2026).
# NOTIFICATIONS_TOUJOURS_IMMEDIATES=lead_new,lead_assigned,lead_callback_requested

# ── PLAN_VEILLE (VEIL12) — acces Meta Ad Library du pilote de veille ─────────
# SEPARE de tout ce qui sert aux campagnes TAQINOR (MetaConnection,
# META_SYSTEM_USER_TOKEN, META_LEAD_ADS_*). Vide / interrupteur a 0 = aucun appel.
# META_AD_LIBRARY_ENABLED=0
# META_AD_LIBRARY_ACCESS_TOKEN=
# META_AD_LIBRARY_APP_ID=
# META_AD_LIBRARY_APP_SECRET=
# Identifiants des societes autorisees (virgules). Vide = personne (D-VEIL-12).
# VEILLE_SOCIETES_AUTORISEES=
# VEIL22 — tri IA de la veille dans l'ERP (API Anthropic PAYANTE) : eteint tant
# que la cle est vide. Cle SEPAREE de CLAUDE_API_KEY. Modeles a choisir (aucun
# modele code en dur).
# VEILLE_IA_CLE_API=
# VEILLE_IA_MODELE_TRI=
# VEILLE_IA_MODELE_AMBIGU=
# VEILLE_IA_SEUIL_AMBIGU=0.7

# ── ACAL331 (D-ACAL-17) — compte de panneaux par le moteur de calepinage ─────
# 0 (DEFAUT, aussi quand la ligne est absente) = compte historique du devis.
# 1 = bascule A/B sur le moteur partage core/calepinage (NOUVEAUX devis
# seulement ; un devis deja emis n'est jamais recalcule). Lancer d'abord le
# dry-run : python manage.py comparer_compte_moteur_calepinage --json
USE_MOTEUR_CALEPINAGE=0

# ── ENFP (decision fondateur D1) — refus des parametres de requete non declares ─
# 0 (DEFAUT, aussi quand la ligne est absente) = tolerant ; 1 = toute requete portant
# un ?parametre que le schema OpenAPI de l operation ne declare pas recoit un 400
# unknown_query_parameter. Le job api-fuzz de la CI le force a 1.
API_QUERY_PARAMS_STRICT=0
