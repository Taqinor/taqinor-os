# ADEP — PROXYS DE CONFIANCE (preuve de signature, 24/10/2026). La page
# /proposition est servie par le Worker Cloudflare, qui relaie l'acceptation
# vers l'API avec `X-Forwarded-For: <IP du visiteur>`. Sans cette liste, Caddy
# REMPLAÇAIT l'en-tête par l'IP de son pair (un nœud Cloudflare) : les 18
# signatures stockées en production portaient des adresses 162.158.x /
# 172.68.x (contrôle lecture seule du 24/10/2026), jamais celle du signataire.
# Plages publiées par Cloudflare (https://www.cloudflare.com/ips/) ; nginx
# déclare les mêmes en `set_real_ip_from` et remonte la chaîne jusqu'au
# visiteur (`real_ip_recursive on`).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Reverse proxy public du Taqinor OS — HTTPS automatique (Let's Encrypt).
# Deux hôtes servent le MÊME OS : api.taqinor.ma (canonique depuis 2026-06)
# et l'ancien {$PUBLIC_HOSTNAME} (sslip.io), conservé pour ne casser aucun
# favori — Caddy gère un certificat par hôte, ça ne coûte rien.
{$PUBLIC_HOSTNAME}, api.taqinor.ma {
	encode gzip
	reverse_proxy nginx:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Simulateur de devis (rescapé du vieux serveur cPanel taqinor.ma/simulator).
# App FastAPI servie par uvicorn en systemd sur l'hôte, écoutant sur la
# passerelle du réseau docker (172.18.0.1:8090) — donc jamais exposée
# publiquement, Caddy seul y accède et termine le TLS.
# L'app est CÂBLÉE sur le préfixe /simulator (son JS appelle /simulator/api/…,
# son HTML charge /simulator/static/…, root_path="/simulator"). On le préserve
# TEL QUEL : on relaie le chemin SANS retirer le préfixe (l'app attend le
# chemin complet /simulator/…), et la racine nue redirige vers /simulator/.
simulateur.taqinor.ma {
	encode gzip
	redir / /simulator/ 308
	reverse_proxy 172.18.0.1:8090 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
