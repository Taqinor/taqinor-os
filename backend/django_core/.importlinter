[importlinter:contract:tiers-is-a-base-layer]
name = The tiers foundation app imports downward only (no domain-core or satellite app — locks ARC17)
type = forbidden
source_modules =
    apps.tiers
forbidden_modules =
    apps.crm
    apps.ventes
    apps.stock
    apps.installations
    apps.sav
    apps.compta
    apps.reporting
    apps.automation
    apps.monitoring
    apps.notifications
    apps.publicapi
    apps.audit
    apps.documents
    apps.dataimport
    apps.contact
# ARC18/19/21 — les modules de TEST des ponts Tiers importent volontairement les
# vrais modèles historiques (crm.Client/Lead, stock.Fournisseur, compta.Partenaire,
# rh.DossierEmploye) et le service crm pour PROUVER que le miroir one-way et la
# bascule flag-gatée fonctionnent de bout en bout. Ce sont des tests d'intégration
# cross-couche, PAS un couplage de production : le code de PRODUCTION de `tiers`
# reste strictement base-layer (aucun import statique de domaine — vérifié). On
# ignore uniquement ces arêtes test→domaine (même motif que les exceptions
# core.tests.* ci-dessous).
ignore_imports =
    apps.tiers.tests.test_arc18_bridge -> apps.crm.models
    apps.tiers.tests.test_arc18_bridge -> apps.stock.models
    apps.tiers.tests.test_arc19_bridge -> apps.compta.models
    apps.tiers.tests.test_arc19_bridge -> apps.rh.models
    apps.tiers.tests.test_arc21_source_ecriture -> apps.crm.models
    apps.tiers.tests.test_arc21_source_ecriture -> apps.crm.services

# ARC6 — `core.numbering` (fabrique de références anti-collision, ex
# `apps.ventes.utils.references`) est une primitive de FONDATION relogée ici :
# elle reçoit en paramètre le modèle/préfixe/société dont elle a besoin, n'importe
# donc AUCUNE app métier et respecte nativement le contrat base-layer ci-dessous.
# `apps.ventes.utils.references` n'est plus qu'un shim de ré-export bit-identique.
[importlinter:contract:core-foundation-is-a-base-layer]
name = The core foundation app imports downward only (no domain-core or satellite app)
type = forbidden
source_modules =
    core
forbidden_modules =
    apps.crm
    apps.ventes
    apps.stock
    apps.installations
    apps.sav
    apps.reporting
    apps.automation
    apps.monitoring
    apps.notifications
    apps.publicapi
    apps.audit
    apps.documents
    apps.dataimport
    apps.contact
# YRBAC6/YRBAC9 — two core SECURITY-RATCHET *test* modules deliberately import
# real domain serializers/models to prove the core masking mixins actually strip
# sensitive fields (prix_achat/marge) and that no public endpoint leaks. These
# are cross-layer integration tests, not production `core` coupling: the base-
# layer intent (core PRODUCTION code imports downward only) holds. Ignore only
# these specific test→domain edges.
ignore_imports =
    core.tests.test_sensitive_field_leak -> apps.stock.serializers
    core.tests.test_sensitive_field_leak -> apps.stock.models
    core.tests.test_public_endpoint_hardening -> apps.ventes.models
    core.tests.test_public_endpoint_hardening -> apps.crm.models
    core.tests.test_registre_traitements -> apps.crm.models
# YHARD4/YHARD10 — two more core cross-layer INTEGRATION tests: YHARD4 asserts
# the i18n content-translation layer round-trips a real domain serializer, and
# YHARD10's export-anonymise UAT-clone command is proven against a real
# crm.Client. Same rationale as the YRBAC6/9 exceptions above — test-only
# cross-layer edges, not production `core` coupling (core prod code imports
# downward only). Ignore just these specific test→domain edges.
    core.tests.test_yhard4_i18n_content -> apps.stock.models
    core.tests.test_yhard4_i18n_content -> apps.stock.serializers
    core.tests.test_yhard10_export_anonymise -> apps.crm.models
# ARC1/2/6 + SCA30-33 — les tests des primitives noyau (TenantModel, viewset
# scopé, numérotation, kit DocumentMetier) exercent la primitive contre de VRAIS
# modèles/viewsets domaine ; même motif que les exceptions ci-dessus (arêtes
# test→domaine, jamais du couplage `core` de production — le code prod de core
# n'importe plus records.views depuis le fold repair, cf. document_viewset qui
# INJECTE désormais le chatter mixin).
    core.tests.test_tenant_model -> apps.notifications.models
    core.tests.test_numbering -> apps.crm.models
    core.tests.test_numbering -> apps.ventes.models
    core.tests.test_numbering -> apps.ventes.utils.references
    core.tests.test_company_scoped_viewset -> apps.crm.views
    core.tests.test_company_scoped_viewset -> apps.sav.views
    core.tests.test_company_scoped_viewset -> apps.installations.views.transporteur
    core.tests.test_documents_viewset -> apps.records.views
    core.tests.test_documents_status -> apps.installations.models_demande_achat
    core.tests.test_documents_status -> apps.installations.models_ordre_soustraitance
# NTDMO25 — `authentication.tasks.seed_demo_company_task` (Celery envelope)
# imports `authentication.views_demo_wizard` LAZILY (function-local, only at
# call time), which itself pulls in `authentication.views_console` and, from
# there, several domain selectors (the demo-kit wizard seeds sample data
# across apps). grimp still sees the static edge, so the legitimate
# core.tests.test_wir50_security_beat -> authentication.tasks foundation-app
# edge (already allowed, `authentication` not in forbidden_modules) now
# transitively reaches those domain apps through this ONE hop. Prune just
# that hop — the same pattern as the test-only edges above, but for a lazy
# production edge instead of a test edge.
    authentication.tasks -> authentication.views_demo_wizard
# NTDMO30 — MÊME motif, une hop de plus : la purge des sociétés démo expirées
# (`purger_societes_demo_expirees_task`) écrit son PROPRE AuditLog avant chaque
# suppression, via un import fonction-local `apps.audit.recorder` — exactement
# comme `authentication.device`/`password_policy`/`services`/`views`/
# `views_console` le font depuis longtemps, et comme les exceptions
# `notifications|stock|automation|dataimport.services -> apps.audit.recorder`
# plus haut dans ce fichier. grimp voit l'arête statique, donc l'arête
# fondation LÉGITIME `core.tests.test_wir50_security_beat -> authentication.
# tasks` (autorisée : `authentication` n'est pas dans forbidden_modules)
# atteint maintenant apps.ventes/stock/sav de façon TRANSITIVE via
# audit.recorder -> records.services -> <domaine>.selectors. On élague cette
# SEULE hop : toute arête DIRECTE `core.* -> apps.*` reste détectée, et aucune
# autre source ne gagne le moindre droit.
    authentication.tasks -> apps.audit.recorder

# AOF33 — `core.calepinage` est le MOTEUR de calepinage, partagé par DEUX
# consommateurs qui ne peuvent pas s'importer l'un l'autre (`apps.ao` pour la
# réponse à appel d'offres, `apps.ventes` pour la villa). Le loger dans l'une
# des deux apps obligerait l'autre à en dépendre — sémantiquement faux et déjà
# bloqué par les contrats ci-dessus. Il vit donc en fondation, et sa PURETÉ est
# la contrepartie : stdlib + numpy seulement, aucune dépendance Django. C'est ce
# qui le rend testable SANS base de données, donc hors du gate migrations.
# Django/DRF/celery ne sont pas des root_packages ici : ils sont couverts par le
# second verrou `core/tests/test_calepinage_purete.py` (analyse AST).
[importlinter:contract:calepinage-est-un-noyau-pur]
name = Le moteur de calepinage reste un noyau pur (aucun modèle, vue, tâche ou app)
type = forbidden
source_modules =
    core.calepinage
forbidden_modules =
    core.models
    core.views
    core.vues
    core.serializers
    core.viewsets
    core.services
    core.selectors
    core.tasks
    core.jobs
    core.numbering
    core.documents
    core.pdf
    core.permissions
    core.events
    core.workflow
    core.middleware
    core.mixins
    authentication

# PV33 — `core.electrique` est le MOTEUR de conception ÉLECTRIQUE PV (chaînes,
# onduleurs, protections, sections de câble, nomenclature, schéma unifilaire),
# frère de `core.calepinage` et partagé par les MÊMES deux consommateurs qui ne
# peuvent pas s'importer l'un l'autre (`apps.ao`, `apps.ventes`). Même
# arbitrage, donc même contrepartie : il vit en fondation et reste PUR —
# stdlib SEULEMENT (il n'a même pas l'usage de numpy), aucune dépendance
# Django, aucune I/O. C'est ce qui le rend testable SANS base de données, donc
# hors du gate migrations.
# `core.calepinage` figure dans les modules INTERDITS : les deux noyaux se
# versionnent séparément et ne doivent pas se tenir par la main (un noyau qui en
# importe un autre hérite de ses dépendances et de son MAJEUR).
# Django/DRF/celery ne sont pas des root_packages ici : ils sont couverts par le
# second verrou `core/tests/test_electrique_purete.py` (analyse AST).
[importlinter:contract:electrique-est-un-noyau-pur]
name = Le moteur électrique reste un noyau pur (aucun modèle, vue, tâche ou app)
type = forbidden
source_modules =
    core.electrique
forbidden_modules =
    core.calepinage
    core.models
    core.views
    core.vues
    core.serializers
    core.viewsets
    core.services
    core.selectors
    core.tasks
    core.jobs
    core.numbering
    core.documents
    core.pdf
    core.permissions
    core.events
    core.workflow
    core.middleware
    core.mixins
    authentication
