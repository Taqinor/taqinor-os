# AUD825 — COUVERTURE COMPLÉTÉE (28/09/2026). Ce contrat n'énumérait que 15 des
# 77 paquets de `apps/` : 62 apps (compta, facturation, achats, ged, rh, paie,
# contrats, cpq, marketing, pos, portail, ao…) n'étaient PAS couvertes, et un
# contrat `forbidden` ne teste QUE ce qu'il énumère. Contrairement au contrat
# `core` ci-dessous, on ne peut PAS écrire `forbidden_modules = apps` ici :
# `apps.tiers` est un descendant de `apps` et import-linter refuse la
# configuration (« Modules have shared descendants ») — même chose avec
# `apps.*`. La couverture est donc EXHAUSTIVE PAR ÉNUMÉRATION : les 71 apps
# ci-dessous = tous les paquets de `apps/` SAUF `tiers` lui-même et les apps de
# FONDATION (`roles`, `records`, `parametres`, `customfields`, `core`), qui
# n'ont jamais figuré parmi les 15 interdites — les exempter ne relâche donc
# rien. Une app AJOUTÉE plus tard n'est pas couverte automatiquement : c'est la
# limite structurelle du type `forbidden` avec une source interne au paquet.
[importlinter:contract:tiers-is-a-base-layer]
name = The tiers foundation app imports downward only (no domain-core or satellite app — locks ARC17)
type = forbidden
source_modules =
    apps.tiers
forbidden_modules =
    apps.accessreview
    apps.achats
    apps.adminops
    apps.adsengine
    apps.agent
    apps.agriculture
    apps.ai_governance
    apps.ao
    apps.assurances
    apps.audit
    apps.automation
    apps.btp_chantier
    apps.chat
    apps.compta
    apps.contact
    apps.contacts
    apps.contrats
    apps.conversation_ai
    apps.cpq
    apps.credit
    apps.crm
    apps.dataimport
    apps.documents
    apps.douane
    apps.ecommerce_connect
    apps.education
    apps.einvoice
    apps.entites
    apps.esg
    apps.extensions
    apps.facturation
    apps.fiscal
    apps.flotte
    apps.fpa
    apps.frais
    apps.ged
    apps.gestion_projet
    apps.hospitality
    apps.identity
    apps.immobilier
    apps.innovation
    apps.installations
    apps.kb
    apps.litiges
    apps.marketing
    apps.migration
    apps.monitoring
    apps.mrp
    apps.notifications
    apps.offlinesync
    apps.onboarding
    apps.outillage
    apps.paie
    apps.portail
    apps.pos
    apps.promotions
    apps.publicapi
    apps.qhse
    apps.reporting
    apps.rh
    apps.sante
    apps.sav
    apps.scm
    apps.stock
    apps.territoires
    apps.transport
    apps.trash
    apps.uxviews
    apps.veille_ao
    apps.ventes
    apps.visites
    apps.voip
# ARC18/19/21 + AUDV23 — les modules de TEST des ponts Tiers importent volontairement les
# vrais modèles historiques (crm.Client/Lead, stock.Fournisseur, compta.Partenaire,
# rh.DossierEmploye) et le service crm pour PROUVER que le miroir one-way et la
# bascule flag-gatée fonctionnent de bout en bout. Ce sont des tests d'intégration
# cross-couche, PAS un couplage de production : le code de PRODUCTION de `tiers`
# reste strictement base-layer (aucun import statique de domaine — vérifié). On
# ignore uniquement ces arêtes test→domaine (même motif que les exceptions
# core.tests.* ci-dessous).
ignore_imports =
    apps.tiers.tests.test_arc18_bridge -> apps.crm.models
    apps.tiers.tests.test_arc18_bridge -> apps.stock.models
    apps.tiers.tests.test_arc19_bridge -> apps.compta.models
    apps.tiers.tests.test_arc19_bridge -> apps.rh.models
    apps.tiers.tests.test_arc21_source_ecriture -> apps.crm.models
    apps.tiers.tests.test_arc21_source_ecriture -> apps.crm.services
    apps.tiers.tests.test_audv23_hooks_identite -> apps.crm.models
    apps.tiers.tests.test_audv23_hooks_identite -> apps.stock.models
    apps.tiers.tests.test_audv23_hooks_identite -> apps.stock.services

# ARC6 — `core.numbering` (fabrique de références anti-collision, ex
# `apps.ventes.utils.references`) est une primitive de FONDATION relogée ici :
# elle reçoit en paramètre le modèle/préfixe/société dont elle a besoin, n'importe
# donc AUCUNE app métier et respecte nativement le contrat base-layer ci-dessous.
# `apps.ventes.utils.references` n'est plus qu'un shim de ré-export bit-identique.
# AUD825 — POLARITÉ INVERSÉE (28/09/2026). Ce contrat énumérait 14 apps
# interdites sur les 78 que porte `apps/` : compta, facturation, achats, ged,
# rh, paie, contrats, cpq, marketing, pos, portail, ao… n'étaient PAS couverts,
# et un contrat `forbidden` ne teste QUE ce qu'il énumère. La couche était
# propre en fait, mais la GARDE avait un trou de 63 apps : une lane future qui
# aurait écrit `from apps.compta.models import EcritureComptable` dans `core/`
# serait passée avec une CI verte, réintroduisant le cycle d'import que M5
# interdit. On interdit désormais le PAQUET ENTIER (`apps`) et on énumère les
# arêtes légitimes ci-dessous — la liste à tenir devient celle des EXCEPTIONS
# (qui se justifient une par une) et non celle des apps couvertes (qui se
# périme à chaque `startapp`).
[importlinter:contract:core-foundation-is-a-base-layer]
name = The core foundation app imports downward only (no domain-core or satellite app)
type = forbidden
source_modules =
    core
forbidden_modules =
    apps
# AUD825 / ARÊTES FONDATION → FONDATION. `roles`, `records` et `parametres`
# sont des apps de FONDATION au sens de CLAUDE.md (« foundation-app imports
# (roles, records, authentication, core, customfields, parametres, reporting…)
# are exempt ») : elles vivaient déjà HORS de la liste des 14 interdites, donc
# les exempter ici ne relâche RIEN par rapport à l'état d'avant l'inversion —
# c'est la traduction fidèle de l'ancien périmètre. Deux arêtes de PRODUCTION
# les empruntent (`core.scoping -> apps.roles.models`,
# `core.feature_flags -> apps.records.models`, plus la commande
# `preflight_edition`), le reste sont des tests noyau qui montent un rôle ou un
# enregistrement réel. Un import `core -> apps.<domaine>` reste refusé.
ignore_imports =
    core.** -> apps.roles.**
    core.** -> apps.records.**
    core.** -> apps.parametres.**
# MÊME arête fondation→fondation, atteinte d'une hop plus loin :
# `core.tenant_context -> authentication.cookie_auth -> authentication.
# session_policy -> apps.parametres.models` (lecture fonction-locale du
# `CompanyProfile` pour la politique de session). `authentication` est une app
# de fondation autorisée (elle n'a jamais figuré parmi les 14 interdites), et
# `parametres` l'est aussi : on élague cette SEULE hop, exactement comme les
# exceptions `authentication.tasks -> …` plus bas. Toute arête DIRECTE
# `core.* -> apps.<domaine>` reste détectée.
    authentication.session_policy -> apps.parametres.models
# AUD231 — le test des huit balayages beat a DÉMÉNAGÉ dans apps/pos/tests
# (contrat core = couche de base, fix-ci #620) : plus aucune arête core.tests
# vers les domaines, les exceptions mortes sont retirées (06/09/2026).
# SOL13/SOL14 + YHARD — trois autres tests noyau cross-couche révélés par
# l'inversion : le registre des traitements CNDP s'appuie sur un dossier RH
# réel, et le filtre « sociétés ayant tel module » sur une société d'adminops.
    core.tests.test_registre_traitements -> apps.rh.models
    core.tests.test_sol14_societes_avec_module -> apps.adminops.models
# YRBAC6/YRBAC9 — two core SECURITY-RATCHET *test* modules deliberately import
# real domain serializers/models to prove the core masking mixins actually strip
# sensitive fields (prix_achat/marge) and that no public endpoint leaks. These
# are cross-layer integration tests, not production `core` coupling: the base-
# layer intent (core PRODUCTION code imports downward only) holds. Ignore only
# these specific test→domain edges.
    core.tests.test_sensitive_field_leak -> apps.stock.serializers
    core.tests.test_sensitive_field_leak -> apps.stock.models
    core.tests.test_public_endpoint_hardening -> apps.ventes.models
    core.tests.test_public_endpoint_hardening -> apps.crm.models
    core.tests.test_registre_traitements -> apps.crm.models
# YHARD4/YHARD10 — two more core cross-layer INTEGRATION tests: YHARD4 asserts
# the i18n content-translation layer round-trips a real domain serializer, and
# YHARD10's export-anonymise UAT-clone command is proven against a real
# crm.Client. Same rationale as the YRBAC6/9 exceptions above — test-only
# cross-layer edges, not production `core` coupling (core prod code imports
# downward only). Ignore just these specific test→domain edges.
    core.tests.test_yhard4_i18n_content -> apps.stock.models
    core.tests.test_yhard4_i18n_content -> apps.stock.serializers
    core.tests.test_yhard10_export_anonymise -> apps.crm.models
# NTAI24 — l'index sémantique cross-module est une FONDATION qui ne cite que
# des CHAÎNES (« crm.lead ») : le code de production n'importe aucune app. Son
# test, lui, indexe un lead/client RÉEL pour prouver que le branchement
# post_save/post_delete fonctionne de bout en bout. Même motif test→domaine que
# les exceptions ci-dessus ; l'intention base-layer tient.
    core.tests.test_ntai24_search_index -> apps.crm.models
# ARC1/2/6 + SCA30-33 — les tests des primitives noyau (TenantModel, viewset
# scopé, numérotation, kit DocumentMetier) exercent la primitive contre de VRAIS
# modèles/viewsets domaine ; même motif que les exceptions ci-dessus (arêtes
# test→domaine, jamais du couplage `core` de production — le code prod de core
# n'importe plus records.views depuis le fold repair, cf. document_viewset qui
# INJECTE désormais le chatter mixin).
    core.tests.test_tenant_model -> apps.notifications.models
    core.tests.test_numbering -> apps.crm.models
    core.tests.test_numbering -> apps.ventes.models
    core.tests.test_numbering -> apps.ventes.utils.references
    core.tests.test_company_scoped_viewset -> apps.crm.views
    core.tests.test_company_scoped_viewset -> apps.sav.views
    core.tests.test_company_scoped_viewset -> apps.installations.views.transporteur
    core.tests.test_documents_viewset -> apps.records.views
    core.tests.test_documents_status -> apps.installations.models_demande_achat
    core.tests.test_documents_status -> apps.installations.models_ordre_soustraitance
# AUD422 — AUCUNE exception ajoutée, et c'est délibéré : la suite de déni
# cross-tenant RLS (`core/tests/test_rls_cross_tenant_denial.py`) peuple des
# lignes RÉELLES dans les cinq tables argent en résolvant ses modèles par
# CHAÎNE (`django.apps.apps.get_model('compta', 'EcritureComptable')`), jamais
# par import. Un `from apps.compta.models import …` y ouvrait, en transitif,
# une dizaine d'arêtes interdites (compta.models → crm.models → crm.services →
# notifications / ventes / stock / sav / publicapi / reporting) : les élaguer
# aurait affaibli le contrat pour TOUT LE MONDE. Ne pas « simplifier » ce test
# en réintroduisant les imports.
# NTDMO25 — `authentication.tasks.seed_demo_company_task` (Celery envelope)
# imports `authentication.views_demo_wizard` LAZILY (function-local, only at
# call time), which itself pulls in `authentication.views_console` and, from
# there, several domain selectors (the demo-kit wizard seeds sample data
# across apps). grimp still sees the static edge, so the legitimate
# core.tests.test_wir50_security_beat -> authentication.tasks foundation-app
# edge (already allowed, `authentication` not in forbidden_modules) now
# transitively reaches those domain apps through this ONE hop. Prune just
# that hop — the same pattern as the test-only edges above, but for a lazy
# production edge instead of a test edge.
    authentication.tasks -> authentication.views_demo_wizard
# NTDMO30 — MÊME motif, une hop de plus : la purge des sociétés démo expirées
# (`purger_societes_demo_expirees_task`) écrit son PROPRE AuditLog avant chaque
# suppression, via un import fonction-local `apps.audit.recorder` — exactement
# comme `authentication.device`/`password_policy`/`services`/`views`/
# `views_console` le font depuis longtemps, et comme les exceptions
# `notifications|stock|automation|dataimport.services -> apps.audit.recorder`
# plus haut dans ce fichier. grimp voit l'arête statique, donc l'arête
# fondation LÉGITIME `core.tests.test_wir50_security_beat -> authentication.
# tasks` (autorisée : `authentication` n'est pas dans forbidden_modules)
# atteint maintenant apps.ventes/stock/sav de façon TRANSITIVE via
# audit.recorder -> records.services -> <domaine>.selectors. On élague cette
# SEULE hop : toute arête DIRECTE `core.* -> apps.*` reste détectée, et aucune
# autre source ne gagne le moindre droit.
    authentication.tasks -> apps.audit.recorder
# NTEXT21 — l'onglet custom « objet_custom_lie » (points d'extension UI
# déclaratifs, ``core.ui_extensions``) est une FONDATION pure : ``cible`` est
# une CHAÎNE opaque, et le contenu réel est résolu par un gestionnaire
# ENREGISTRÉ par l'app propriétaire (``apps.customfields`` se branche depuis
# son propre ``ready()`` — même patron que ``core.workflow.
# register_delegation_resolver``, déjà toléré ci-dessus). Le test, lui, monte
# un VRAI Client/Devis/CustomRecord pour prouver le résolveur bout-en-bout —
# même motif test→domaine que toutes les exceptions précédentes ; le code
# PRODUCTION de core (`core/ui_extensions.py`, `core/ui_extensions_api.py`)
# n'importe toujours aucune app métier.
    core.tests.test_ntext21_ui_onglets -> apps.crm.models
    core.tests.test_ntext21_ui_onglets -> apps.customfields.models
    core.tests.test_ntext21_ui_onglets -> apps.ventes.models

# AOF33 — `core.calepinage` est le MOTEUR de calepinage, partagé par DEUX
# consommateurs qui ne peuvent pas s'importer l'un l'autre (`apps.ao` pour la
# réponse à appel d'offres, `apps.ventes` pour la villa). Le loger dans l'une
# des deux apps obligerait l'autre à en dépendre — sémantiquement faux et déjà
# bloqué par les contrats ci-dessus. Il vit donc en fondation, et sa PURETÉ est
# la contrepartie : stdlib + numpy seulement, aucune dépendance Django. C'est ce
# qui le rend testable SANS base de données, donc hors du gate migrations.
# Django/DRF/celery ne sont pas des root_packages ici : ils sont couverts par le
# second verrou `core/tests/test_calepinage_purete.py` (analyse AST).
[importlinter:contract:calepinage-est-un-noyau-pur]
name = Le moteur de calepinage reste un noyau pur (aucun modèle, vue, tâche ou app)
type = forbidden
source_modules =
    core.calepinage
forbidden_modules =
    core.models
    core.views
    core.vues
    core.serializers
    core.viewsets
    core.services
    core.selectors
    core.tasks
    core.jobs
    core.numbering
    core.documents
    core.pdf
    core.permissions
    core.events
    core.workflow
    core.middleware
    core.mixins
    authentication

# PV33 — `core.electrique` est le MOTEUR de conception ÉLECTRIQUE PV (chaînes,
# onduleurs, protections, sections de câble, nomenclature, schéma unifilaire),
# frère de `core.calepinage` et partagé par les MÊMES deux consommateurs qui ne
# peuvent pas s'importer l'un l'autre (`apps.ao`, `apps.ventes`). Même
# arbitrage, donc même contrepartie : il vit en fondation et reste PUR —
# stdlib SEULEMENT (il n'a même pas l'usage de numpy), aucune dépendance
# Django, aucune I/O. C'est ce qui le rend testable SANS base de données, donc
# hors du gate migrations.
# `core.calepinage` figure dans les modules INTERDITS : les deux noyaux se
# versionnent séparément et ne doivent pas se tenir par la main (un noyau qui en
# importe un autre hérite de ses dépendances et de son MAJEUR).
# Django/DRF/celery ne sont pas des root_packages ici : ils sont couverts par le
# second verrou `core/tests/test_electrique_purete.py` (analyse AST).
[importlinter:contract:electrique-est-un-noyau-pur]
name = Le moteur électrique reste un noyau pur (aucun modèle, vue, tâche ou app)
type = forbidden
source_modules =
    core.electrique
forbidden_modules =
    core.calepinage
    core.models
    core.views
    core.vues
    core.serializers
    core.viewsets
    core.services
    core.selectors
    core.tasks
    core.jobs
    core.numbering
    core.documents
    core.pdf
    core.permissions
    core.events
    core.workflow
    core.middleware
    core.mixins
    authentication
