    apps.ventes.domain.facturation_ops
    apps.ventes.domain.encaissements
    apps.ventes.domain.facturation_vente
    apps.ventes.domain.annulation_facture
    apps.ventes.domain.negociation

# VNT9 (Groupe VNT, lot M0) — la vente se lit par la FAÇADE : crm,
# installations, sav, stock, reporting, portail, publicapi et calepinage ne
# lisent jamais en direct les sommes de factures ni les écritures de la vente
# (échéancier, sélecteurs de facturation, module de lecture, domaine de
# facturation) ; ils passent par `apps.ventes.selectors` / `apps.ventes.services`
# (CLAUDE.md, « Cross-app boundary »). Seuls les imports DIRECTS sont jugés.
# `ignore_imports` : VIDE (ENF20, 14/10/2026). Les 4 arêtes de TESTS de la
# sonde R3-E (crm crx20/mry7 -> domain.recouvrement, installations astk et
# stock produit_nom_unique -> domain.facturation_ops) testent des helpers du
# domaine que la façade n'exporte pas (`_x` privés, `facturer_devis_complet`
# appelé par sa seule vue) : elles les chargent par `importlib.import_module`
# (test boîte blanche délibéré, politique QJR645 « un test importe depuis
# apps.ventes.domain.<module> »). Aucun code de PRODUCTION n'y est exempté.
[importlinter:contract:vente-lue-par-la-facade]
name = Les autres domaines lisent la vente par la facade ventes, jamais ses internes de facturation (VNT9)
type = forbidden
allow_indirect_imports = True
