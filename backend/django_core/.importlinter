# VNT9 (Groupe VNT, lot M0) — LA lecture de la vente est PURE : le module unique
# `apps.ventes.vente_facturation` (plan_facturation, etat_vente,
# factures_de_la_vente, chaine_vente ; propriétaire facturation J5) n'importe
# aucune couche d'écriture ni de présentation de ventes. Un module interdit pas
# encore créé (facturation_vente, annulation_facture, negociation) est accepté
# par import-linter ; le module SOURCE, lui, doit exister (créé vide par VNT9).
# Seuls les imports DIRECTS sont jugés.
[importlinter:contract:lecture-de-vente-pure]
name = La lecture de la vente (apps.ventes.vente_facturation) n'importe aucune couche d'ecriture (VNT9)
